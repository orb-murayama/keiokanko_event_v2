    </div>

    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
    <script>
        function logout() {
            document.cookie = 'login=; path=/; max-age=0';
            window.location.href = '/admin/login';
        }

        const pathParts = window.location.pathname.split('/');
        const optionId = pathParts[3];

        async function loadOptionInfo() {
            try {
                const res = await axios.get(\`/api/options/\${optionId}\`);
                const option = res.data;
                document.getElementById('pageTitle').textContent = \`\${option.name} - 在庫管理 | 管理画面\`;
                document.getElementById('optionName').textContent = option.name;
                document.getElementById('eventName').textContent = \`イベント: \${option.event_name || '未設定'}\`;
            } catch (error) {
                console.error('Error loading option info:', error);
            }
        }

        async function loadStocks() {
            try {
                const res = await axios.get(\`/api/options/\${optionId}/stocks\`);
                const stocks = res.data;
                
                document.getElementById('loadingStocks').classList.add('hidden');
                document.getElementById('stocksTableContainer').classList.remove('hidden');
                
                const stocksList = document.getElementById('stocksList');
                
                if (stocks.length === 0) {
                    stocksList.innerHTML = \`
                        <tr>
                            <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                                まだ在庫が設定されていません
                            </td>
                        </tr>
                    \`;
                    return;
                }
                
                stocksList.innerHTML = stocks.map(stock => \`
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 border-b text-sm text-gray-700">
                            \${stock.date || '<span class="text-gray-400">日付指定なし</span>'}
                        </td>
                        <td class="px-4 py-3 border-b text-sm text-gray-700">
                            \${stock.stock_name || '<span class="text-gray-400">-</span>'}
                        </td>
                        <td class="px-4 py-3 border-b text-right text-sm text-gray-700">
                            ¥\${(stock.price || 0).toLocaleString()}
                        </td>
                        <td class="px-4 py-3 border-b text-center">
                            <span class="font-semibold text-blue-600">\${stock.total_stock}</span>
                        </td>
                        <td class="px-4 py-3 border-b text-center">
                            <span class="font-semibold text-orange-600">\${stock.booked}</span>
                        </td>
                        <td class="px-4 py-3 border-b text-center">
                            <span class="font-semibold \${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
                                \${stock.available_stock}
                            </span>
                        </td>
                        <td class="px-4 py-3 border-b text-center">
                            <button onclick="editStock(\${stock.id}, '\${stock.date}', '\${stock.stock_name || ''}', \${stock.price}, \${stock.total_stock})" 
                                class="text-blue-600 hover:text-blue-800 mr-2">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button onclick="deleteStock(\${stock.id})" class="text-red-600 hover:text-red-800">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                \`).join('');
            } catch (error) {
                console.error('Error loading stocks:', error);
                document.getElementById('loadingStocks').innerHTML = \`
                    <p class="text-red-600">データの読み込みに失敗しました</p>
                \`;
            }
        }

        document.getElementById('addStockForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const data = {
                dateStart: formData.get('dateStart'),
                dateEnd: formData.get('dateEnd'),
                stockName: formData.get('stockName') || null,
                price: Number(formData.get('price')),
                totalStock: Number(formData.get('totalStock'))
            };
            
            try {
                const res = await axios.post(\`/api/options/\${optionId}/stocks\`, data);
                alert(res.data.message || '在庫を追加しました');
                e.target.reset();
                await loadStocks();
            } catch (error) {
                console.error('Error adding stock:', error);
                alert('在庫の追加に失敗しました: ' + (error.response?.data?.message || error.message));
            }
        });

        function editStock(id, date, stockName, price, totalStock) {
            document.getElementById('editStockId').value = id;
            document.getElementById('editDate').value = date;
            document.getElementById('editStockName').value = stockName;
            document.getElementById('editPrice').value = price;
            document.getElementById('editTotalStock').value = totalStock;
            document.getElementById('editModal').classList.remove('hidden');
        }

        function closeEditModal() {
            document.getElementById('editModal').classList.add('hidden');
        }

        document.getElementById('editStockForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const stockId = document.getElementById('editStockId').value;
            const data = {
                date: document.getElementById('editDate').value,
                stock_name: document.getElementById('editStockName').value || null,
                price: Number(document.getElementById('editPrice').value),
                total_stock: Number(document.getElementById('editTotalStock').value)
            };
            
            try {
                const res = await axios.put(\`/api/options/\${optionId}/stocks/\${stockId}\`, data);
                alert(res.data.message || '在庫を更新しました');
                closeEditModal();
                await loadStocks();
            } catch (error) {
                console.error('Error updating stock:', error);
                alert('在庫の更新に失敗しました: ' + (error.response?.data?.message || error.message));
            }
        });

        async function deleteStock(id) {
            if (!confirm('この在庫を削除してもよろしいですか？')) return;
            
            try {
                const res = await axios.delete(\`/api/options/\${optionId}/stocks/\${id}\`);
                alert(res.data.message || '在庫を削除しました');
                await loadStocks();
            } catch (error) {
                console.error('Error deleting stock:', error);
                alert('在庫の削除に失敗しました: ' + (error.response?.data?.message || error.message));
            }
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await loadOptionInfo();
            await loadStocks();
        });
    </script>
</body>
</html>
  `)
})


