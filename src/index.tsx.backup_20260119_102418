                font-size: 1rem;
                font-weight: 700;
                color: #2563eb;
                padding-top: 10px;
                border-top: 1px solid #e5e7eb;
            }

            /* Quantity Controls */
            .quantity-controls {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .quantity-btn {
                width: 36px;
                height: 36px;
                border: 2px solid #dc2626;
                background: white;
                color: #dc2626;
                border-radius: 8px;
                font-size: 1.2rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.2s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .quantity-btn:hover:not(:disabled) {
                background: #dc2626;
                color: white;
                transform: scale(1.1);
            }

            .quantity-btn:disabled {
                opacity: 0.3;
                cursor: not-allowed;
            }

            .quantity-display {
                min-width: 40px;
                text-align: center;
                font-size: 1.2rem;
                font-weight: 700;
                color: #1f2937;
            }

            /* Price List Summary */
            .price-list-summary {
                display: none; /* 料金一覧を非表示（コードは保持） */
                background: linear-gradient(135deg, #f0f9ff, #e0e7ff);
                border: 2px solid #3b82f6;
                border-radius: 12px;
                padding: 20px;
                margin-bottom: 25px;
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
            }

            .price-list-title {
                font-size: 1.25rem;
                color: #1f2937;
                margin-bottom: 15px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
            }

            .price-list-title i {
                color: #3b82f6;
            }

            .price-list-grid {
                display: grid;
                gap: 16px;
            }

            .price-list-product {
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 10px;
                padding: 16px;
                box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
            }

            .price-product-header {
                display: flex;
                flex-direction: column;
                gap: 4px;
                margin-bottom: 12px;
                padding-bottom: 12px;
                border-bottom: 2px solid #f3f4f6;
            }

            .price-product-name {
                font-size: 1.1rem;
                font-weight: 700;
                color: #1f2937;
            }

            .price-product-desc {
                font-size: 0.85rem;
                color: #6b7280;
            }

            .price-items-container {
                display: grid;
                gap: 8px;
            }

            .price-list-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: white;
                border: 1px solid #e5e7eb;
                border-radius: 8px;
                padding: 12px 16px;
                transition: all 0.2s;
            }

            .price-list-item:hover {
                border-color: #3b82f6;
                box-shadow: 0 2px 8px rgba(59, 130, 246, 0.1);
            }

            .price-item-name {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            .category-name-badge {
                font-size: 0.95rem;
                font-weight: 600;
                color: #1f2937;
            }

            .product-name-badge {
                font-size: 0.95rem;
                font-weight: 600;
                color: #1f2937;
            }

            .stock-name-text {
                font-size: 0.85rem;
                color: #6b7280;
            }

            .price-item-details {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .price-band-small {
                background: linear-gradient(135deg, #fef3c7, #fde68a);
                color: #92400e;
                padding: 4px 10px;
                border-radius: 6px;
                font-size: 0.75rem;
                font-weight: 600;
                border: 1px solid #fbbf24;
            }

            .price-amount-large {
                font-size: 1.25rem;
                font-weight: 700;
                color: #dc2626;
            }

            /* Price Summary */
            /* Options Section */
            .options-section {
                background: #f9fafb;
                border: 2px solid #e5e7eb;
                border-radius: 12px;
                padding: 25px;
                margin-top: 30px;
            }

            .options-section .section-title {
                font-size: 1.3rem;
                color: #1f2937;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 700;
            }

            .options-section .section-title i {
                color: #8b5cf6;
            }

            .option-group {
                margin-bottom: 25px;
            }

            .option-group:last-child {
                margin-bottom: 0;
            }

            .option-group-header {
                display: flex;
                align-items: flex-start;
                gap: 15px;
                margin-bottom: 15px;
            }

            .option-image {
                width: 80px;
                height: 80px;
                object-fit: cover;
                border-radius: 8px;
                border: 1px solid #e5e7eb;
                flex-shrink: 0;
            }

            .option-header-text {
                flex: 1;
            }

            .option-group-title {
                font-size: 1.2rem;
                font-weight: 700;
                color: #1f2937;
                margin-bottom: 5px;
            }

            .option-group-description {
                font-size: 0.9rem;
                color: #6b7280;
                line-height: 1.5;
            }

            .option-item {
                background: white;
                border: 2px solid #e5e7eb;
                border-radius: 10px;
                padding: 20px;
                margin-bottom: 15px;
                display: flex;
                flex-direction: column;
                gap: 15px;
                transition: all 0.3s ease;
            }

            .option-item:hover {
                border-color: #8b5cf6;
                box-shadow: 0 4px 12px rgba(139, 92, 246, 0.1);
            }

            .option-item:last-child {
                margin-bottom: 0;
            }

            .option-info {
                flex: 1;
            }

            .option-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 8px;
            }

            .option-name {
                font-size: 1.1rem;
                font-weight: 700;
                color: #1f2937;
            }

            .option-price {
                font-size: 1.2rem;
                font-weight: 700;
                color: #dc2626;
            }

            .option-description {
                font-size: 0.9rem;
                color: #6b7280;
                line-height: 1.5;
            }

            .option-stock-info {
                font-size: 0.85rem;
                color: #059669;
                font-weight: 600;
            }

            /* Price Summary */
            .price-summary {
                background: linear-gradient(135deg, #fef3c7, #dbeafe);
                border: 3px solid #f59e0b;
                border-radius: 15px;
                padding: 25px;
                margin-top: 30px;
                box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
                animation: slideIn 0.4s ease;
            }

            @keyframes slideIn {
                from {
                    opacity: 0;
                    transform: translateY(20px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .price-summary h4 {
                font-size: 1.4rem;
                color: #1f2937;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 800;
            }

            .price-summary h4 i {
                color: #f59e0b;
            }

            .price-row {
                display: flex;
                justify-content: space-between;
                padding: 12px 0;
                border-bottom: 1px solid rgba(0,0,0,0.1);
            }

            .price-row:last-child {
                border-bottom: none;
                margin-top: 15px;
                padding-top: 20px;
                border-top: 3px solid #dc2626;
                background: rgba(220, 38, 38, 0.05);
                padding: 20px;
                margin: 20px -10px -10px -10px;
                border-radius: 10px;
            }

            .price-label {
                font-size: 1.1rem;
                color: #374151;
                font-weight: 600;
            }

            .price-value {
                font-size: 1.2rem;
                font-weight: 700;
                color: #dc2626;
            }

            .price-row:last-child .price-label {
                font-size: 1.4rem;
                font-weight: 800;
                color: #1f2937;
            }

            .price-row:last-child .price-value {
                font-size: 1.6rem;
                font-weight: 900;
                color: #dc2626;
            }

            .price-row:last-child .price-value {
                font-size: 1.5rem;
            }

            /* Submit Button */
            .submit-btn {
                width: 100%;
                padding: 18px;
                background: linear-gradient(135deg, #dc2626, #b91c1c);
                color: white;
                border: none;
                border-radius: 12px;
                font-size: 1.2rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s ease;
                margin-top: 30px;
                box-shadow: 0 4px 15px rgba(220, 38, 38, 0.3);
            }

            .submit-btn:hover:not(:disabled) {
                transform: translateY(-3px);
                box-shadow: 0 8px 20px rgba(220, 38, 38, 0.4);
            }

            .submit-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                transform: none;
            }

            /* Loading & Error States */
            .loading-state {
                text-align: center;
                padding: 60px 20px;
                color: #6b7280;
            }

            .loading-spinner {
                font-size: 3rem;
                color: #dc2626;
                animation: spin 1s linear infinite;
            }

            @keyframes spin {
                to { transform: rotate(360deg); }
            }

            .error-state {
                background: #fee2e2;
                border: 2px solid #dc2626;
                border-radius: 12px;
                padding: 20px;
                text-align: center;
                color: #991b1b;
                margin: 20px 0;
            }

            .empty-state {
                text-align: center;
                padding: 40px 20px;
                color: #6b7280;
            }

            .empty-icon {
                font-size: 3rem;
                margin-bottom: 15px;
                opacity: 0.3;
            }

            /* Responsive */
            @media (max-width: 768px) {
                .hero h1 {
                    font-size: 1.8rem;
                }

                .hero p {
                    font-size: 1rem;
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }

                .date-buttons {
                    flex-direction: column;
                }

                .date-button-label {
                    width: 100%;
                    text-align: center;
                }

                .calendar-grid {
                    grid-template-columns: repeat(7, 1fr);
                    gap: 5px;
                }

                .calendar-label {
                    padding: 10px 3px;
                    min-height: 60px;
                }

                .calendar-number {
                    font-size: 1rem;
                }

                .stock-item {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 15px;
                }

                .quantity-controls {
                    width: 100%;
                    justify-content: flex-end;
                }
            }

            /* Animation */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        </style>
    </head>
    <body>
        <div id="app">
            <!-- Hero Section -->
            <div class="hero" style="background: url('${event.image_url || 'https://placehold.co/1920x600/1a1a1a/ffffff?text=Event+Booking'}') center/cover">
                <div class="hero-content">
                    <h1>${event.name}</h1>
                </div>
            </div>

            <!-- Main Content -->
            <div class="container">
                <!-- Event Info -->
                <div class="event-info">
                    <h2><i class="fas fa-info-circle"></i> イベント情報</h2>
                    
                    <!-- Event Name -->
                    <div class="event-title-section">
                        <h3 class="event-main-title">${event.name}</h3>
                        ${event.category_name ? `
                        <div class="category-tag">
                            <i class="fas fa-tag"></i> ${event.category_name}
                        </div>
                        ` : ''}
                    </div>

                    <!-- Client & Detail -->
                    ${event.client_name || event.detail ? `
                    <div class="event-meta-section">
                        ${event.client_name ? `
                        <div class="meta-item">
                            <i class="fas fa-building"></i>
                            <strong>主催企業:</strong>
                            <span>${event.client_name}</span>
                        </div>
                        ` : ''}
                        ${event.detail ? `
                        <div class="meta-item">
                            <i class="fas fa-file-alt"></i>
                            <strong>イベント詳細:</strong>
                            <span>${event.detail}</span>
                        </div>
                        ` : ''}
                    </div>
                    ` : ''}

                    <!-- Info Grid -->
                    <div class="info-grid">
                        ${event.location ? `
                        <div class="info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <strong>場所</strong>
                                <span>${event.location}</span>
                            </div>
                        </div>
                        ` : ''}
                        ${event.event_start_date ? `
                        <div class="info-item">
                            <i class="fas fa-calendar-day"></i>
                            <div>
                                <strong>開催期間</strong>
                                <span>${event.event_start_date} 〜 ${event.event_end_date || event.event_start_date}</span>
                            </div>
                        </div>
                        ` : ''}
                        ${event.registration_start_date ? `
                        <div class="info-item">
                            <i class="fas fa-clock"></i>
                            <div>
                                <strong>受付期間</strong>
                                <span>${formatRegistrationDate(event.registration_start_date)} 〜 ${formatRegistrationDate(event.registration_end_date)}</span>
                            </div>
                        </div>
                        ` : ''}
                    </div>
                </div>

                <!-- Purchase Form -->
                <div class="purchase-form">
                    <!-- Loading State -->
                    <div v-if="loading" class="loading-state">
                        <div class="loading-spinner"><i class="fas fa-spinner"></i></div>
                        <p>データを読み込み中...</p>
                    </div>

                    <!-- Error State -->
                    <div v-if="errorMessage" class="error-state">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p>{{ errorMessage }}</p>
                    </div>

                    <!-- Form Content -->
                    <div v-if="!loading && !errorMessage">
                        <!-- Step 1: Date Selection -->
                        <div class="form-section">
                            <h3>
                                <i class="fas fa-calendar-alt"></i>
                                日付を選択してください
                                <span class="required">*必須</span>
                            </h3>
                            
                            <div v-if="availableDates.length === 0" class="empty-state">
                                <div class="empty-icon"><i class="fas fa-calendar-times"></i></div>
                                <p>現在予約可能な日付がありません</p>
                            </div>

                            <!-- Button Selection Mode -->
                            <div v-else-if="dateSelectionType === 'button'" class="date-buttons">
                                <div v-for="dateObj in availableDates" :key="dateObj.date" class="date-button-wrapper">
                                    <input 
                                        type="radio" 
                                        :id="'date-' + dateObj.date"
                                        name="booking_date"
                                        :value="dateObj.date"
                                        v-model="selectedDate"
                                        @change="onDateChange"
                                    >
                                    <label :for="'date-' + dateObj.date" class="date-button-label">
                                        {{ formatDateButton(dateObj.date) }}
                                    </label>
                                </div>
                            </div>

                            <!-- Calendar Selection Mode -->
                            <div v-else class="calendar-container">
                                <!-- 月ヘッダー（前月/次月ボタン） -->
                                <div class="calendar-header">
                                    <button @click="previousMonth" class="month-nav-btn" type="button">
                                        <i class="fas fa-chevron-left"></i> 前月
                                    </button>
                                    <div class="current-month">{{ currentMonthLabel }}</div>
                                    <button @click="nextMonth" class="month-nav-btn" type="button">
                                        次月 <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>

                                <!-- 曜日ヘッダー -->
                                <div class="calendar-weekdays">
                                    <div class="weekday sunday">日</div>
                                    <div class="weekday">月</div>
                                    <div class="weekday">火</div>
                                    <div class="weekday">水</div>
                                    <div class="weekday">木</div>
                                    <div class="weekday">金</div>
                                    <div class="weekday saturday">土</div>
                                </div>

                                <!-- カレンダーグリッド -->
                                <div class="calendar-grid">
                                    <div v-for="(dateObj, index) in calendarDates" :key="index" class="calendar-date">
                                        <!-- 空白セル -->
                                        <div v-if="dateObj.empty" class="calendar-empty"></div>
                                        
                                        <!-- 日付セル -->
                                        <template v-else>
                                            <input 
                                                type="radio" 
                                                :id="'date-' + dateObj.dateStr"
                                                name="booking_date"
                                                :value="dateObj.dateStr"
                                                v-model="selectedDate"
                                                :disabled="!dateObj.available"
                                                @change="onDateChange"
                                            >
                                            <label 
                                                :for="'date-' + dateObj.dateStr" 
                                                class="calendar-label"
                                                :class="{ 
                                                    disabled: !dateObj.available,
                                                    today: dateObj.isToday
                                                }"
                                            >
                                                <div class="calendar-day">{{ dateObj.dayOfWeek }}</div>
                                                <div class="calendar-number">{{ dateObj.day }}</div>
                                            </label>
                                        </template>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Step 2: Product List (Always visible) -->
                        <div class="form-section">
                            <h3>
                                <i class="fas fa-list"></i>
                                商品・枚数を選択してください
                                <span class="required">*必須</span>
                            </h3>
                            
                            <div v-if="!selectedDate" class="help-text">
                                <i class="fas fa-info-circle"></i>
                                日付を選択すると、在庫数と枚数選択が可能になります
                            </div>

                            <div v-if="allProducts.length === 0" class="empty-state">
                                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                <p>商品がありません</p>
                            </div>

                            <!-- Products without date selection (read-only) -->
                            <div v-if="!selectedDate && allProducts.length > 0">
                                <div v-for="product in allProducts" :key="product.product_id" class="product-group">
                                    <div class="product-header">
                                        <div class="product-title">{{ product.product_name }}</div>
                                        <div v-if="product.product_description" class="product-description">
                                            {{ product.product_description }}
                                        </div>
                                        <div v-if="product.prices.length > 0" class="product-prices">
                                            <span v-for="price in product.prices" :key="price.price_id" class="price-badge">
                                                {{ price.category_name }}: ¥{{ price.price.toLocaleString() }}
                                            </span>
                                        </div>
                                    </div>

                                    <ul v-if="product.stock_names.length > 0" class="stock-list">
                                        <li v-for="(stock, idx) in product.stock_names" :key="idx" class="stock-list-item disabled">
                                            <div>
                                                <div class="stock-item-name">{{ stock.stock_name || product.product_name }}</div>
                                                <div v-if="stock.price_band" class="stock-item-details">価格帯: {{ stock.price_band }}</div>
                                            </div>
                                        </li>
                                    </ul>
                                    <div v-else class="stock-list">
                                        <div class="stock-list-item disabled">
                                            <div class="stock-item-name">{{ product.product_name }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Products with date selection (interactive) -->
                            <div v-if="selectedDate && productsWithPrices.length > 0">
                                <!-- Price List Summary -->
                                <div class="price-list-summary">
                                    <h4 class="price-list-title">
                                        <i class="fas fa-tags"></i> 料金一覧
                                    </h4>
                                    <div class="price-list-grid">
                                        <div v-for="product in productsWithPrices" :key="'price-' + product.product_id" class="price-list-product">
                                            <div class="price-product-header">
                                                <span class="price-product-name">{{ product.product_name }}</span>
                                                <span v-if="product.product_description" class="price-product-desc">{{ product.product_description }}</span>
                                            </div>
                                            <div v-if="productPricesList[product.product_id] && productPricesList[product.product_id].length > 0" class="price-items-container">
                                                <div v-for="priceInfo in productPricesList[product.product_id]" :key="'price-info-' + priceInfo.id" class="price-list-item">
                                                    <div class="price-item-name">
                                                        <span class="category-name-badge">{{ priceInfo.common_name || priceInfo.category_name }}</span>
                                                    </div>
                                                    <div class="price-item-details">
                                                        <span class="price-amount-large">¥{{ (priceInfo.price || 0).toLocaleString() }}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div v-for="product in productsWithPrices" :key="product.product_id" class="product-group">
                                    <div class="product-header">
                                        <img v-if="product.image_url" :src="product.image_url" :alt="product.product_name" class="product-image">
                                        <div class="product-info-text">
                                            <div class="product-title">{{ product.product_name }}</div>
                                            <div v-if="product.product_description" class="product-description">
                                                {{ product.product_description }}
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 在庫ごとにグループ化 -->
                                    <div v-for="stock in product.stocks" :key="stock.stock_id" class="stock-group">
                                        <!-- 価格設定がある在庫のみ表示 -->
                                        <template v-if="stock.priceList && stock.priceList.length > 0">
                                            <div class="stock-group-header">
                                                <span class="stock-group-name">{{ stock.stock_name || product.product_name }}</span>
                                                <span class="stock-available">残り {{ stock.available }} 枚</span>
                                            </div>
                                            
                                            <!-- 価格カテゴリごとに表示（大人・子供など） -->
                                            <div v-for="(priceInfo, priceIndex) in stock.priceList" :key="stock.stock_id + '_' + priceIndex" class="stock-item">
                                                <div class="stock-info">
                                                    <div class="stock-name">
                                                        {{ priceInfo.common_name || priceInfo.category_name }}
                                                    </div>
                                                    <div class="stock-details">
                                                        <span class="stock-price">¥{{ (priceInfo.price || 0).toLocaleString() }}</span>
                                                    </div>
                                                </div>
                                                <div class="quantity-controls">
                                                    <button 
                                                        type="button"
                                                        class="quantity-btn"
                                                        @click="decrementQuantity(stock.stock_id + '_' + priceIndex)"
                                                        :disabled="!stockQuantities[stock.stock_id + '_' + priceIndex] || stockQuantities[stock.stock_id + '_' + priceIndex] <= 0"
                                                    >
                                                        <i class="fas fa-minus"></i>
                                                    </button>
                                                    <div class="quantity-display">{{ stockQuantities[stock.stock_id + '_' + priceIndex] || 0 }}</div>
                                                    <button 
                                                        type="button"
                                                        class="quantity-btn"
                                                        @click="incrementQuantity(stock.stock_id + '_' + priceIndex, stock.available)"
                                                        :disabled="(stockQuantities[stock.stock_id + '_' + priceIndex] || 0) >= stock.available || (stockQuantities[stock.stock_id + '_' + priceIndex] || 0) >= 10"
                                                    >
                                                        <i class="fas fa-plus"></i>
                                                    </button>
                                                </div>
                                                <!-- Individual Item Total -->
                                                <div v-if="stockQuantities[stock.stock_id + '_' + priceIndex] > 0" class="item-total">
                                                    小計: ¥{{ ((stockQuantities[stock.stock_id + '_' + priceIndex] || 0) * (productPrices[stock.stock_id + '_' + priceIndex] || 0)).toLocaleString() }}
                                                </div>
                                            </div>
                                        </template>
                                    </div>
                                </div>

                            </div>

                            <div v-else-if="selectedDate && productsForDate.length > 0 && productsWithPrices.length === 0" class="empty-state">
                                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                <p>選択された日付に価格設定がされている商品がありません</p>
                            </div>

                            <div v-else-if="selectedDate && productsForDate.length === 0" class="empty-state">
                                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                <p>選択された日付に利用可能な商品がありません</p>
                            </div>

                            <!-- Options Section -->
                            <div v-if="selectedDate && options.length > 0" class="options-section">
                                    <h3 class="section-title">
                                        <i class="fas fa-plus-circle"></i> オプション
                                    </h3>
                                    
                                    <div v-for="option in options" :key="option.option_id" class="option-group">
                                        <div class="option-group-header">
                                            <img v-if="option.image_url" :src="option.image_url" :alt="option.option_name" class="option-image">
                                            <div class="option-header-text">
                                                <h4 class="option-group-title">{{ option.option_name }}</h4>
                                                <p v-if="option.option_description" class="option-group-description">
                                                    {{ option.option_description }}
                                                </p>
                                            </div>
                                        </div>
                                        
                                        <!-- 在庫ごとに表示 -->
                                        <div v-for="stock in option.stocks" :key="stock.stock_id" class="option-item">
                                            <div class="option-info">
                                                <div class="option-header">
                                                    <div class="option-name">
                                                        <span v-if="stock.stock_name">{{ stock.stock_name }}</span>
                                                        <span v-else>{{ option.option_name }}</span>
                                                    </div>
                                                    <div class="option-price">¥{{ (stock.price || 0).toLocaleString() }}</div>
                                                </div>
                                                <div class="option-stock-info">
                                                    残り {{ stock.available }} 個
                                                </div>
                                            </div>
                                            <div class="quantity-controls">
                                                <button 
                                                    type="button"
                                                    class="quantity-btn"
                                                    @click="decrementOptionQuantity(stock.stock_id)"
                                                    :disabled="!optionQuantities[stock.stock_id] || optionQuantities[stock.stock_id] <= 0"
                                                >
                                                    <i class="fas fa-minus"></i>
                                                </button>
                                                <div class="quantity-display">{{ optionQuantities[stock.stock_id] || 0 }}</div>
                                                <button 
                                                    type="button"
                                                    class="quantity-btn"
                                                    @click="incrementOptionQuantity(stock.stock_id, stock.available)"
                                                    :disabled="(optionQuantities[stock.stock_id] || 0) >= stock.available || (optionQuantities[stock.stock_id] || 0) >= 10"
                                                >
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </div>
                                            <!-- Individual Option Total -->
                                            <div v-if="optionQuantities[stock.stock_id] > 0" class="item-total">
                                                小計: ¥{{ ((optionQuantities[stock.stock_id] || 0) * (stock.price || 0)).toLocaleString() }}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Price Summary -->
                                <div v-if="totalQuantity > 0" class="price-summary">
                                    <h4><i class="fas fa-calculator"></i> 料金合計</h4>
                                    <div class="price-row">
                                        <div class="price-label">選択枚数</div>
                                        <div class="price-value">{{ totalQuantity }} 枚</div>
                                    </div>
                                    <div class="price-row">
                                        <div class="price-label">合計金額</div>
                                        <div class="price-value">¥{{ grandTotal.toLocaleString() }}</div>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <button 
                                    type="button"
                                    class="submit-btn"
                                    @click="proceedToBooking"
                                    :disabled="!canSubmit || submitting"
                                >
                                    <i class="fas fa-arrow-right"></i>
                                    {{ submitting ? '処理中...' : '予約内容を確認する' }}
                                </button>
                            </div>

                            <div v-else-if="selectedDate && productsForDate.length === 0" class="empty-state">
                                <div class="empty-icon"><i class="fas fa-box-open"></i></div>
                                <p>選択された日付に利用可能な商品がありません</p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <script>
            const { createApp } = Vue;

            createApp({
                data() {
                    return {
                        eventId: ${eventId},
                        dateSelectionType: '${event.date_selection_type || 'calendar'}',
                        eventStartDate: '${event.event_start_date || ''}',
                        currentMonth: null, // 表示中の月（初期化は mounted で設定）
                        loading: true,
                        errorMessage: '',
                        allProducts: [], // 全商品情報（日付選択前）
                        availableDates: [],
                        selectedDate: null,
                        productsForDate: [], // 選択日付の商品情報
                        stockQuantities: {},
                        productPrices: {}, // stock_id -> price mapping
                        productPricesList: {}, // product_id -> price list mapping
                        options: [], // オプション一覧
                        optionQuantities: {}, // option_id -> quantity mapping
                        submitting: false
                    }
                },
                computed: {
                    // カレンダー表示用の日付配列（月次表示）
                    calendarDates() {
                        if (!this.currentMonth) return [];
                        
                        const dates = [];
                        const year = this.currentMonth.getFullYear();
                        const month = this.currentMonth.getMonth();
                        const dayNames = ['日', '月', '火', '水', '木', '金', '土'];
                        
                        // 月の最初の日と最後の日
                        const firstDay = new Date(year, month, 1);
                        const lastDay = new Date(year, month + 1, 0);
                        
                        // 月の最初の曜日（0=日曜）
                        const firstDayOfWeek = firstDay.getDay();
                        
                        // 空白セルを追加（月の開始前）
                        for (let i = 0; i < firstDayOfWeek; i++) {
                            dates.push({ empty: true });
                        }
                        
                        // 今日の日付文字列
                        const todayStr = new Date().toISOString().split('T')[0];
                        
                        // 月の日付を追加
                        for (let day = 1; day <= lastDay.getDate(); day++) {
                            const date = new Date(year, month, day);
                            const dateStr = date.toISOString().split('T')[0];
                            const available = this.availableDates.some(d => d.date === dateStr);
                            
                            dates.push({
                                dateStr: dateStr,
                                day: day,
                                dayOfWeek: dayNames[date.getDay()],
                                available: available,
                                isToday: dateStr === todayStr
                            });
                        }
                        
                        return dates;
                    },
                    // 現在の月のラベル
                    currentMonthLabel() {
                        if (!this.currentMonth) return '';
                        return \`\${this.currentMonth.getFullYear()}年 \${this.currentMonth.getMonth() + 1}月\`;
                    },
                    // 価格設定がある商品のみをフィルタリング
                    productsWithPrices() {
                        return this.productsForDate.filter(product => {
                            // 商品の在庫に価格リストがあるかチェック
                            return product.stocks && product.stocks.some(stock => 
                                stock.priceList && stock.priceList.length > 0
                            );
                        });
                    },
                    // 選択された枚数の合計
                    totalQuantity() {
                        return Object.values(this.stockQuantities).reduce((sum, qty) => sum + (qty || 0), 0);
                    },
                    // 合計金額
                    grandTotal() {
                        let total = 0;
                        // 商品の合計
                        for (const stockId in this.stockQuantities) {
                            const qty = this.stockQuantities[stockId] || 0;
                            const price = this.productPrices[stockId] || 0;
                            total += qty * price;
                        }
                        // オプションの合計（在庫IDから料金を取得）
                        for (const stockId in this.optionQuantities) {
                            const qty = this.optionQuantities[stockId] || 0;
                            // 全オプションから該当する在庫を検索
                            let stockPrice = 0;
                            for (const option of this.options) {
                                const stock = option.stocks.find(s => s.stock_id == stockId);
                                if (stock) {
                                    stockPrice = stock.price || 0;
                                    break;
                                }
                            }
                            total += qty * stockPrice;
                        }
                        return total;
                    },
                    // 予約可能かチェック
                    canSubmit() {
                        return this.selectedDate && this.totalQuantity > 0 && this.grandTotal > 0;
                    }
                },
                methods: {
                    // 前月へ移動
                    previousMonth() {
                        if (!this.currentMonth) return;
                        const newMonth = new Date(this.currentMonth);
                        newMonth.setMonth(newMonth.getMonth() - 1);
                        this.currentMonth = newMonth;
                    },
                    // 次月へ移動
                    nextMonth() {
                        if (!this.currentMonth) return;
                        const newMonth = new Date(this.currentMonth);
                        newMonth.setMonth(newMonth.getMonth() + 1);
                        this.currentMonth = newMonth;
                    },
                    async loadInitialData() {
                        try {
                            // 全商品情報を取得（日付選択前の表示用）
                            const productsResponse = await axios.get(\`/api/events/\${this.eventId}/products-all\`);
                            this.allProducts = productsResponse.data.products || [];

                            // 利用可能な日付を取得
                            const datesResponse = await axios.get(\`/api/events/\${this.eventId}/available-dates\`);
                            this.availableDates = datesResponse.data.dates || [];
                            
                            this.loading = false;
                        } catch (error) {
                            console.error('データ取得エラー:', error);
                            this.errorMessage = 'データの読み込みに失敗しました。';
                            this.loading = false;
                        }
                    },
                    async onDateChange() {
                        if (!this.selectedDate) return;
                        
                        this.productsForDate = [];
                        this.stockQuantities = {};
                        this.productPrices = {};
                        this.productPricesList = {};
                        
                        try {
                            const response = await axios.get(\`/api/events/\${this.eventId}/products-by-date\`, {
                                params: { date: this.selectedDate }
                            });
                            this.productsForDate = response.data.products || [];
                            
                            // 在庫IDごとの数量を初期化 & 価格情報を取得
                            for (const product of this.productsForDate) {
                                // 商品の価格情報を取得
                                const pricesResponse = await axios.get(\`/api/products/\${product.product_id}\`);
                                const productData = pricesResponse.data.product;
                                
                                console.log('商品ID:', product.product_id, '価格情報:', productData.prices);
                                
                                // 商品ごとの価格リストを保存（料金一覧表示用）
                                if (productData.prices && productData.prices.length > 0) {
                                    this.productPricesList[product.product_id] = productData.prices;
                                    
                                    // 在庫ごとに価格リストを追加
                                    for (const stock of product.stocks) {
                                        // 価格帯に対応する価格リストをフィルタリング
                                        const priceList = productData.prices.filter(p => 
                                            p.category_name && p.category_name.startsWith((stock.price_band || '') + '-')
                                        );
                                        
                                        // 在庫に価格リストを追加（Vue.jsで使用）
                                        stock.priceList = priceList.length > 0 ? priceList : productData.prices;
                                        
                                        console.log('📋 在庫ID:', stock.stock_id, '価格リスト:', stock.priceList);
                                        
                                        // 各価格カテゴリの数量を初期化
                                        stock.priceList.forEach((priceInfo, index) => {
                                            const key = \`\${stock.stock_id}_\${index}\`;
                                            this.stockQuantities[key] = 0;
                                            this.productPrices[key] = priceInfo.price;
                                            console.log('💰 初期化:', key, '→ 価格', priceInfo.price, 
                                                '名前:', priceInfo.common_name || priceInfo.category_name);
                                        });
                                    }
                                }
                            }
                            
                            console.log('最終的な数量マッピング:', this.stockQuantities);
                            console.log('最終的な価格マッピング:', this.productPrices);
                            
                            // 日付別オプションを取得
                            const optionsResponse = await axios.get(\`/api/events/\${this.eventId}/options-by-date\`, {
                                params: { date: this.selectedDate }
                            });
                            this.options = optionsResponse.data.options || [];
                            
                            // オプション数量を初期化
                            this.options.forEach(option => {
                                option.stocks.forEach(stock => {
                                    this.optionQuantities[stock.stock_id] = 0;
                                });
                            });
                            
                            console.log('オプション読み込み完了:', this.options);
                        } catch (error) {
                            console.error('商品取得エラー:', error);
                            this.errorMessage = '商品情報の読み込みに失敗しました。';
                        }
                    },
                    incrementQuantity(key, maxAvailable) {
                        const current = this.stockQuantities[key] || 0;
                        if (current < maxAvailable && current < 10) {
                            this.stockQuantities[key] = current + 1;
                        }
                    },
                    decrementQuantity(key) {
                        const current = this.stockQuantities[key] || 0;
                        if (current > 0) {
                            this.stockQuantities[key] = current - 1;
                        }
                    },
                    incrementOptionQuantity(stockId, maxAvailable) {
                        const current = this.optionQuantities[stockId] || 0;
                        if (current < maxAvailable && current < 10) {
                            this.optionQuantities[stockId] = current + 1;
                        }
                    },
                    decrementOptionQuantity(stockId) {
                        const current = this.optionQuantities[stockId] || 0;
                        if (current > 0) {
                            this.optionQuantities[stockId] = current - 1;
                        }
                    },
                    findStockById(stockId) {
                        for (const product of this.productsForDate) {
                            const stock = product.stocks.find(s => s.stock_id === stockId);
                            if (stock) {
                                // 商品名も含めて返す
                                return {
                                    ...stock,
                                    product_name: product.product_name
                                };
                            }
                        }
                        return null;
                    },
                    findProductIdByStockId(stockId) {
                        for (const product of this.productsForDate) {
                            if (product.stocks.some(s => s.stock_id === stockId)) {
                                return product.product_id;
                            }
                        }
                        return null;
                    },
                    proceedToBooking() {
                        if (!this.canSubmit) return;
                        
                        this.submitting = true;
                        
                        // 予約データ構築
                        const bookingData = {
                            event_id: this.eventId,
                            selected_date: this.selectedDate,  // ← date から selected_date に変更
                            date: this.selectedDate,
                            total_quantity: this.totalQuantity,
                            total_amount: this.grandTotal,
                            items: [],
                            options: []
                        };
                        
                        // 商品データ
                        for (const stockId in this.stockQuantities) {
                            const qty = this.stockQuantities[stockId];
                            if (qty > 0) {
                                const stock = this.findStockById(parseInt(stockId));
                                if (stock) {
                                    bookingData.items.push({
                                        stock_id: parseInt(stockId),
                                        product_id: this.findProductIdByStockId(parseInt(stockId)),
                                        product_name: stock.product_name,
                                        stock_name: stock.stock_name,
                                        price_band: stock.price_band,
                                        quantity: qty,
                                        price: this.productPrices[stockId]
                                    });
                                }
                            }
                        }
                        
                        // オプションデータ（在庫IDから取得）
                        for (const stockId in this.optionQuantities) {
                            const qty = this.optionQuantities[stockId];
                            if (qty > 0) {
                                // 全オプションから該当する在庫を検索
                                for (const option of this.options) {
                                    const stock = option.stocks.find(s => s.stock_id == stockId);
                                    if (stock) {
                                        bookingData.options.push({
                                            stock_id: parseInt(stockId),
                                            option_id: option.option_id,
                                            option_name: option.option_name,
                                            stock_name: stock.stock_name,
                                            quantity: qty,
                                            price: stock.price
                                        });
                                        break;
                                    }
                                }
                            }
                        }
                        
                        console.log('予約データ:', bookingData);
                        
                        // セッションストレージに予約データを保存
                        sessionStorage.setItem('bookingData', JSON.stringify(bookingData));
                        
                        // ログイン画面に遷移
                        window.location.href = '/booking/login?event_id=' + this.eventId;
                    },
                    formatDateButton(dateStr) {
                        const date = new Date(dateStr);
                        const dayNames = ['日', '月', '火', '水', '木', '金', '土'];
                        return \`\${date.getMonth() + 1}月\${date.getDate()}日(\${dayNames[date.getDay()]})\`;
                    }
                },
                mounted() {
                    // 初期表示月をイベント開始日に設定
                    if (this.eventStartDate) {
                        this.currentMonth = new Date(this.eventStartDate);
                    } else {
                        this.currentMonth = new Date(); // イベント開始日がない場合は今月
                    }
                    this.loadInitialData();
                }
            }).mount('#app');
        </script>
    </body>
    </html>
  `)
})

