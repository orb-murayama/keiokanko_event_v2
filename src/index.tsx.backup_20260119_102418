    const finalNameEn = originalEvent.name_en ? (newName ? newName : `Copy ${originalEvent.name_en}`) : null
    
    // イベントをコピー（最小限のカラムのみ、undefinedをnullに変換）
    const eventResult = await DB.prepare(`
      INSERT INTO events (
        name, name_en, detail, detail_en, location, location_en, contact, contact_en, 
        remarks, remarks_en, question, postage, thanks_msg, thanks_msg_en, note,
        client_id, company_flg, enable_flg, payment_flg,
        customer_client_id, category, date_selection_type,
