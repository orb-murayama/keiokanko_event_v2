            // 言語タブの切り替え
            // イベント画像のアップロード処理
            async function handleEventImageSelect(event) {
                const file = event.target.files[0];
                if (!file) return;

                // ファイルサイズチェック（5MB）
                if (file.size > 5 * 1024 * 1024) {
                    alert('画像ファイルは5MB以下にしてください');
                    event.target.value = '';
                    return;
                }

                // ファイルタイプチェック
                const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
                if (!allowedTypes.includes(file.type)) {
                    alert('対応していない画像形式です（JPEG, PNG, GIF, WebPのみ）');
                    event.target.value = '';
                    return;
                }

                try {
                    const formData = new FormData();
                    formData.append('image', file);

                    const response = await fetch('/api/events/upload-image', {
                        method: 'POST',
                        body: formData
                    });

                    if (!response.ok) {
                        const error = await response.json();
                        throw new Error(error.error || '画像のアップロードに失敗しました');
                    }

                    const result = await response.json();
                    
                    // 隠しフィールドにURLを設定
                    document.getElementById('eventImageUrl').value = result.image_url;
                    
                    // プレビュー表示
                    const previewImg = document.getElementById('eventImagePreviewImg');
                    const noImageText = document.getElementById('noImageText');
                    const clearBtn = document.getElementById('clearEventImageBtn');
                    
                    previewImg.src = result.image_url;
                    previewImg.classList.remove('hidden');
                    noImageText.classList.add('hidden');
                    clearBtn.classList.remove('hidden');
                    
                    alert('画像をアップロードしました');
                } catch (error) {
                    console.error('画像アップロードエラー:', error);
                    alert(error.message || '画像のアップロードに失敗しました');
                    event.target.value = '';
                }
            }

