    <script>
        const pathParts = window.location.pathname.split('/');
        const clientId = pathParts[3] === 'new' ? null : pathParts[3];
        const isEditMode = !!clientId;

        document.addEventListener('DOMContentLoaded', async () => {
            try {
                document.getElementById('mode').value = isEditMode ? 'edit' : 'new';
                
                const pageTitle = isEditMode ? 'クライアント編集' : 'クライアント新規登録';
                document.getElementById('pageTitle').textContent = pageTitle + ' | 管理画面';
                document.getElementById('pageHeader').innerHTML = '<i class="fas fa-user-tie"></i>' + pageTitle;
                document.getElementById('submitBtnText').textContent = isEditMode ? '更新する' : '登録する';

                // 都道府県一覧を取得
                const prefsRes = await axios.get('/api/prefs');
                const prefs = prefsRes.data;
                const prefSelect = document.getElementById('pref_id');
                prefs.forEach(pref => {
                    const option = document.createElement('option');
                    option.value = pref.id;
                    option.textContent = pref.name;
                    prefSelect.appendChild(option);
                });

                // 編集モードの場合、クライアント情報を取得
                if (isEditMode) {
                    const clientRes = await axios.get('/api/clients/' + clientId);
                    const client = clientRes.data;
                    
                    document.getElementById('clientId').value = client.id;
                    document.getElementById('name').value = client.name || '';
                    document.getElementById('client_code').value = client.client_code || '';
                    document.getElementById('branch_office').value = client.branch_office || '';
                    document.getElementById('contactable_person').value = client.contactable_person || '';
                    document.getElementById('position').value = client.position || '';
                    document.getElementById('tel').value = client.tel || '';
                    document.getElementById('fax').value = client.fax || '';
                    document.getElementById('email').value = client.email || '';
                    document.getElementById('zip').value = client.zip || '';
                    document.getElementById('pref_id').value = client.pref_id || '';
                    document.getElementById('addr').value = client.addr || '';
                    document.getElementById('remarks').value = client.remarks || '';
                }
            } catch (error) {
                console.error('初期化エラー:', error);
                alert('データの読み込みに失敗しました');
            }
        });

        document.getElementById('clientForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const mode = document.getElementById('mode').value;
            const clientId = document.getElementById('clientId').value;
            const formData = new FormData(e.target);
            const data = Object.fromEntries(formData.entries());
            
            // 空文字をnullに変換
            Object.keys(data).forEach(key => {
                if (data[key] === '') data[key] = null;
            });
            
            // パスワードは空文字列をセット
            data.password = '';
            data.group_id = 1;
            data.reg_flg = 1;
            
            try {
                let response;
                if (mode === 'new') {
                    response = await axios.post('/api/clients', data);
                    alert('クライアントを登録しました！');
                } else {
                    response = await axios.put(\`/api/clients/\${clientId}\`, data);
                    alert('クライアント情報を更新しました！');
                }
                window.location.href = '/admin/clients';
            } catch (error) {
                console.error('Error:', error);
                const message = mode === 'new' ? '登録に失敗しました' : '更新に失敗しました';
                alert(\`\${message}: \${error.response?.data?.error || error.message}\`);
            }
        });
    </script>
</body>
</html>
  `)
})

