  const { DB } = c.env
  const eventId = c.req.param('id')

  // イベント情報取得（カテゴリ、クライアント名も取得）
  const event = await DB.prepare(`
    SELECT 
      e.*,
      c.name as client_name,
      cat.name as category_name
    FROM events e
    LEFT JOIN clients c ON e.client_id = c.id
    LEFT JOIN categories cat ON e.category = cat.id
    WHERE e.id = ? AND e.enable_flg = 1
  `).bind(eventId).first()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  // 日時フォーマット関数（00:00の場合は時刻非表示）
  const formatRegistrationDate = (dateTimeStr) => {
    if (!dateTimeStr) return '';
    const date = new Date(dateTimeStr);
    const year = date.getFullYear();
    const month = date.getMonth() + 1;
    const day = date.getDate();
    const hours = date.getHours();
    const minutes = date.getMinutes();
    
    // 時刻が00:00の場合は日付のみ表示
    if (hours === 0 && minutes === 0) {
      return `${year}年${month}月${day}日`;
    }
    return `${year}年${month}月${day}日 ${hours}:${minutes.toString().padStart(2, '0')}`;
