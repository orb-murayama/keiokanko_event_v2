        <script>
            // URLからoptionIdを取得
            const pathParts = window.location.pathname.split('/');
            const optionId = pathParts[3] === 'new' ? null : pathParts[3];
            const isEditMode = !!optionId;

            // ページ初期化
            document.addEventListener('DOMContentLoaded', async () => {
                try {
                    // modeを設定
                    document.getElementById('mode').value = isEditMode ? 'edit' : 'new';
                    
                    // 送信ボタンのテキストを更新
                    document.getElementById('submitBtnText').textContent = isEditMode ? '更新する' : '登録する';
                    
                    // タイトルとヘッダーを更新
                    const pageTitle = isEditMode ? 'オプション編集' : '新規オプション登録';
                    document.getElementById('pageTitle').textContent = pageTitle + ' | 管理画面';
                    document.getElementById('pageHeader').innerHTML = '<i class="fas fa-list-ul"></i>' + pageTitle;
                    document.getElementById('breadcrumb').textContent = isEditMode ? '編集' : '新規登録';

                    // イベント一覧を取得
                    const eventsRes = await axios.get('/api/v1/events?per_page=1000');
                    const events = eventsRes.data.data;
                    const eventSelect = document.getElementById('event_id');
                    events.forEach(event => {
                        const option = document.createElement('option');
                        option.value = event.id;
                        option.textContent = event.name;
                        eventSelect.appendChild(option);
                    });

                    // オプションカテゴリー一覧を取得
                    const categoriesRes = await axios.get('/api/option-categories');
                    const categories = categoriesRes.data;
                    const categorySelect = document.getElementById('option_category_id');
                    categories.forEach(cat => {
                        const option = document.createElement('option');
                        option.value = cat.id;
                        option.textContent = cat.name;
                        categorySelect.appendChild(option);
                    });

                    // 編集モードの場合、オプション情報を取得
                    if (isEditMode) {
                        const optionRes = await axios.get('/api/options/' + optionId);
                        const option = optionRes.data.option;  // APIレスポンスの構造に合わせて修正
                        
                        document.getElementById('optionId').value = option.id;
                        document.getElementById('name').value = option.name || '';
                        document.getElementById('event_id').value = option.event_id || '';
                        document.getElementById('option_category_id').value = option.option_category_id || '';
                        document.getElementById('enable_flg').value = option.enable_flg !== undefined ? option.enable_flg : 1;
                        document.getElementById('description').value = option.description || '';
                        document.getElementById('remarks').value = option.remarks || '';
                        document.getElementById('image_url').value = option.image_url || '';
                        
                        // 画像プレビューを表示
                        if (option.image_url) {
                            const previewImg = document.getElementById('previewImg');
                            const imagePreview = document.getElementById('imagePreview');
                            if (previewImg) previewImg.src = option.image_url;
                            if (imagePreview) imagePreview.style.display = 'block';
                        }
                    }
                } catch (error) {
                    console.error('初期化エラー:', error);
                    alert('データの読み込みに失敗しました');
                }
            });

            // 画像ファイル選択時のプレビュー処理
            const imageFile = document.getElementById('imageFile');
            const imagePreview = document.getElementById('imagePreview');
            const noImageText = document.getElementById('noImageText');
            const clearImageBtn = document.getElementById('clearImageBtn');
            
            if (imageFile) {
                imageFile.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        // ファイルサイズチェック（5MB制限）
                        if (file.size > 5 * 1024 * 1024) {
                            alert('画像ファイルは5MB以下にしてください');
                            e.target.value = '';
                            return;
                        }
                        
                        // 画像タイプチェック
                        if (!file.type.match('image.*')) {
                            alert('画像ファイルを選択してください');
                            e.target.value = '';
                            return;
                        }
                        
                        // プレビュー表示
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            if (imagePreview) {
                                imagePreview.src = e.target.result;
                                imagePreview.classList.remove('hidden');
                            }
                            if (noImageText) {
                                noImageText.classList.add('hidden');
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
            
            // 画像クリアボタン
            if (clearImageBtn) {
                clearImageBtn.addEventListener('click', function() {
                    if (imageFile) imageFile.value = '';
                    if (imagePreview) {
                        imagePreview.src = '/static/images/no-image.svg';
                        imagePreview.classList.add('hidden');
                    }
                    if (noImageText) {
                        noImageText.classList.remove('hidden');
                    }
                });
            }
            
            document.getElementById('optionForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const mode = document.getElementById('mode').value;
                const optionId = document.getElementById('optionId').value;
                const formData = new FormData(e.target);
                const data = Object.fromEntries(formData.entries());
                
                try {
                    // 画像ファイルがある場合は先にアップロード
                    const imageFile = document.getElementById('imageFile');
                    if (imageFile && imageFile.files && imageFile.files[0]) {
                        const file = imageFile.files[0];
                        const imageFormData = new FormData();
                        imageFormData.append('image', file);
                        
                        const uploadResponse = await axios.post('/api/options/upload-image', imageFormData, {
                            headers: { 'Content-Type': 'multipart/form-data' }
                        });
                        
                        if (uploadResponse.data && uploadResponse.data.image_url) {
                            data.image_url = uploadResponse.data.image_url;
                        }
                    }
                    
                    let response;
                    if (mode === 'new') {
                        response = await axios.post('/api/options', data);
                        alert('オプションを登録しました！');
                    } else {
                        response = await axios.put(\`/api/options/\${optionId}\`, data);
                        alert('オプションを更新しました！');
                    }
                    window.location.href = '/admin/options';
                } catch (error) {
                    console.error('Error:', error);
                    const message = mode === 'new' ? '登録に失敗しました' : '更新に失敗しました';
                    alert(\`\${message}: \${error.response?.data?.error || error.message}\`);
                }
            });
        </script>
    </body>
    </html>
  `)
})

