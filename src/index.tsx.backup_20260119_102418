// API: イベントフォームフィールド保存
app.post('/api/events/:id/form-fields', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const { fields } = await c.req.json()

  // テーブルが存在しない場合は作成
  await DB.prepare(`
    CREATE TABLE IF NOT EXISTS event_form_fields (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      event_id INTEGER NOT NULL,
      field_type TEXT NOT NULL,
      field_name TEXT NOT NULL,
      field_label TEXT NOT NULL,
      field_options TEXT,
      is_required INTEGER DEFAULT 0,
      description TEXT,
      display_order INTEGER DEFAULT 0,
      placeholder TEXT,
      parent_field_id INTEGER,
      parent_condition TEXT,
      indent_level INTEGER DEFAULT 0,
      created_at TEXT DEFAULT (datetime('now', 'localtime')),
      modified_at TEXT DEFAULT (datetime('now', 'localtime')),
      FOREIGN KEY (event_id) REFERENCES events(id)
    )
  `).run()

  // 既存のフィールドを削除
  await DB.prepare(`
    DELETE FROM event_form_fields WHERE event_id = ?
  `).bind(eventId).run()

  // 新しいフィールドを挿入
  // 第1パス: 全フィールドを挿入してIDマッピングを作成
  const idMapping = {}; // old ID -> new ID のマッピング
  
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i]
    const result = await DB.prepare(`
      INSERT INTO event_form_fields (
        event_id, field_type, field_name, field_label, field_options,
        is_required, description, display_order, placeholder,
        parent_field_id, parent_condition, indent_level
      )
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      eventId,
      field.field_type,
      field.field_name,
      field.field_label,
      field.field_options || null,
      field.is_required ? 1 : 0,
      field.description || null,
      i,
      field.placeholder || null,
      null, // 第1パスでは親IDは設定しない
      field.parent_condition || null,
      field.indent_level || 0
    ).run()
    
    // IDマッピングを保存（元のIDまたは配列インデックス → 新しいDB ID）
    const newId = result.meta.last_row_id;
    
    // field.idがある場合（既存フィールドまたはnew_xxx形式）
    if (field.id) {
      const fieldIdStr = field.id.toString();
      idMapping[fieldIdStr] = newId;
    }
    
    // 配列インデックスもキーに（フォールバック）
    idMapping[`index_${i}`] = newId;
  }
  
  // 第2パス: parent_field_idを更新
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i]
    if (field.parent_field_id) {
      const newFieldId = idMapping[`index_${i}`];
      
      // 親フィールドのIDを解決
      let actualParentId = null;
      
      // parent_field_idが文字列（new_xxxなど）または数値の場合
      const parentIdStr = field.parent_field_id.toString();
      
      if (idMapping[parentIdStr]) {
        // マッピングに直接存在する場合
        actualParentId = idMapping[parentIdStr];
      } else if (parentIdStr.startsWith('new_')) {
        // new_xxx形式の場合、配列から親を探す
        const parentIndex = fields.findIndex(f => 
          f.id && f.id.toString() === parentIdStr
        );
        if (parentIndex >= 0) {
          actualParentId = idMapping[`index_${parentIndex}`];
        }
      } else {
        // 数値IDの場合、そのまま使用（既存フィールドへの参照の可能性）
        actualParentId = parseInt(parentIdStr) || null;
      }
      
      if (actualParentId) {
        await DB.prepare(`
          UPDATE event_form_fields
          SET parent_field_id = ?
          WHERE id = ?
        `).bind(actualParentId, newFieldId).run();
      }
    }
  }

  return c.json({ success: true, message: 'フォームフィールドを保存しました' })
})

