                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        開始時刻 <span class="text-gray-500 text-xs">(オプション)</span>
                                    </label>
                                    <input type="time" id="timeSlotStart" 
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        終了時刻 <span class="text-gray-500 text-xs">(オプション)</span>
                                    </label>
                                    <input type="time" id="timeSlotEnd" 
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    総在庫数 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="totalStock" required min="0" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                    placeholder="50">
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>登録
                            </button>
                            <a href="/admin/shared-stock-pools" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            function getDateRange(startDate, endDate) {
                const dates = [];
                const currentDate = new Date(startDate);
                const end = endDate ? new Date(endDate) : new Date(startDate);
                
                while (currentDate <= end) {
                    dates.push(new Date(currentDate).toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
                
                return dates;
            }

            document.getElementById('poolForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const startDate = document.getElementById('poolDateStart').value;
                const endDate = document.getElementById('poolDateEnd').value || startDate;

                const data = {
                    pool_name: document.getElementById('poolName').value,
                    pool_code: document.getElementById('poolCode').value || null,
                    description: document.getElementById('poolDescription').value || null,
                    time_slot_label: document.getElementById('timeSlotLabel').value || null,
                    time_slot_start: document.getElementById('timeSlotStart').value || null,
                    time_slot_end: document.getElementById('timeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('totalStock').value),
                    date_start: startDate,
                    date_end: endDate,
                    enable_flg: 1
                };

                try {
                    const result = await axios.post('/api/shared-stock-pools/batch', data);
                    alert(\`\${result.data.created_count}個のプールを登録しました（\${startDate} ～ \${endDate}）\`);
                    window.location.href = '/admin/shared-stock-pools';
                } catch (error) {
                    console.error('Error:', error);
                    alert('保存に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 共有在庫プール編集
app.get('/admin/shared-stock-pools/:id/edit', async (c) => {
  const { DB } = c.env
  const poolId = c.req.param('id')

  const pool = await DB.prepare(`
    SELECT * FROM shared_stock_pools WHERE id = ?
  `).bind(parseInt(poolId)).first()

  if (!pool) {
    return c.text('プールが見つかりません', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>共有在庫プール編集 - 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/shared-stock-pools" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>プール一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">共有在庫プール編集</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-4xl mx-auto px-4">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <form id="poolForm" class="space-y-6">
                        <!-- 日付設定（編集モードでは単一日付のみ） -->
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-calendar-alt text-blue-600 mr-2"></i>
                                <h3 class="text-lg font-bold text-gray-800">日付設定</h3>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    日付 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="poolDate" required value="${pool.date}"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <p class="text-xs text-gray-600 mt-2">
                                <i class="fas fa-info-circle mr-1"></i>
                                編集モードでは単一日付のプールのみ変更できます。
                            </p>
                        </div>

                        <!-- プール詳細 -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-bold text-gray-800">プール詳細</h3>
                            
                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        プール名 <span class="text-red-600">*</span>
                                    </label>
                                    <input type="text" id="poolName" required value="${pool.pool_name}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        プールコード <span class="text-gray-500 text-xs">(オプション)</span>
                                    </label>
                                    <input type="text" id="poolCode" value="${pool.pool_code || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    説明 <span class="text-gray-500 text-xs">(オプション)</span>
                                </label>
                                <textarea id="poolDescription" rows="2" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">${pool.description || ''}</textarea>
                            </div>

                            <div class="grid md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        時間帯ラベル
                                    </label>
                                    <input type="text" id="timeSlotLabel" value="${pool.time_slot_label || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        開始時刻
                                    </label>
                                    <input type="time" id="timeSlotStart" value="${pool.time_slot_start || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        終了時刻
                                    </label>
                                    <input type="time" id="timeSlotEnd" value="${pool.time_slot_end || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    総在庫数 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="totalStock" required min="0" value="${pool.total_stock}"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <p class="text-sm text-gray-600 mt-1">
                                    現在の予約済数: <span class="font-semibold text-red-600">${pool.booked}</span> / 
                                    利用可能: <span class="font-semibold text-green-600">${pool.available_stock}</span>
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>更新
                            </button>
                            <a href="/admin/shared-stock-pools" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('poolForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const data = {
                    date: document.getElementById('poolDate').value,
                    pool_name: document.getElementById('poolName').value,
                    pool_code: document.getElementById('poolCode').value || null,
                    description: document.getElementById('poolDescription').value || null,
                    time_slot_label: document.getElementById('timeSlotLabel').value || null,
                    time_slot_start: document.getElementById('timeSlotStart').value || null,
                    time_slot_end: document.getElementById('timeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('totalStock').value),
                    enable_flg: 1
                };

                try {
                    await axios.put('/api/shared-stock-pools/${poolId}', data);
                    alert('プールを更新しました');
                    window.location.href = '/admin/shared-stock-pools';
                } catch (error) {
                    console.error('Error:', error);
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 商品在庫管理

// 管理画面 - オプション新規登録フォーム
app.get('/admin/shared-stock-pools/manage', async (c) => {
  const { DB } = c.env
  const poolName = c.req.query('pool_name')
  const poolCode = c.req.query('pool_code') || ''

  if (!poolName) {
    return c.text('プール名が指定されていません', 400)
  }

  // 日別在庫一覧を取得
  const { results: stocks } = await DB.prepare(`
    SELECT * FROM shared_stock_pools
    WHERE pool_name = ? AND (pool_code = ? OR (pool_code IS NULL AND ? = ''))
    AND enable_flg = 1
    ORDER BY date ASC, time_slot_start
  `).bind(poolName, poolCode, poolCode).all()

  if (stocks.length === 0) {
    return c.text('プールが見つかりません', 404)
  }

  const firstPool = stocks[0]
  const totalStock = stocks.reduce((sum, s) => sum + s.total_stock, 0)
  const totalBooked = stocks.reduce((sum, s) => sum + s.booked, 0)
  const totalAvailable = stocks.reduce((sum, s) => sum + s.available_stock, 0)

  const stocksHtml = stocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b">${stock.date}</td>
      <td class="px-4 py-3 border-b">
        ${stock.time_slot_label || '<span class="text-gray-400">-</span>'}
        ${stock.time_slot_start ? `<div class="text-xs text-gray-500">${stock.time_slot_start} - ${stock.time_slot_end}</div>` : ''}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold text-blue-600">${stock.total_stock.toLocaleString()}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="text-red-600">${stock.booked.toLocaleString()}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock.toLocaleString()}
        </span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="showEditForm(${stock.id})" class="text-blue-600 hover:text-blue-800 mr-3">
          <i class="fas fa-edit"></i> 編集
        </button>
        <button onclick="deleteStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i> 削除
        </button>
      </td>
    </tr>
  `).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${poolName} - 在庫管理</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/shared-stock-pools" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>プール一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${poolName} - 在庫管理</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- プール情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-info-circle mr-2 text-blue-600"></i>プール情報
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">プール名</p>
                            <p class="text-lg font-semibold">${poolName}</p>
                        </div>
                        ${poolCode ? `
                        <div>
                            <p class="text-sm text-gray-600">プールコード</p>
                            <p class="text-lg font-semibold">${poolCode}</p>
                        </div>
                        ` : ''}
                        ${firstPool.description ? `
                        <div class="md:col-span-2">
                            <p class="text-sm text-gray-600">説明</p>
                            <p class="text-gray-800">${firstPool.description}</p>
                        </div>
                        ` : ''}
                    </div>
                    
                    <!-- 統計情報 -->
                    <div class="mt-6 grid md:grid-cols-3 gap-4">
                        <div class="bg-blue-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">総在庫</p>
                            <p class="text-2xl font-bold text-blue-600">${totalStock.toLocaleString()}</p>
                        </div>
                        <div class="bg-red-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">予約済</p>
                            <p class="text-2xl font-bold text-red-600">${totalBooked.toLocaleString()}</p>
                        </div>
                        <div class="bg-green-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">利用可能</p>
                            <p class="text-2xl font-bold text-green-600">${totalAvailable.toLocaleString()}</p>
                        </div>
                    </div>
                </div>

                <!-- 日別在庫一覧 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-bold text-gray-800">
                            <i class="fas fa-calendar-alt mr-2 text-blue-600"></i>日別在庫一覧
                        </h2>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">時間帯</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">在庫数</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">予約済</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody id="stockTableBody">
                                ${stocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 在庫追加フォーム -->
                <div id="addFormSection" class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>在庫追加
                    </h2>
                    <form id="addStockForm" class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="addDateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-gray-500 text-xs">(省略可)</span>
                                </label>
                                <input type="date" id="addDateEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <p class="text-xs text-gray-600">
                            <i class="fas fa-info-circle mr-1"></i>
                            終了日を指定すると、期間内の在庫を一括追加できます
                        </p>
                        
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    時間帯ラベル
                                </label>
                                <input type="text" id="addTimeSlotLabel"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500"
                                    placeholder="例: 午前、1日ツアー">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始時刻
                                </label>
                                <input type="time" id="addTimeSlotStart"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了時刻
                                </label>
                                <input type="time" id="addTimeSlotEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                総在庫数 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" id="addTotalStock" required min="0"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500"
                                placeholder="50">
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>在庫を追加
                            </button>
                            <button type="button" onclick="resetAddForm()" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 在庫編集フォーム（非表示） -->
                <div id="editFormSection" class="bg-white rounded-lg shadow-md p-6 mb-6" style="display:none;">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-edit mr-2 text-blue-600"></i>在庫編集
                    </h2>
                    <form id="editStockForm" class="space-y-4">
                        <input type="hidden" id="editStockId">
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                日付 <span class="text-red-600">*</span>
                            </label>
                            <input type="date" id="editDate" required
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    時間帯ラベル
                                </label>
                                <input type="text" id="editTimeSlotLabel"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                    placeholder="例: 午前、1日ツアー">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始時刻
                                </label>
                                <input type="time" id="editTimeSlotStart"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了時刻
                                </label>
                                <input type="time" id="editTimeSlotEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                総在庫数 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" id="editTotalStock" required min="0"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                placeholder="50">
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>保存
                            </button>
                            <button type="button" onclick="hideEditForm()" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const poolName = '${poolName}';
            const poolCode = '${poolCode}';

            // 日付範囲生成
            function getDateRange(startDate, endDate) {
                const dates = [];
                const currentDate = new Date(startDate);
                const end = endDate ? new Date(endDate) : new Date(startDate);
                
                while (currentDate <= end) {
                    dates.push(new Date(currentDate).toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
                
                return dates;
            }

            // 追加フォームをリセット
            function resetAddForm() {
                document.getElementById('addStockForm').reset();
                document.getElementById('editFormSection').style.display = 'none';
            }

            // 編集フォーム表示
            async function showEditForm(id) {
                try {
                    const res = await axios.get(\`/api/shared-stock-pools/\${id}\`);
                    const pool = res.data.pool;

                    document.getElementById('editStockId').value = pool.id;
                    document.getElementById('editDate').value = pool.date;
                    document.getElementById('editTimeSlotLabel').value = pool.time_slot_label || '';
                    document.getElementById('editTimeSlotStart').value = pool.time_slot_start || '';
                    document.getElementById('editTimeSlotEnd').value = pool.time_slot_end || '';
                    document.getElementById('editTotalStock').value = pool.total_stock;

                    document.getElementById('editFormSection').style.display = 'block';
                    // スムーズスクロール
                    document.getElementById('editFormSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
                } catch (error) {
                    alert('在庫情報の取得に失敗しました');
                    console.error(error);
                }
            }

            // 編集フォームをキャンセル
            function hideEditForm() {
                document.getElementById('editFormSection').style.display = 'none';
                document.getElementById('editStockForm').reset();
            }

            // 在庫追加
            document.getElementById('addStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const startDate = document.getElementById('addDateStart').value;
                const endDate = document.getElementById('addDateEnd').value || startDate;
                const dates = getDateRange(startDate, endDate);

                const baseData = {
                    pool_name: poolName,
                    pool_code: poolCode || null,
                    description: '${firstPool.description ? firstPool.description.replace(/'/g, "\\'") : ''}' || null,
                    time_slot_label: document.getElementById('addTimeSlotLabel').value || null,
                    time_slot_start: document.getElementById('addTimeSlotStart').value || null,
                    time_slot_end: document.getElementById('addTimeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('addTotalStock').value),
                    enable_flg: 1
                };

                try {
                    let successCount = 0;
                    for (const date of dates) {
                        await axios.post('/api/shared-stock-pools', {
                            ...baseData,
                            date: date
                        });
                        successCount++;
                    }
                    alert(\`\${successCount}件の在庫を追加しました（\${startDate} ～ \${endDate}）\`);
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('追加に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });

            // 在庫編集
            document.getElementById('editStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const id = document.getElementById('editStockId').value;
                const data = {
                    pool_name: poolName,
                    pool_code: poolCode || null,
                    description: '${firstPool.description ? firstPool.description.replace(/'/g, "\\'") : ''}' || null,
                    date: document.getElementById('editDate').value,
                    time_slot_label: document.getElementById('editTimeSlotLabel').value || null,
                    time_slot_start: document.getElementById('editTimeSlotStart').value || null,
                    time_slot_end: document.getElementById('editTimeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('editTotalStock').value),
                    enable_flg: 1
                };

                try {
                    await axios.put(\`/api/shared-stock-pools/\${id}\`, data);
                    alert('在庫を更新しました');
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });

            // 在庫削除
            async function deleteStock(id) {
                if (!confirm('この日付の在庫を削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/shared-stock-pools/\${id}\`);
                    alert('在庫を削除しました');
                    window.location.reload();
                } catch (error) {
                    alert('削除に失敗しました');
                    console.error(error);
                }
            }
        </script>
    </body>
    </html>
  `)
})

