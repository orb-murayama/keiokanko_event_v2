            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('memberForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value,
                    family_name: document.getElementById('family_name').value,
                    first_name: document.getElementById('first_name').value,
                    family_kana: document.getElementById('family_kana').value || null,
                    first_kana: document.getElementById('first_kana').value || null,
                    sex: document.getElementById('sex').value || null,
                    birth: document.getElementById('birth').value || null,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    tel: document.getElementById('tel').value,
                    enable_flg: parseInt(document.getElementById('enable_flg').value)
                }

                try {
                    await axios.post('/api/members', data)
                    alert('会員を登録しました！')
                    window.location.href = '/admin/members'
                } catch (error) {
                    alert('登録に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})


// 会員編集画面
app.get('/admin/members/:id/edit', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  const member = await DB.prepare('SELECT * FROM members WHERE id = ?').bind(id).first()
  const { results: prefs } = await DB.prepare('SELECT id, name FROM prefs ORDER BY id').all()

  if (!member) {
    return c.text('会員が見つかりません', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>会員編集 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <nav class="bg-gradient-to-r from-blue-600 to-blue-800 text-white shadow-lg">
            <div class="container mx-auto px-4 py-3">
                <div class="flex items-center justify-between">
                    <h1 class="text-2xl font-bold">
                        <i class="fas fa-calendar-alt mr-2"></i>
                        イベント予約管理システム
                    </h1>
                    <div class="flex gap-4">
                        <a href="/" class="hover:text-blue-200 transition"><i class="fas fa-home mr-1"></i>トップ</a>
                        <a href="/admin" class="hover:text-blue-200 transition"><i class="fas fa-cog mr-1"></i>管理画面</a>
                        <a href="/admin/members" class="hover:text-blue-200 transition"><i class="fas fa-users mr-1"></i>会員管理</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-8">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-user-edit mr-2 text-purple-600"></i>会員編集
                    </h2>
                    <nav class="text-sm text-gray-600 mt-2">
                        <a href="/" class="hover:text-blue-600">トップ</a>
                        <span class="mx-2">/</span>
                        <a href="/admin" class="hover:text-blue-600">管理画面</a>
                        <span class="mx-2">/</span>
                        <a href="/admin/members" class="hover:text-blue-600">会員管理</a>
                        <span class="mx-2">/</span>
                        <span>編集</span>
                    </nav>
                </div>

                <form id="memberForm" class="space-y-6">
                    <!-- 基本情報 -->
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">
                            <i class="fas fa-info-circle mr-2"></i>基本情報
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    メールアドレス <span class="text-red-500">*</span>
                                </label>
                                <input type="email" id="email" required
                                       value="${member.email}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    姓（漢字） <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="last_name" required
                                       value="${member.last_name}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    名（漢字） <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="first_name" required
                                       value="${member.first_name}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    姓（ローマ字）
                                </label>
                                <input type="text" id="last_name_roma"
                                       value="${member.last_name_roma || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    名（ローマ字）
                                </label>
                                <input type="text" id="first_name_roma"
                                       value="${member.first_name_roma || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    姓（英字）
                                </label>
                                <input type="text" id="last_name_en"
                                       value="${member.last_name_en || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    名（英字）
                                </label>
                                <input type="text" id="first_name_en"
                                       value="${member.first_name_en || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    性別
                                </label>
                                <select id="gender" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                                    <option value="" ${!member.gender ? 'selected' : ''}>未選択</option>
                                    <option value="male" ${member.gender === 'male' ? 'selected' : ''}>男性</option>
                                    <option value="female" ${member.gender === 'female' ? 'selected' : ''}>女性</option>
                                    <option value="other" ${member.gender === 'other' ? 'selected' : ''}>その他</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    生年月日
                                </label>
                                <input type="date" id="birth_date"
                                       value="${member.birth_date || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>
                        </div>
                    </div>

                    <!-- 住所情報 -->
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">
                            <i class="fas fa-map-marker-alt mr-2"></i>住所情報
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    郵便番号
                                </label>
                                <input type="text" id="zip"
                                       value="${member.zip || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    都道府県
                                </label>
                                <select id="pref_id" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                                    <option value="">選択してください</option>
                                    ${prefs.map(p => `<option value="${p.id}" ${member.pref_id === p.id ? 'selected' : ''}>${p.name}</option>`).join('')}
                                </select>
                            </div>

                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    住所
                                </label>
                                <input type="text" id="addr"
                                       value="${member.addr || ''}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>
                        </div>
                    </div>

                    <!-- 連絡先情報 -->
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">
                            <i class="fas fa-phone mr-2"></i>連絡先情報
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    連絡先電話番号 <span class="text-red-500">*</span>
                                </label>
                                <input type="tel" id="tel" required
                                       value="${member.tel}"
                                       class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                            </div>
                        </div>
                    </div>

                    <!-- その他 -->
                    <div>
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">
                            <i class="fas fa-cog mr-2"></i>その他
                        </h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    状態
                                </label>
                                <select id="enable_flg" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                                    <option value="1" ${member.enable_flg === 1 ? 'selected' : ''}>有効</option>
                                    <option value="0" ${member.enable_flg === 0 ? 'selected' : ''}>無効</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-4 pt-6">
                        <button type="submit" 
                                class="flex-1 bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-semibold">
                            <i class="fas fa-save mr-2"></i>更新する
                        </button>
                        <a href="/admin/members/${member.id}" 
                           class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold text-center">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('memberForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    email: document.getElementById('email').value,
                    last_name: document.getElementById('last_name').value,
                    first_name: document.getElementById('first_name').value,
                    last_name_roma: document.getElementById('last_name_roma').value || null,
                    first_name_roma: document.getElementById('first_name_roma').value || null,
                    last_name_en: document.getElementById('last_name_en').value || null,
                    first_name_en: document.getElementById('first_name_en').value || null,
                    gender: document.getElementById('gender').value || null,
                    birth_date: document.getElementById('birth_date').value || null,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    tel: document.getElementById('tel').value,
                    enable_flg: parseInt(document.getElementById('enable_flg').value)
                }

                try {
                    await axios.put('/api/members/${member.id}', data)
                    alert('会員情報を更新しました！')
                    window.location.href = '/admin/members/${member.id}'
                } catch (error) {
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})

// 会員登録API
app.post('/api/members', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    // メールアドレスの重複チェック
    const existing = await DB.prepare(`
      SELECT id FROM members WHERE email = ?
    `).bind(data.email).first()
    
    if (existing) {
      return c.json({ error: 'このメールアドレスは既に登録されています' }, 400)
    }

    const result = await DB.prepare(`
      INSERT INTO members (
        email, last_name, first_name, last_name_roma, first_name_roma,
        last_name_en, first_name_en, gender, birth_date, zip, pref_id, addr, tel, enable_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.email,
      data.last_name,
      data.first_name,
      data.last_name_roma,
      data.first_name_roma,
      data.last_name_en,
      data.first_name_en,
      data.gender,
      data.birth_date,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.enable_flg
    ).run()

    return c.json({ id: result.meta.last_row_id, message: '会員を登録しました' })
  } catch (error) {
    console.error('会員登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 会員更新API
app.put('/api/members/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()

  try {
    await DB.prepare(`
      UPDATE members SET
        email = ?,
        last_name = ?,
        first_name = ?,
        last_name_roma = ?,
        first_name_roma = ?,
        last_name_en = ?,
        first_name_en = ?,
        gender = ?,
        birth_date = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        tel = ?,
        enable_flg = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.email,
      data.last_name,
      data.first_name,
      data.last_name_roma,
      data.first_name_roma,
      data.last_name_en,
      data.first_name_en,
      data.gender,
      data.birth_date,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.enable_flg,
      id
    ).run()

    return c.json({ message: '会員情報を更新しました' })
  } catch (error) {
    console.error('会員更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - イベントのコピー
app.post('/api/events/:id/copy', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  try {
    // 元のイベントが存在するか確認
    const { results } = await DB.prepare(`
      SELECT name, name_en FROM events WHERE id = ? AND deleted_at IS NULL
    `).bind(eventId).all()
    
    if (results.length === 0) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    const originalName = results[0].name
    const originalNameEn = results[0].name_en
    
    // INSERT ... SELECTを使用してコピー（id, created_at, modified_at, deleted_atを除く）
    const result = await DB.prepare(`
      INSERT INTO events (
        name, detail, location, contact, remarks, question, postage, thanks_msg, note,
        client_id, company_flg, enable_flg, payment_flg, payment_cd,
        payment_methods, bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name,
        customer_client_id, form_field_settings,
        event_url, category, date_selection_type, event_start_date, event_end_date,
        registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, cc_email, sender_email, sender_name, email_signature, contact_info,
        store_code, bank_transfer_deadline, convenience_payment_deadline, available_convenience_stores,
        credit_fee_enabled, credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_enabled, bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_enabled, convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        auto_reply_enabled, auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        name_en, detail_en, location_en, contact_en, remarks_en, thanks_msg_en, note_en,
        email_signature_en, contact_info_en,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en,
        created_at, modified_at
      )
      SELECT
        'コピー ' || name, detail, location, contact, remarks, question, postage, thanks_msg, note,
        client_id, company_flg, 0, payment_flg, payment_cd,
        payment_methods, bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name,
        customer_client_id, form_field_settings,
        NULL, category, date_selection_type, event_start_date, event_end_date,
        registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, cc_email, sender_email, sender_name, email_signature, contact_info,
        store_code, bank_transfer_deadline, convenience_payment_deadline, available_convenience_stores,
        credit_fee_enabled, credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_enabled, bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_enabled, convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        auto_reply_enabled, auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        CASE WHEN name_en IS NOT NULL THEN 'Copy ' || name_en ELSE NULL END,
        detail_en, location_en, contact_en, remarks_en, thanks_msg_en, note_en,
        email_signature_en, contact_info_en,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en,
        datetime('now', 'localtime'), datetime('now', 'localtime')
      FROM events
      WHERE id = ? AND deleted_at IS NULL
    `).bind(eventId).run()
    
    return c.json({ 
      message: 'イベント「' + originalName + '」をコピーしました',
      newEventId: result.meta.last_row_id
    })
  } catch (error) {
    console.error('イベントコピーエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - イベントの削除（論理削除）
app.delete('/api/events/:id', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  try {
    // イベントの存在確認
    const { results } = await DB.prepare(`
      SELECT id FROM events WHERE id = ? AND deleted_at IS NULL
    `).bind(eventId).all()
    
    if (results.length === 0) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    // 論理削除（deleted_atを設定）
    await DB.prepare(`
      UPDATE events 
      SET deleted_at = datetime('now', 'localtime'),
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(eventId).run()
    
    return c.json({ message: 'イベントを削除しました' })
  } catch (error) {
    console.error('イベント削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品のコピー
app.post('/api/products/:id/copy', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    // 元の商品情報を取得
    const { results } = await DB.prepare(`
      SELECT * FROM products WHERE id = ? AND deleted_at IS NULL
    `).bind(productId).all()
    
    if (results.length === 0) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    const original = results[0]
    const originalName = original.name
    
    // 商品をコピー（名前に「コピー 」を接頭辞として付ける）
    const result = await DB.prepare(`
      INSERT INTO products (
        client_id, event_id, name, sales_start, sales_end, closing_trade,
        product_category_id, description, remarks, enable_flg,
        cancellation_days_1, cancellation_rate_1,
        cancellation_days_2, cancellation_rate_2,
        cancellation_days_3, cancellation_rate_3,
        cancellation_days_4, cancellation_rate_4,
        cancellation_days_5, cancellation_rate_5,
        created_at, modified_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      original.client_id,
      original.event_id,
      'コピー ' + original.name,
      original.sales_start,
      original.sales_end,
      original.closing_trade,
      original.product_category_id,
      original.description,
      original.remarks,
      original.cancellation_days_1,
      original.cancellation_rate_1,
      original.cancellation_days_2,
      original.cancellation_rate_2,
      original.cancellation_days_3,
      original.cancellation_rate_3,
      original.cancellation_days_4,
      original.cancellation_rate_4,
      original.cancellation_days_5,
      original.cancellation_rate_5
    ).run()
    
    return c.json({ 
      message: '商品「' + originalName + '」をコピーしました',
      newProductId: result.meta.last_row_id
    })
  } catch (error) {
    console.error('商品コピーエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

