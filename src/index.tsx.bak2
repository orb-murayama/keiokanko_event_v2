                            <label class="block text-sm font-medium text-gray-700 mb-2">メールアドレス</label>
                            <input type="text" id="searchEmail" placeholder="メールアドレスで検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">氏名</label>
                            <input type="text" id="searchName" placeholder="氏名で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">電話番号</label>
                            <input type="text" id="searchTel" placeholder="電話番号で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">都道府県</label>
                            <input type="text" id="searchPref" placeholder="都道府県で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">状態</label>
                            <select id="searchStatus" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-purple-500">
                                <option value="">すべて</option>
                                <option value="1">有効</option>
                                <option value="0">無効</option>
                            </select>
                        </div>
                        <div class="flex items-end gap-2">
                            <button type="submit" class="bg-purple-600 text-white px-6 py-2 rounded-lg hover:bg-purple-700">
                                <i class="fas fa-search mr-2"></i>検索
                            </button>
                            <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">メールアドレス</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">氏名</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">電話番号</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">都道府県</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">状態</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
                            </tr>
                        </thead>
                        <tbody id="members-tbody" class="bg-white divide-y divide-gray-200">
                            <!-- データはJavaScriptで動的にロードされます -->
                            <tr>
                                <td colspan="7" class="px-6 py-4 text-center text-gray-500">
                                    <i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- ページネーション -->
                <div id="pagination" class="mt-6 flex justify-between items-center">
                    <div id="pagination-info" class="text-sm text-gray-700"></div>
                    <div class="flex gap-2">
                        <button id="prev-page" onclick="changePage(currentPage - 1)" 
                                class="px-4 py-2 border rounded-lg hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-left mr-1"></i>前へ
                        </button>
                        <button id="next-page" onclick="changePage(currentPage + 1)"
                                class="px-4 py-2 border rounded-lg hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                            次へ<i class="fas fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script>
            let currentPage = 1;
            let perPage = 20;
            let totalPages = 1;
            let searchParams = {};

            // 会員一覧をAPIから取得して表示
            async function loadMembers() {
                try {
                    console.log('会員データをAPIから取得中...');
                    const params = new URLSearchParams({
                        page: currentPage,
                        per_page: perPage,
                        ...searchParams
                    });
                    
                    const response = await fetch(\`/api/members?\${params}\`);
                    
                    if (!response.ok) {
                        throw new Error(\`HTTP error! status: \${response.status}\`);
                    }
                    
                    const result = await response.json();
                    console.log('取得した会員データ:', result);
                    
                    const tbody = document.getElementById('members-tbody');
                    
                    if (!result.data || result.data.length === 0) {
                        tbody.innerHTML = \`
                            <tr>
                                <td colspan="8" class="px-6 py-4 text-center text-gray-500">
                                    <i class="fas fa-info-circle mr-2"></i>データがありません
                                </td>
                            </tr>
                        \`;
                        document.getElementById('pagination').classList.add('hidden');
                        return;
                    }
                    
                    tbody.innerHTML = result.data.map(m => \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">\${m.id}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">\${m.email}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">\${m.family_name} \${m.first_name}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">\${m.tel || '-'}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">\${m.pref_name || '-'}</td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                \${m.enable_flg === 1 
                                    ? '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">有効</span>'
                                    : '<span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">無効</span>'
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <a href="/admin/members/\${m.id}/edit" class="text-blue-600 hover:text-blue-900">
                                    <i class="fas fa-edit"></i> 編集
                                </a>
                            </td>
                        </tr>
                    \`).join('');
                    
                    // ページネーション更新
                    totalPages = result.pagination.total_pages;
                    document.getElementById('pagination-info').textContent = 
                        \`全 \${result.pagination.total} 件中 \${(currentPage - 1) * perPage + 1} - \${Math.min(currentPage * perPage, result.pagination.total)} 件を表示\`;
                    document.getElementById('prev-page').disabled = currentPage === 1;
                    document.getElementById('next-page').disabled = currentPage >= totalPages;
                    document.getElementById('pagination').classList.remove('hidden');
                    
                    console.log(\`\${result.data.length}件の会員データを表示しました\`);
                    
                } catch (error) {
                    console.error('会員データの取得に失敗:', error);
                    const tbody = document.getElementById('members-tbody');
                    tbody.innerHTML = \`
                        <tr>
                            <td colspan="8" class="px-6 py-4 text-center text-red-500">
                                <i class="fas fa-exclamation-triangle mr-2"></i>データの取得に失敗しました
                            </td>
                        </tr>
                    \`;
                }
            }
            
            // ページ変更
            function changePage(page) {
                if (page < 1 || page > totalPages) return;
                currentPage = page;
                loadMembers();
            }
            
            // 検索フォーム送信
            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                currentPage = 1;
                searchParams = {
                    email: document.getElementById('searchEmail').value,
                    name: document.getElementById('searchName').value,
                    tel: document.getElementById('searchTel').value,
                    pref: document.getElementById('searchPref').value,
                    status: document.getElementById('searchStatus').value
                };
                loadMembers();
            });
            
            // 検索リセット
            function resetSearch() {
                document.getElementById('searchEmail').value = '';
                document.getElementById('searchName').value = '';
                document.getElementById('searchTel').value = '';
                document.getElementById('searchPref').value = '';
                document.getElementById('searchStatus').value = '';
                currentPage = 1;
                searchParams = {};
                loadMembers();
            }
            
            // ページロード時に実行
            document.addEventListener('DOMContentLoaded', loadMembers);
        </script>
    </body>
    </html>
  `)
})

