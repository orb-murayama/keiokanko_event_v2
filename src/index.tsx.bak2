                            <label class="flex items-center cursor-pointer">
                                <input type="radio" name="date_selection_type" value="calendar"
                                    class="w-5 h-5 text-blue-600 focus:ring-2 focus:ring-blue-500">
                                <span class="ml-3 text-gray-700 font-medium">
                                    <i class="fas fa-calendar mr-2 text-green-600"></i>カレンダー選択
                                </span>
                            </label>
                        </div>
                        <div class="mt-4 text-xs text-gray-500">
                            <p><strong>ボタン選択：</strong>事前に設定した日付をボタンで選択</p>
                            <p><strong>カレンダー選択：</strong>カレンダーから自由に日付を選択</p>
                        </div>
                    </div>
                    
                    <!-- メール設定 -->
                    <div class="border-t pt-6 mt-6">
                        <h3 class="text-xl font-bold text-gray-800 mb-6">
                            <i class="fas fa-envelope mr-2 text-purple-600"></i>メール設定
                        </h3>
                        
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">管理者メールアドレス</label>
                                <input type="email" name="admin_email" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"
                                    placeholder="admin@example.com">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">管理者予備メールアドレス（CC）</label>
                                <input type="email" name="admin_cc_email" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"
                                    placeholder="backup@example.com">
                            </div>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-6 mt-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">発信者名</label>
                                <input type="text" name="sender_name" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"
                                    placeholder="イベント事務局">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">発信者メールアドレス</label>
                                <input type="email" name="sender_email" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"
                                    placeholder="noreply@example.com">
                            </div>
                        </div>
                    </div>
                    
                    <!-- 決済設定 -->
                    <div class="border-t pt-6 mt-6" id="paymentSettingsSection">
                        <h3 class="text-xl font-bold text-gray-800 mb-6">
                            <i class="fas fa-credit-card mr-2 text-green-600"></i>決済設定
                        </h3>
                        
                        <!-- 支払方法 -->
                        <div class="mb-6">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                支払方法 <span class="text-red-600">*</span>
                            </label>
                            <div class="space-y-2">
                                <label class="flex items-center">
                                    <input type="checkbox" name="payment_method" value="1" class="mr-2 w-4 h-4">
                                    <span>クレジットカード</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="payment_method" value="2" id="bankTransferCheckbox" class="mr-2 w-4 h-4">
                                    <span>銀行振込</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="payment_method" value="4" class="mr-2 w-4 h-4">
                                    <span>コンビニ払い</span>
                                </label>
                            </div>
                        </div>
                        
                        <!-- 銀行振込情報（銀行振込選択時のみ表示） -->
                        <div id="bankInfoSection" class="hidden mb-6 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                            <h4 class="text-lg font-semibold text-gray-800 mb-4">
                                <i class="fas fa-university mr-2 text-blue-600"></i>銀行振込口座情報
                            </h4>
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        金融機関名 <span class="text-red-600">*</span>
                                    </label>
                                    <input type="text" name="bank_name" id="bankName"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                        placeholder="例: ○○銀行">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        支店名 <span class="text-red-600">*</span>
                                    </label>
                                    <input type="text" name="bank_branch" id="bankBranch"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                        placeholder="例: △△支店">
                                </div>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6 mt-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        口座種別 <span class="text-red-600">*</span>
                                    </label>
                                    <select name="bank_account_type" id="bankAccountType"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                        <option value="">選択してください</option>
                                        <option value="普通">普通</option>
                                        <option value="当座">当座</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        口座番号（7桁） <span class="text-red-600">*</span>
                                    </label>
                                    <input type="text" name="bank_account_number" id="bankAccountNumber"
                                        maxlength="7" pattern="[0-9]{7}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                        placeholder="1234567">
                                </div>
                            </div>
                            <div class="mt-4">
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    口座名義（カタカナ） <span class="text-red-600">*</span>
                                </label>
                                <input type="text" name="bank_account_name" id="bankAccountName"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="例: カ）サンプルカイシャ">
                            </div>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">店舗コード（クレジット/コンビニ電文用）</label>
                                <input type="text" name="store_code" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500"
                                    placeholder="店舗コード">
                            </div>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-6 mt-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">銀行振込期限（日数）</label>
                                <input type="number" name="bank_transfer_deadline" value="7" min="1" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">コンビニ入金期限（日数）</label>
                                <input type="number" name="convenience_payment_deadline" value="7" min="1" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        
                        <div class="mt-4">
                            <label class="block text-sm font-semibold text-gray-700 mb-2">使用可能コンビニ（複数選択可）</label>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="セブンイレブン" class="mr-2 w-4 h-4">
                                    <span class="text-sm">セブンイレブン</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="ファミリーマート" class="mr-2 w-4 h-4">
                                    <span class="text-sm">ファミリーマート</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="ローソン" class="mr-2 w-4 h-4">
                                    <span class="text-sm">ローソン</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="セイコーマート" class="mr-2 w-4 h-4">
                                    <span class="text-sm">セイコーマート</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="デイリーヤマザキ" class="mr-2 w-4 h-4">
                                    <span class="text-sm">デイリーヤマザキ</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="ミニストップ" class="mr-2 w-4 h-4">
                                    <span class="text-sm">ミニストップ</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="checkbox" name="convenience_store" value="スリーエフ" class="mr-2 w-4 h-4">
                                    <span class="text-sm">スリーエフ</span>
                                </label>
                            </div>
                        </div>
                        
                        <!-- クレジットカード決済手数料 -->
                        <div class="mt-6 p-4 bg-green-50 border border-green-200 rounded-lg">
                            <h4 class="font-semibold text-gray-800 mb-4">クレジットカード決済手数料</h4>
                            <div class="space-y-3">
                                <label class="flex items-center">
                                    <input type="radio" name="credit_fee_type" value="none" checked class="mr-2">
                                    <span>手数料を課金しない</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="credit_fee_type" value="percentage" class="mr-2">
                                    <span>決済金額の</span>
                                    <input type="number" name="credit_fee_percentage" value="0" min="0" step="0.1" 
                                        class="ml-2 w-20 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">%</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="credit_fee_type" value="fixed" class="mr-2">
                                    <span>一律</span>
                                    <input type="number" name="credit_fee_fixed" value="0" min="0" 
                                        class="ml-2 w-32 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">円</span>
                                </label>
                            </div>
                        </div>
                        
                        <!-- 銀行振込決済手数料 -->
                        <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-lg">
                            <h4 class="font-semibold text-gray-800 mb-4">銀行振込決済手数料</h4>
                            <div class="space-y-3">
                                <label class="flex items-center">
                                    <input type="radio" name="bank_fee_type" value="none" checked class="mr-2">
                                    <span>手数料を課金しない</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="bank_fee_type" value="percentage" class="mr-2">
                                    <span>決済金額の</span>
                                    <input type="number" name="bank_fee_percentage" value="0" min="0" step="0.1" 
                                        class="ml-2 w-20 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">%</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="bank_fee_type" value="fixed" class="mr-2">
                                    <span>一律</span>
                                    <input type="number" name="bank_fee_fixed" value="0" min="0" 
                                        class="ml-2 w-32 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">円</span>
                                </label>
                            </div>
                        </div>
                        
                        <!-- コンビニ決済手数料 -->
                        <div class="mt-4 p-4 bg-orange-50 border border-orange-200 rounded-lg">
                            <h4 class="font-semibold text-gray-800 mb-4">コンビニ決済手数料</h4>
                            <div class="space-y-3">
                                <label class="flex items-center">
                                    <input type="radio" name="convenience_fee_type" value="none" checked class="mr-2">
                                    <span>手数料を課金しない</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="convenience_fee_type" value="percentage" class="mr-2">
                                    <span>決済金額の</span>
                                    <input type="number" name="convenience_fee_percentage" value="0" min="0" step="0.1" 
                                        class="ml-2 w-20 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">%</span>
                                </label>
                                <label class="flex items-center">
                                    <input type="radio" name="convenience_fee_type" value="fixed" class="mr-2">
                                    <span>一律</span>
                                    <input type="number" name="convenience_fee_fixed" value="0" min="0" 
                                        class="ml-2 w-32 px-2 py-1 border border-gray-300 rounded">
                                    <span class="ml-1">円</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    

                    <!-- 申込フォーム入力項目設定 -->
                    <div class="border-t pt-6 mt-6">
                        <h3 class="text-xl font-bold text-gray-800 mb-6">
                            <i class="fas fa-clipboard-list mr-2 text-blue-600"></i>申込フォーム入力項目設定
                        </h3>
                        <p class="text-sm text-gray-600 mb-4">予約申込時に表示する入力項目を選択してください</p>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_name_kanji" value="1" checked class="mr-2 w-4 h-4">
                                <span class="text-sm">名前（漢字）</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_name_kana" value="1" checked class="mr-2 w-4 h-4">
                                <span class="text-sm">名前（カナ）</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_name_roma" value="1" class="mr-2 w-4 h-4">
                                <span class="text-sm">名前（ローマ字）</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_address" value="1" checked class="mr-2 w-4 h-4">
                                <span class="text-sm">住所</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_tel" value="1" checked class="mr-2 w-4 h-4">
                                <span class="text-sm">連絡先電話番号</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_birth_date" value="1" class="mr-2 w-4 h-4">
                                <span class="text-sm">生年月日</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" name="form_field_age" value="1" class="mr-2 w-4 h-4">
                                <span class="text-sm">年齢</span>
                            </label>
                        </div>
                    </div>
                    
                    <!-- 言語タブ -->
                    <div class="border-t pt-6 mt-6">
                        <div class="flex gap-2 mb-6 border-b">
                            <button type="button" id="tabJapanese" onclick="switchLanguageTab('ja')" 
                                class="px-6 py-3 font-semibold border-b-2 border-blue-600 text-blue-600">
                                日本語
                            </button>
                            <button type="button" id="tabEnglish" onclick="switchLanguageTab('en')" 
                                class="px-6 py-3 font-semibold text-gray-500 hover:text-gray-700">
                                English
                            </button>
                        </div>
                        
                        <!-- 日本語コンテンツ -->
                        <div id="contentJapanese" class="space-y-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    お問合せ先 <span class="text-red-600">*</span>
                                </label>
                                <textarea name="contact" rows="3" required 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="電話番号、メールアドレスなど"></textarea>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    購入後メッセージ
                                </label>
                                <textarea name="thanks_msg" rows="3" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="購入完了後に表示されるメッセージ"></textarea>
                            </div>
                            
                            <!-- オートリプライメール設定（日本語） -->
                            <div class="border-t pt-6 mt-6">
                                <!-- オートリプライメールを送信するチェックボックス -->
                                <div class="mb-6">
                                    <label class="flex items-center">
                                        <input type="checkbox" name="auto_reply_enabled" value="1" checked class="mr-2 w-5 h-5">
                                        <span class="font-semibold text-gray-800">オートリプライメールを送信する</span>
                                    </label>
                                </div>
                                
                                <h4 class="text-lg font-bold text-gray-800 mb-4">
                                    <i class="fas fa-robot mr-2 text-indigo-600"></i>オートリプライメール設定
                                </h4>
                                
                                <div class="mb-4">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        メールのシグニチャ
                                    </label>
                                    <textarea name="email_signature" rows="3" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                        placeholder="メール署名を入力"></textarea>
                                </div>
                                
                                <div class="space-y-4">
                                    <h5 class="font-semibold text-gray-700 mb-2">決済完了時</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード</label>
                                        <textarea name="auto_reply_credit_payment" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="クレジットカード決済完了時の自動返信メール本文"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行振込</label>
                                        <textarea name="auto_reply_bank_payment" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="銀行振込決済完了時の自動返信メール本文"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ</label>
                                        <textarea name="auto_reply_convenience_payment" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="コンビニ決済完了時の自動返信メール本文"></textarea>
                                    </div>
                                </div>
                                
                                <div class="space-y-4 mt-6">
                                    <h5 class="font-semibold text-gray-700 mb-2">取消時</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード</label>
                                        <textarea name="auto_reply_credit_cancel" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="クレジットカード取消時の自動返信メール本文"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行振込</label>
                                        <textarea name="auto_reply_bank_cancel" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="銀行振込取消時の自動返信メール本文"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ</label>
                                        <textarea name="auto_reply_convenience_cancel" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="コンビニ取消時の自動返信メール本文"></textarea>
                                    </div>
                                </div>
                                
                                <div class="space-y-4 mt-6">
                                    <h5 class="font-semibold text-gray-700 mb-2">その他自動送信メール</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード返金時</label>
                                        <textarea name="auto_reply_credit_refund" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行入金時</label>
                                        <textarea name="auto_reply_bank_deposit" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行返金時</label>
                                        <textarea name="auto_reply_bank_refund" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ入金時</label>
                                        <textarea name="auto_reply_convenience_deposit" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ返金時</label>
                                        <textarea name="auto_reply_convenience_refund" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- 英語コンテンツ -->
                        <div id="contentEnglish" class="space-y-6 hidden">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    お問合せ先（英語）
                                </label>
                                <textarea name="contact_en" rows="3" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="電話番号、メールアドレスなど"></textarea>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    購入後メッセージ（英語）
                                </label>
                                <textarea name="thanks_msg_en" rows="3" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="購入完了後に表示されるメッセージ"></textarea>
                            </div>
                            
                            <!-- オートリプライメール設定（英語） -->
                            <div class="border-t pt-6 mt-6">
                                <h4 class="text-lg font-bold text-gray-800 mb-4">
                                    <i class="fas fa-robot mr-2 text-indigo-600"></i>オートリプライメール設定（英語）
                                </h4>
                                
                                <div class="mb-4">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        メールのシグニチャ（英語）
                                    </label>
                                    <textarea name="email_signature_en" rows="3" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                        placeholder="メール署名を入力"></textarea>
                                </div>
                                
                                <div class="space-y-4">
                                    <h5 class="font-semibold text-gray-700 mb-2">決済完了時（英語）</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード（英語）</label>
                                        <textarea name="auto_reply_credit_payment_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Credit card payment completion auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行振込（英語）</label>
                                        <textarea name="auto_reply_bank_payment_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Bank transfer payment completion auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ（英語）</label>
                                        <textarea name="auto_reply_convenience_payment_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Convenience store payment completion auto-reply email"></textarea>
                                    </div>
                                </div>
                                
                                <div class="space-y-4 mt-6">
                                    <h5 class="font-semibold text-gray-700 mb-2">取消時（英語）</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード（英語）</label>
                                        <textarea name="auto_reply_credit_cancel_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Credit card cancellation auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行振込（英語）</label>
                                        <textarea name="auto_reply_bank_cancel_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Bank transfer cancellation auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ（英語）</label>
                                        <textarea name="auto_reply_convenience_cancel_en" rows="3" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Convenience store cancellation auto-reply email"></textarea>
                                    </div>
                                </div>
                                
                                <div class="space-y-4 mt-6">
                                    <h5 class="font-semibold text-gray-700 mb-2">その他自動送信メール（英語）</h5>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">クレジットカード返金時（英語）</label>
                                        <textarea name="auto_reply_credit_refund_en" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Credit card refund auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行入金時（英語）</label>
                                        <textarea name="auto_reply_bank_deposit_en" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Bank deposit confirmation auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">銀行返金時（英語）</label>
                                        <textarea name="auto_reply_bank_refund_en" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Bank refund auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ入金時（英語）</label>
                                        <textarea name="auto_reply_convenience_deposit_en" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Convenience store deposit confirmation auto-reply email"></textarea>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">コンビニ返金時（英語）</label>
                                        <textarea name="auto_reply_convenience_refund_en" rows="2" 
                                            class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm"
                                            placeholder="Convenience store refund auto-reply email"></textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 備考 -->
                    <div class="border-t pt-6 mt-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                備考
                            </label>
                            <textarea name="remarks" rows="2" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"></textarea>
                        </div>
                    </div>
                    
                    
                    <div class="flex gap-4 pt-6">
                        <button type="submit" 
                            class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                            <i class="fas fa-save mr-2"></i>登録する
                        </button>
                        <a href="/admin/events" 
                            class="bg-gray-300 text-gray-700 px-8 py-3 rounded-lg hover:bg-gray-400 transition font-semibold">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // イベントIDを取得（編集モードの場合）
            // URLパターン: /admin/events/7/edit または /admin/events/new
            const pathParts = window.location.pathname.split('/');
            console.log('URL pathParts:', pathParts);
            // pathParts = ["", "admin", "events", "7", "edit"] または ["", "admin", "events", "new"]
            const eventId = (pathParts.length === 5 && pathParts[4] === 'edit') ? pathParts[3] : null;
            const isEditMode = !!eventId;
            console.log('Event ID:', eventId, 'Edit Mode:', isEditMode);
            
            // ページ読み込み時の初期化
            document.addEventListener('DOMContentLoaded', async function() {
                console.log('=== Event Form Initialization START ===');
                console.log('Edit Mode:', isEditMode, 'Event ID:', eventId);
                
                try {
                    // 主催者一覧を取得
                    const organizersRes = await axios.get('/api/v1/organizers?per_page=1000');
                    const organizers = organizersRes.data.data;
                    const organizerSelect = document.getElementById('organizerId');
                    organizers.forEach(org => {
                        const option = document.createElement('option');
                        option.value = org.id;
                        option.textContent = org.name;
                        organizerSelect.appendChild(option);
                    });
                    
                    // クライアント企業一覧を取得
                    const clientsRes = await axios.get('/api/v1/clients?per_page=1000');
                    const clients = clientsRes.data.data;
                    const clientSelect = document.getElementById('customerClientId');
                    clients.forEach(client => {
                        const option = document.createElement('option');
                        option.value = client.id;
                        option.textContent = client.name;
                        clientSelect.appendChild(option);
                    });
                    
                    // 販売会社一覧を取得
                    const vendorsRes = await axios.get('/api/v1/vendors?per_page=1000');
                    const vendors = vendorsRes.data.data;
                    const vendorSelect = document.getElementById('vendorId');
                    vendors.forEach(vendor => {
                        const option = document.createElement('option');
                        option.value = vendor.id;
                        option.textContent = vendor.name;
                        vendorSelect.appendChild(option);
                    });
                    
                    // 支店一覧を取得
                    const branchesRes = await axios.get('/api/branches?per_page=1000');
                    const branches = branchesRes.data.data;
                    const branchSelect = document.getElementById('branchCode');
                    branches.forEach(branch => {
                        const option = document.createElement('option');
                        option.value = branch.branch_code;
                        option.textContent = branch.branch_full_name;
                        branchSelect.appendChild(option);
                    });
                    
                    // カテゴリ一覧を取得してセレクタに追加
                    console.log('Loading categories...');
                    const categoriesRes = await axios.get('/api/v1/categories?per_page=1000');
                    const categories = categoriesRes.data.data;
                    console.log('Categories loaded:', categories);
                    
                    const categorySelector = document.getElementById('categorySelector');
                    categories.forEach(cat => {
                        const option = document.createElement('option');
                        option.value = cat.id;
                        option.textContent = cat.name;
                        categorySelector.appendChild(option);
                    });
                    
                    // カテゴリ選択機能の初期化
                    const selectedCategoryIds = [];
                    const selectedCategoryNames = [];
                    const selectedCategoriesDiv = document.getElementById('selectedCategories');
                    const categoryDataInput = document.getElementById('categoryData');
                    
                    categorySelector.addEventListener('change', function() {
                        const selectedId = parseInt(this.value);
                        if (!selectedId) return;
                        
                        if (selectedCategoryIds.includes(selectedId)) {
                            this.value = '';
                            return;
                        }
                        
                        const selectedCategory = categories.find(c => c.id === selectedId);
                        selectedCategoryIds.push(selectedId);
                        selectedCategoryNames.push(selectedCategory.name);
                        
                        const tag = document.createElement('span');
                        tag.className = 'inline-flex items-center gap-2 px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium';
                        tag.innerHTML = \`
                            <span>\${selectedCategory.name}</span>
                            <button type="button" class="hover:bg-purple-200 rounded-full p-1" onclick="removeCategory(\${selectedId})">
                                <i class="fas fa-times text-xs"></i>
                            </button>
                        \`;
                        selectedCategoriesDiv.appendChild(tag);
                        // カテゴリ名の配列をJSON文字列として保存
                        categoryDataInput.value = JSON.stringify(selectedCategoryNames);
                        this.value = '';
                    });
                    
                    window.removeCategory = function(categoryId) {
                        const index = selectedCategoryIds.indexOf(categoryId);
                        if (index > -1) {
                            selectedCategoryIds.splice(index, 1);
                            selectedCategoryNames.splice(index, 1);
                            // カテゴリ名の配列をJSON文字列として保存
                            categoryDataInput.value = JSON.stringify(selectedCategoryNames);
                            
                            selectedCategoriesDiv.innerHTML = '';
                            selectedCategoryIds.forEach((id, idx) => {
                                const cat = categories.find(c => c.id === id);
                                const tag = document.createElement('span');
                                tag.className = 'inline-flex items-center gap-2 px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium';
                                tag.innerHTML = \`
                                    <span>\${cat.name}</span>
                                    <button type="button" class="hover:bg-purple-200 rounded-full p-1" onclick="removeCategory(\${id})">
                                        <i class="fas fa-times text-xs"></i>
                                    </button>
                                \`;
                                selectedCategoriesDiv.appendChild(tag);
                            });
                        }
                    };
                    
                    // 親イベント一覧を取得
                    console.log('Loading parent events...');
                    const parentEventsRes = await axios.get('/api/events/parents/list');
                    const parentEvents = parentEventsRes.data.parents;
                    console.log('Parent events loaded:', parentEvents);
                    
                    const parentEventSelector = document.getElementById('parentEventSelector');
                    parentEvents.forEach(event => {
                        const option = document.createElement('option');
                        option.value = event.id;
                        option.textContent = event.name;
                        parentEventSelector.appendChild(option);
                    });
                    
                    // イベントタイプによる表示切り替え
                    window.toggleParentEventSelector = function() {
                        const eventType = document.getElementById('eventTypeSelector').value;
                        const parentContainer = document.getElementById('parentEventSelectorContainer');
                        const parentSelector = document.getElementById('parentEventSelector');
                        
                        if (eventType === 'child') {
                            parentContainer.style.display = 'block';
                            parentSelector.required = true;
                        } else {
                            parentContainer.style.display = 'none';
                            parentSelector.required = false;
                            parentSelector.value = '';
                        }
                    };
                    
                    // 編集モードの場合、既存データを取得してフォームに設定
                    if (isEditMode && eventId) {
                        console.log('Loading event data for ID:', eventId);
                        const eventRes = await axios.get('/api/events/' + eventId);
                        const eventData = eventRes.data.event; // レスポンス構造に合わせて修正
                        console.log('Event data loaded:', eventData);
                        
                        // フォームに値を設定（elements を使用）
                        const form = document.getElementById('eventForm');
                        if (form && eventData) {
                            if (form.elements.name) form.elements.name.value = eventData.name || '';
                            if (form.elements.name_en) form.elements.name_en.value = eventData.name_en || '';
                            if (form.elements.detail) form.elements.detail.value = eventData.detail || '';
                            if (form.elements.detail_en) form.elements.detail_en.value = eventData.detail_en || '';
                            if (form.elements.location) form.elements.location.value = eventData.location || '';
                            if (form.elements.location_en) form.elements.location_en.value = eventData.location_en || '';
                            if (form.elements.contact) form.elements.contact.value = eventData.contact || '';
                            if (form.elements.contact_en) form.elements.contact_en.value = eventData.contact_en || '';
                            if (form.elements.remarks) form.elements.remarks.value = eventData.remarks || '';
                            if (form.elements.remarks_en) form.elements.remarks_en.value = eventData.remarks_en || '';
                            if (form.elements.thanks_msg) form.elements.thanks_msg.value = eventData.thanks_msg || '';
                            if (form.elements.thanks_msg_en) form.elements.thanks_msg_en.value = eventData.thanks_msg_en || '';
                            
                            // 紐付け（getElementById を使用）
                            if (eventData.organizer_id) {
                                const organizerSelect = document.getElementById('organizerId');
                                if (organizerSelect) organizerSelect.value = eventData.organizer_id;
                            }
                            if (eventData.customer_client_id) {
                                const clientSelect = document.getElementById('customerClientId');
                                if (clientSelect) clientSelect.value = eventData.customer_client_id;
                            }
                            if (eventData.vendor_id) {
                                const vendorSelect = document.getElementById('vendorId');
                                if (vendorSelect) vendorSelect.value = eventData.vendor_id;
                            }
                            if (eventData.branch_code) {
                                const branchSelect = document.getElementById('branchCode');
                                if (branchSelect) branchSelect.value = eventData.branch_code;
                            }
                            
                            // URL
                            if (form.elements.event_url) form.elements.event_url.value = eventData.event_url || '';
                            
                            // カテゴリ（既存データから復元）
                            if (eventData.category) {
                                try {
                                    // category が "[5]" のような文字列、または "スポーツ" のような名前配列の場合に対応
                                    let categoryData = JSON.parse(eventData.category);
                                    if (Array.isArray(categoryData)) {
                                        categoryData.forEach(item => {
                                            // item が数値（ID）の場合
                                            if (typeof item === 'number') {
                                                const cat = categories.find(c => c.id === item);
                                                if (cat) {
                                                    selectedCategoryIds.push(cat.id);
                                                    selectedCategoryNames.push(cat.name);
                                                    
                                                    const tag = document.createElement('span');
                                                    tag.className = 'inline-flex items-center gap-2 px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium';
                                                    tag.innerHTML = \`
                                                        <span>\${cat.name}</span>
                                                        <button type="button" class="hover:bg-purple-200 rounded-full p-1" onclick="removeCategory(\${cat.id})">
                                                            <i class="fas fa-times text-xs"></i>
                                                        </button>
                                                    \`;
                                                    selectedCategoriesDiv.appendChild(tag);
                                                }
                                            } 
                                            // item が文字列（名前）の場合
                                            else if (typeof item === 'string') {
                                                const cat = categories.find(c => c.name === item);
                                                if (cat) {
                                                    selectedCategoryIds.push(cat.id);
                                                    selectedCategoryNames.push(cat.name);
                                                    
                                                    const tag = document.createElement('span');
                                                    tag.className = 'inline-flex items-center gap-2 px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-sm font-medium';
                                                    tag.innerHTML = \`
                                                        <span>\${cat.name}</span>
                                                        <button type="button" class="hover:bg-purple-200 rounded-full p-1" onclick="removeCategory(\${cat.id})">
                                                            <i class="fas fa-times text-xs"></i>
                                                        </button>
                                                    \`;
                                                    selectedCategoriesDiv.appendChild(tag);
                                                }
                                            }
                                        });
                                        // カテゴリ名の配列を隠しフィールドにセット
                                        categoryDataInput.value = JSON.stringify(selectedCategoryNames);
                                    }
                                } catch (e) {
                                    console.error('Failed to parse category data:', e);
                                }
                            }
                            
                            // 日付選択タイプ
                            if (eventData.date_selection_type && form.elements.date_selection_type) {
                                const radios = form.elements.date_selection_type;
                                for (let i = 0; i < radios.length; i++) {
                                    if (radios[i].value === eventData.date_selection_type) {
                                        radios[i].checked = true;
                                    }
                                }
                            }
                            
                            // 日程
                            if (eventData.event_start_date && form.elements.event_start_date) form.elements.event_start_date.value = eventData.event_start_date;
                            if (eventData.event_end_date && form.elements.event_end_date) form.elements.event_end_date.value = eventData.event_end_date;
                            if (eventData.registration_start_date && form.elements.registration_start_date) form.elements.registration_start_date.value = eventData.registration_start_date;
                            if (eventData.registration_end_date && form.elements.registration_end_date) form.elements.registration_end_date.value = eventData.registration_end_date;
                            if (eventData.admin_login_start_date && form.elements.admin_login_start_date) form.elements.admin_login_start_date.value = eventData.admin_login_start_date;
                            if (eventData.admin_login_end_date && form.elements.admin_login_end_date) form.elements.admin_login_end_date.value = eventData.admin_login_end_date;
                            
                            // メール設定
                            if (form.elements.admin_email) form.elements.admin_email.value = eventData.admin_email || '';
                            if (form.elements.admin_cc_email) form.elements.admin_cc_email.value = eventData.admin_cc_email || '';
                            if (form.elements.sender_name) form.elements.sender_name.value = eventData.sender_name || '';
                            if (form.elements.sender_email) form.elements.sender_email.value = eventData.sender_email || '';
                            if (form.elements.email_signature) form.elements.email_signature.value = eventData.email_signature || '';
                            if (form.elements.email_signature_en) form.elements.email_signature_en.value = eventData.email_signature_en || '';
                            if (form.elements.contact_info) form.elements.contact_info.value = eventData.contact_info || '';
                            if (form.elements.contact_info_en) form.elements.contact_info_en.value = eventData.contact_info_en || '';
                            
                            // 決済設定（payment_methodsはビットフラグ）
                            if (eventData.payment_methods !== undefined && form.elements.payment_method) {
                                const paymentValue = parseInt(eventData.payment_methods);
                                const checkboxes = form.elements.payment_method;
                                for (let i = 0; i < checkboxes.length; i++) {
                                    const checkboxValue = parseInt(checkboxes[i].value);
                                    checkboxes[i].checked = (paymentValue & checkboxValue) !== 0;
                                }
                            }
                            
                            // 銀行情報
                            if (form.elements.store_code) form.elements.store_code.value = eventData.store_code || '';
                            if (document.getElementById('bankName')) document.getElementById('bankName').value = eventData.bank_name || '';
                            if (document.getElementById('bankBranch')) document.getElementById('bankBranch').value = eventData.bank_branch || '';
                            if (eventData.bank_account_type && document.getElementById('bankAccountType')) document.getElementById('bankAccountType').value = eventData.bank_account_type;
                            if (document.getElementById('bankAccountNumber')) document.getElementById('bankAccountNumber').value = eventData.bank_account_number || '';
                            if (document.getElementById('bankAccountName')) document.getElementById('bankAccountName').value = eventData.bank_account_name || '';
                            
                            // 有効フラグ
                            if (eventData.enable_flg !== undefined && form.elements.enable_flg) {
                                form.elements.enable_flg.checked = eventData.enable_flg === 1;
                            }
                            
                            // イベントタイプと親イベントID
                            if (eventData.event_type && form.elements.event_type) {
                                form.elements.event_type.value = eventData.event_type || 'standalone';
                                // 表示切り替え
                                toggleParentEventSelector();
                            }
                            if (eventData.parent_event_id && form.elements.parent_event_id) {
                                form.elements.parent_event_id.value = eventData.parent_event_id;
                            }
                            
                            // 手数料設定（クレジットカード）
                            if (eventData.credit_fee_type && form.elements.credit_fee_type) {
                                form.elements.credit_fee_type.value = eventData.credit_fee_type;
                            }
                            if (eventData.credit_fee_percentage !== undefined && form.elements.credit_fee_percentage) {
                                form.elements.credit_fee_percentage.value = eventData.credit_fee_percentage;
                            }
                            if (eventData.credit_fee_fixed !== undefined && form.elements.credit_fee_fixed) {
                                form.elements.credit_fee_fixed.value = eventData.credit_fee_fixed;
                            }
                            
                            // 手数料設定（銀行振込）
                            if (eventData.bank_fee_type && form.elements.bank_fee_type) {
                                form.elements.bank_fee_type.value = eventData.bank_fee_type;
                            }
                            if (eventData.bank_fee_percentage !== undefined && form.elements.bank_fee_percentage) {
                                form.elements.bank_fee_percentage.value = eventData.bank_fee_percentage;
                            }
                            if (eventData.bank_fee_fixed !== undefined && form.elements.bank_fee_fixed) {
                                form.elements.bank_fee_fixed.value = eventData.bank_fee_fixed;
                            }
                            
                            // 手数料設定（コンビニ決済）
                            if (eventData.convenience_fee_type && form.elements.convenience_fee_type) {
                                form.elements.convenience_fee_type.value = eventData.convenience_fee_type;
                            }
                            if (eventData.convenience_fee_percentage !== undefined && form.elements.convenience_fee_percentage) {
                                form.elements.convenience_fee_percentage.value = eventData.convenience_fee_percentage;
                            }
                            if (eventData.convenience_fee_fixed !== undefined && form.elements.convenience_fee_fixed) {
                                form.elements.convenience_fee_fixed.value = eventData.convenience_fee_fixed;
                            }
                            
                            // コンビニ店舗（JSON配列から復元）
                            if (eventData.available_convenience_stores) {
                                try {
                                    console.log('Restoring convenience stores:', eventData.available_convenience_stores);
                                    const stores = JSON.parse(eventData.available_convenience_stores);
                                    console.log('Parsed stores:', stores);
                                    if (Array.isArray(stores)) {
                                        const checkboxes = document.querySelectorAll('input[name="convenience_store"]');
                                        console.log('Found checkboxes:', checkboxes.length);
                                        checkboxes.forEach(checkbox => {
                                            const isChecked = stores.includes(checkbox.value);
                                            console.log('Checkbox ' + checkbox.value + ': ' + isChecked);
                                            checkbox.checked = isChecked;
                                        });
                                        // 復元後の状態を確認
                                        setTimeout(() => {
                                            const verifyCheckboxes = document.querySelectorAll('input[name="convenience_store"]:checked');
                                            console.log('Verified checked convenience stores after restoration:', verifyCheckboxes.length);
                                            verifyCheckboxes.forEach(cb => console.log(' - Checked:', cb.value));
                                        }, 100);
                                    }
                                } catch (e) {
                                    console.error('Failed to parse convenience stores:', e);
                                }
                            } else {
                                console.log('No convenience stores data found');
                            }
                            
                            // オートリプライ有効フラグ
                            if (eventData.auto_reply_enabled !== undefined && form.elements.auto_reply_enabled) {
                                form.elements.auto_reply_enabled.checked = eventData.auto_reply_enabled === 1;
                            }
                            
                            // オートリプライ設定（日本語）
                            if (form.elements.auto_reply_credit_payment) form.elements.auto_reply_credit_payment.value = eventData.auto_reply_credit_payment || '';
                            if (form.elements.auto_reply_bank_payment) form.elements.auto_reply_bank_payment.value = eventData.auto_reply_bank_payment || '';
                            if (form.elements.auto_reply_convenience_payment) form.elements.auto_reply_convenience_payment.value = eventData.auto_reply_convenience_payment || '';
                            if (form.elements.auto_reply_credit_cancel) form.elements.auto_reply_credit_cancel.value = eventData.auto_reply_credit_cancel || '';
                            if (form.elements.auto_reply_bank_cancel) form.elements.auto_reply_bank_cancel.value = eventData.auto_reply_bank_cancel || '';
                            if (form.elements.auto_reply_convenience_cancel) form.elements.auto_reply_convenience_cancel.value = eventData.auto_reply_convenience_cancel || '';
                            if (form.elements.auto_reply_credit_refund) form.elements.auto_reply_credit_refund.value = eventData.auto_reply_credit_refund || '';
                            if (form.elements.auto_reply_bank_deposit) form.elements.auto_reply_bank_deposit.value = eventData.auto_reply_bank_deposit || '';
                            if (form.elements.auto_reply_bank_refund) form.elements.auto_reply_bank_refund.value = eventData.auto_reply_bank_refund || '';
                            if (form.elements.auto_reply_convenience_deposit) form.elements.auto_reply_convenience_deposit.value = eventData.auto_reply_convenience_deposit || '';
                            if (form.elements.auto_reply_convenience_refund) form.elements.auto_reply_convenience_refund.value = eventData.auto_reply_convenience_refund || '';
                            
                            // オートリプライ設定（英語）
                            if (form.elements.auto_reply_credit_payment_en) form.elements.auto_reply_credit_payment_en.value = eventData.auto_reply_credit_payment_en || '';
                            if (form.elements.auto_reply_bank_payment_en) form.elements.auto_reply_bank_payment_en.value = eventData.auto_reply_bank_payment_en || '';
                            if (form.elements.auto_reply_convenience_payment_en) form.elements.auto_reply_convenience_payment_en.value = eventData.auto_reply_convenience_payment_en || '';
                            if (form.elements.auto_reply_credit_cancel_en) form.elements.auto_reply_credit_cancel_en.value = eventData.auto_reply_credit_cancel_en || '';
                            if (form.elements.auto_reply_bank_cancel_en) form.elements.auto_reply_bank_cancel_en.value = eventData.auto_reply_bank_cancel_en || '';
                            if (form.elements.auto_reply_convenience_cancel_en) form.elements.auto_reply_convenience_cancel_en.value = eventData.auto_reply_convenience_cancel_en || '';
                            if (form.elements.auto_reply_credit_refund_en) form.elements.auto_reply_credit_refund_en.value = eventData.auto_reply_credit_refund_en || '';
                            if (form.elements.auto_reply_bank_deposit_en) form.elements.auto_reply_bank_deposit_en.value = eventData.auto_reply_bank_deposit_en || '';
                            if (form.elements.auto_reply_bank_refund_en) form.elements.auto_reply_bank_refund_en.value = eventData.auto_reply_bank_refund_en || '';
                            if (form.elements.auto_reply_convenience_deposit_en) form.elements.auto_reply_convenience_deposit_en.value = eventData.auto_reply_convenience_deposit_en || '';
                            if (form.elements.auto_reply_convenience_refund_en) form.elements.auto_reply_convenience_refund_en.value = eventData.auto_reply_convenience_refund_en || '';
                            
                            console.log('Form values set successfully');
                        }
                    }
                    
                    // 銀行振込チェックボックスの変更を監視
                    const bankTransferCheckbox = document.getElementById('bankTransferCheckbox');
                    const bankInfoSection = document.getElementById('bankInfoSection');
                    const bankFields = ['bankName', 'bankBranch', 'bankAccountType', 'bankAccountNumber', 'bankAccountName'];
                    
                    bankTransferCheckbox.addEventListener('change', function() {
                        if (this.checked) {
                            bankInfoSection.classList.remove('hidden');
                            bankFields.forEach(id => {
                                document.getElementById(id).required = true;
                            });
                        } else {
                            bankInfoSection.classList.add('hidden');
                            bankFields.forEach(id => {
                                document.getElementById(id).required = false;
                            });
                        }
                    });
                    
                    // フォームサブミット処理
                    document.getElementById('eventForm').addEventListener('submit', async (e) => {
                        e.preventDefault();
                        
                        const paymentMethods = Array.from(document.querySelectorAll('input[name="payment_method"]:checked'))
                            .map(cb => parseInt(cb.value))
                            .reduce((sum, val) => sum + val, 0);
                        
                        if (paymentMethods === 0) {
                            alert('支払方法を少なくとも1つ選択してください');
                            return;
                        }
                        
                        // コンビニ店舗を配列として取得
                        const convenienceStores = Array.from(document.querySelectorAll('input[name="convenience_store"]:checked'))
                            .map(cb => cb.value);
                        console.log('Selected convenience stores:', convenienceStores);
                        
                        const formData = new FormData(e.target);
                        const data = Object.fromEntries(formData.entries());
                        
                        if (!data.event_url || !data.event_start_date || !data.event_end_date || !data.registration_start_date || !data.registration_end_date) {
                            alert('イベントURL、開催期間、受付期間は必須です');
                            return;
                        }
                        
                        data.payment_methods = paymentMethods;
                        data.convenience_stores = convenienceStores; // コンビニ店舗配列を追加
                        
                        const formFieldSettings = {
                            name_kanji: document.querySelector('input[name="form_field_name_kanji"]').checked,
                            name_kana: document.querySelector('input[name="form_field_name_kana"]').checked,
                            name_roma: document.querySelector('input[name="form_field_name_roma"]').checked,
                            address: document.querySelector('input[name="form_field_address"]').checked,
                            tel: document.querySelector('input[name="form_field_tel"]').checked,
                            birth_date: document.querySelector('input[name="form_field_birth_date"]').checked,
                            age: document.querySelector('input[name="form_field_age"]').checked
                        };
                        data.form_field_settings = JSON.stringify(formFieldSettings);
                        
                        if (!(paymentMethods & 2)) {
                            delete data.bank_name;
                            delete data.bank_branch;
                            delete data.bank_account_type;
                            delete data.bank_account_number;
                            delete data.bank_account_name;
                        }
                        
                        try {
                            const response = eventId
                                ? await axios.put('/api/events/' + eventId, data)
                                : await axios.post('/api/events', data);
                            alert(eventId ? 'イベントを更新しました！' : 'イベントを登録しました！');
                            window.location.href = '/admin/events';
                        } catch (error) {
                            console.error('Error:', error);
                            alert('登録に失敗しました: ' + (error.response?.data?.error || error.message));
                        }
                    });
                    
                } catch (error) {
                    console.error('Error loading data:', error);
                    alert('データの読み込みに失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });

            
            // 言語タブの切り替え
            // 基本情報タブの切り替え（イベント名・詳細）
            function switchBasicLanguageTab(lang) {
                const tabJapanese = document.getElementById('tabBasicJapanese');
                const tabEnglish = document.getElementById('tabBasicEnglish');
                const contentJapanese = document.getElementById('contentBasicJapanese');
                const contentEnglish = document.getElementById('contentBasicEnglish');
                
                if (lang === 'ja') {
                    tabJapanese.classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabJapanese.classList.remove('text-gray-500', 'hover:text-gray-700');
                    tabEnglish.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabEnglish.classList.add('text-gray-500', 'hover:text-gray-700');
                    
                    contentJapanese.style.display = 'block';
                    contentEnglish.style.display = 'none';
                } else if (lang === 'en') {
                    tabEnglish.classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabEnglish.classList.remove('text-gray-500', 'hover:text-gray-700');
                    tabJapanese.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabJapanese.classList.add('text-gray-500', 'hover:text-gray-700');
                    
                    contentEnglish.style.display = 'block';
                    contentJapanese.style.display = 'none';
                }
            }
            
            // オートリプライ設定タブの切り替え
            function switchLanguageTab(lang) {
                const tabJapanese = document.getElementById('tabJapanese');
                const tabEnglish = document.getElementById('tabEnglish');
                const contentJapanese = document.getElementById('contentJapanese');
                const contentEnglish = document.getElementById('contentEnglish');
                
                if (lang === 'ja') {
                    // 日本語タブをアクティブに
                    tabJapanese.classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabJapanese.classList.remove('text-gray-500', 'hover:text-gray-700');
                    tabEnglish.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabEnglish.classList.add('text-gray-500', 'hover:text-gray-700');
                    
                    contentJapanese.classList.remove('hidden');
                    contentEnglish.classList.add('hidden');
                } else if (lang === 'en') {
                    // 英語タブをアクティブに
                    tabEnglish.classList.add('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabEnglish.classList.remove('text-gray-500', 'hover:text-gray-700');
                    tabJapanese.classList.remove('border-b-2', 'border-blue-600', 'text-blue-600');
                    tabJapanese.classList.add('text-gray-500', 'hover:text-gray-700');
                    
                    contentEnglish.classList.remove('hidden');
                    contentJapanese.classList.add('hidden');
                }
            }
            
        </script>
    </body>
    </html>
  `)
}


// ルート登録
app.get('/admin/events/new', handleEventForm)
app.get('/admin/events/:id/edit', handleEventForm)

app.get('/admin/events/:id/form-fields', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  // イベント情報を取得
  const event = await DB.prepare(`
    SELECT * FROM events WHERE id = ?
  `).bind(eventId).first()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>申込フォーム設定 - ${event.name} | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-orange-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-wpforms"></i>
                    申込フォーム設定
                </h1>
                <p class="text-orange-100 mt-2">${event.name}</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-plus"></i>イベント管理
                    </a></li>
                    <li><span class="text-orange-600 font-semibold">フォーム設定</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-8">
                <div class="mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-2">
                        <i class="fas fa-edit"></i> 申込情報入力欄の設定
                    </h2>
                    <p class="text-gray-600">
                        イベント申込時にユーザーが入力する項目を設定できます。<br>
                        項目の追加、削除、並び替えが可能です。
                    </p>
                </div>

                <form id="formFieldsForm" class="space-y-6">
                    <input type="hidden" id="eventId" value="${eventId}">
                    
                    <div id="formFieldsContainer" class="space-y-4">
                        <!-- フィールドが動的に追加されます -->
                    </div>

                    <div class="flex gap-4">
                        <button type="button" id="addFieldBtn" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg flex items-center gap-2">
                            <i class="fas fa-plus-circle"></i>
                            フィールドを追加
                        </button>
                    </div>

                    <div class="flex gap-4 pt-6 border-t">
                        <button type="submit" class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-3 px-8 rounded-lg flex items-center gap-2">
                            <i class="fas fa-save"></i>
                            保存
                        </button>
                        <a href="/admin/events" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-8 rounded-lg flex items-center gap-2">
                            <i class="fas fa-times"></i>
                            キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script src="/static/form-fields-manager.js"></script>
    </body>
    </html>
  `)
})

// 管理画面 - 商品新規登録フォーム
// 商品新規登録・編集画面（統合版）
const handleProductForm = async (c: any) => {
  const productId = c.req.param('id')
  const isEditMode = !!productId
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${isEditMode ? '商品編集' : '新規商品登録'} | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-green-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-box"></i>
                    ${isEditMode ? '商品編集' : '新規商品登録'}
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/products" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-box"></i>商品管理
                    </a></li>
                    <li><span class="text-green-600 font-semibold">新規登録</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-8">
                <form id="productForm" class="space-y-6" enctype="multipart/form-data">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                商品名 <span class="text-red-600">*</span>
                            </label>
                            <input type="text" name="name" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="例：マス席（6名）">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                イベント <span class="text-red-600">*</span>
                            </label>
                            <select name="event_id" id="eventId" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="">選択してください</option>
                            </select>
                        </div>
                    </div>
                    
                    <!-- 商品画像 -->
                    <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
                        <div class="flex items-center mb-4">
                            <label class="block text-lg font-semibold text-gray-800">
                                <i class="fas fa-image mr-2 text-purple-600"></i>
                                商品画像
                            </label>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    画像ファイル
                                </label>
                                <input type="file" name="image" id="imageFile" accept="image/*"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                <p class="text-xs text-gray-500 mt-1">
                                    対応形式：JPG, PNG, GIF / 最大サイズ：5MB
                                </p>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    プレビュー
                                </label>
                                <div id="imagePreview" class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center">
                                    <img id="previewImg" src="" alt="画像プレビュー" 
                                        class="max-w-full max-h-48 mx-auto hidden">
                                    <p id="noImageText" class="text-gray-400">
                                        <i class="fas fa-image text-4xl mb-2"></i><br>
                                        画像未選択
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 価格帯設定（複数登録可能） -->
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
                        <div class="flex items-center mb-4">
                            <label class="block text-lg font-semibold text-gray-800">
                                <i class="fas fa-tags mr-2 text-blue-600"></i>
                                価格帯設定（複数登録可能）
                            </label>
                        </div>
                        <p class="text-sm text-gray-600 mb-4">
                            <strong>ステップ1:</strong> まず共通の名称（大人、子供など）を設定<br>
                            <strong>ステップ2:</strong> 各価格帯（A, B, C...）で価格のみを入力<br>
                            例：名称（大人、子供）→ 価格帯A（10,000円、7,000円）、価格帯B（15,000円、10,000円）
                        </p>
                        
                        <!-- 共通名称設定 -->
                        <div class="bg-white border-2 border-green-300 rounded-lg p-5 mb-6">
                            <h3 class="text-md font-bold text-gray-800 mb-3">
                                <i class="fas fa-users text-green-600 mr-2"></i>
                                共通名称設定（全価格帯共通）
                            </h3>
                            <p class="text-xs text-gray-600 mb-3">
                                すべての価格帯で使用する名称を設定してください。最大5つまで登録できます。
                            </p>
                            
                            <!-- 単位・料金単位・料金説明 -->
                            <div class="grid md:grid-cols-3 gap-4 mb-4 pb-4 border-b border-gray-200">
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">
                                        <i class="fas fa-tag text-blue-600 mr-1"></i>
                                        単位 <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" name="price_unit" required placeholder="例：人、名、台、部屋" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                                    <p class="text-xs text-gray-500 mt-1">数量の単位を入力</p>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">
                                        <i class="fas fa-calculator text-blue-600 mr-1"></i>
                                        料金単位 <span class="text-red-500">*</span>
                                    </label>
                                    <select name="charge_type" required 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                                        <option value="">選択してください</option>
                                        <option value="per_person">1名料金</option>
                                        <option value="group">グループ料金</option>
                                    </select>
                                    <p class="text-xs text-gray-500 mt-1">料金の計算方式を選択</p>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-gray-700 mb-2">
                                        <i class="fas fa-info-circle text-blue-600 mr-1"></i>
                                        料金説明
                                    </label>
                                    <input type="text" name="charge_description" placeholder="例：1名あたりの料金です" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm">
                                    <p class="text-xs text-gray-500 mt-1">料金の説明を入力（任意）</p>
                                </div>
                            </div>
                            
                            <div class="space-y-2">
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <div class="col-span-1"><span class="text-xs font-bold">名称1</span></div>
                                    <div class="col-span-5">
                                        <input type="text" name="common_name_1" required placeholder="大人" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                    <div class="col-span-6">
                                        <input type="text" name="common_desc_1" placeholder="補足説明（例：18歳以上）" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <div class="col-span-1"><span class="text-xs font-bold">名称2</span></div>
                                    <div class="col-span-5">
                                        <input type="text" name="common_name_2" placeholder="子供" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                    <div class="col-span-6">
                                        <input type="text" name="common_desc_2" placeholder="補足説明（例：小中学生）" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <div class="col-span-1"><span class="text-xs font-bold">名称3</span></div>
                                    <div class="col-span-5">
                                        <input type="text" name="common_name_3" placeholder="幼児" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                    <div class="col-span-6">
                                        <input type="text" name="common_desc_3" placeholder="補足説明（例：3歳未満）" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <div class="col-span-1"><span class="text-xs font-bold">名称4</span></div>
                                    <div class="col-span-5">
                                        <input type="text" name="common_name_4" placeholder="シニア" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                    <div class="col-span-6">
                                        <input type="text" name="common_desc_4" placeholder="補足説明（例：60歳以上）" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                </div>
                                <div class="grid grid-cols-12 gap-2 items-center">
                                    <div class="col-span-1"><span class="text-xs font-bold">名称5</span></div>
                                    <div class="col-span-5">
                                        <input type="text" name="common_name_5" placeholder="80歳以上" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                    <div class="col-span-6">
                                        <input type="text" name="common_desc_5" placeholder="補足説明（例：シルバー）" class="w-full px-3 py-2 border rounded text-sm">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- 価格帯グループ -->
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="text-md font-bold text-gray-800">
                                <i class="fas fa-yen-sign text-blue-600 mr-2"></i>
                                価格帯別の価格設定
                            </h3>
                            <button type="button" id="addPriceBandButton" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition text-sm">
                                <i class="fas fa-plus mr-1"></i>価格帯を追加
                            </button>
                        </div>
                        
                        <!-- 価格帯グループコンテナ -->
                        <div id="priceBandsContainer" class="space-y-6">
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                申込上限数
                            </label>
                            <input type="number" name="purchase_limit" min="1" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="10">
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                販売開始日時 <span class="text-red-600">*</span>
                            </label>
                            <input type="datetime-local" name="sales_start" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                販売終了日時 <span class="text-red-600">*</span>
                            </label>
                            <input type="datetime-local" name="sales_end" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            締切日（何日前）
                        </label>
                        <input type="number" name="closing_trade" value="0" min="0" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            placeholder="0">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            商品説明
                        </label>
                        <textarea name="description" rows="4" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            placeholder="商品の詳細説明"></textarea>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                料金に含まれるもの
                            </label>
                            <textarea name="fee_include" rows="2" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="例：座席チケット、パンフレット"></textarea>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                料金に含まれないもの
                            </label>
                            <textarea name="fee_exclude" rows="2" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="例：飲食代、駐車場代"></textarea>
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            キャンセルポリシー
                        </label>
                        <textarea name="cancel_policy" rows="3" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            placeholder="キャンセル規定を入力"></textarea>
                    </div>
                    
                    <!-- 取消条件（営業日数と取消料率） -->
                    <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-4">
                            <i class="fas fa-percent mr-2 text-amber-600"></i>取消条件設定
                        </h3>
                        <p class="text-sm text-gray-600 mb-4">
                            営業日数（何日前まで）と取消料率（％）を設定してください。最大5件まで登録できます。
                        </p>
                        
                        <div class="space-y-3">
                            <div class="grid grid-cols-12 gap-3 items-center">
                                <div class="col-span-1 text-center">
                                    <span class="font-bold text-gray-700">1</span>
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">営業日数（日前）</label>
                                    <input type="number" name="cancellation_days_1" min="0" placeholder="例：7" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">取消料率（％）</label>
                                    <input type="number" name="cancellation_rate_1" min="0" max="100" placeholder="例：20" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-12 gap-3 items-center">
                                <div class="col-span-1 text-center">
                                    <span class="font-bold text-gray-700">2</span>
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">営業日数（日前）</label>
                                    <input type="number" name="cancellation_days_2" min="0" placeholder="例：5" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">取消料率（％）</label>
                                    <input type="number" name="cancellation_rate_2" min="0" max="100" placeholder="例：30" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-12 gap-3 items-center">
                                <div class="col-span-1 text-center">
                                    <span class="font-bold text-gray-700">3</span>
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">営業日数（日前）</label>
                                    <input type="number" name="cancellation_days_3" min="0" placeholder="例：3" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">取消料率（％）</label>
                                    <input type="number" name="cancellation_rate_3" min="0" max="100" placeholder="例：50" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-12 gap-3 items-center">
                                <div class="col-span-1 text-center">
                                    <span class="font-bold text-gray-700">4</span>
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">営業日数（日前）</label>
                                    <input type="number" name="cancellation_days_4" min="0" placeholder="例：1" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">取消料率（％）</label>
                                    <input type="number" name="cancellation_rate_4" min="0" max="100" placeholder="例：80" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                            </div>
                            
                            <div class="grid grid-cols-12 gap-3 items-center">
                                <div class="col-span-1 text-center">
                                    <span class="font-bold text-gray-700">5</span>
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">営業日数（日前）</label>
                                    <input type="number" name="cancellation_days_5" min="0" placeholder="例：0（当日）" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                                <div class="col-span-5">
                                    <label class="block text-xs font-semibold text-gray-700 mb-1">取消料率（％）</label>
                                    <input type="number" name="cancellation_rate_5" min="0" max="100" placeholder="例：100" 
                                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 text-sm">
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            公開状態
                        </label>
                        <select name="enable_flg" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="1">有効</option>
                            <option value="0">無効</option>
                        </select>
                    </div>
                    
                    <div class="flex gap-4 pt-6">
                        <button type="submit" 
                            class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                            <i class="fas fa-save mr-2"></i>登録する
                        </button>
                        <a href="/admin/products" 
                            class="bg-gray-300 text-gray-700 px-8 py-3 rounded-lg hover:bg-gray-400 transition font-semibold">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // URLパターン: /admin/products/7/edit または /admin/products/new
            const pathParts = window.location.pathname.split('/');
            console.log('URL pathParts:', pathParts);
            // pathParts = ["", "admin", "products", "7", "edit"] または ["", "admin", "products", "new"]
            const productId = (pathParts.length === 5 && pathParts[4] === 'edit') ? pathParts[3] : null;
            const isEditMode = !!productId;
            console.log('Product ID:', productId, 'Edit Mode:', isEditMode);
            
            // ページ読み込み時の初期化
            document.addEventListener('DOMContentLoaded', async function() {
                console.log('=== Product Form Initialization START ===');
                console.log('Edit Mode:', isEditMode, 'Product ID:', productId);
                
                // 画像プレビュー機能
                const imageFile = document.getElementById('imageFile');
                const previewImg = document.getElementById('previewImg');
                const noImageText = document.getElementById('noImageText');
                
                if (imageFile) {
                    imageFile.addEventListener('change', function(e) {
                        const file = e.target.files[0];
                        if (file) {
                            // ファイルサイズチェック（5MB）
                            if (file.size > 5 * 1024 * 1024) {
                                alert('ファイルサイズが大きすぎます。5MB以下の画像を選択してください。');
                                imageFile.value = '';
                                return;
                            }
                            
                            // プレビュー表示
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                previewImg.src = e.target.result;
                                previewImg.classList.remove('hidden');
                                noImageText.classList.add('hidden');
                            };
                            reader.readAsDataURL(file);
                        } else {
                            previewImg.classList.add('hidden');
                            noImageText.classList.remove('hidden');
                        }
                    });
                }
                
                try {
                    // イベント一覧を取得
                    console.log('Loading events...');
                    const eventsRes = await axios.get('/api/v1/events?per_page=1000');
                    const events = eventsRes.data.data;
                    const eventSelect = document.getElementById('eventId');
                    events.forEach(event => {
                        const option = document.createElement('option');
                        option.value = event.id;
                        option.textContent = event.name;
                        eventSelect.appendChild(option);
                    });
                    console.log('Events loaded:', events.length);
                    
                    // 編集モードの場合、既存データを取得してフォームに設定
                    if (isEditMode && productId) {
                        console.log('Loading product data for ID:', productId);
                        const productRes = await axios.get('/api/products/' + productId);
                        const productData = productRes.data.product;
                        console.log('Product data loaded:', productData);
                        
                        // フォームに値を設定
                        const form = document.getElementById('productForm');
                        if (form && productData) {
                            if (form.elements.name) form.elements.name.value = productData.name || '';
                            if (form.elements.description) form.elements.description.value = productData.description || '';
                            
                            // 紐付け
                            if (productData.event_id) {
                                const eventSelect = document.getElementById('eventId');
                                if (eventSelect) eventSelect.value = productData.event_id;
                            }
                            if (productData.product_category_id && form.elements.product_category_id) {
                                form.elements.product_category_id.value = productData.product_category_id;
                            }
                            
                            // 販売期間
                            if (productData.sales_start && form.elements.sales_start) form.elements.sales_start.value = productData.sales_start;
                            if (productData.sales_end && form.elements.sales_end) form.elements.sales_end.value = productData.sales_end;
                            
                            // その他詳細
                            if (form.elements.remarks) form.elements.remarks.value = productData.remarks || '';
                            if (form.elements.fee_include) form.elements.fee_include.value = productData.fee_include || '';
                            if (form.elements.fee_exclude) form.elements.fee_exclude.value = productData.fee_exclude || '';
                            if (form.elements.cancel_policy) form.elements.cancel_policy.value = productData.cancel_policy || '';
                            if (form.elements.closing_trade) form.elements.closing_trade.value = productData.closing_trade || '';
                            if (form.elements.purchase_limit) form.elements.purchase_limit.value = productData.purchase_limit || '';
                            
                            // 有効フラグ
                            if (productData.enable_flg !== undefined && form.elements.enable_flg) {
                                form.elements.enable_flg.checked = productData.enable_flg === 1;
                            }
                            
                            // 単位・料金単位・料金説明
                            if (form.elements.price_unit) form.elements.price_unit.value = productData.price_unit || '人';
                            if (form.elements.charge_type) form.elements.charge_type.value = productData.charge_type || 'per_person';
                            if (form.elements.charge_description) form.elements.charge_description.value = productData.charge_description || '';
                            
                            // 画像プレビューの設定
                            if (productData.image_url) {
                                const preview = document.getElementById('imagePreview');
                                if (preview) {
                                    preview.src = productData.image_url;
                                    preview.classList.remove('hidden');
                                }
                            }
                            
                            // 共通名称設定の復元
                            if (productData.common_names && Array.isArray(productData.common_names)) {
                                productData.common_names.forEach((item, index) => {
                                    const i = index + 1;
                                    if (form.elements['common_name_' + i]) form.elements['common_name_' + i].value = item.name || '';
                                    if (form.elements['common_desc_' + i]) form.elements['common_desc_' + i].value = item.description || '';
                                });
                            }
                            
                            // 取消条件設定の復元
                            if (productData.cancellation_policy_details && Array.isArray(productData.cancellation_policy_details)) {
                                productData.cancellation_policy_details.forEach((item, index) => {
                                    const i = index + 1;
                                    if (form.elements['cancellation_days_' + i]) form.elements['cancellation_days_' + i].value = item.days || '';
                                    if (form.elements['cancellation_rate_' + i]) form.elements['cancellation_rate_' + i].value = item.rate || '';
                                });
                            }
                            
                            console.log('Form values set successfully');
                        }
                        
                        // 価格帯データの復元（編集モード時）
                        if (isEditMode && productData && productData.prices && productData.prices.length > 0) {
                            console.log('Restoring price bands:', productData.prices);
                            
                            // category_name から価格帯とスロットを解析（例: "A-名称1" → 価格帯A, スロット1）
                            const priceBandData = {};
                            productData.prices.forEach(priceItem => {
                                console.log('Processing price item:', priceItem);
                                const categoryName = priceItem.category_name || '';
                                console.log('category_name:', categoryName);
                                
                                // "A-名称1" のような形式をパース
                                // ハイフンで分割して処理
                                const parts = categoryName.split('-');
                                console.log('Split parts:', parts, 'length:', parts.length);
                                if (parts.length === 2) {
                                    const band = parts[0].trim(); // "A", "B", etc.
                                    const slotPart = parts[1].trim(); // "名称1"
                                    console.log('Band:', band, 'SlotPart:', slotPart, 'Length:', slotPart.length);
                                    
                                    // 末尾の数字を抽出（シンプルな方法）
                                    let slot = '';
                                    for (let i = slotPart.length - 1; i >= 0; i--) {
                                        const char = slotPart[i];
                                        if (char >= '0' && char <= '9') {
                                            slot = char + slot;
                                        } else {
                                            break;
                                        }
                                    }
                                    
                                    console.log('Extracted slot:', slot);
                                    if (slot) {
                                        console.log('Adding to priceBandData - band:', band, 'slot:', slot, 'price:', priceItem.price);
                                        
                                        if (!priceBandData[band]) {
                                            priceBandData[band] = {};
                                        }
                                        priceBandData[band][slot] = priceItem.price;
                                    } else {
                                        console.log('No slot number found in:', slotPart);
                                    }
                                } else {
                                    console.log('Invalid parts length:', parts.length);
                                }
                            });
                            
                            console.log('Parsed price band data:', priceBandData);
                            // 価格帯データをフォームに反映（後で価格帯管理の初期化後に実行）
                            window.existingPriceBandData = priceBandData;
                            console.log('Saved to window.existingPriceBandData:', window.existingPriceBandData);
                        }
                    }
                    
                    // 価格帯管理の初期化
                    let priceBandCounter = 0;
                    const priceBandsContainer = document.getElementById('priceBandsContainer');
                    const addPriceBandButton = document.getElementById('addPriceBandButton');
                    
                    // 共通名称設定を取得する関数
                    function getCommonNameLabels() {
                        const labels = [];
                        const currentForm = document.getElementById('productForm');
                        for (let i = 1; i <= 5; i++) {
                            const nameElement = currentForm ? currentForm.elements['common_name_' + i] : null;
                            const name = nameElement ? nameElement.value.trim() : '';
                            if (name) {
                                labels.push(\`名称\${i}（\${name}）\`);
                            } else {
                                labels.push(\`名称\${i}\`);
                            }
                        }
                        return labels;
                    }
                    
                    function addPriceBand(bandLetter = null, priceData = null) {
                        priceBandCounter++;
                        const bandId = 'band_' + priceBandCounter;
                        const displayLetter = bandLetter || String.fromCharCode(64 + priceBandCounter);
                        
                        // 共通名称設定のラベルを取得
                        const commonLabels = getCommonNameLabels();
                        
                        const bandHtml = \`
                            <div class="border border-gray-300 rounded-lg p-4 bg-gray-50" id="\${bandId}" data-band-letter="\${displayLetter}">
                                <div class="flex items-center justify-between mb-3">
                                    <h4 class="text-sm font-bold text-gray-700">
                                        <i class="fas fa-layer-group text-green-600 mr-1"></i>
                                        価格帯 \${displayLetter}
                                    </h4>
                                    <button type="button" onclick="removePriceBand('\${bandId}')" class="text-red-600 hover:text-red-800 text-sm">
                                        <i class="fas fa-trash mr-1"></i>削除
                                    </button>
                                </div>
                                <div class="space-y-2">
                                    <div class="grid grid-cols-12 gap-2 items-center">
                                        <div class="col-span-1"></div>
                                        <div class="col-span-2"><span class="text-xs font-bold">\${commonLabels[0]}</span></div>
                                        <div class="col-span-2"><span class="text-xs font-bold">\${commonLabels[1]}</span></div>
                                        <div class="col-span-2"><span class="text-xs font-bold">\${commonLabels[2]}</span></div>
                                        <div class="col-span-2"><span class="text-xs font-bold">\${commonLabels[3]}</span></div>
                                        <div class="col-span-2"><span class="text-xs font-bold">\${commonLabels[4]}</span></div>
                                    </div>
                                    <div class="grid grid-cols-12 gap-2 items-center">
                                        <div class="col-span-1"><span class="text-xs font-bold">価格</span></div>
                                        <div class="col-span-2">
                                            <input type="number" name="price_\${priceBandCounter}_1" min="0" placeholder="0" value="\${priceData && priceData[1] ? priceData[1] : ''}" class="w-full px-2 py-1 border rounded text-sm">
                                        </div>
                                        <div class="col-span-2">
                                            <input type="number" name="price_\${priceBandCounter}_2" min="0" placeholder="0" value="\${priceData && priceData[2] ? priceData[2] : ''}" class="w-full px-2 py-1 border rounded text-sm">
                                        </div>
                                        <div class="col-span-2">
                                            <input type="number" name="price_\${priceBandCounter}_3" min="0" placeholder="0" value="\${priceData && priceData[3] ? priceData[3] : ''}" class="w-full px-2 py-1 border rounded text-sm">
                                        </div>
                                        <div class="col-span-2">
                                            <input type="number" name="price_\${priceBandCounter}_4" min="0" placeholder="0" value="\${priceData && priceData[4] ? priceData[4] : ''}" class="w-full px-2 py-1 border rounded text-sm">
                                        </div>
                                        <div class="col-span-2">
                                            <input type="number" name="price_\${priceBandCounter}_5" min="0" placeholder="0" value="\${priceData && priceData[5] ? priceData[5] : ''}" class="w-full px-2 py-1 border rounded text-sm">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        \`;
                        
                        priceBandsContainer.insertAdjacentHTML('beforeend', bandHtml);
                    }
                    
                    window.removePriceBand = function(bandId) {
                        const band = document.getElementById(bandId);
                        if (band) {
                            band.remove();
                        }
                    };
                    
                    // 既存の価格帯のラベルを更新する関数
                    function updatePriceBandLabels() {
                        const commonLabels = getCommonNameLabels();
                        console.log('updatePriceBandLabels called. commonLabels:', commonLabels);
                        console.log('priceBandCounter:', priceBandCounter);
                        
                        // 既存の全価格帯を走査してラベルを更新
                        for (let i = 1; i <= priceBandCounter; i++) {
                            const bandElement = document.getElementById('band_' + i);
                            console.log('Processing band:', i, 'Element found:', !!bandElement);
                            
                            if (bandElement) {
                                // 名称行（最初の.grid.grid-cols-12）のラベルのみを取得
                                const gridRows = bandElement.querySelectorAll('.grid.grid-cols-12');
                                console.log('Grid rows found:', gridRows.length);
                                
                                if (gridRows.length >= 1) {
                                    // 最初の行（名称行）のラベルを取得
                                    const nameLabels = gridRows[0].querySelectorAll('.text-xs.font-bold');
                                    console.log('Name labels found in first grid:', nameLabels.length);
                                    
                                    // nameLabels[0-4]が名称1-5（空白divは.text-xs.font-boldを持たないのでスキップされる）
                                    for (let j = 0; j < 5 && j < nameLabels.length; j++) {
                                        console.log(\`Updating label \${j}: "\${nameLabels[j].textContent}" -> "\${commonLabels[j]}"\`);
                                        nameLabels[j].textContent = commonLabels[j];
                                    }
                                }
                            }
                        }
                    }
                    
                    // 共通名称設定の入力フィールドが変更されたら価格帯のラベルを更新
                    const currentForm = document.getElementById('productForm');
                    for (let i = 1; i <= 5; i++) {
                        const nameElement = currentForm ? currentForm.elements['common_name_' + i] : null;
                        if (nameElement) {
                            nameElement.addEventListener('input', () => {
                                updatePriceBandLabels();
                            });
                        }
                    }
                    
                    if (addPriceBandButton) {
                        addPriceBandButton.addEventListener('click', () => addPriceBand());
                    }
                    
                    // 初期表示: 編集モードなら既存データを復元、新規モードなら1つ追加
                    console.log('Checking price band restoration - isEditMode:', isEditMode);
                    console.log('window.existingPriceBandData:', window.existingPriceBandData);
                    if (isEditMode && window.existingPriceBandData && Object.keys(window.existingPriceBandData).length > 0) {
                        // 既存の価格帯データを復元
                        const bands = Object.keys(window.existingPriceBandData).sort();
                        console.log('Restoring bands:', bands);
                        bands.forEach(bandLetter => {
                            console.log('Adding band:', bandLetter, 'with data:', window.existingPriceBandData[bandLetter]);
                            addPriceBand(bandLetter, window.existingPriceBandData[bandLetter]);
                        });
                    } else {
                        console.log('No price band data to restore, adding default band');
                        // 新規モードまたは編集モードで価格帯データがない場合は1つ追加
                        addPriceBand();
                    }
                    
                    // 画像ファイル選択時のプレビュー処理
                    const imageFile = document.getElementById('imageFile');
                    const imagePreview = document.getElementById('imagePreview');
                    const clearImageBtn = document.getElementById('clearImageBtn');
                    
                    if (imageFile) {
                        imageFile.addEventListener('change', function(e) {
                            const file = e.target.files[0];
                            if (file) {
                                // ファイルサイズチェック（5MB制限）
                                if (file.size > 5 * 1024 * 1024) {
                                    alert('画像ファイルは5MB以下にしてください');
                                    e.target.value = '';
                                    return;
                                }
                                
                                // 画像タイプチェック
                                if (!file.type.match('image.*')) {
                                    alert('画像ファイルを選択してください');
                                    e.target.value = '';
                                    return;
                                }
                                
                                // プレビュー表示
                                const reader = new FileReader();
                                reader.onload = function(e) {
                                    if (imagePreview) {
                                        imagePreview.src = e.target.result;
                                        imagePreview.classList.remove('hidden');
                                    }
                                };
                                reader.readAsDataURL(file);
                            }
                        });
                    }
                    
                    // 画像クリアボタン
                    if (clearImageBtn) {
                        clearImageBtn.addEventListener('click', function() {
                            if (imageFile) imageFile.value = '';
                            if (imagePreview) {
                                imagePreview.src = '/static/images/no-image.svg';
                                imagePreview.classList.add('hidden');
                            }
                        });
                    }
                    
                    // フォームサブミット処理
                    const productForm = document.getElementById('productForm');
                    if (productForm) {
                        productForm.addEventListener('submit', async (e) => {
                            e.preventDefault();
                            const formData = new FormData(e.target);
                            const data = Object.fromEntries(formData.entries());
                            
                            // 価格帯データを配列形式で収集
                            const prices = [];
                            for (let i = 1; i <= priceBandCounter; i++) {
                                const bandElement = document.getElementById('band_' + i);
                                if (bandElement) {
                                    const bandLetter = bandElement.getAttribute('data-band-letter') || String.fromCharCode(64 + i);
                                    const priceRow = {
                                        price_band: bandLetter, // A, B, C... (data-band-letterから取得)
                                        price_1: formData.get('price_' + i + '_1') || 0,
                                        price_2: formData.get('price_' + i + '_2') || 0,
                                        price_3: formData.get('price_' + i + '_3') || 0,
                                        price_4: formData.get('price_' + i + '_4') || 0,
                                        price_5: formData.get('price_' + i + '_5') || 0
                                    };
                                    prices.push(priceRow);
                                }
                            }
                            
                            // 価格帯データをdataオブジェクトに追加
                            data.prices = prices;
                            
                            // 価格帯の個別フィールドを削除（prices配列に統合済み）
                            for (let i = 1; i <= priceBandCounter; i++) {
                                for (let j = 1; j <= 5; j++) {
                                    delete data['price_' + i + '_' + j];
                                }
                            }
                            
                            // DBに保存しないフィールドを削除
                            // 注意: price_unit, charge_type, charge_description, common_name_*, common_desc_*, 
                            // cancellation_days_*, cancellation_rate_* はAPIで処理されるため削除しない
                            
                            try {
                                // 画像ファイルがある場合は先にアップロード
                                const imageFile = document.getElementById('imageFile');
                                if (imageFile && imageFile.files && imageFile.files[0]) {
                                    const file = imageFile.files[0];
                                    const imageFormData = new FormData();
                                    imageFormData.append('image', file);
                                    
                                    const uploadResponse = await axios.post('/api/products/upload-image', imageFormData, {
                                        headers: { 'Content-Type': 'multipart/form-data' }
                                    });
                                    
                                    if (uploadResponse.data && uploadResponse.data.image_url) {
                                        data.image_url = uploadResponse.data.image_url;
                                    }
                                }
                                
                                const response = productId 
                                    ? await axios.put('/api/products/' + productId, data) 
                                    : await axios.post('/api/products', data);
                                alert(productId ? '商品を更新しました！' : '商品を登録しました！');
                                window.location.href = '/admin/products';
                            } catch (error) {
                                console.error('Error:', error);
                                alert('登録に失敗しました: ' + (error.response?.data?.error || error.message));
                            }
                        });
                    }
                    
                } catch (error) {
                    console.error('Error loading data:', error);
                    alert('データの読み込みに失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
}

// ルート登録
app.get('/admin/products/new', handleProductForm)
app.get('/admin/products/:id/edit', handleProductForm)

// 管理画面 - オプション新規登録フォーム
// 管理画面 - オプション新規登録・編集（共通）
app.get('/admin/options/:id/edit', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  // オプション情報を取得（編集モードの場合）
  let option = null
  let prices = []
  
  if (optionId !== 'new') {
    const optionData = await DB.prepare(`
      SELECT o.*, e.name as event_name
      FROM options o
      LEFT JOIN events e ON o.event_id = e.id
      WHERE o.id = ? AND o.deleted_at IS NULL
    `).bind(parseInt(optionId)).first()
    
    if (!optionData) {
      return c.html('<h1>オプションが見つかりません</h1>')
    }
    
    option = optionData
    
    // 価格情報を取得
    const { results: priceData } = await DB.prepare(`
      SELECT * FROM option_prices WHERE option_id = ?
    `).bind(parseInt(optionId)).all()
    prices = priceData
  }
  
  const mode = optionId === 'new' ? 'new' : 'edit'
  const pageTitle = mode === 'new' ? '新規オプション登録' : 'オプション編集'
  
  // イベント一覧を取得
  const { results: events } = await DB.prepare(`
    SELECT id, name FROM events WHERE enable_flg = 1 ORDER BY name
  `).all()
  
  const eventsOptions = events.map(event => 
    `<option value="${event.id}" ${option && option.event_id === event.id ? 'selected' : ''}>${event.name}</option>`
  ).join('')
  
  // オプションカテゴリー一覧を取得
  const { results: categories } = await DB.prepare(`
    SELECT id, name FROM option_categories ORDER BY name
  `).all()
  
  const categoriesOptions = categories.map(cat => 
    `<option value="${cat.id}" ${option && option.option_category_id === cat.id ? 'selected' : ''}>${cat.name}</option>`
  ).join('')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${pageTitle} | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-purple-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-list-ul"></i>
                    ${pageTitle}
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/options" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-list-ul"></i>オプション管理
                    </a></li>
                    <li><span class="text-purple-600 font-semibold">${mode === 'new' ? '新規登録' : '編集'}</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-8">
                <form id="optionForm" class="space-y-6">
                    <input type="hidden" id="optionId" value="${option ? option.id : ''}">
                    <input type="hidden" id="mode" value="${mode}">
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                オプション名 <span class="text-red-600">*</span>
                            </label>
                            <input type="text" name="name" required value="${option ? option.name : ''}"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="例：駐車場">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                イベント <span class="text-red-600">*</span>
                            </label>
                            <select name="event_id" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="">選択してください</option>
                                ${eventsOptions}
                            </select>
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                カテゴリー <span class="text-red-600">*</span>
                            </label>
                            <select name="option_category_id" required 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="">選択してください</option>
                                ${categoriesOptions}
                            </select>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                価格 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" name="price" required min="0" value="${prices.length > 0 ? prices[0].price : ''}"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="2000">
                        </div>
                    </div>
                    
                    <!-- オプション画像 -->
                    <div class="bg-purple-50 border border-purple-200 rounded-lg p-6">
                        <div class="flex items-center mb-4">
                            <label class="block text-lg font-semibold text-gray-800">
                                <i class="fas fa-image mr-2 text-purple-600"></i>
                                オプション画像
                            </label>
                        </div>
                        
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    画像ファイル
                                </label>
                                <input type="file" name="image" id="imageFile" accept="image/*"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-transparent">
                                <p class="text-xs text-gray-500 mt-1">
                                    対応形式：JPG, PNG, GIF, WebP / 最大サイズ：5MB
                                </p>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    プレビュー
                                </label>
                                <div class="border-2 border-dashed border-gray-300 rounded-lg p-4 text-center bg-white">
                                    <img id="imagePreview" 
                                         src="${option && option.image_url ? option.image_url : '/static/images/no-image.svg'}" 
                                         alt="プレビュー" 
                                         class="${option && option.image_url ? '' : 'hidden'} max-w-full h-auto max-h-48 mx-auto rounded">
                                    <p id="noImageText" class="${option && option.image_url ? 'hidden' : ''} text-gray-400 py-8">
                                        <i class="fas fa-image text-4xl mb-2"></i><br>
                                        画像未選択
                                    </p>
                                </div>
                                <button type="button" id="clearImageBtn" 
                                    class="mt-2 text-sm text-red-600 hover:text-red-800">
                                    <i class="fas fa-times mr-1"></i>画像をクリア
                                </button>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            オプション説明
                        </label>
                        <textarea name="description" rows="4" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            placeholder="オプションの詳細説明">${option ? option.description || '' : ''}</textarea>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            公開状態
                        </label>
                        <select name="enable_flg" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <option value="1" ${!option || option.enable_flg === 1 ? 'selected' : ''}>有効</option>
                            <option value="0" ${option && option.enable_flg === 0 ? 'selected' : ''}>無効</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            備考
                        </label>
                        <textarea name="remarks" rows="2" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">${option ? option.remarks || '' : ''}</textarea>
                    </div>
                    
                    <div class="flex gap-4 pt-6">
                        <button type="submit" 
                            class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                            <i class="fas fa-save mr-2"></i>${mode === 'new' ? '登録する' : '更新する'}
                        </button>
                        <a href="/admin/options" 
                            class="bg-gray-300 text-gray-700 px-8 py-3 rounded-lg hover:bg-gray-400 transition font-semibold">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // 画像ファイル選択時のプレビュー処理
            const imageFile = document.getElementById('imageFile');
            const imagePreview = document.getElementById('imagePreview');
            const noImageText = document.getElementById('noImageText');
            const clearImageBtn = document.getElementById('clearImageBtn');
            
            if (imageFile) {
                imageFile.addEventListener('change', function(e) {
                    const file = e.target.files[0];
                    if (file) {
                        // ファイルサイズチェック（5MB制限）
                        if (file.size > 5 * 1024 * 1024) {
                            alert('画像ファイルは5MB以下にしてください');
                            e.target.value = '';
                            return;
                        }
                        
                        // 画像タイプチェック
                        if (!file.type.match('image.*')) {
                            alert('画像ファイルを選択してください');
                            e.target.value = '';
                            return;
                        }
                        
                        // プレビュー表示
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            if (imagePreview) {
                                imagePreview.src = e.target.result;
                                imagePreview.classList.remove('hidden');
                            }
                            if (noImageText) {
                                noImageText.classList.add('hidden');
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }
            
            // 画像クリアボタン
            if (clearImageBtn) {
                clearImageBtn.addEventListener('click', function() {
                    if (imageFile) imageFile.value = '';
                    if (imagePreview) {
                        imagePreview.src = '/static/images/no-image.svg';
                        imagePreview.classList.add('hidden');
                    }
                    if (noImageText) {
                        noImageText.classList.remove('hidden');
                    }
                });
            }
            
            document.getElementById('optionForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const mode = document.getElementById('mode').value;
                const optionId = document.getElementById('optionId').value;
                const formData = new FormData(e.target);
                const data = Object.fromEntries(formData.entries());
                
                try {
                    // 画像ファイルがある場合は先にアップロード
                    const imageFile = document.getElementById('imageFile');
                    if (imageFile && imageFile.files && imageFile.files[0]) {
                        const file = imageFile.files[0];
                        const imageFormData = new FormData();
                        imageFormData.append('image', file);
                        
                        const uploadResponse = await axios.post('/api/options/upload-image', imageFormData, {
                            headers: { 'Content-Type': 'multipart/form-data' }
                        });
                        
                        if (uploadResponse.data && uploadResponse.data.image_url) {
                            data.image_url = uploadResponse.data.image_url;
                        }
                    }
                    
                    let response;
                    if (mode === 'new') {
                        response = await axios.post('/api/options', data);
                        alert('オプションを登録しました！');
                    } else {
                        response = await axios.put(\`/api/options/\${optionId}\`, data);
                        alert('オプションを更新しました！');
                    }
                    window.location.href = '/admin/options';
                } catch (error) {
                    console.error('Error:', error);
                    const message = mode === 'new' ? '登録に失敗しました' : '更新に失敗しました';
                    alert(\`\${message}: \${error.response?.data?.error || error.message}\`);
                }
            });
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - オプション新規登録（new用にリダイレクト）
app.get('/admin/options/new', async (c) => {
  return c.redirect('/admin/options/new/edit')
})


// 管理画面 - 共有在庫プール管理
app.get('/admin/shared-stock-pools', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>共有在庫プール管理 - 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>管理画面トップ
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">共有在庫プール管理</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- プール一覧 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-2xl font-bold text-gray-800">
                            <i class="fas fa-list mr-2 text-blue-600"></i>
                            共有在庫プール一覧
                        </h2>
                        <a href="/admin/shared-stock-pools/new" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-plus mr-2"></i>新規プール登録
                        </a>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">プール名</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">日付範囲</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">総在庫</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">予約済</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">利用可能</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">操作</th>
                                </tr>
                            </thead>
                            <tbody id="poolTableBody" class="bg-white divide-y divide-gray-200">
                                <tr>
                                    <td colspan="6" class="px-4 py-8 text-center text-gray-500">
                                        <i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="bg-blue-50 rounded-lg p-4">
                    <h3 class="font-semibold text-blue-900 mb-2">
                        <i class="fas fa-info-circle mr-2"></i>共有在庫プールとは？
                    </h3>
                    <p class="text-sm text-blue-800">
                        複数の商品やオプションで共通の在庫を管理する仕組みです。例えば、バスの座席や駐車場など、物理的に同じリソースを複数の商品・プランで販売する場合に使用します。
                        <br><br>
                        <strong>日付範囲指定：</strong>開始日と終了日を指定すると、その期間のプールを一括登録できます。
                    </p>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // ページ読み込み時にプール一覧を取得
            async function loadPools() {
                try {
                    const res = await axios.get('/api/shared-stock-pools/summary');
                    const { pools } = res.data;
                    
                    const tbody = document.getElementById('poolTableBody');
                    
                    if (pools.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500">共有在庫プールがありません</td></tr>';
                        return;
                    }
                    
                    tbody.innerHTML = pools.map(pool => \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3">
                                <div class="font-medium text-gray-900">\${pool.pool_name}</div>
                                \${pool.pool_code ? \`<div class="text-xs text-gray-500">コード: \${pool.pool_code}</div>\` : ''}
                                \${pool.description ? \`<div class="text-xs text-gray-600 mt-1">\${pool.description}</div>\` : ''}
                            </td>
                            <td class="px-4 py-3 text-sm text-gray-700">
                                \${pool.date_count}日分
                                <div class="text-xs text-gray-500">\${pool.first_date} ～ \${pool.last_date}</div>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="text-lg font-semibold text-blue-600">\${pool.total_stock_sum.toLocaleString()}</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="text-lg font-semibold text-red-600">\${pool.booked_sum.toLocaleString()}</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="text-lg font-semibold \${pool.available_stock_sum > 0 ? 'text-green-600' : 'text-gray-400'}">
                                    \${pool.available_stock_sum.toLocaleString()}
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <a href="/admin/shared-stock-pools/manage?pool_name=\${encodeURIComponent(pool.pool_name)}&pool_code=\${encodeURIComponent(pool.pool_code || '')}" 
                                   class="bg-blue-600 text-white px-3 py-1 rounded hover:bg-blue-700 text-sm">
                                    <i class="fas fa-boxes mr-1"></i>在庫管理
                                </a>
                            </td>
                        </tr>
                    \`).join('');
                } catch (error) {
                    console.error('Error loading pools:', error);
                    document.getElementById('poolTableBody').innerHTML = 
                        '<tr><td colspan="6" class="px-4 py-8 text-center text-red-500"><i class="fas fa-exclamation-triangle mr-2"></i>データの読み込みに失敗しました</td></tr>';
                }
            }
            
            // ページ読み込み時に実行
            document.addEventListener('DOMContentLoaded', loadPools);

            // プール詳細表示
            async function viewPoolDetails(poolId) {
                try {
                    const res = await axios.get(\`/api/shared-stock-pools/\${poolId}\`);
                    const { pool, products, options } = res.data;

                    let message = \`プール名: \${pool.pool_name}\\n\`;
                    message += \`総在庫: \${pool.total_stock}  予約済: \${pool.booked}  利用可能: \${pool.available_stock}\\n\\n\`;
                    
                    if (products.length > 0) {
                        message += '【紐付けられた商品】\\n';
                        products.forEach(p => {
                            message += \`- \${p.product_name} (消費数: \${p.consume_quantity})\\n\`;
                        });
                    }
                    
                    if (options.length > 0) {
                        message += '\\n【紐付けられたオプション】\\n';
                        options.forEach(o => {
                            message += \`- \${o.option_name} (消費数: \${o.consume_quantity})\\n\`;
                        });
                    }

                    if (products.length === 0 && options.length === 0) {
                        message += 'まだ商品・オプションが紐付けられていません。';
                    }

                    alert(message);
                } catch (error) {
                    alert('プール詳細の取得に失敗しました');
                    console.error(error);
                }
            }

            // プール削除
            async function deletePool(poolId) {
                if (!confirm('このプールを削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/shared-stock-pools/\${poolId}\`);
                    alert('プールを削除しました');
                    loadPools(); // 再読み込み
                } catch (error) {
                    alert('プールの削除に失敗しました');
                    console.error(error);
                }
            }
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 共有在庫プール在庫管理（日別一覧）
app.get('/admin/shared-stock-pools/manage', async (c) => {
  const { DB } = c.env
  const poolName = c.req.query('pool_name')
  const poolCode = c.req.query('pool_code') || ''

  if (!poolName) {
    return c.text('プール名が指定されていません', 400)
  }

  // 日別在庫一覧を取得
  const { results: stocks } = await DB.prepare(`
    SELECT * FROM shared_stock_pools
    WHERE pool_name = ? AND (pool_code = ? OR (pool_code IS NULL AND ? = ''))
    AND enable_flg = 1
    ORDER BY date ASC, time_slot_start
  `).bind(poolName, poolCode, poolCode).all()

  if (stocks.length === 0) {
    return c.text('プールが見つかりません', 404)
  }

  const firstPool = stocks[0]
  const totalStock = stocks.reduce((sum, s) => sum + s.total_stock, 0)
  const totalBooked = stocks.reduce((sum, s) => sum + s.booked, 0)
  const totalAvailable = stocks.reduce((sum, s) => sum + s.available_stock, 0)

  const stocksHtml = stocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b">${stock.date}</td>
      <td class="px-4 py-3 border-b">
        ${stock.time_slot_label || '<span class="text-gray-400">-</span>'}
        ${stock.time_slot_start ? `<div class="text-xs text-gray-500">${stock.time_slot_start} - ${stock.time_slot_end}</div>` : ''}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold text-blue-600">${stock.total_stock.toLocaleString()}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="text-red-600">${stock.booked.toLocaleString()}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock.toLocaleString()}
        </span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="showEditForm(${stock.id})" class="text-blue-600 hover:text-blue-800 mr-3">
          <i class="fas fa-edit"></i> 編集
        </button>
        <button onclick="deleteStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i> 削除
        </button>
      </td>
    </tr>
  `).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${poolName} - 在庫管理</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/shared-stock-pools" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>プール一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${poolName} - 在庫管理</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- プール情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-info-circle mr-2 text-blue-600"></i>プール情報
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">プール名</p>
                            <p class="text-lg font-semibold">${poolName}</p>
                        </div>
                        ${poolCode ? `
                        <div>
                            <p class="text-sm text-gray-600">プールコード</p>
                            <p class="text-lg font-semibold">${poolCode}</p>
                        </div>
                        ` : ''}
                        ${firstPool.description ? `
                        <div class="md:col-span-2">
                            <p class="text-sm text-gray-600">説明</p>
                            <p class="text-gray-800">${firstPool.description}</p>
                        </div>
                        ` : ''}
                    </div>
                    
                    <!-- 統計情報 -->
                    <div class="mt-6 grid md:grid-cols-3 gap-4">
                        <div class="bg-blue-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">総在庫</p>
                            <p class="text-2xl font-bold text-blue-600">${totalStock.toLocaleString()}</p>
                        </div>
                        <div class="bg-red-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">予約済</p>
                            <p class="text-2xl font-bold text-red-600">${totalBooked.toLocaleString()}</p>
                        </div>
                        <div class="bg-green-50 rounded-lg p-4 text-center">
                            <p class="text-sm text-gray-600 mb-1">利用可能</p>
                            <p class="text-2xl font-bold text-green-600">${totalAvailable.toLocaleString()}</p>
                        </div>
                    </div>
                </div>

                <!-- 日別在庫一覧 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-xl font-bold text-gray-800">
                            <i class="fas fa-calendar-alt mr-2 text-blue-600"></i>日別在庫一覧
                        </h2>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">時間帯</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">在庫数</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">予約済</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody id="stockTableBody">
                                ${stocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 在庫追加フォーム -->
                <div id="addFormSection" class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>在庫追加
                    </h2>
                    <form id="addStockForm" class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="addDateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-gray-500 text-xs">(省略可)</span>
                                </label>
                                <input type="date" id="addDateEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <p class="text-xs text-gray-600">
                            <i class="fas fa-info-circle mr-1"></i>
                            終了日を指定すると、期間内の在庫を一括追加できます
                        </p>
                        
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    時間帯ラベル
                                </label>
                                <input type="text" id="addTimeSlotLabel"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500"
                                    placeholder="例: 午前、1日ツアー">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始時刻
                                </label>
                                <input type="time" id="addTimeSlotStart"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了時刻
                                </label>
                                <input type="time" id="addTimeSlotEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                総在庫数 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" id="addTotalStock" required min="0"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500"
                                placeholder="50">
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>在庫を追加
                            </button>
                            <button type="button" onclick="resetAddForm()" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 在庫編集フォーム（非表示） -->
                <div id="editFormSection" class="bg-white rounded-lg shadow-md p-6 mb-6" style="display:none;">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-edit mr-2 text-blue-600"></i>在庫編集
                    </h2>
                    <form id="editStockForm" class="space-y-4">
                        <input type="hidden" id="editStockId">
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                日付 <span class="text-red-600">*</span>
                            </label>
                            <input type="date" id="editDate" required
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                        </div>
                        
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    時間帯ラベル
                                </label>
                                <input type="text" id="editTimeSlotLabel"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                    placeholder="例: 午前、1日ツアー">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始時刻
                                </label>
                                <input type="time" id="editTimeSlotStart"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了時刻
                                </label>
                                <input type="time" id="editTimeSlotEnd"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                総在庫数 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" id="editTotalStock" required min="0"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                placeholder="50">
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>保存
                            </button>
                            <button type="button" onclick="hideEditForm()" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const poolName = '${poolName}';
            const poolCode = '${poolCode}';

            // 日付範囲生成
            function getDateRange(startDate, endDate) {
                const dates = [];
                const currentDate = new Date(startDate);
                const end = endDate ? new Date(endDate) : new Date(startDate);
                
                while (currentDate <= end) {
                    dates.push(new Date(currentDate).toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
                
                return dates;
            }

            // 追加フォームをリセット
            function resetAddForm() {
                document.getElementById('addStockForm').reset();
                document.getElementById('editFormSection').style.display = 'none';
            }

            // 編集フォーム表示
            async function showEditForm(id) {
                try {
                    const res = await axios.get(\`/api/shared-stock-pools/\${id}\`);
                    const pool = res.data.pool;

                    document.getElementById('editStockId').value = pool.id;
                    document.getElementById('editDate').value = pool.date;
                    document.getElementById('editTimeSlotLabel').value = pool.time_slot_label || '';
                    document.getElementById('editTimeSlotStart').value = pool.time_slot_start || '';
                    document.getElementById('editTimeSlotEnd').value = pool.time_slot_end || '';
                    document.getElementById('editTotalStock').value = pool.total_stock;

                    document.getElementById('editFormSection').style.display = 'block';
                    // スムーズスクロール
                    document.getElementById('editFormSection').scrollIntoView({ behavior: 'smooth', block: 'center' });
                } catch (error) {
                    alert('在庫情報の取得に失敗しました');
                    console.error(error);
                }
            }

            // 編集フォームをキャンセル
            function hideEditForm() {
                document.getElementById('editFormSection').style.display = 'none';
                document.getElementById('editStockForm').reset();
            }

            // 在庫追加
            document.getElementById('addStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const startDate = document.getElementById('addDateStart').value;
                const endDate = document.getElementById('addDateEnd').value || startDate;
                const dates = getDateRange(startDate, endDate);

                const baseData = {
                    pool_name: poolName,
                    pool_code: poolCode || null,
                    description: '${firstPool.description ? firstPool.description.replace(/'/g, "\\'") : ''}' || null,
                    time_slot_label: document.getElementById('addTimeSlotLabel').value || null,
                    time_slot_start: document.getElementById('addTimeSlotStart').value || null,
                    time_slot_end: document.getElementById('addTimeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('addTotalStock').value),
                    enable_flg: 1
                };

                try {
                    let successCount = 0;
                    for (const date of dates) {
                        await axios.post('/api/shared-stock-pools', {
                            ...baseData,
                            date: date
                        });
                        successCount++;
                    }
                    alert(\`\${successCount}件の在庫を追加しました（\${startDate} ～ \${endDate}）\`);
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('追加に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });

            // 在庫編集
            document.getElementById('editStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const id = document.getElementById('editStockId').value;
                const data = {
                    pool_name: poolName,
                    pool_code: poolCode || null,
                    description: '${firstPool.description ? firstPool.description.replace(/'/g, "\\'") : ''}' || null,
                    date: document.getElementById('editDate').value,
                    time_slot_label: document.getElementById('editTimeSlotLabel').value || null,
                    time_slot_start: document.getElementById('editTimeSlotStart').value || null,
                    time_slot_end: document.getElementById('editTimeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('editTotalStock').value),
                    enable_flg: 1
                };

                try {
                    await axios.put(\`/api/shared-stock-pools/\${id}\`, data);
                    alert('在庫を更新しました');
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });

            // 在庫削除
            async function deleteStock(id) {
                if (!confirm('この日付の在庫を削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/shared-stock-pools/\${id}\`);
                    alert('在庫を削除しました');
                    window.location.reload();
                } catch (error) {
                    alert('削除に失敗しました');
                    console.error(error);
                }
            }
        </script>
    </body>
    </html>
  `)
})

