                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-plus"></i>イベント管理
                    </a></li>
                    <li><span class="text-purple-600 font-semibold">新規登録</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-8">
                <form id="eventForm" class="space-y-6">
                    <!-- イベント名・詳細（言語タブ） -->
                    <div>
                        <div class="flex gap-2 mb-6 border-b">
                            <button type="button" id="tabBasicJapanese" onclick="switchBasicLanguageTab('ja')" 
                                class="px-6 py-3 font-semibold border-b-2 border-blue-600 text-blue-600">
                                日本語
                            </button>
                            <button type="button" id="tabBasicEnglish" onclick="switchBasicLanguageTab('en')" 
                                class="px-6 py-3 font-semibold text-gray-500 hover:text-gray-700">
                                English
                            </button>
                        </div>
                        
                        <!-- 日本語コンテンツ -->
                        <div id="contentBasicJapanese" class="space-y-6">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    イベント名 <span class="text-red-600">*</span>
                                </label>
                                <input type="text" name="name" required 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="例：長岡花火大会 2025">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    イベント詳細
                                </label>
                                <textarea name="detail" rows="4" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="イベントの詳細説明を入力してください"></textarea>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-map-marker-alt mr-2 text-red-600"></i>場所
                                </label>
                                <input type="text" name="location" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                    placeholder="例：東京都渋谷区○○ホール">
                            </div>
                        </div>
                        
                        <!-- 英語コンテンツ -->
                        <div id="contentBasicEnglish" class="space-y-6" style="display: none;">
