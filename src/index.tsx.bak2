// API: イベント一覧取得
app.get('/api/events', async (c) => {
  const { DB } = c.env
  
  const { results } = await DB.prepare(`
    SELECT * FROM events 
    WHERE enable_flg = 1 
    ORDER BY created_at DESC
  `).all<Event>()

  return c.json({ events: results })
})

// ===================================
// API v1 エンドポイント（RESTful API）
// ===================================

// API v1: カテゴリ一覧取得
app.get('/api/v1/categories', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '100', 10)
  const enableFlg = c.req.query('enable_flg')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (enableFlg !== undefined) {
    conditions.push('enable_flg = ?')
    params.push(parseInt(enableFlg, 10))
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得
  const countQuery = `SELECT COUNT(*) as total FROM categories ${whereClause}`
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      id,
      name,
      display_order,
      enable_flg,
      created_at,
      modified_at
    FROM categories 
    ${whereClause}
    ORDER BY display_order ASC, id ASC
    LIMIT ? OFFSET ?
  `
  const { results: categories } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: categories,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API v1: イベント一覧取得
app.get('/api/v1/events', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const name = c.req.query('name')
  const branchCode = c.req.query('branch_code')
  const clientId = c.req.query('client_id')
  const vendorId = c.req.query('vendor_id')
  const eventStartDateFrom = c.req.query('event_start_date_from')
  const eventStartDateTo = c.req.query('event_start_date_to')
  const enableFlg = c.req.query('enable_flg')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = ['e.deleted_at IS NULL']
  const params = []
  
  if (name) {
    conditions.push('e.name LIKE ?')
    params.push('%' + name + '%')
  }
  
  if (branchCode) {
    conditions.push('e.branch_code = ?')
    params.push(branchCode)
  }
  
  if (clientId) {
    conditions.push('e.customer_client_id = ?')
    params.push(parseInt(clientId, 10))
  }
  
  if (vendorId) {
    conditions.push('e.client_id = ?')
    params.push(parseInt(vendorId, 10))
  }
  
  if (eventStartDateFrom) {
    conditions.push('e.event_start_date >= ?')
    params.push(eventStartDateFrom)
  }
  
  if (eventStartDateTo) {
    conditions.push('e.event_start_date <= ?')
    params.push(eventStartDateTo)
  }
  
  if (enableFlg !== undefined) {
    conditions.push('e.enable_flg = ?')
    params.push(parseInt(enableFlg, 10))
  }
  
  const whereClause = 'WHERE ' + conditions.join(' AND ')
  
  // 総数取得（branch_code検索のためにbranchesテーブルをJOIN）
  const countQuery = `
    SELECT COUNT(*) as total 
    FROM events e
    LEFT JOIN branches b ON e.branch_code = b.branch_code
    ${whereClause}
  `
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得（親子関係を考慮してソート）
  // 親イベントとその子イベントをグループ化して表示
  const dataQuery = `
    SELECT 
      e.*,
      c.name as client_name,
      v.name as vendor_name,
      b.branch_name,
      b.branch_full_name,
      CASE 
        WHEN e.event_type = 'child' THEN e.parent_event_id
        ELSE e.id
      END as sort_group,
      CASE 
        WHEN e.event_type = 'parent' THEN 0
        WHEN e.event_type = 'child' THEN 1
        ELSE 2
      END as sort_order
    FROM events e
    LEFT JOIN clients c ON e.customer_client_id = c.id
    LEFT JOIN clients v ON e.client_id = v.id
    LEFT JOIN branches b ON e.branch_code = b.branch_code
    ${whereClause}
    ORDER BY 
      sort_group DESC,
      sort_order ASC,
      e.id ASC
    LIMIT ? OFFSET ?
  `
  const { results: rawEvents } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // sort_group と sort_order を除去してクリーンなデータを返す
  const events = rawEvents.map(({ sort_group, sort_order, ...event }) => event)
  
  // レスポンス構築
  return c.json({
    data: events,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API v1: 主催者（ベンダー）一覧取得
