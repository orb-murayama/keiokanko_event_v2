// API v1: 商品一覧取得
app.get('/api/v1/products', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const eventId = c.req.query('event_id')
  const name = c.req.query('name')
  const eventName = c.req.query('event_name')
  const status = c.req.query('status')
  const enableFlg = c.req.query('enable_flg')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (eventId) {
    conditions.push('p.event_id = ?')
    params.push(parseInt(eventId, 10))
  }
  
  if (name) {
    // INSTR関数で部分一致検索（長い文字列にも対応）
    conditions.push('INSTR(p.name, ?) > 0')
    params.push(name.trim())
  }
  
  if (eventName) {
    // INSTR関数で部分一致検索（長い文字列にも対応）
    conditions.push('INSTR(e.name, ?) > 0')
    params.push(eventName.trim())
  }
  
  if (status !== undefined && status !== '') {
    conditions.push('p.enable_flg = ?')
    params.push(parseInt(status, 10))
  }
  
  if (enableFlg !== undefined) {
    conditions.push('p.enable_flg = ?')
    params.push(parseInt(enableFlg, 10))
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得（JOINを含める）
  const countQuery = `
    SELECT COUNT(*) as total 
    FROM products p
    LEFT JOIN events e ON p.event_id = e.id
    ${whereClause}
  `
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      p.*,
      e.name as event_name
    FROM products p
    LEFT JOIN events e ON p.event_id = e.id
    ${whereClause}
    ORDER BY p.created_at DESC
    LIMIT ? OFFSET ?
  `
  const { results: products } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: products,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API v1: 予約一覧取得
app.get('/api/v1/bookings', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const eventId = c.req.query('event_id')
  const bookingNumber = c.req.query('booking_number')
  const bookingStatus = c.req.query('booking_status')
  const paymentStatus = c.req.query('payment_status')
  const createdAtFrom = c.req.query('created_at_from')
  const createdAtTo = c.req.query('created_at_to')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (eventId) {
    conditions.push('p.event_id = ?')
    params.push(parseInt(eventId, 10))
  }
  
  if (bookingNumber) {
    conditions.push('pb.booking_number LIKE ?')
    params.push('%' + bookingNumber + '%')
  }
  
  if (bookingStatus) {
    conditions.push('pb.booking_status = ?')
    params.push(bookingStatus)
  }
  
  if (paymentStatus) {
    conditions.push('pb.payment_status = ?')
    params.push(paymentStatus)
  }
  
  if (createdAtFrom) {
    conditions.push('pb.created_at >= ?')
    params.push(createdAtFrom)
  }
  
  if (createdAtTo) {
    conditions.push('pb.created_at <= ?')
    params.push(createdAtTo + ' 23:59:59')
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得
  const countQuery = `
    SELECT COUNT(*) as total 
    FROM product_bookings pb
    LEFT JOIN products p ON pb.product_id = p.id
    ${whereClause}
  `
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      pb.*,
      p.name as product_name,
      e.name as event_name,
      (c.family_name || ' ' || c.first_name) as customer_name,
      c.email as customer_email
    FROM product_bookings pb
    LEFT JOIN products p ON pb.product_id = p.id
    LEFT JOIN events e ON p.event_id = e.id
    LEFT JOIN customers c ON pb.customer_id = c.id
    ${whereClause}
    ORDER BY pb.created_at DESC
    LIMIT ? OFFSET ?
  `
  const { results: bookings } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: bookings,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

