// 管理画面 - 販売会社管理
app.get('/admin/vendors', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>販売会社管理 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-amber-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-store"></i>
                    販売会社管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/vendors" class="text-amber-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-store"></i>販売会社管理
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-gray-800">販売会社一覧</h2>
                <a href="/admin/vendors/new" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg flex items-center gap-2">
                    <i class="fas fa-plus"></i>
                    新規販売会社登録
                </a>
            </div>

            <!-- 検索フォーム -->
            <div class="bg-white rounded-lg shadow p-4 mb-6">
                <form id="searchForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">会社名</label>
                        <input type="text" id="searchName" placeholder="会社名で検索" 
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">メールアドレス</label>
                        <input type="text" id="searchEmail" placeholder="メールアドレスで検索"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500">
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="bg-amber-600 text-white px-6 py-2 rounded-lg hover:bg-amber-700">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">ID</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">販売会社ID</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">会社名</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">担当者名</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">役職</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">電話番号</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">メールアドレス</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">状態</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">操作</th>
                        </tr>
                    </thead>
                    <tbody id="vendors-tbody">
                        <tr><td colspan="9" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...
                        </td></tr>
                    </tbody>
                </table>
            </div>

            <!-- ページネーション -->
            <div id="pagination" class="mt-6 flex items-center justify-between hidden">
                <div class="text-sm text-gray-600">
                    <span id="paginationInfo"></span>
                </div>
                <div class="flex gap-2">
                    <button onclick="goToPage(currentPage - 1)" id="prevPageBtn" 
                            class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50" disabled>
                        <i class="fas fa-chevron-left"></i> 前へ
                    </button>
                    <button onclick="goToPage(currentPage + 1)" id="nextPageBtn" 
                            class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50" disabled>
                        次へ <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script>
            let currentPage = 1;
            let perPage = 20;
            let searchParams = {};

            document.addEventListener('DOMContentLoaded', () => {
                loadVendors();
            });

            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                currentPage = 1;
                searchParams = {
                    name: document.getElementById('searchName').value,
                    email: document.getElementById('searchEmail').value
                };
                loadVendors();
            });

            function resetSearch() {
                document.getElementById('searchName').value = '';
                document.getElementById('searchEmail').value = '';
                currentPage = 1;
                searchParams = {};
                loadVendors();
            }

            function goToPage(page) {
                currentPage = page;
                loadVendors();
            }

            async function loadVendors() {
                try {
                    console.log('販売業者データをAPIから取得中...');
                    const params = new URLSearchParams({
                        page: currentPage,
                        per_page: perPage,
                        ...searchParams
                    });
                    
                    const response = await fetch(\`/api/v1/vendors?\${params}\`);
                    if (!response.ok) {
                        throw new Error(\`HTTP error! status: \${response.status}\`);
                    }
                    
                    const result = await response.json();
                    console.log('取得した販売業者データ:', result);
                    
                    const tbody = document.getElementById('vendors-tbody');
                    
                    if (!result.data || result.data.length === 0) {
                        tbody.innerHTML = \`
                            <tr>
                                <td colspan="9" class="px-4 py-8 text-center text-gray-500">
                                    <i class="fas fa-info-circle mr-2"></i>データがありません
                                </td>
                            </tr>
                        \`;
                        document.getElementById('pagination').classList.add('hidden');
                        return;
                    }
                    
                    tbody.innerHTML = result.data.map(vendor => \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 border-b">\${vendor.id}</td>
                            <td class="px-4 py-3 border-b text-sm font-mono">\${vendor.vendor_code || '-'}</td>
                            <td class="px-4 py-3 border-b font-semibold">\${vendor.name}</td>
                            <td class="px-4 py-3 border-b text-sm">\${vendor.contactable_person || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${vendor.position || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${vendor.tel || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${vendor.email}</td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 text-xs rounded \${vendor.reg_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                    \${vendor.reg_flg ? '有効' : '無効'}
                                </span>
                            </td>
                            <td class="px-4 py-3 border-b">
                                <div class="flex gap-2">
                                    <a href="/admin/vendors/\${vendor.id}/edit" class="text-blue-600 hover:text-blue-800">
                                        <i class="fas fa-edit"></i>編集
                                    </a>
                                    <a href="/admin/vendors/\${vendor.id}" class="text-gray-600 hover:text-gray-800">
                                        <i class="fas fa-eye"></i>詳細
                                    </a>
                                </div>
                            </td>
                        </tr>
                    \`).join('');
                    
                    if (result.pagination) {
                        updatePagination(result.pagination);
                    }
                    
                    console.log(\`\${result.data.length}件の販売業者データを表示しました\`);
                    
                } catch (error) {
                    console.error('販売業者データの取得に失敗:', error);
                    const tbody = document.getElementById('vendors-tbody');
                    tbody.innerHTML = \`
                        <tr>
                            <td colspan="9" class="px-4 py-8 text-center text-red-500">
                                <i class="fas fa-exclamation-triangle mr-2"></i>データの取得に失敗しました
                            </td>
                        </tr>
                    \`;
                }
            }

            function updatePagination(pagination) {
                const paginationDiv = document.getElementById('pagination');
                const paginationInfo = document.getElementById('paginationInfo');
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                
                paginationInfo.textContent = \`全\${pagination.total}件中 \${(pagination.page - 1) * pagination.per_page + 1}～\${Math.min(pagination.page * pagination.per_page, pagination.total)}件を表示\`;
                
                prevBtn.disabled = pagination.page <= 1;
                nextBtn.disabled = pagination.page >= pagination.total_pages;
                
                paginationDiv.classList.remove('hidden');
            }
        </script>
    </body>
    </html>
  `)
})

// 販売会社新規登録画面
app.get('/admin/vendors/new', async (c) => {
  const { DB } = c.env
  
  // 都道府県リスト取得
  const { results: prefs } = await DB.prepare(`
    SELECT id, name FROM prefs ORDER BY id
  `).all()
  
  const prefOptions = prefs.map(p => `<option value="${p.id}">${p.name}</option>`).join('')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
