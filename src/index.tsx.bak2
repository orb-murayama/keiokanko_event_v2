// API - 商品登録
app.post('/api/products', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.event_id || !data.prices || data.prices.length === 0 || !data.sales_start || !data.sales_end) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントからclient_idを取得
    const event = await DB.prepare(`
      SELECT client_id FROM events WHERE id = ?
    `).bind(parseInt(data.event_id)).first()
    
    if (!event) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    // 共通名称設定と取消条件設定をJSON形式に変換
    const commonNames = [];
    const cancellationPolicyDetails = [];
    
    for (let i = 1; i <= 5; i++) {
      if (data[`common_name_${i}`]) {
        commonNames.push({
          label: `名称${i}`,  // 「名称1」「名称2」...
          name: data[`common_name_${i}`],
          description: data[`common_desc_${i}`] || ''
        });
      }
      if (data[`cancellation_days_${i}`]) {
        cancellationPolicyDetails.push({
          days: parseInt(data[`cancellation_days_${i}`]),
          rate: parseInt(data[`cancellation_rate_${i}`]) || 0
        });
      }
    }
    
    // 商品を登録（テーブル構造に合わせて実際に存在するカラムのみ）
    const productResult = await DB.prepare(`
      INSERT INTO products (
        client_id, event_id, name, sales_start, sales_end, 
        closing_trade, description, remarks, fee_include, fee_exclude, 
        cancel_policy, purchase_limit, enable_flg,
        common_names, cancellation_policy_details,
        price_unit, charge_type, charge_description
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      event.client_id,
      parseInt(data.event_id),
      data.name,
      data.sales_start,
      data.sales_end,
      parseInt(data.closing_trade) || 0,
      data.description || '',
      data.remarks || '',
      data.fee_include || '',
      data.fee_exclude || '',
      data.cancel_policy || '',
      parseInt(data.purchase_limit) || null,
      parseInt(data.enable_flg) || 1,
      JSON.stringify(commonNames),
      JSON.stringify(cancellationPolicyDetails),
      data.price_unit || '人',
      data.charge_type || 'per_person',
      data.charge_description || ''
    ).run()
    
    const productId = productResult.meta.last_row_id
    
    // 価格帯データを登録（A, B, C... 各価格帯の5つの価格をそれぞれ保存）
    for (const priceData of data.prices) {
      const priceBand = priceData.price_band // "A", "B", "C"...
      
      // price_1 〜 price_5 をそれぞれ個別レコードとして登録
      for (let i = 1; i <= 5; i++) {
        const priceValue = priceData[`price_${i}`]
        if (priceValue && parseInt(priceValue) > 0) {
          // category_name には「価格帯A-名称1」のような識別子を保存
          const categoryName = `${priceBand}-名称${i}`
          
          await DB.prepare(`
            INSERT INTO product_prices (product_id, price, category_name)
            VALUES (?, ?, ?)
          `).bind(
            productId,
            parseInt(priceValue),
            categoryName
          ).run()
        }
      }
    }
    
    return c.json({ 
      success: true, 
      id: productId,
      message: '商品を登録しました' 
    })
  } catch (error) {
    console.error('Product registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品詳細取得
app.get('/api/products/:id', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    // 商品情報を取得
    const product = await DB.prepare(`
      SELECT 
        p.*,
        e.name as event_name
      FROM products p
      LEFT JOIN events e ON p.event_id = e.id
      WHERE p.id = ? AND p.deleted_at IS NULL
    `).bind(parseInt(productId)).first()
    
    if (!product) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    // 価格帯情報を取得
    const prices = await DB.prepare(`
      SELECT * FROM product_prices
      WHERE product_id = ?
      ORDER BY id
    `).bind(parseInt(productId)).all()
    
    // JSONフィールドをパース
    let commonNames = [];
    let cancellationPolicyDetails = [];
    try {
      if (product.common_names) {
        commonNames = JSON.parse(product.common_names);
      }
      if (product.cancellation_policy_details) {
        cancellationPolicyDetails = JSON.parse(product.cancellation_policy_details);
      }
    } catch (e) {
      console.error('JSON parse error:', e);
    }
    
    // pricesに共通名称を追加
    const enrichedPrices = (prices.results || []).map(priceItem => {
      // category_nameから「名称X」のXを抽出（例: "A-名称1" → 1）
      let commonName = '';
      let commonDescription = '';
      if (priceItem.category_name) {
        const match = priceItem.category_name.match(/名称(\d+)$/);
        if (match) {
          const slotNumber = parseInt(match[1]); // 1, 2, 3...
          // commonNamesから対応する名称を取得
          const commonNameItem = commonNames.find(item => item.label === `名称${slotNumber}`);
          if (commonNameItem) {
            commonName = commonNameItem.name || '';
            commonDescription = commonNameItem.description || '';
          }
        }
      }
      
      return {
        ...priceItem,
        common_name: commonName,          // 「大人」「子供」など
        common_description: commonDescription  // 「大人料金」など
      };
    });
    
    return c.json({ 
      product: {
        ...product,
        common_names: commonNames,
        cancellation_policy_details: cancellationPolicyDetails,
        prices: enrichedPrices
      }
    })
  } catch (error) {
    console.error('Product detail error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品更新
app.put('/api/products/:id', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.event_id) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 共通名称設定と取消条件設定をJSON形式に変換
    const commonNames = [];
    const cancellationPolicyDetails = [];
    
    for (let i = 1; i <= 5; i++) {
      if (data[`common_name_${i}`]) {
        commonNames.push({
          label: `名称${i}`,  // 「名称1」「名称2」...
          name: data[`common_name_${i}`],
          description: data[`common_desc_${i}`] || ''
        });
      }
      if (data[`cancellation_days_${i}`]) {
        cancellationPolicyDetails.push({
          days: parseInt(data[`cancellation_days_${i}`]),
          rate: parseInt(data[`cancellation_rate_${i}`]) || 0
        });
      }
    }
    
    // 商品を更新（実際に存在するカラムのみ）
    const result = await DB.prepare(`
      UPDATE products
      SET event_id = ?,
          name = ?,
          sales_start = ?,
          sales_end = ?,
          description = ?,
          remarks = ?,
          fee_include = ?,
          fee_exclude = ?,
          cancel_policy = ?,
          closing_trade = ?,
          purchase_limit = ?,
          enable_flg = ?,
          common_names = ?,
          cancellation_policy_details = ?,
          price_unit = ?,
          charge_type = ?,
          charge_description = ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      parseInt(data.event_id),
      data.name,
      data.sales_start,
      data.sales_end,
      data.description || '',
      data.remarks || '',
      data.fee_include || '',
      data.fee_exclude || '',
      data.cancel_policy || '',
      parseInt(data.closing_trade) || 0,
      parseInt(data.purchase_limit) || null,
      parseInt(data.enable_flg) || 1,
      JSON.stringify(commonNames),
      JSON.stringify(cancellationPolicyDetails),
      data.price_unit || '人',
      data.charge_type || 'per_person',
      data.charge_description || '',
      parseInt(productId)
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    // 価格帯データを更新（既存の価格を削除して再登録）
    if (data.prices && Array.isArray(data.prices)) {
      // 既存の価格をすべて削除
      await DB.prepare(`
        DELETE FROM product_prices WHERE product_id = ?
      `).bind(parseInt(productId)).run()
      
      // 新しい価格データを登録（A, B, C... 各価格帯の5つの価格をそれぞれ保存）
      for (const priceData of data.prices) {
        const priceBand = priceData.price_band // "A", "B", "C"...
        
        // price_1 〜 price_5 をそれぞれ個別レコードとして登録
        for (let i = 1; i <= 5; i++) {
          const priceValue = priceData[`price_${i}`]
          if (priceValue && parseInt(priceValue) > 0) {
            // category_name には「価格帯A-名称1」のような識別子を保存
            const categoryName = `${priceBand}-名称${i}`
            
            await DB.prepare(`
              INSERT INTO product_prices (product_id, price, category_name)
              VALUES (?, ?, ?)
            `).bind(
              parseInt(productId),
              parseInt(priceValue),
              categoryName
            ).run()
          }
        }
      }
    }
    
    return c.json({ 
      success: true,
      message: '商品を更新しました' 
    })
  } catch (error) {
    console.error('Product update error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - オプション登録
app.post('/api/options', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.event_id || !data.option_category_id || !data.price || !data.sales_start || !data.sales_end) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントが存在するか確認
    const event = await DB.prepare(`
      SELECT id FROM events WHERE id = ?
    `).bind(parseInt(data.event_id)).first()
    
    if (!event) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    // オプションを登録（client_idカラムは存在しないため除外）
    const optionResult = await DB.prepare(`
      INSERT INTO options (
        event_id, name, option_category_id,
        description, remarks, enable_flg, image_url
      ) VALUES (?, ?, ?, ?, ?, ?, ?)
    `).bind(
      parseInt(data.event_id),
      data.name,
      parseInt(data.option_category_id),
      data.description || '',
      data.remarks || '',
      parseInt(data.enable_flg) || 1,
      data.image_url || null
    ).run()
    
    const optionId = optionResult.meta.last_row_id
    
    // 価格を登録
    await DB.prepare(`
      INSERT INTO option_prices (option_id, price)
      VALUES (?, ?)
    `).bind(
      optionId,
      parseInt(data.price)
    ).run()
    
    return c.json({ 
      success: true, 
      id: optionId,
      message: 'オプションを登録しました' 
    })
  } catch (error) {
    console.error('Option registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 在庫登録
app.post('/api/stocks', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.product_id || !data.date || data.stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 同じ日付・在庫名・価格帯の在庫が既に存在するかチェック
    const existing = await DB.prepare(`
      SELECT id FROM product_stocks
      WHERE product_id = ? AND date = ? 
        AND (stock_name IS ? OR (stock_name IS NULL AND ? IS NULL))
        AND (price_band IS ? OR (price_band IS NULL AND ? IS NULL))
    `).bind(
      parseInt(data.product_id), 
      data.date,
      data.stock_name || null,
      data.stock_name || null,
      data.price_band || null,
      data.price_band || null
    ).first()
    
    if (existing) {
      return c.json({ error: 'この日付・在庫名・価格帯の在庫は既に登録されています。編集してください。' }, 400)
    }
    
    // 在庫を登録
    const result = await DB.prepare(`
      INSERT INTO product_stocks (
        product_id, date, stock_name, price_band, stock, booked
      ) VALUES (?, ?, ?, ?, ?, 0)
    `).bind(
      parseInt(data.product_id),
      data.date,
      data.stock_name || null,
      data.price_band || null,
      parseInt(data.stock)
    ).run()
    
    return c.json({ 
      success: true, 
      id: result.meta.last_row_id,
      message: '在庫を登録しました' 
    })
  } catch (error) {
    console.error('Stock registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

