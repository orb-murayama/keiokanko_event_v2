// API - 予約登録
app.post('/api/bookings', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.event_id || !data.product_id || !data.stock_id || !data.family_name || !data.first_name || !data.email || !data.tel) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }

    // booking_form_responsesテーブルを作成（存在しない場合）
    await DB.prepare(`
      CREATE TABLE IF NOT EXISTS booking_form_responses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        customer_id INTEGER NOT NULL,
        event_id INTEGER NOT NULL,
        field_id INTEGER NOT NULL,
        field_name TEXT NOT NULL,
        field_value TEXT,
        created_at TEXT DEFAULT (datetime('now', 'localtime')),
        modified_at TEXT DEFAULT (datetime('now', 'localtime')),
        FOREIGN KEY (customer_id) REFERENCES customers(id),
        FOREIGN KEY (event_id) REFERENCES events(id),
        FOREIGN KEY (field_id) REFERENCES event_form_fields(id)
      )
    `).run()

    // インデックス作成（存在しない場合）
    await DB.prepare(`
      CREATE INDEX IF NOT EXISTS idx_booking_form_responses_customer_id ON booking_form_responses(customer_id)
    `).run()
    await DB.prepare(`
      CREATE INDEX IF NOT EXISTS idx_booking_form_responses_event_id ON booking_form_responses(event_id)
    `).run()
    await DB.prepare(`
      CREATE INDEX IF NOT EXISTS idx_booking_form_responses_field_id ON booking_form_responses(field_id)
    `).run()
    
    // 在庫確認
    const stock = await DB.prepare(`
      SELECT stock, booked FROM product_stocks WHERE id = ?
    `).bind(parseInt(data.stock_id)).first()
    
    if (!stock) {
      return c.json({ error: '在庫が見つかりません' }, 404)
    }
    
    // 数量の合計を計算
    let totalQuantity = 0
    const quantities = data.quantities || {}
    for (const key in quantities) {
      totalQuantity += parseInt(quantities[key]) || 0
    }
    
    if (totalQuantity === 0) {
      return c.json({ error: '数量を1以上入力してください' }, 400)
    }
    
    if (stock.stock - stock.booked < totalQuantity) {
      return c.json({ error: '在庫が不足しています' }, 400)
    }

    // 商品の共有在庫チェック
    const productSharedStockCheck = await checkProductSharedStock(DB, parseInt(data.product_id), totalQuantity)
    if (!productSharedStockCheck.available) {
      return c.json({ error: productSharedStockCheck.message }, 400)
    }

    // オプションの共有在庫チェック
    const options = data.options || []
    const optionSharedStockChecks = []
    for (const optionData of options) {
      if (optionData.quantity > 0) {
        const optionCheck = await checkOptionSharedStock(DB, parseInt(optionData.option_id), parseInt(optionData.quantity))
        if (!optionCheck.available) {
          return c.json({ error: optionCheck.message }, 400)
        }
        optionSharedStockChecks.push({ optionId: optionData.option_id, quantity: optionData.quantity, pools: optionCheck.pools })
      }
    }
    
    // トランザクション開始（D1ではトランザクション未サポートなので、エラー時はロールバック処理が必要）
    
    // 顧客情報を登録
    const customerResult = await DB.prepare(`
      INSERT INTO customers (
        family_name, first_name, family_kana, first_kana, 
        email, tel, enable_flg
      ) VALUES (?, ?, ?, ?, ?, ?, 1)
    `).bind(
      data.family_name,
      data.first_name,
      data.family_kana || null,
      data.first_kana || null,
      data.email,
      data.tel
    ).run()
    
    const customerId = customerResult.meta.last_row_id
    
    // 価格情報を取得して予約を登録
    const prices = data.prices || []
    for (const priceData of prices) {
      if (priceData.quantity > 0) {
        await DB.prepare(`
          INSERT INTO product_bookings (
            customer_id, product_id, product_stock_id, price, quantity, enable_flg
          ) VALUES (?, ?, ?, ?, ?, 1)
        `).bind(
          customerId,
          parseInt(data.product_id),
          parseInt(data.stock_id),
          parseInt(priceData.price),
          parseInt(priceData.quantity)
        ).run()
      }
    }
    
    // 在庫の予約済数を更新
    await DB.prepare(`
      UPDATE product_stocks
      SET booked = booked + ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(totalQuantity, parseInt(data.stock_id)).run()

    // 商品の共有在庫を減算
    if (productSharedStockCheck.pools.length > 0) {
      await decrementSharedStock(DB, productSharedStockCheck.pools, totalQuantity)
    }
    
    // オプション予約を保存
    for (const optionData of options) {
      if (optionData.quantity > 0) {
        await DB.prepare(`
          INSERT INTO option_bookings (
            customer_id, option_id, quantity, price, enable_flg
          ) VALUES (?, ?, ?, ?, 1)
        `).bind(
          customerId,
          parseInt(optionData.option_id),
          parseInt(optionData.quantity),
          parseInt(optionData.price)
        ).run()
      }
    }

    // オプションの共有在庫を減算
    for (const optionCheck of optionSharedStockChecks) {
      if (optionCheck.pools.length > 0) {
        await decrementSharedStock(DB, optionCheck.pools, optionCheck.quantity)
      }
    }
    
    // カスタムフォームフィールドの回答を保存
    const customFields = data.custom_fields || {}
    for (const fieldId in customFields) {
      const value = customFields[fieldId]
      if (value && value !== '') {
        // field_idから数値部分を抽出
        const numericFieldId = parseInt(fieldId.replace('custom_', ''))
        
        await DB.prepare(`
          INSERT INTO booking_form_responses (
            customer_id, event_id, field_id, field_name, field_value
          ) VALUES (?, ?, ?, ?, ?)
        `).bind(
          customerId,
          parseInt(data.event_id),
          numericFieldId,
          `field_${numericFieldId}`,
          typeof value === 'object' ? JSON.stringify(value) : String(value)
        ).run()
      }
    }
    
    return c.json({ 
      success: true,
      customer_id: customerId,
      message: '予約が完了しました' 
    })
  } catch (error) {
    console.error('Booking registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 予約キャンセル
app.post('/api/bookings/:id/cancel', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('id')
  
  try {
    // 予約情報を取得
    const booking = await DB.prepare(`
      SELECT * FROM product_bookings WHERE id = ?
    `).bind(bookingId).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    if (booking.enable_flg === 0) {
      return c.json({ error: 'この予約は既にキャンセルされています' }, 400)
    }
    
    // 予約をキャンセル（enable_flg を 0 に設定）
    await DB.prepare(`
      UPDATE product_bookings
      SET enable_flg = 0,
          canceled_at = datetime('now', 'localtime'),
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(bookingId).run()
    
    // 在庫の予約済数を減らす
    if (booking.product_stock_id) {
      await DB.prepare(`
        UPDATE product_stocks
        SET booked = booked - ?,
            modified_at = datetime('now', 'localtime')
        WHERE id = ?
      `).bind(booking.quantity, booking.product_stock_id).run()
    }

    // 商品の共有在庫を戻す
    const productSharedStockCheck = await checkProductSharedStock(DB, booking.product_id, 0) // 0で在庫チェックスキップ、プール情報のみ取得
    if (productSharedStockCheck.pools.length > 0) {
      await incrementSharedStock(DB, productSharedStockCheck.pools, booking.quantity)
    }

    // オプション予約もキャンセル
    const { results: optionBookings } = await DB.prepare(`
      SELECT * FROM option_bookings WHERE customer_id = ? AND enable_flg = 1
    `).bind(booking.customer_id).all()

    for (const optionBooking of optionBookings) {
      await DB.prepare(`
        UPDATE option_bookings
        SET enable_flg = 0,
            canceled_at = datetime('now', 'localtime'),
            modified_at = datetime('now', 'localtime')
        WHERE id = ?
      `).bind(optionBooking.id).run()

      // オプションの共有在庫を戻す
      const optionSharedStockCheck = await checkOptionSharedStock(DB, optionBooking.option_id, 0)
      if (optionSharedStockCheck.pools.length > 0) {
        await incrementSharedStock(DB, optionSharedStockCheck.pools, optionBooking.quantity)
      }
    }
    
    return c.json({ 
      success: true,
      message: '予約をキャンセルしました' 
    })
  } catch (error) {
    console.error('Booking cancellation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

