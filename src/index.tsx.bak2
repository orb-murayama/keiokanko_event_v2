import { Hono } from 'hono'
import { cors } from 'hono/cors'
import { serveStatic } from 'hono/cloudflare-workers'
import type { Bindings, Event, Product, ProductPrice, ProductStock, Option, OptionPrice } from './types'

const app = new Hono<{ Bindings: Bindings }>()

// 環境変数から動作モードを取得
// APP_MODE=customer: お客様側画面のみ
// APP_MODE=admin: 管理画面のみ
// APP_MODE=all または未設定: 両方動作（開発環境用）
const getAppMode = (c: any): 'customer' | 'admin' | 'all' => {
  const mode = c.env?.APP_MODE || 'all'
  return mode as 'customer' | 'admin' | 'all'
}

// ルートアクセス制御ミドルウェア
const routeAccessControl = (requiredMode: 'customer' | 'admin') => {
  return async (c: any, next: any) => {
    const appMode = getAppMode(c)
    
    // allモードは全てのルートにアクセス可能
    if (appMode === 'all') {
      await next()
      return
    }
    
    // モードが一致しない場合は404を返す
    if (appMode !== requiredMode) {
      return c.notFound()
    }
    
    await next()
  }
}

// CORS設定（API用）
app.use('/api/*', cors())

// 静的ファイル配信
app.use('/static/*', serveStatic({ root: './public' }))

