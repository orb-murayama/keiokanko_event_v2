        <script>
            let currentPage = 1;
            let perPage = 20;
            let totalPages = 1;
            let searchParams = {};
            let branchesMap = {}; // 支店コードから支店名へのマップ

            const roleLabels = {
                'system_admin': 'システム管理者',
                'admin': '管理者',
                'branch': '支店',
                'client': 'クライアント'
            };

            const roleColors = {
                'system_admin': 'bg-red-100 text-red-800',
                'admin': 'bg-blue-100 text-blue-800',
                'branch': 'bg-green-100 text-green-800',
                'client': 'bg-gray-100 text-gray-800'
            };
            
            // 支店データを取得してマップを構築
            async function loadBranches() {
                try {
                    const response = await fetch('/api/branches');
                    const result = await response.json();
                    if (result.success && result.data) {
                        result.data.forEach(branch => {
                            branchesMap[branch.branch_code] = branch.branch_name;
                        });
                    }
                } catch (error) {
                    console.error('支店データ取得エラー:', error);
                }
            }
            
            // 所属支店を表示用にフォーマット
            function formatBranch(account) {
                if (!account.primary_branch_code) {
                    return '-';
                }
                const branchName = branchesMap[account.primary_branch_code] || account.primary_branch_code;
                
                // 追加アクセス権限がある場合
                if (account.accessible_branches) {
                    try {
                        const accessible = JSON.parse(account.accessible_branches);
                        if (accessible && accessible.length > 0) {
                            return branchName + ' <span class="text-xs text-gray-500">(+' + accessible.length + '支店)</span>';
                        }
                    } catch (e) {
                        // JSON解析エラーは無視
                    }
                }
                
                return branchName;
            }

            async function loadAccounts() {
                try {
                    console.log('アカウントデータをAPIから取得中...');
                    const params = new URLSearchParams({
                        page: currentPage,
                        per_page: perPage,
                        ...searchParams
                    });
                    
                    const response = await fetch(\`/api/accounts?\${params}\`);
                    if (!response.ok) {
                        throw new Error(\`HTTP error! status: \${response.status}\`);
                    }
                    
                    const result = await response.json();
                    console.log('取得したアカウントデータ:', result);
                    
                    const tbody = document.getElementById('accounts-tbody');
                    
                    if (!result.data || result.data.length === 0) {
                        tbody.innerHTML = \`
                            <tr>
                                <td colspan="8" class="px-4 py-8 text-center text-gray-500">
                                    <i class="fas fa-info-circle mr-2"></i>データがありません
                                </td>
                            </tr>
                        \`;
                        document.getElementById('pagination').classList.add('hidden');
                        return;
                    }
                    
                    tbody.innerHTML = result.data.map(account => \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 border-b">\${account.id}</td>
                            <td class="px-4 py-3 border-b font-mono text-sm">\${account.login_id}</td>
                            <td class="px-4 py-3 border-b">\${account.person_name}</td>
                            <td class="px-4 py-3 border-b text-sm">\${account.client_name || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${formatBranch(account)}</td>
                            <td class="px-4 py-3 border-b text-sm">\${account.email}</td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 text-xs rounded \${roleColors[account.role] || 'bg-gray-100 text-gray-800'}">
                                    \${roleLabels[account.role] || account.role}
                                </span>
                            </td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 text-xs rounded \${account.enable_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                    \${account.enable_flg ? '有効' : '無効'}
                                </span>
                            </td>
                            <td class="px-4 py-3 border-b">
                                <div class="flex gap-2">
                                    <a href="/admin/accounts/\${account.id}/edit" class="text-blue-600 hover:text-blue-800">
                                        <i class="fas fa-edit"></i>編集
                                    </a>
                                    <a href="/admin/accounts/\${account.id}" class="text-gray-600 hover:text-gray-800">
                                        <i class="fas fa-eye"></i>詳細
                                    </a>
                                </div>
                            </td>
                        </tr>
                    \`).join('');
                    
                    // ページネーション更新
                    totalPages = result.pagination.total_pages;
                    document.getElementById('pagination-info').textContent = 
                        \`全 \${result.pagination.total} 件中 \${(currentPage - 1) * perPage + 1} - \${Math.min(currentPage * perPage, result.pagination.total)} 件を表示\`;
                    document.getElementById('prev-page').disabled = currentPage === 1;
                    document.getElementById('next-page').disabled = currentPage >= totalPages;
                    document.getElementById('pagination').classList.remove('hidden');
                    
                } catch (error) {
                    console.error('アカウント一覧の取得に失敗:', error);
                    document.getElementById('accounts-tbody').innerHTML = \`
                        <tr>
                            <td colspan="8" class="px-4 py-8 text-center text-red-500">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                データの取得に失敗しました: \${error.message}
                            </td>
                        </tr>
                    \`;
                }
            }

            function changePage(page) {
                if (page < 1 || page > totalPages) return;
                currentPage = page;
                loadAccounts();
            }

            // 検索フォーム送信
            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                currentPage = 1;
                searchParams = {
                    login_id: document.getElementById('searchLoginId').value,
                    person_name: document.getElementById('searchPersonName').value,
                    email: document.getElementById('searchEmail').value
                };
                loadAccounts();
            });

            // 検索リセット
            function resetSearch() {
                document.getElementById('searchLoginId').value = '';
                document.getElementById('searchPersonName').value = '';
                document.getElementById('searchEmail').value = '';
                currentPage = 1;
                searchParams = {};
                loadAccounts();
            }

            // 初期読み込み
            document.addEventListener('DOMContentLoaded', async () => {
                await loadBranches(); // 支店データを先に読み込み
                loadAccounts();
            });
        </script>
    </body>
    </html>
  `)
})

// アカウント新規登録画面
app.get('/admin/accounts/new', async (c) => {
