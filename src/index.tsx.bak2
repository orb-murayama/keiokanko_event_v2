                                </label>
                                <input type="number" id="totalStock" required min="0" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                                    placeholder="50">
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>登録
                            </button>
                            <a href="/admin/shared-stock-pools" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            function getDateRange(startDate, endDate) {
                const dates = [];
                const currentDate = new Date(startDate);
                const end = endDate ? new Date(endDate) : new Date(startDate);
                
                while (currentDate <= end) {
                    dates.push(new Date(currentDate).toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
                
                return dates;
            }

            document.getElementById('poolForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const startDate = document.getElementById('poolDateStart').value;
                const endDate = document.getElementById('poolDateEnd').value || startDate;

                const data = {
                    pool_name: document.getElementById('poolName').value,
                    pool_code: document.getElementById('poolCode').value || null,
                    description: document.getElementById('poolDescription').value || null,
                    time_slot_label: document.getElementById('timeSlotLabel').value || null,
                    time_slot_start: document.getElementById('timeSlotStart').value || null,
                    time_slot_end: document.getElementById('timeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('totalStock').value),
                    date_start: startDate,
                    date_end: endDate,
                    enable_flg: 1
                };

                try {
                    const result = await axios.post('/api/shared-stock-pools/batch', data);
                    alert(\`\${result.data.created_count}個のプールを登録しました（\${startDate} ～ \${endDate}）\`);
                    window.location.href = '/admin/shared-stock-pools';
                } catch (error) {
                    console.error('Error:', error);
                    alert('保存に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 共有在庫プール編集
app.get('/admin/shared-stock-pools/:id/edit', async (c) => {
  const { DB } = c.env
  const poolId = c.req.param('id')

  const pool = await DB.prepare(`
    SELECT * FROM shared_stock_pools WHERE id = ?
  `).bind(parseInt(poolId)).first()

  if (!pool) {
    return c.text('プールが見つかりません', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>共有在庫プール編集 - 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/shared-stock-pools" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>プール一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">共有在庫プール編集</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-4xl mx-auto px-4">
                <div class="bg-white rounded-lg shadow-md p-6">
                    <form id="poolForm" class="space-y-6">
                        <!-- 日付設定（編集モードでは単一日付のみ） -->
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <div class="flex items-center mb-3">
                                <i class="fas fa-calendar-alt text-blue-600 mr-2"></i>
                                <h3 class="text-lg font-bold text-gray-800">日付設定</h3>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    日付 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="poolDate" required value="${pool.date}"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                            </div>
                            <p class="text-xs text-gray-600 mt-2">
                                <i class="fas fa-info-circle mr-1"></i>
                                編集モードでは単一日付のプールのみ変更できます。
                            </p>
                        </div>

                        <!-- プール詳細 -->
                        <div class="space-y-4">
                            <h3 class="text-lg font-bold text-gray-800">プール詳細</h3>
                            
                            <div class="grid md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        プール名 <span class="text-red-600">*</span>
                                    </label>
                                    <input type="text" id="poolName" required value="${pool.pool_name}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        プールコード <span class="text-gray-500 text-xs">(オプション)</span>
                                    </label>
                                    <input type="text" id="poolCode" value="${pool.pool_code || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    説明 <span class="text-gray-500 text-xs">(オプション)</span>
                                </label>
                                <textarea id="poolDescription" rows="2" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">${pool.description || ''}</textarea>
                            </div>

                            <div class="grid md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        時間帯ラベル
                                    </label>
                                    <input type="text" id="timeSlotLabel" value="${pool.time_slot_label || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        開始時刻
                                    </label>
                                    <input type="time" id="timeSlotStart" value="${pool.time_slot_start || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        終了時刻
                                    </label>
                                    <input type="time" id="timeSlotEnd" value="${pool.time_slot_end || ''}"
                                        class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    総在庫数 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="totalStock" required min="0" value="${pool.total_stock}"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                <p class="text-sm text-gray-600 mt-1">
                                    現在の予約済数: <span class="font-semibold text-red-600">${pool.booked}</span> / 
                                    利用可能: <span class="font-semibold text-green-600">${pool.available_stock}</span>
                                </p>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <button type="submit" 
                                class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i>更新
                            </button>
                            <a href="/admin/shared-stock-pools" 
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('poolForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const data = {
                    date: document.getElementById('poolDate').value,
                    pool_name: document.getElementById('poolName').value,
                    pool_code: document.getElementById('poolCode').value || null,
                    description: document.getElementById('poolDescription').value || null,
                    time_slot_label: document.getElementById('timeSlotLabel').value || null,
                    time_slot_start: document.getElementById('timeSlotStart').value || null,
                    time_slot_end: document.getElementById('timeSlotEnd').value || null,
                    total_stock: parseInt(document.getElementById('totalStock').value),
                    enable_flg: 1
                };

                try {
                    await axios.put('/api/shared-stock-pools/${poolId}', data);
                    alert('プールを更新しました');
                    window.location.href = '/admin/shared-stock-pools';
                } catch (error) {
                    console.error('Error:', error);
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 商品在庫管理
app.get('/admin/products/:id/stocks', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  // 商品情報を取得
  const product = await DB.prepare(`
    SELECT p.*, e.name as event_name
    FROM products p
    LEFT JOIN events e ON p.event_id = e.id
    WHERE p.id = ?
  `).bind(parseInt(productId)).first()
  
  if (!product) {
    return c.text('商品が見つかりません', 404)
  }
  
  // 価格帯情報を取得（category_nameから価格帯を抽出）
  const { results: prices } = await DB.prepare(`
    SELECT DISTINCT category_name
    FROM product_prices
    WHERE product_id = ? AND category_name IS NOT NULL
    ORDER BY category_name ASC
  `).bind(parseInt(productId)).all()
  
  // category_nameから価格帯（A, B, C...）を抽出
  const priceBandsSet = new Set()
  prices.forEach(p => {
    if (p.category_name) {
      const match = p.category_name.match(/^([A-Z])/)
      if (match) {
        priceBandsSet.add(match[1])
      }
    }
  })
  const priceBandsArray = Array.from(priceBandsSet).sort()
  
  const priceBandsOptions = priceBandsArray.map(pb => 
    `<option value="${pb}">${pb}</option>`
  ).join('')
  
  // 在庫情報を取得
  const { results: stocks } = await DB.prepare(`
    SELECT * FROM product_stocks
    WHERE product_id = ?
    ORDER BY date ASC, stock_name ASC, price_band ASC
  `).bind(parseInt(productId)).all()
  
  const stocksHtml = stocks.map(stock => {
    const available = stock.stock - stock.booked
    const stockData = JSON.stringify({
      id: stock.id,
      date: stock.date,
      stock_name: stock.stock_name || '',
      price_band: stock.price_band || '',
      stock: stock.stock
    })
    
    return `
      <tr class="hover:bg-gray-50">
        <td class="px-4 py-3 border-b">${stock.date}</td>
        <td class="px-4 py-3 border-b">
          ${stock.stock_name || '<span class="text-gray-400">未設定</span>'}
        </td>
        <td class="px-4 py-3 border-b text-center">
          ${stock.price_band ? `<span class="inline-block bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs font-bold">${stock.price_band}</span>` : '<span class="text-gray-400">未設定</span>'}
        </td>
        <td class="px-4 py-3 border-b text-right">
          <span class="font-semibold text-blue-600">${stock.stock.toLocaleString()}</span>
        </td>
        <td class="px-4 py-3 border-b text-right">
          <span class="text-red-600">${stock.booked.toLocaleString()}</span>
        </td>
        <td class="px-4 py-3 border-b text-right">
          <span class="font-semibold ${available > 0 ? 'text-green-600' : 'text-gray-400'}">
            ${available.toLocaleString()}
          </span>
        </td>
        <td class="px-4 py-3 border-b">
          <button onclick='editStock(${stockData.replace(/'/g, "\\'")})'
            class="text-blue-600 hover:text-blue-800 mr-3">
            <i class="fas fa-edit"></i>編集
          </button>
          <button onclick="deleteStock(${stock.id})" 
            class="text-red-600 hover:text-red-800">
            <i class="fas fa-trash"></i>削除
          </button>
        </td>
      </tr>
    `
  }).join('')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>在庫管理 - ${product.name} | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-green-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-boxes"></i>
                    在庫管理 - ${product.name}
                </h1>
                <p class="text-green-100 mt-2">イベント: ${product.event_name}</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/products" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-box"></i>商品管理
                    </a></li>
                    <li><span class="text-green-600 font-semibold">在庫管理</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <!-- 個別在庫設定 -->
            <div id="individualStockTab">
                <!-- 在庫登録フォーム -->
                <div class="bg-white rounded-b-lg shadow-md p-6 mb-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">個別在庫登録</h2>
                <form id="stockForm" class="space-y-4">
                    <input type="hidden" id="stockId" name="stock_id">
                    
                    <!-- 日付範囲選択 -->
                    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-4">
                        <div class="flex items-center mb-3">
                            <i class="fas fa-calendar-alt text-blue-600 mr-2"></i>
                            <h3 class="text-sm font-bold text-gray-800">日付設定</h3>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="stockDateStart" name="date_start" required 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                            
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-gray-500 text-xs">(未入力の場合は開始日のみ)</span>
                                </label>
                                <input type="date" id="stockDateEnd" name="date_end" 
                                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                        </div>
                        <p class="text-xs text-gray-600 mt-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            終了日を入力すると、開始日から終了日までの期間の在庫を一括で登録できます。
                        </p>
                    </div>
                    
                    <!-- 在庫詳細設定 -->
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                在庫名 <span class="text-gray-500 text-xs">(例: 午前、11時～12時)</span>
                            </label>
                            <input type="text" id="stockName" name="stock_name" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="午前">
                        </div>
                        
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                価格帯 <span class="text-gray-500 text-xs">(商品登録で設定した価格帯)</span>
                            </label>
                            <select id="priceBand" name="price_band" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <option value="">選択してください</option>
                                ${priceBandsOptions}
                            </select>
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                在庫数 <span class="text-red-600">*</span>
                            </label>
                            <input type="number" id="stockQuantity" name="stock" required min="0" 
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                placeholder="100">
                        </div>
                        
                        <div class="flex items-end">
                            <button type="submit" 
                                class="w-full bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition font-semibold">
                                <i class="fas fa-save mr-2"></i><span id="submitButtonText">登録</span>
                            </button>
                            <button type="button" id="cancelButton" onclick="cancelEdit()" style="display:none;"
                                class="ml-2 bg-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- 在庫一覧 -->
            <div class="bg-white rounded-lg shadow-md p-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">在庫一覧</h2>
                    <div class="text-sm text-gray-600">
                        <span class="mr-4">
                            <i class="fas fa-box text-blue-600 mr-1"></i>
                            総在庫: <strong>${stocks.reduce((sum, s) => sum + s.stock, 0).toLocaleString()}</strong>
                        </span>
                        <span class="mr-4">
                            <i class="fas fa-clipboard-check text-red-600 mr-1"></i>
                            予約済: <strong>${stocks.reduce((sum, s) => sum + s.booked, 0).toLocaleString()}</strong>
                        </span>
                        <span>
                            <i class="fas fa-check-circle text-green-600 mr-1"></i>
                            利用可能: <strong>${stocks.reduce((sum, s) => sum + (s.stock - s.booked), 0).toLocaleString()}</strong>
                        </span>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">日付</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">在庫名</th>
                                <th class="px-4 py-3 text-center text-sm font-semibold text-gray-700">価格帯</th>
                                <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">在庫数</th>
                                <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">予約済</th>
                                <th class="px-4 py-3 text-right text-sm font-semibold text-gray-700">利用可能</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${stocksHtml || '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">在庫が登録されていません</td></tr>'}
                        </tbody>
                    </table>
                </div>
            </div>
            </div>

        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const productId = ${productId};
            
            // 日付範囲から日付配列を生成
            function getDateRange(startDate, endDate) {
                const dates = [];
                const currentDate = new Date(startDate);
                const end = endDate ? new Date(endDate) : new Date(startDate);
                
                while (currentDate <= end) {
                    dates.push(new Date(currentDate).toISOString().split('T')[0]);
                    currentDate.setDate(currentDate.getDate() + 1);
                }
                
                return dates;
            }
            
            // 在庫登録・更新
            document.getElementById('stockForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const formData = new FormData(e.target);
                const stockId = formData.get('stock_id');
                
                // 編集モードの場合は単一日付で更新
                if (stockId) {
                    const data = {
                        product_id: productId,
                        date: formData.get('date_start'),
                        stock_name: formData.get('stock_name') || null,
                        price_band: formData.get('price_band') || null,
                        stock: parseInt(formData.get('stock'))
                    };
                    
                    try {
                        await axios.put(\`/api/stocks/\${stockId}\`, data);
                        alert('在庫を更新しました！');
                        window.location.reload();
                    } catch (error) {
                        console.error('Error:', error);
                        alert('処理に失敗しました: ' + (error.response?.data?.error || error.message));
                    }
                    return;
                }
                
                // 新規登録（一括登録対応）
                const startDate = formData.get('date_start');
                const endDate = formData.get('date_end');
                const stockName = formData.get('stock_name') || null;
                const priceBand = formData.get('price_band') || null;
                const stock = parseInt(formData.get('stock'));
                
                // 日付範囲を取得
                const dates = getDateRange(startDate, endDate);
                
                // 確認メッセージ
                const confirmMessage = dates.length > 1 
                    ? \`\${startDate} から \${endDate} までの \${dates.length} 日分の在庫を登録します。よろしいですか？\`
                    : \`\${startDate} の在庫を登録します。よろしいですか？\`;
                
                if (!confirm(confirmMessage)) {
                    return;
                }
                
                try {
                    // 各日付に対して在庫を登録
                    let successCount = 0;
                    let errorCount = 0;
                    const errors = [];
                    
                    for (const date of dates) {
                        const data = {
                            product_id: productId,
                            date: date,
                            stock_name: stockName,
                            price_band: priceBand,
                            stock: stock
                        };
                        
                        try {
                            await axios.post('/api/stocks', data);
                            successCount++;
                        } catch (error) {
                            errorCount++;
                            errors.push(\`\${date}: \${error.response?.data?.error || error.message}\`);
                        }
                    }
                    
                    // 結果を表示
                    if (errorCount === 0) {
                        alert(\`\${successCount} 日分の在庫を登録しました！\`);
                    } else {
                        alert(\`成功: \${successCount} 日分\\n失敗: \${errorCount} 日分\\n\\nエラー詳細:\\n\${errors.join('\\n')}\`);
                    }
                    
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('処理に失敗しました: ' + error.message);
                }
            });
            
            // 編集モード
            function editStock(stockData) {
                document.getElementById('stockId').value = stockData.id;
                document.getElementById('stockDateStart').value = stockData.date;
                document.getElementById('stockDateEnd').value = ''; // 編集時は終了日を空に
                document.getElementById('stockDateEnd').disabled = true; // 編集時は終了日を無効化
                document.getElementById('stockName').value = stockData.stock_name || '';
                document.getElementById('priceBand').value = stockData.price_band || '';
                document.getElementById('stockQuantity').value = stockData.stock;
                
                document.getElementById('submitButtonText').textContent = '更新';
                document.getElementById('cancelButton').style.display = 'block';
                document.getElementById('stockDateStart').scrollIntoView({ behavior: 'smooth' });
            }
            
            // 編集キャンセル
            function cancelEdit() {
                document.getElementById('stockForm').reset();
                document.getElementById('stockId').value = '';
                document.getElementById('stockDateEnd').disabled = false; // 終了日を有効化
                document.getElementById('submitButtonText').textContent = '登録';
                document.getElementById('cancelButton').style.display = 'none';
            }
            
            // 在庫削除
            async function deleteStock(id) {
                if (!confirm('この在庫を削除してもよろしいですか？')) {
                    return;
                }
                
                try {
                    await axios.delete(\`/api/stocks/\${id}\`);
                    alert('在庫を削除しました！');
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('削除に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            }

            // タブ切り替え
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 商品の共有在庫設定
app.get('/admin/products/:id/shared-stocks', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')

  // 商品情報を取得
  const { results: products } = await DB.prepare(`
    SELECT * FROM products WHERE id = ?
  `).bind(productId).all()

  if (products.length === 0) {
    return c.text('商品が見つかりません', 404)
  }

  const product = products[0]

  // 現在の共有在庫設定を取得
  const { results: sharedStocks } = await DB.prepare(`
    SELECT pss.*, ssp.pool_name, ssp.pool_code, ssp.date, ssp.time_slot_label,
           ssp.total_stock, ssp.booked, ssp.available_stock
    FROM product_shared_stocks pss
    JOIN shared_stock_pools ssp ON pss.shared_stock_pool_id = ssp.id
    WHERE pss.product_id = ? AND pss.enable_flg = 1 AND ssp.enable_flg = 1
    ORDER BY ssp.date ASC, ssp.time_slot_start
  `).bind(productId).all()

  // 利用可能な共有在庫プール（プール名でグループ化）を取得
  const { results: availablePools } = await DB.prepare(`
    SELECT DISTINCT pool_name, pool_code
    FROM shared_stock_pools
    WHERE enable_flg = 1
    GROUP BY pool_name, pool_code
    ORDER BY pool_name
  `).all()

  // 商品の価格帯を取得（category_nameから抽出）
  const { results: prices } = await DB.prepare(`
    SELECT DISTINCT category_name FROM product_prices
    WHERE product_id = ? AND category_name IS NOT NULL
    ORDER BY category_name
  `).bind(productId).all()
  
  // category_nameから価格帯（A, B, C...）を抽出
  const priceBandsSet = new Set()
  prices.forEach(p => {
    if (p.category_name) {
      const match = p.category_name.match(/^([A-Z])/)
      if (match) {
        priceBandsSet.add(match[1])
      }
    }
  })
  const priceBandsArray = Array.from(priceBandsSet).sort()

  const sharedStocksHtml = sharedStocks.length > 0 ? sharedStocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b">
        <div class="font-medium text-gray-900">${stock.pool_name}</div>
        ${stock.pool_code ? `<div class="text-xs text-gray-500">コード: ${stock.pool_code}</div>` : ''}
      </td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">${stock.date}</td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">
        ${stock.time_slot_label || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-center">${stock.price_band || '-'}</td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock}
        </span>
        <span class="text-gray-500">/ ${stock.total_stock}</span>
      </td>
      <td class="px-4 py-3 border-b">
        ${stock.stock_name || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="deleteSharedStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i> 削除
        </button>
      </td>
    </tr>
  `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">まだ共有在庫が設定されていません</td></tr>'

  const poolsOptions = availablePools.map(pool => {
    const label = `${pool.pool_name}${pool.pool_code ? ' (' + pool.pool_code + ')' : ''}`
    return `<option value="${pool.pool_name}|${pool.pool_code || ''}">${label}</option>`
  }).join('')

  const priceBandsOptions = priceBandsArray.map(pb => 
    `<option value="${pb}">${pb}価格</option>`
  ).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${product.name} - 共有在庫設定 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/products" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>商品一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${product.name} - 共有在庫設定</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- 商品情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-box mr-2 text-blue-600"></i>商品情報
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">商品名</p>
                            <p class="text-lg font-semibold">${product.name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">商品ID</p>
                            <p class="text-lg font-semibold">${product.id}</p>
                        </div>
                    </div>
                </div>

                <!-- 共有在庫追加フォーム -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>共有在庫を追加
                    </h2>
                    <form id="addSharedStockForm" class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    共有在庫プール <span class="text-red-600">*</span>
                                </label>
                                <select id="poolName" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                    <option value="">選択してください</option>
                                    ${poolsOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    価格帯 <span class="text-red-600">*</span>
                                </label>
                                <select id="priceBand" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                    <option value="">選択してください</option>
                                    ${priceBandsOptions}
                                </select>
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateEnd" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                表示名（オプション）
                            </label>
                            <input type="text" id="stockName" placeholder="例: バス座席"
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                        </div>
                        <div class="flex gap-4">
                            <button type="submit"
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>共有在庫を追加
                            </button>
                            <button type="button" onclick="document.getElementById('addSharedStockForm').reset()"
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 現在の共有在庫設定 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-list mr-2 text-blue-600"></i>設定済み共有在庫
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">プール名</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">時間帯</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">価格帯</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">表示名</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody id="sharedStocksTable">
                                ${sharedStocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const productId = ${productId};

            // 共有在庫追加
            document.getElementById('addSharedStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const poolValue = document.getElementById('poolName').value;
                const [poolName, poolCode] = poolValue.split('|');

                const data = {
                    pool_name: poolName,
                    pool_code: poolCode || null,
                    date_start: document.getElementById('dateStart').value,
                    date_end: document.getElementById('dateEnd').value,
                    price_band: document.getElementById('priceBand').value,
                    stock_name: document.getElementById('stockName').value || null
                };

                try {
                    const result = await axios.post(\`/api/products/\${productId}/shared-stocks/batch\`, data);
                    alert(\`共有在庫を追加しました（\${result.data.added_count}件）\`);
                    window.location.reload();
                } catch (error) {
                    alert('追加に失敗しました: ' + (error.response?.data?.error || error.message));
                    console.error(error);
                }
            });

            // 共有在庫削除
            async function deleteSharedStock(linkId) {
                if (!confirm('この共有在庫設定を削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/products/\${productId}/shared-stocks/\${linkId}\`);
                    alert('共有在庫設定を削除しました');
                    window.location.reload();
                } catch (error) {
                    alert('削除に失敗しました');
                    console.error(error);
                }
            }
        </script>
    </body>
    </html>
  `)
})

// API: 商品に共有在庫を一括追加
app.post('/api/products/:id/shared-stocks/batch', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // 必須フィールドチェック
    if (!data.pool_name || !data.date_start) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 日付範囲を取得
    const startDate = new Date(data.date_start)
    const endDate = data.date_end ? new Date(data.date_end) : startDate
    const dates = []
    
    for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
      dates.push(d.toISOString().split('T')[0])
    }
    
    let addedCount = 0
    let errors = []
    
    for (const date of dates) {
      // 該当する共有在庫プールを検索
      const pool = await DB.prepare(`
        SELECT id FROM shared_stock_pools
        WHERE pool_name = ? 
          AND (pool_code IS NULL AND ? IS NULL OR pool_code = ?)
          AND date = ?
          AND enable_flg = 1
      `).bind(
        data.pool_name,
        data.pool_code || null,
        data.pool_code || null,
        date
      ).first()
      
      if (!pool) {
        errors.push(`${date}: 該当する共有在庫プールが見つかりません`)
        continue
      }
      
      // 既存の設定をチェック
      const existing = await DB.prepare(`
        SELECT id FROM product_shared_stocks
        WHERE product_id = ? AND shared_stock_pool_id = ?
          AND (price_band IS NULL AND ? IS NULL OR price_band = ?)
      `).bind(
        parseInt(productId),
        pool.id,
        data.price_band || null,
        data.price_band || null
      ).first()
      
      if (existing) {
        errors.push(`${date}: 既に設定済みです`)
        continue
      }
      
      // 共有在庫設定を追加
      await DB.prepare(`
        INSERT INTO product_shared_stocks 
        (product_id, shared_stock_pool_id, stock_name, price_band, enable_flg)
        VALUES (?, ?, ?, ?, 1)
      `).bind(
        parseInt(productId),
        pool.id,
        data.stock_name || null,
        data.price_band || null
      ).run()
      
      addedCount++
    }
    
    return c.json({
      success: true,
      added_count: addedCount,
      errors: errors.length > 0 ? errors : null,
      message: `${addedCount}件の共有在庫を追加しました`
    })
  } catch (error) {
    console.error('Shared stock batch creation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 商品の共有在庫設定を削除
app.delete('/api/products/:id/shared-stocks/:linkId', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const linkId = c.req.param('linkId')
  
  try {
    // 設定が存在するかチェック
    const existing = await DB.prepare(`
      SELECT * FROM product_shared_stocks
      WHERE id = ? AND product_id = ?
    `).bind(parseInt(linkId), parseInt(productId)).first()
    
    if (!existing) {
      return c.json({ error: '共有在庫設定が見つかりません' }, 404)
    }
    
    // 設定を削除
    await DB.prepare(`
      DELETE FROM product_shared_stocks WHERE id = ?
    `).bind(parseInt(linkId)).run()
    
    return c.json({
      success: true,
      message: '共有在庫設定を削除しました'
    })
  } catch (error) {
    console.error('Shared stock deletion error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 管理画面 - オプションの共有在庫設定
app.get('/admin/options/:id/shared-stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')

  // オプション情報を取得
  const { results: options } = await DB.prepare(`
    SELECT * FROM options WHERE id = ?
  `).bind(optionId).all()

  if (options.length === 0) {
    return c.text('オプションが見つかりません', 404)
  }

  const option = options[0]

  // 現在の共有在庫設定を取得
  const { results: sharedStocks } = await DB.prepare(`
    SELECT oss.*, ssp.pool_name, ssp.pool_code, ssp.date, ssp.time_slot_label,
           ssp.total_stock, ssp.booked, ssp.available_stock
    FROM option_shared_stocks oss
    JOIN shared_stock_pools ssp ON oss.shared_stock_pool_id = ssp.id
    WHERE oss.option_id = ? AND oss.enable_flg = 1 AND ssp.enable_flg = 1
    ORDER BY ssp.date ASC, ssp.time_slot_start
  `).bind(optionId).all()

  // 利用可能な共有在庫プール（プール名単位）を取得
  const { results: availablePools } = await DB.prepare(`
    SELECT DISTINCT pool_name, pool_code
    FROM shared_stock_pools
    WHERE enable_flg = 1
    ORDER BY pool_name
  `).all()

  const sharedStocksHtml = sharedStocks.length > 0 ? sharedStocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b">
        <div class="font-medium text-gray-900">${stock.pool_name}</div>
        ${stock.pool_code ? `<div class="text-xs text-gray-500">コード: ${stock.pool_code}</div>` : ''}
      </td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">${stock.date}</td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">
        ${stock.time_slot_label || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-right">
        <span class="font-semibold text-blue-600">${stock.price ? stock.price.toLocaleString() : '-'}</span>
        ${stock.price ? '<span class="text-xs text-gray-500">円</span>' : ''}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock}
        </span>
        <span class="text-gray-500">/ ${stock.total_stock}</span>
      </td>
      <td class="px-4 py-3 border-b">
        ${stock.stock_name || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="deleteSharedStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i> 削除
        </button>
      </td>
    </tr>
  `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">まだ共有在庫が設定されていません</td></tr>'

  const poolsOptions = availablePools.map(pool => {
    const label = pool.pool_code ? `${pool.pool_name} (${pool.pool_code})` : pool.pool_name
    return `<option value="${pool.pool_name}|${pool.pool_code || ''}">${label}</option>`
  }).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${option.name} - 共有在庫設定 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/options" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>オプション一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${option.name} - 共有在庫設定</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- オプション情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-puzzle-piece mr-2 text-purple-600"></i>オプション情報
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">オプション名</p>
                            <p class="text-lg font-semibold">${option.name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">オプションID</p>
                            <p class="text-lg font-semibold">${option.id}</p>
                        </div>
                    </div>
                </div>

                <!-- 共有在庫追加フォーム（期間一括登録） -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>共有在庫を追加（期間一括登録）
                    </h2>
                    <form id="addSharedStockForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                共有在庫プール <span class="text-red-600">*</span>
                            </label>
                            <select id="poolSelect" required
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <option value="">選択してください</option>
                                ${poolsOptions}
                            </select>
                            <p class="text-xs text-gray-500 mt-1">プール名単位で選択</p>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateEnd" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    料金 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="price" min="0" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <p class="text-xs text-gray-500 mt-1">円</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    表示名（オプション）
                                </label>
                                <input type="text" id="stockName" placeholder="例: バス座席"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <button type="submit"
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>共有在庫を一括追加
                            </button>
                            <button type="button" onclick="document.getElementById('addSharedStockForm').reset()"
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 現在の共有在庫設定 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-list mr-2 text-blue-600"></i>設定済み共有在庫
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">プール名</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">時間帯</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">料金</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">表示名</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody id="sharedStocksTable">
                                ${sharedStocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const optionId = ${optionId};

            // 共有在庫追加（期間一括登録）
            document.getElementById('addSharedStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const poolValue = document.getElementById('poolSelect').value;
                const [pool_name, pool_code] = poolValue.split('|');

                const data = {
                    pool_name,
                    pool_code: pool_code || null,
                    date_start: document.getElementById('dateStart').value,
                    date_end: document.getElementById('dateEnd').value,
                    price: parseInt(document.getElementById('price').value),
                    stock_name: document.getElementById('stockName').value || null
                };

                try {
                    const response = await axios.post(\`/api/options/\${optionId}/shared-stocks/batch\`, data);
                    alert(response.data.message || '共有在庫を追加しました');
                    window.location.reload();
                } catch (error) {
                    alert('追加に失敗しました: ' + (error.response?.data?.error || error.message));
                    console.error(error);
                }
            });

            // 共有在庫削除
            async function deleteSharedStock(linkId) {
                if (!confirm('この共有在庫設定を削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/options/\${optionId}/shared-stocks/\${linkId}\`);
                    alert('共有在庫設定を削除しました');
                    window.location.reload();
                } catch (error) {
                    alert('削除に失敗しました');
                    console.error(error);
                }
            }
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - オプションの在庫管理
app.get('/admin/options/:id/stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')

  // オプション情報を取得
  const { results: options } = await DB.prepare(`
    SELECT o.*, e.name as event_name
    FROM options o
    LEFT JOIN events e ON o.event_id = e.id
    WHERE o.id = ?
  `).bind(optionId).all()

  if (options.length === 0) {
    return c.text('オプションが見つかりません', 404)
  }

  const option = options[0]

  // 在庫設定を取得
  const { results: stocks } = await DB.prepare(`
    SELECT 
      id,
      option_id,
      date,
      stock_name,
      price,
      total_stock,
      booked,
      available_stock,
      enable_flg,
      created_at,
      modified_at
    FROM option_stocks
    WHERE option_id = ? AND enable_flg = 1
    ORDER BY date ASC
  `).bind(optionId).all()

  const stocksHtml = stocks.length > 0 ? stocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b text-sm text-gray-700">${stock.date || '<span class="text-gray-400">日付指定なし</span>'}</td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">${stock.stock_name || '<span class="text-gray-400">-</span>'}</td>
      <td class="px-4 py-3 border-b text-right text-sm text-gray-700">¥${stock.price?.toLocaleString() || 0}</td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold text-blue-600">${stock.total_stock}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold text-orange-600">${stock.booked}</span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock}
        </span>
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="editStock(${stock.id})" class="text-blue-600 hover:text-blue-800 mr-2">
          <i class="fas fa-edit"></i>
        </button>
        <button onclick="deleteStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i>
        </button>
      </td>
    </tr>
  `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">まだ在庫が設定されていません</td></tr>'

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${option.name} - 在庫管理 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/options" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>オプション一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${option.name} - 在庫管理</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- オプション情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-puzzle-piece mr-2 text-purple-600"></i>オプション情報
                    </h2>
                    <div class="grid md:grid-cols-3 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">オプション名</p>
                            <p class="text-lg font-semibold">${option.name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">イベント名</p>
                            <p class="text-lg font-semibold">${option.event_name || '-'}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">オプションID</p>
                            <p class="text-lg font-semibold">${option.id}</p>
                        </div>
                    </div>
                </div>

                <!-- 在庫追加フォーム -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>在庫を追加
                    </h2>
                    <form id="addStockForm" class="space-y-4">
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateEnd" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="grid md:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    在庫名（オプション）
                                </label>
                                <input type="text" id="stockName" placeholder="例: 午前便、午後便"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <p class="text-xs text-gray-500 mt-1">未入力の場合は空白として登録されます</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    料金 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="price" value="0" min="0" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <p class="text-xs text-gray-500 mt-1">円</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    総在庫数 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="totalStock" value="0" min="0" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <button type="submit"
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>期間一括登録
                            </button>
                            <button type="button" onclick="document.getElementById('addStockForm').reset()"
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 在庫一覧 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-box mr-2 text-blue-600"></i>在庫一覧
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">在庫名</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">料金</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">総在庫</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">予約済み</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${stocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script>
            // 在庫追加フォーム送信
            document.getElementById('addStockForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const dateStart = document.getElementById('dateStart').value
                const dateEnd = document.getElementById('dateEnd').value
                const stockName = document.getElementById('stockName').value
                const price = parseInt(document.getElementById('price').value)
                const totalStock = parseInt(document.getElementById('totalStock').value)

                if (!dateStart || !dateEnd) {
                    alert('開始日と終了日を入力してください')
                    return
                }

                if (new Date(dateStart) > new Date(dateEnd)) {
                    alert('開始日は終了日より前の日付を指定してください')
                    return
                }

                try {
                    const response = await axios.post('/api/options/${optionId}/stocks', {
                        dateStart,
                        dateEnd,
                        stockName: stockName || null,
                        price,
                        totalStock
                    })

                    if (response.data.success) {
                        alert('在庫を登録しました')
                        location.reload()
                    } else {
                        alert('エラー: ' + (response.data.message || '在庫の登録に失敗しました'))
                    }
                } catch (error) {
                    console.error(error)
                    alert('在庫の登録に失敗しました: ' + (error.response?.data?.message || error.message))
                }
            })

            // 在庫削除
            async function deleteStock(stockId) {
                if (!confirm('この在庫を削除しますか？')) return

                try {
                    const response = await axios.delete(\`/api/options/${optionId}/stocks/\${stockId}\`)

                    if (response.data.success) {
                        alert('在庫を削除しました')
                        location.reload()
                    } else {
                        alert('エラー: ' + (response.data.message || '在庫の削除に失敗しました'))
                    }
                } catch (error) {
                    console.error(error)
                    alert('在庫の削除に失敗しました: ' + (error.response?.data?.message || error.message))
                }
            }

            // 在庫編集（将来的に実装）
            function editStock(stockId) {
                alert('在庫編集機能は近日実装予定です')
            }
        </script>
    </body>
    </html>
  `)
})

// API - イベント登録
app.post('/api/events', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.client_id || !data.customer_client_id || !data.contact) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントURL、開催期間、受付期間の必須チェック
    if (!data.event_url || !data.event_start_date || !data.event_end_date || !data.registration_start_date || !data.registration_end_date) {
      return c.json({ error: 'イベントURL、開催期間、受付期間は必須です' }, 400)
    }
    
    // イベントURLの一意性チェック
    const existingEvent = await DB.prepare(`
      SELECT id FROM events WHERE event_url = ?
    `).bind(data.event_url).first()
    
    if (existingEvent) {
      return c.json({ error: 'このイベントURLは既に使用されています' }, 400)
    }
    
    // コンビニ店舗を配列からJSONに変換
    const convenienceStores = data.convenience_stores ? JSON.stringify(data.convenience_stores) : null
    
    // イベントを登録（全項目対応）
    const result = await DB.prepare(`
      INSERT INTO events (
        name, detail, location, contact, remarks, thanks_msg,
        name_en, detail_en, location_en, contact_en, remarks_en, thanks_msg_en,
        organizer_id, client_id, customer_client_id, vendor_id, branch_code, enable_flg,
        event_url, category, date_selection_type,
        event_type, parent_event_id,
        event_start_date, event_end_date,
        registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, admin_cc_email, sender_name, sender_email,
        email_signature, email_signature_en,
        payment_flg, payment_methods,
        bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name,
        store_code, bank_transfer_deadline, convenience_payment_deadline,
        available_convenience_stores,
        credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        form_field_settings,
        auto_reply_enabled,
        auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.detail || '',
      data.location || null,
      data.contact,
      data.remarks || '',
      data.thanks_msg || '',
      data.name_en || null,
      data.detail_en || null,
      data.location_en || null,
      data.contact_en || null,
      data.remarks_en || null,
      data.thanks_msg_en || null,
      data.client_id ? parseInt(data.client_id) : null, // organizer_id
      data.customer_client_id ? parseInt(data.customer_client_id) : parseInt(data.client_id), // client_id
      data.customer_client_id ? parseInt(data.customer_client_id) : null,
      data.vendor_id ? parseInt(data.vendor_id) : null,
      data.branch_code || null,
      parseInt(data.enable_flg) || 1,
      data.event_url || null,
      data.category || null,
      data.date_selection_type || 'button',
      data.event_type || 'standalone',
      data.parent_event_id ? parseInt(data.parent_event_id) : null,
      data.event_start_date || null,
      data.event_end_date || null,
      data.registration_start_date || null,
      data.registration_end_date || null,
      data.admin_login_start_date || null,
      data.admin_login_end_date || null,
      data.admin_email || null,
      data.admin_cc_email || null,
      data.sender_name || null,
      data.sender_email || null,
      data.email_signature || null,
      data.email_signature_en || null,
      parseInt(data.payment_flg) || 0,
      parseInt(data.payment_methods) || 1,
      data.bank_name || null,
      data.bank_branch || null,
      data.bank_account_type || null,
      data.bank_account_number || null,
      data.bank_account_name || null,
      data.store_code || null,
      parseInt(data.bank_transfer_deadline) || 7,
      parseInt(data.convenience_payment_deadline) || 7,
      convenienceStores,
      data.credit_fee_type || 'none',
      parseFloat(data.credit_fee_percentage) || 0,
      parseInt(data.credit_fee_fixed) || 0,
      data.bank_fee_type || 'none',
      parseFloat(data.bank_fee_percentage) || 0,
      parseInt(data.bank_fee_fixed) || 0,
      data.convenience_fee_type || 'none',
      parseFloat(data.convenience_fee_percentage) || 0,
      parseInt(data.convenience_fee_fixed) || 0,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}',
      data.auto_reply_enabled ? 1 : 0,
      data.auto_reply_credit_payment || null,
      data.auto_reply_bank_payment || null,
      data.auto_reply_convenience_payment || null,
      data.auto_reply_credit_cancel || null,
      data.auto_reply_bank_cancel || null,
      data.auto_reply_convenience_cancel || null,
      data.auto_reply_credit_refund || null,
      data.auto_reply_bank_deposit || null,
      data.auto_reply_bank_refund || null,
      data.auto_reply_convenience_deposit || null,
      data.auto_reply_convenience_refund || null,
      data.auto_reply_credit_payment_en || null,
      data.auto_reply_bank_payment_en || null,
      data.auto_reply_convenience_payment_en || null,
      data.auto_reply_credit_cancel_en || null,
      data.auto_reply_bank_cancel_en || null,
      data.auto_reply_convenience_cancel_en || null,
      data.auto_reply_credit_refund_en || null,
      data.auto_reply_bank_deposit_en || null,
      data.auto_reply_bank_refund_en || null,
      data.auto_reply_convenience_deposit_en || null,
      data.auto_reply_convenience_refund_en || null
    ).run()
    
    return c.json({ 
      success: true, 
      id: result.meta.last_row_id,
      message: 'イベントを登録しました' 
    })
  } catch (error) {
    console.error('Event registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - イベント更新
app.put('/api/events/:id', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.contact) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントURL、開催期間、受付期間の必須チェック
    if (!data.event_url || !data.event_start_date || !data.event_end_date || !data.registration_start_date || !data.registration_end_date) {
      return c.json({ error: 'イベントURL、開催期間、受付期間は必須です' }, 400)
    }
    
    // イベントURLの一意性チェック（自分以外のイベントで同じURLが使われていないか確認）
    const existingEvent = await DB.prepare(`
      SELECT id FROM events WHERE event_url = ? AND id != ?
    `).bind(data.event_url, eventId).first()
    
    if (existingEvent) {
      return c.json({ error: 'このイベントURLは既に使用されています' }, 400)
    }
    
    // コンビニ店舗を配列からJSONに変換
    const convenienceStores = data.convenience_stores ? JSON.stringify(data.convenience_stores) : null
    
    // イベントを更新（全項目対応）
    const result = await DB.prepare(`
      UPDATE events
      SET name = ?,
          detail = ?,
          location = ?,
          contact = ?,
          remarks = ?,
          thanks_msg = ?,
          name_en = ?,
          detail_en = ?,
          location_en = ?,
          contact_en = ?,
          remarks_en = ?,
          thanks_msg_en = ?,
          enable_flg = ?,
          payment_flg = ?,
          payment_methods = ?,
          event_url = ?,
          category = ?,
          date_selection_type = ?,
          event_type = ?,
          parent_event_id = ?,
          event_start_date = ?,
          event_end_date = ?,
          registration_start_date = ?,
          registration_end_date = ?,
          admin_login_start_date = ?,
          admin_login_end_date = ?,
          admin_email = ?,
          admin_cc_email = ?,
          sender_name = ?,
          sender_email = ?,
          email_signature = ?,
          email_signature_en = ?,
          customer_client_id = ?,
          organizer_id = ?,
          vendor_id = ?,
          branch_code = ?,
          bank_name = ?,
          bank_branch = ?,
          bank_account_type = ?,
          bank_account_number = ?,
          bank_account_name = ?,
          store_code = ?,
          bank_transfer_deadline = ?,
          convenience_payment_deadline = ?,
          available_convenience_stores = ?,
          credit_fee_type = ?,
          credit_fee_percentage = ?,
          credit_fee_fixed = ?,
          bank_fee_type = ?,
          bank_fee_percentage = ?,
          bank_fee_fixed = ?,
          convenience_fee_type = ?,
          convenience_fee_percentage = ?,
          convenience_fee_fixed = ?,
          form_field_settings = ?,
          auto_reply_enabled = ?,
          auto_reply_credit_payment = ?,
          auto_reply_bank_payment = ?,
          auto_reply_convenience_payment = ?,
          auto_reply_credit_cancel = ?,
          auto_reply_bank_cancel = ?,
          auto_reply_convenience_cancel = ?,
          auto_reply_credit_refund = ?,
          auto_reply_bank_deposit = ?,
          auto_reply_bank_refund = ?,
          auto_reply_convenience_deposit = ?,
          auto_reply_convenience_refund = ?,
          auto_reply_credit_payment_en = ?,
          auto_reply_bank_payment_en = ?,
          auto_reply_convenience_payment_en = ?,
          auto_reply_credit_cancel_en = ?,
          auto_reply_bank_cancel_en = ?,
          auto_reply_convenience_cancel_en = ?,
          auto_reply_credit_refund_en = ?,
          auto_reply_bank_deposit_en = ?,
          auto_reply_bank_refund_en = ?,
          auto_reply_convenience_deposit_en = ?,
          auto_reply_convenience_refund_en = ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.name,
      data.detail || '',
      data.location || null,
      data.contact,
      data.remarks || '',
      data.thanks_msg || '',
      data.name_en || null,
      data.detail_en || null,
      data.location_en || null,
      data.contact_en || null,
      data.remarks_en || null,
      data.thanks_msg_en || null,
      parseInt(data.enable_flg) || 1,
      parseInt(data.payment_flg) || 0,
      parseInt(data.payment_methods) || 1,
      data.event_url || null,
      data.category || null,
      data.date_selection_type || 'button',
      data.event_type || 'standalone',
      data.parent_event_id ? parseInt(data.parent_event_id) : null,
      data.event_start_date || null,
      data.event_end_date || null,
      data.registration_start_date || null,
      data.registration_end_date || null,
      data.admin_login_start_date || null,
      data.admin_login_end_date || null,
      data.admin_email || null,
      data.admin_cc_email || null,
      data.sender_name || null,
      data.sender_email || null,
      data.email_signature || null,
      data.email_signature_en || null,
      data.customer_client_id ? parseInt(data.customer_client_id) : null,
      data.client_id ? parseInt(data.client_id) : null,
      data.vendor_id ? parseInt(data.vendor_id) : null,
      data.branch_code || null,
      data.bank_name || null,
      data.bank_branch || null,
      data.bank_account_type || null,
      data.bank_account_number || null,
      data.bank_account_name || null,
      data.store_code || null,
      parseInt(data.bank_transfer_deadline) || 7,
      parseInt(data.convenience_payment_deadline) || 7,
      convenienceStores,
      data.credit_fee_type || 'none',
      parseFloat(data.credit_fee_percentage) || 0,
      parseInt(data.credit_fee_fixed) || 0,
      data.bank_fee_type || 'none',
      parseFloat(data.bank_fee_percentage) || 0,
      parseInt(data.bank_fee_fixed) || 0,
      data.convenience_fee_type || 'none',
      parseFloat(data.convenience_fee_percentage) || 0,
      parseInt(data.convenience_fee_fixed) || 0,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}',
      data.auto_reply_enabled ? 1 : 0,
      data.auto_reply_credit_payment || null,
      data.auto_reply_bank_payment || null,
      data.auto_reply_convenience_payment || null,
      data.auto_reply_credit_cancel || null,
      data.auto_reply_bank_cancel || null,
      data.auto_reply_convenience_cancel || null,
      data.auto_reply_credit_refund || null,
      data.auto_reply_bank_deposit || null,
      data.auto_reply_bank_refund || null,
      data.auto_reply_convenience_deposit || null,
      data.auto_reply_convenience_refund || null,
      data.auto_reply_credit_payment_en || null,
      data.auto_reply_bank_payment_en || null,
      data.auto_reply_convenience_payment_en || null,
      data.auto_reply_credit_cancel_en || null,
      data.auto_reply_bank_cancel_en || null,
      data.auto_reply_convenience_cancel_en || null,
      data.auto_reply_credit_refund_en || null,
      data.auto_reply_bank_deposit_en || null,
      data.auto_reply_bank_refund_en || null,
      data.auto_reply_convenience_deposit_en || null,
      data.auto_reply_convenience_refund_en || null,
      eventId
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    return c.json({ 
      success: true,
      message: 'イベントを更新しました' 
    })
  } catch (error) {
    console.error('Event update error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - オプション在庫の追加（期間一括登録）
app.post('/api/options/:id/stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  try {
    const { dateStart, dateEnd, stockName, price, totalStock } = await c.req.json()

    if (!dateStart || !dateEnd || price === undefined || totalStock === undefined) {
      return c.json({ success: false, message: '必須項目が不足しています' }, 400)
    }

    const start = new Date(dateStart)
    const end = new Date(dateEnd)

    if (start > end) {
      return c.json({ success: false, message: '開始日は終了日より前の日付を指定してください' }, 400)
    }

    // 日付ごとにループして登録
    let insertCount = 0
    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
      const dateStr = d.toISOString().split('T')[0]

      // 重複チェック
      const { results: existing } = await DB.prepare(`
        SELECT id FROM option_stocks 
        WHERE option_id = ? AND date = ? AND stock_name IS ?
      `).bind(optionId, dateStr, stockName || null).all()

      if (existing.length > 0) {
        continue // 既存の在庫がある場合はスキップ
      }

      // 在庫を登録
      await DB.prepare(`
        INSERT INTO option_stocks (option_id, date, stock_name, price, total_stock, booked, available_stock, enable_flg)
        VALUES (?, ?, ?, ?, ?, 0, ?, 1)
      `).bind(optionId, dateStr, stockName || null, price, totalStock, totalStock).run()

      insertCount++
    }

    return c.json({ success: true, message: `${insertCount}件の在庫を登録しました`, count: insertCount })
  } catch (error: any) {
    console.error('在庫追加エラー:', error)
    return c.json({ success: false, message: error.message }, 500)
  }
})

// API - オプション在庫の削除
app.delete('/api/options/:id/stocks/:stockId', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('stockId')
  
  try {
    // enable_flgを0に設定（論理削除）
    await DB.prepare(`
      UPDATE option_stocks SET enable_flg = 0, modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(stockId).run()

    return c.json({ success: true, message: '在庫を削除しました' })
  } catch (error: any) {
    console.error('在庫削除エラー:', error)
    return c.json({ success: false, message: error.message }, 500)
  }
})

// API - CSV出力（予約データ）
app.get('/api/bookings/export/csv', async (c) => {
  const { DB } = c.env
  
  try {
    const eventId = c.req.query('event_id')
    
    let query = `
      SELECT 
        pb.id as booking_id,
        e.name as event_name,
        p.name as product_name,
        ps.date as booking_date,
        ps.stock_name,
        c.family_name,
        c.first_name,
        c.email,
        c.tel,
        pb.quantity,
        pb.price,
        (pb.quantity * pb.price) as total_price,
        pb.enable_flg,
        pb.created_at
      FROM product_bookings pb
      JOIN customers c ON pb.customer_id = c.id
      JOIN products p ON pb.product_id = p.id
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
      WHERE pb.enable_flg = 1
    `
    
    const params = []
    if (eventId) {
      query += ` AND e.id = ?`
      params.push(parseInt(eventId))
    }
    
    query += ` ORDER BY pb.created_at DESC`
    
    const stmt = DB.prepare(query)
    const { results: bookings } = params.length > 0 ? await stmt.bind(...params).all() : await stmt.all()
    
    // CSV形式に変換
    let csv = '\uFEFF' // UTF-8 BOM for Excel
    csv += '予約ID,イベント名,商品名,予約日,時間帯,姓,名,メールアドレス,電話番号,数量,単価,合計金額,ステータス,予約日時\n'
    
    bookings.forEach(booking => {
      csv += [
        booking.booking_id,
        `"${booking.event_name}"`,
        `"${booking.product_name}"`,
        booking.booking_date || '',
        `"${booking.stock_name || ''}"`,
        `"${booking.family_name}"`,
        `"${booking.first_name}"`,
        booking.email,
        booking.tel,
        booking.quantity,
        booking.price,
        booking.total_price,
        booking.enable_flg === 1 ? '有効' : 'キャンセル',
        booking.created_at
      ].join(',') + '\n'
    })
    
    return new Response(csv, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename="bookings_${new Date().toISOString().slice(0, 10)}.csv"`
      }
    })
  } catch (error) {
    console.error('CSV export error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - レポート（売上集計）
app.get('/api/reports/sales', async (c) => {
  const { DB } = c.env
  
  try {
    const eventId = c.req.query('event_id')
    
    // イベント別売上集計
    let eventSalesQuery = `
      SELECT 
        e.id as event_id,
        e.name as event_name,
        COUNT(DISTINCT pb.id) as total_bookings,
        SUM(pb.quantity) as total_quantity,
        SUM(pb.quantity * pb.price) as total_sales
      FROM events e
      LEFT JOIN products p ON e.id = p.event_id
      LEFT JOIN product_bookings pb ON p.id = pb.product_id AND pb.enable_flg = 1
    `
    
    const eventParams = []
    if (eventId) {
      eventSalesQuery += ` WHERE e.id = ?`
      eventParams.push(parseInt(eventId))
    }
    
    eventSalesQuery += ` GROUP BY e.id, e.name ORDER BY total_sales DESC`
    
    const eventStmt = DB.prepare(eventSalesQuery)
    const { results: eventSales } = eventParams.length > 0 ? await eventStmt.bind(...eventParams).all() : await eventStmt.all()
    
    // 商品別売上集計
    let productSalesQuery = `
      SELECT 
        p.id as product_id,
        p.name as product_name,
        e.name as event_name,
        COUNT(pb.id) as total_bookings,
        SUM(pb.quantity) as total_quantity,
        SUM(pb.quantity * pb.price) as total_sales
      FROM products p
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_bookings pb ON p.id = pb.product_id AND pb.enable_flg = 1
    `
    
    const productParams = []
    if (eventId) {
      productSalesQuery += ` WHERE e.id = ?`
      productParams.push(parseInt(eventId))
    }
    
    productSalesQuery += ` GROUP BY p.id, p.name, e.name ORDER BY total_sales DESC`
    
    const productStmt = DB.prepare(productSalesQuery)
    const { results: productSales } = productParams.length > 0 ? await productStmt.bind(...productParams).all() : await productStmt.all()
    
    // オプション別売上集計
    let optionSalesQuery = `
      SELECT 
        o.id as option_id,
        o.name as option_name,
        e.name as event_name,
        COUNT(ob.id) as total_bookings,
        SUM(ob.quantity) as total_quantity,
        SUM(ob.quantity * ob.price) as total_sales
      FROM options o
      JOIN events e ON o.event_id = e.id
      LEFT JOIN option_bookings ob ON o.id = ob.option_id AND ob.enable_flg = 1
    `
    
    const optionParams = []
    if (eventId) {
      optionSalesQuery += ` WHERE e.id = ?`
      optionParams.push(parseInt(eventId))
    }
    
    optionSalesQuery += ` GROUP BY o.id, o.name, e.name ORDER BY total_sales DESC`
    
    const optionStmt = DB.prepare(optionSalesQuery)
    const { results: optionSales } = optionParams.length > 0 ? await optionStmt.bind(...optionParams).all() : await optionStmt.all()
    
    return c.json({
      success: true,
      eventSales,
      productSales,
      optionSales
    })
  } catch (error) {
    console.error('Sales report error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品画像アップロード
app.post('/api/products/upload-image', async (c) => {
  const { R2 } = c.env
  
  try {
    const formData = await c.req.formData()
    const file = formData.get('image')
    
    if (!file || !(file instanceof File)) {
      return c.json({ error: '画像ファイルが選択されていません' }, 400)
    }
    
    // ファイルサイズチェック（5MB制限）
    if (file.size > 5 * 1024 * 1024) {
      return c.json({ error: '画像ファイルは5MB以下にしてください' }, 400)
    }
    
    // ファイルタイプチェック
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp']
    if (!allowedTypes.includes(file.type)) {
      return c.json({ error: '対応していない画像形式です（JPEG, PNG, GIF, WebPのみ）' }, 400)
    }
    
    // ファイル名を生成（タイムスタンプ + ランダム文字列）
    const timestamp = Date.now()
    const randomStr = Math.random().toString(36).substring(2, 15)
    const ext = file.name.split('.').pop()
    const fileName = `products/${timestamp}-${randomStr}.${ext}`
    
    // R2にアップロード
    const arrayBuffer = await file.arrayBuffer()
    await R2.put(fileName, arrayBuffer, {
      httpMetadata: {
        contentType: file.type
      }
    })
    
    // URLを返す（本番環境ではカスタムドメインまたはR2のPublic URLを使用）
    const imageUrl = `/api/products/images/${fileName}`
    
    return c.json({ 
      success: true,
      image_url: imageUrl,
      file_name: fileName
    })
  } catch (error) {
    console.error('Image upload error:', error)
    return c.json({ error: '画像のアップロードに失敗しました' }, 500)
  }
})

// API - 商品画像取得
app.get('/api/products/images/*', async (c) => {
  const { R2 } = c.env
  const fileName = c.req.path.replace('/api/products/images/', '')
  
  try {
    const object = await R2.get(fileName)
    
    if (!object) {
      return c.notFound()
    }
    
    const headers = new Headers()
    headers.set('Content-Type', object.httpMetadata?.contentType || 'image/jpeg')
    headers.set('Cache-Control', 'public, max-age=31536000')
    
    return new Response(object.body, { headers })
  } catch (error) {
    console.error('Image fetch error:', error)
    return c.notFound()
  }
})

