// API - OTP生成とメール送信
app.post('/api/auth/send-otp', async (c) => {
  const { DB } = c.env
  const { email } = await c.req.json()
  
  if (!email) {
    return c.json({ error: 'メールアドレスが必要です' }, 400)
  }
  
  try {
    // メールアドレスが登録されているか確認
    const customer = await DB.prepare(`
      SELECT * FROM customers WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.json({ error: 'このメールアドレスでの予約が見つかりません' }, 404)
    }
    
    // 6桁のOTPコードを生成
    const otpCode = Math.floor(100000 + Math.random() * 900000).toString()
    
    // 有効期限を10分後に設定
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000).toISOString()
    
    // 既存の未使用OTPを無効化
    await DB.prepare(`
      UPDATE otp_codes 
      SET is_used = 1 
      WHERE email = ? AND is_used = 0
    `).bind(email).run()
    
    // 新しいOTPを保存
    await DB.prepare(`
      INSERT INTO otp_codes (email, code, expires_at)
      VALUES (?, ?, ?)
    `).bind(email, otpCode, expiresAt).run()
    
    // 本番環境ではメール送信サービスを使用
    // 開発環境ではコンソールにOTPを出力
    console.log('='.repeat(50))
    console.log('📧 OTP送信シミュレーション')
    console.log(`宛先: ${email}`)
    console.log(`OTPコード: ${otpCode}`)
    console.log(`有効期限: ${new Date(expiresAt).toLocaleString('ja-JP')}`)
    console.log('='.repeat(50))
    
    return c.json({ 
      success: true,
      message: 'ワンタイムパスワードを送信しました',
      // 開発環境でのテスト用（本番環境では削除すること）
      dev_otp: otpCode
    })
  } catch (error) {
    console.error('OTP generation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - OTP検証
app.post('/api/auth/verify-otp', async (c) => {
  const { DB } = c.env
  const { email, code } = await c.req.json()
  
  if (!email || !code) {
    return c.json({ error: 'メールアドレスとOTPコードが必要です' }, 400)
  }
  
  try {
    // OTPコードを取得
    const otp = await DB.prepare(`
      SELECT * FROM otp_codes 
      WHERE email = ? AND code = ? AND is_used = 0
      ORDER BY created_at DESC
      LIMIT 1
    `).bind(email, code).first()
    
    if (!otp) {
      // 試行回数をカウント（セキュリティ対策）
      await DB.prepare(`
        UPDATE otp_codes 
        SET attempt_count = attempt_count + 1
        WHERE email = ? AND is_used = 0
      `).bind(email).run()
      
      return c.json({ error: 'OTPコードが正しくありません' }, 401)
    }
    
    // 有効期限チェック
    const now = new Date()
    const expiresAt = new Date(otp.expires_at)
    
    if (now > expiresAt) {
      return c.json({ error: 'OTPコードの有効期限が切れています' }, 401)
    }
    
    // 試行回数チェック（5回まで）
    if (otp.attempt_count >= 5) {
      return c.json({ error: '試行回数が上限に達しました。新しいOTPを取得してください' }, 429)
    }
    
    // OTPを使用済みにする
    await DB.prepare(`
      UPDATE otp_codes 
      SET is_used = 1, 
          used_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(otp.id).run()
    
    return c.json({ 
      success: true,
      message: '認証に成功しました',
      email: email
    })
  } catch (error) {
    console.error('OTP verification error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// マイページ - ログイン画面
app.get('/mypage', (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>マイページ | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-blue-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-user-circle"></i>
                    マイページ
                </h1>
                <p class="text-blue-100 mt-2">予約確認・キャンセル</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-alt"></i>イベント一覧
                    </a></li>
                    <li><a href="/mypage" class="text-blue-600 font-semibold hover:text-blue-800 flex items-center gap-2">
                        <i class="fas fa-user-circle"></i>マイページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-md mx-auto">
                <!-- ステップ1: メールアドレス入力 -->
                <div id="step1" class="bg-white rounded-lg shadow-md p-8">
                    <div class="text-center mb-6">
                        <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-100 rounded-full mb-4">
                            <i class="fas fa-envelope text-blue-600 text-3xl"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">予約確認</h2>
                        <p class="text-gray-600">予約時に使用したメールアドレスを入力してください</p>
                    </div>

                    <form id="emailForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-envelope mr-2"></i>メールアドレス
                            </label>
                            <input type="email" id="email" required 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                   placeholder="example@example.com">
                        </div>

                        <button type="submit" id="sendOtpBtn"
                                class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg flex items-center justify-center gap-2 transition">
                            <i class="fas fa-paper-plane"></i>
                            認証コードを送信
                        </button>
                    </form>

                    <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                        <p class="text-sm text-blue-800">
                            <i class="fas fa-shield-alt mr-2"></i>
                            セキュリティのため、ワンタイムパスワードによる認証を行います
                        </p>
                    </div>
                </div>

                <!-- ステップ2: OTP入力 -->
                <div id="step2" class="bg-white rounded-lg shadow-md p-8" style="display: none;">
                    <div class="text-center mb-6">
                        <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 rounded-full mb-4">
                            <i class="fas fa-key text-green-600 text-3xl"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">認証コード入力</h2>
                        <p class="text-gray-600" id="sentEmailText"></p>
                    </div>

                    <form id="otpForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-lock mr-2"></i>6桁の認証コード
                            </label>
                            <input type="text" id="otpCode" required maxlength="6" pattern="[0-9]{6}"
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-transparent text-center text-2xl tracking-widest font-mono"
                                   placeholder="000000"
                                   autocomplete="off">
                        </div>

                        <button type="submit" id="verifyOtpBtn"
                                class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg flex items-center justify-center gap-2 transition">
                            <i class="fas fa-check-circle"></i>
                            認証して予約を確認
                        </button>

                        <button type="button" id="backToStep1Btn"
                                class="w-full bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-6 rounded-lg flex items-center justify-center gap-2 transition">
                            <i class="fas fa-arrow-left"></i>
                            メールアドレスを変更
                        </button>
                    </form>

                    <div class="mt-6 p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                        <p class="text-sm text-yellow-800 mb-2">
                            <i class="fas fa-clock mr-2"></i>
                            認証コードは10分間有効です
                        </p>
                        <p class="text-sm text-yellow-800" id="devOtpDisplay" style="display: none;">
                            <i class="fas fa-info-circle mr-2"></i>
                            <strong>開発環境:</strong> OTPコード = <span id="devOtpCode" class="font-mono font-bold"></span>
                        </p>
                    </div>

                    <div class="mt-4 text-center">
                        <button type="button" id="resendOtpBtn" class="text-blue-600 hover:text-blue-800 text-sm font-semibold">
                            <i class="fas fa-redo mr-1"></i>認証コードを再送信
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
        let currentEmail = '';
        
        // ステップ1: メールアドレス送信
        document.getElementById('emailForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const email = document.getElementById('email').value;
            const sendBtn = document.getElementById('sendOtpBtn');
            
            sendBtn.disabled = true;
            sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>送信中...';
            
            try {
                const response = await axios.post('/api/auth/send-otp', { email });
                
                if (response.data.success) {
                    currentEmail = email;
                    
                    // ステップ2へ移行
                    document.getElementById('step1').style.display = 'none';
                    document.getElementById('step2').style.display = 'block';
                    document.getElementById('sentEmailText').textContent = 
                        email + ' に認証コードを送信しました';
                    
                    // 開発環境でOTPを表示
                    if (response.data.dev_otp) {
                        document.getElementById('devOtpDisplay').style.display = 'block';
                        document.getElementById('devOtpCode').textContent = response.data.dev_otp;
                    }
                    
                    // OTP入力欄にフォーカス
                    setTimeout(() => {
                        document.getElementById('otpCode').focus();
                    }, 100);
                }
            } catch (error) {
                console.error('OTP send error:', error);
                alert(error.response?.data?.error || 'エラーが発生しました');
            } finally {
                sendBtn.disabled = false;
                sendBtn.innerHTML = '<i class="fas fa-paper-plane"></i> 認証コードを送信';
            }
        });
        
        // ステップ2: OTP検証
        document.getElementById('otpForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const code = document.getElementById('otpCode').value;
            const verifyBtn = document.getElementById('verifyOtpBtn');
            
            if (code.length !== 6 || !/^\d{6}$/.test(code)) {
                alert('6桁の数字を入力してください');
                return;
            }
            
            verifyBtn.disabled = true;
            verifyBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>認証中...';
            
            try {
                const response = await axios.post('/api/auth/verify-otp', {
                    email: currentEmail,
                    code: code
                });
                
                if (response.data.success) {
                    // 認証成功 → 予約一覧へ
                    window.location.href = '/mypage/bookings?email=' + encodeURIComponent(currentEmail);
                }
            } catch (error) {
                console.error('OTP verify error:', error);
                alert(error.response?.data?.error || '認証に失敗しました');
                document.getElementById('otpCode').value = '';
                document.getElementById('otpCode').focus();
            } finally {
                verifyBtn.disabled = false;
                verifyBtn.innerHTML = '<i class="fas fa-check-circle"></i> 認証して予約を確認';
            }
        });
        
        // 戻るボタン
        document.getElementById('backToStep1Btn').addEventListener('click', () => {
            document.getElementById('step2').style.display = 'none';
            document.getElementById('step1').style.display = 'block';
            document.getElementById('otpCode').value = '';
            currentEmail = '';
        });
        
        // 再送信ボタン
        document.getElementById('resendOtpBtn').addEventListener('click', async () => {
            const resendBtn = document.getElementById('resendOtpBtn');
            resendBtn.disabled = true;
            resendBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i>送信中...';
            
            try {
                const response = await axios.post('/api/auth/send-otp', { email: currentEmail });
                
                if (response.data.success) {
                    alert('認証コードを再送信しました');
                    
                    // 開発環境でOTPを表示
                    if (response.data.dev_otp) {
                        document.getElementById('devOtpCode').textContent = response.data.dev_otp;
                    }
                }
            } catch (error) {
                console.error('OTP resend error:', error);
                alert(error.response?.data?.error || '再送信に失敗しました');
            } finally {
                resendBtn.disabled = false;
                resendBtn.innerHTML = '<i class="fas fa-redo mr-1"></i>認証コードを再送信';
            }
        });
        
        // 数字のみ入力を許可
        document.getElementById('otpCode').addEventListener('input', (e) => {
            e.target.value = e.target.value.replace(/[^0-9]/g, '');
        });
        </script>
    </body>
    </html>
  `)
})

// マイページ - 予約一覧
app.get('/mypage/bookings', async (c) => {
  const { DB } = c.env
  const email = c.req.query('email')
  
  if (!email) {
    return c.redirect('/mypage')
  }
  
  try {
    // 顧客情報を取得
    const customer = await DB.prepare(`
      SELECT * FROM customers WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.html('<h1>予約が見つかりません</h1><a href="/mypage">戻る</a>', 404)
    }
    
    // 予約一覧を取得
    const { results: bookings } = await DB.prepare(`
      SELECT 
        pb.*,
        p.name as product_name,
        ps.date,
        ps.stock_name,
        ps.price_band,
        e.name as event_name,
        e.id as event_id
      FROM product_bookings pb
      JOIN products p ON pb.product_id = p.id
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
      WHERE pb.customer_id = ?
      ORDER BY pb.created_at DESC
    `).bind(customer.id).all()
    
    // 各予約のオプションを取得
    const bookingsWithOptions = await Promise.all(bookings.map(async (booking) => {
      const { results: options } = await DB.prepare(`
        SELECT 
          ob.*,
          o.name as option_name
        FROM option_bookings ob
        JOIN options o ON ob.option_id = o.id
        WHERE ob.product_booking_id = ?
      `).bind(booking.id).all()
      
      return { ...booking, options }
    }))
    
    const bookingCards = bookingsWithOptions.map(booking => {
      const totalAmount = booking.price * booking.quantity + 
        (booking.options?.reduce((sum, opt) => sum + (opt.price * opt.quantity), 0) || 0)
      
      const statusBadge = booking.enable_flg 
        ? '<span class="px-3 py-1 bg-green-100 text-green-800 text-sm font-semibold rounded-full">予約中</span>'
        : '<span class="px-3 py-1 bg-red-100 text-red-800 text-sm font-semibold rounded-full">キャンセル済</span>'
      
      const optionsHtml = booking.options && booking.options.length > 0
        ? `
          <div class="mt-3 pt-3 border-t border-gray-200">
            <p class="text-sm font-semibold text-gray-700 mb-2">オプション:</p>
            ${booking.options.map(opt => `
              <div class="flex justify-between text-sm text-gray-600">
                <span>・${opt.option_name}</span>
                <span>${opt.quantity}個 × ¥${opt.price.toLocaleString()} = ¥${(opt.price * opt.quantity).toLocaleString()}</span>
              </div>
            `).join('')}
          </div>
        `
        : ''
      
      const cancelButton = booking.enable_flg
        ? `<button onclick="cancelBooking(${booking.id})" 
                   class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-lg text-center transition">
              <i class="fas fa-ban mr-2"></i>キャンセル
           </button>`
        : ''
      
      return `
        <div class="bg-white rounded-lg shadow-md p-6 mb-4">
          <div class="flex items-start justify-between mb-4">
            <div>
              <h3 class="text-xl font-bold text-gray-800 mb-1">${booking.event_name}</h3>
              <p class="text-gray-600">${booking.product_name}</p>
              ${booking.date ? `<p class="text-sm text-gray-500 mt-1"><i class="fas fa-calendar mr-1"></i>${booking.date}</p>` : ''}
            </div>
            ${statusBadge}
          </div>
          
          <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <span class="text-gray-600">価格帯:</span>
                <span class="font-semibold ml-2">${booking.price_band || booking.stock_name || '-'}</span>
              </div>
              <div>
                <span class="text-gray-600">数量:</span>
                <span class="font-semibold ml-2">${booking.quantity}個</span>
              </div>
              <div>
                <span class="text-gray-600">単価:</span>
                <span class="font-semibold ml-2">¥${booking.price.toLocaleString()}</span>
              </div>
              <div>
                <span class="text-gray-600">小計:</span>
                <span class="font-semibold ml-2">¥${(booking.price * booking.quantity).toLocaleString()}</span>
              </div>
            </div>
            ${optionsHtml}
            <div class="mt-3 pt-3 border-t border-gray-300">
              <div class="flex justify-between text-lg font-bold">
                <span>合計金額:</span>
                <span class="text-blue-600">¥${totalAmount.toLocaleString()}</span>
              </div>
            </div>
          </div>
          
          <div class="flex gap-3 text-sm text-gray-500 mb-4">
            <div><i class="fas fa-clock mr-1"></i>予約日時: ${new Date(booking.created_at).toLocaleString('ja-JP')}</div>
            ${booking.canceled_at ? `<div><i class="fas fa-ban mr-1"></i>キャンセル日時: ${new Date(booking.canceled_at).toLocaleString('ja-JP')}</div>` : ''}
          </div>
          
          <div class="flex gap-3">
            <a href="/events/${booking.event_id}" 
               class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg text-center transition">
              <i class="fas fa-info-circle mr-2"></i>イベント詳細
            </a>
            ${cancelButton}
          </div>
        </div>
      `
    }).join('')
    
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>予約一覧 | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
      </head>
      <body class="bg-gray-50 min-h-screen">
          <header class="bg-blue-600 text-white shadow-lg">
              <div class="container mx-auto px-4 py-6">
                  <h1 class="text-3xl font-bold flex items-center gap-3">
                      <i class="fas fa-user-circle"></i>
                      マイページ
                  </h1>
                  <p class="text-blue-100 mt-2">${customer.family_name} ${customer.first_name} 様の予約一覧</p>
              </div>
          </header>

          <nav class="bg-white shadow-md border-b">
              <div class="container mx-auto px-4">
                  <ul class="flex gap-6 py-4">
                      <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-home"></i>トップページ
                      </a></li>
                      <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-calendar-alt"></i>イベント一覧
                      </a></li>
                      <li><a href="/mypage" class="text-blue-600 font-semibold hover:text-blue-800 flex items-center gap-2">
                          <i class="fas fa-user-circle"></i>マイページ
                      </a></li>
                      <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-cog"></i>管理画面
                      </a></li>
                  </ul>
              </div>
          </nav>

          <main class="container mx-auto px-4 py-8">
              <div class="max-w-4xl mx-auto">
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <div class="flex items-center justify-between">
                          <div>
                              <h2 class="text-2xl font-bold text-gray-800 mb-2">
                                  <i class="fas fa-list text-blue-600 mr-2"></i>
                                  予約一覧
                              </h2>
                              <p class="text-gray-600">メールアドレス: ${customer.email}</p>
                          </div>
                          <a href="/mypage" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded-lg flex items-center gap-2">
                              <i class="fas fa-sign-out-alt"></i>ログアウト
                          </a>
                      </div>
                  </div>
                  
                  ${bookings.length > 0 ? bookingCards : `
                    <div class="bg-white rounded-lg shadow-md p-12 text-center">
                        <i class="fas fa-inbox text-gray-400 text-6xl mb-4"></i>
                        <p class="text-xl text-gray-600">予約がありません</p>
                    </div>
                  `}
              </div>
          </main>

          <footer class="bg-gray-800 text-white mt-12">
              <div class="container mx-auto px-4 py-6 text-center">
                  <p>&copy; 2025 イベント予約管理システム</p>
              </div>
          </footer>

          <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
          <script>
          async function cancelBooking(bookingId) {
              if (!confirm('この予約をキャンセルしますか？\\n\\nキャンセル後は元に戻せません。')) {
                  return;
              }
              
              try {
                  const response = await axios.post(\`/api/bookings/\${bookingId}/cancel\`);
                  
                  if (response.data.success) {
                      alert('予約をキャンセルしました');
                      location.reload();
                  }
              } catch (error) {
                  console.error('Cancel error:', error);
                  alert('キャンセルに失敗しました: ' + (error.response?.data?.error || error.message));
              }
          }
          </script>
      </body>
      </html>
    `)
  } catch (error) {
    console.error('Mypage error:', error)
    return c.html('<h1>エラーが発生しました</h1><a href="/mypage">戻る</a>', 500)
  }
})

// API - マイページ用予約取得
app.get('/api/mypage/bookings', async (c) => {
  const { DB } = c.env
  const email = c.req.query('email')
  
  if (!email) {
    return c.json({ error: 'メールアドレスが必要です' }, 400)
  }
  
  try {
    // 顧客情報を取得
    const customer = await DB.prepare(`
      SELECT * FROM customers WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.json({ bookings: [] })
    }
    
    // 予約一覧を取得
    const { results: bookings } = await DB.prepare(`
      SELECT 
        pb.*,
        p.name as product_name,
        ps.date,
        ps.stock_name,
        ps.price_band,
        e.name as event_name
      FROM product_bookings pb
      JOIN products p ON pb.product_id = p.id
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
      WHERE pb.customer_id = ?
      ORDER BY pb.created_at DESC
    `).bind(customer.id).all()
    
    return c.json({ bookings })
  } catch (error) {
    console.error('Mypage API error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ============================================
// 主催者管理（Organizers）
// ============================================

// 主催者一覧
app.get('/admin/organizers', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>主催者管理 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-pink-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-building"></i>
                    主催者管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/organizers" class="text-pink-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-building"></i>主催者管理
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-gray-800">主催者一覧</h2>
                <a href="/admin/organizers/new" class="bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-lg flex items-center gap-2">
                    <i class="fas fa-plus"></i>
                    新規主催者登録
                </a>
            </div>

            <!-- 検索フォーム -->
            <div class="bg-white rounded-lg shadow p-4 mb-6">
                <form id="searchForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">主催者名</label>
                        <input type="text" id="searchName" placeholder="主催者名で検索" 
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-pink-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">メールアドレス</label>
                        <input type="text" id="searchEmail" placeholder="メールアドレスで検索"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-pink-500">
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="bg-pink-600 text-white px-6 py-2 rounded-lg hover:bg-pink-700">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow overflow-hidden">
                <table class="min-w-full">
                    <thead class="bg-gray-100">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">ID</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">主催者名</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">部署・支店</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">電話番号</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">メールアドレス</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">状態</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-gray-700 uppercase">操作</th>
                        </tr>
                    </thead>
                    <tbody id="organizers-tbody">
                        <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">
                            <i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...
                        </td></tr>
                    </tbody>
                </table>
            </div>

            <!-- ページネーション -->
            <div id="pagination" class="mt-6 flex items-center justify-between hidden">
                <div class="text-sm text-gray-600">
                    <span id="paginationInfo"></span>
                </div>
                <div class="flex gap-2">
                    <button onclick="goToPage(currentPage - 1)" id="prevPageBtn" 
                            class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50" disabled>
                        <i class="fas fa-chevron-left"></i> 前へ
                    </button>
                    <button onclick="goToPage(currentPage + 1)" id="nextPageBtn" 
                            class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50" disabled>
                        次へ <i class="fas fa-chevron-right"></i>
                    </button>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script>
            let currentPage = 1;
            let perPage = 20;
            let searchParams = {};

            document.addEventListener('DOMContentLoaded', () => {
                loadOrganizers();
            });

            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                currentPage = 1;
                searchParams = {
                    name: document.getElementById('searchName').value,
                    email: document.getElementById('searchEmail').value
                };
                loadOrganizers();
            });

            function resetSearch() {
                document.getElementById('searchName').value = '';
                document.getElementById('searchEmail').value = '';
                currentPage = 1;
                searchParams = {};
                loadOrganizers();
            }

            function goToPage(page) {
                currentPage = page;
                loadOrganizers();
            }

            async function loadOrganizers() {
                try {
                    console.log('主催者データをAPIから取得中...');
                    const params = new URLSearchParams({
                        page: currentPage,
                        per_page: perPage,
                        ...searchParams
                    });
                    
                    const response = await fetch(\`/api/v1/organizers?\${params}\`);
                    if (!response.ok) {
                        throw new Error(\`HTTP error! status: \${response.status}\`);
                    }
                    
                    const result = await response.json();
                    console.log('取得した主催者データ:', result);
                    
                    const tbody = document.getElementById('organizers-tbody');
                    
                    if (!result.data || result.data.length === 0) {
                        tbody.innerHTML = \`
                            <tr>
                                <td colspan="7" class="px-4 py-8 text-center text-gray-500">
                                    <i class="fas fa-info-circle mr-2"></i>データがありません
                                </td>
                            </tr>
                        \`;
                        document.getElementById('pagination').classList.add('hidden');
                        return;
                    }
                    
                    tbody.innerHTML = result.data.map(org => \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 border-b">\${org.id}</td>
                            <td class="px-4 py-3 border-b font-semibold">\${org.name}</td>
                            <td class="px-4 py-3 border-b text-sm">\${org.branch_office || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${org.tel || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${org.email}</td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 text-xs rounded \${org.reg_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                    \${org.reg_flg ? '有効' : '無効'}
                                </span>
                            </td>
                            <td class="px-4 py-3 border-b">
                                <div class="flex gap-2">
                                    <a href="/admin/organizers/\${org.id}/edit" class="text-blue-600 hover:text-blue-800">
                                        <i class="fas fa-edit"></i>編集
                                    </a>
                                    <a href="/admin/organizers/\${org.id}" class="text-gray-600 hover:text-gray-800">
                                        <i class="fas fa-eye"></i>詳細
                                    </a>
                                </div>
                            </td>
                        </tr>
                    \`).join('');
                    
                    if (result.pagination) {
                        updatePagination(result.pagination);
                    }
                    
                    console.log(\`\${result.data.length}件の主催者データを表示しました\`);
                    
                } catch (error) {
                    console.error('主催者データの取得に失敗:', error);
                    const tbody = document.getElementById('organizers-tbody');
                    tbody.innerHTML = \`
                        <tr>
                            <td colspan="7" class="px-4 py-8 text-center text-red-500">
                                <i class="fas fa-exclamation-triangle mr-2"></i>データの取得に失敗しました
                            </td>
                        </tr>
                    \`;
                }
            }

            function updatePagination(pagination) {
                const paginationDiv = document.getElementById('pagination');
                const paginationInfo = document.getElementById('paginationInfo');
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                
                paginationInfo.textContent = \`全\${pagination.total}件中 \${(pagination.page - 1) * pagination.per_page + 1}～\${Math.min(pagination.page * pagination.per_page, pagination.total)}件を表示\`;
                
                prevBtn.disabled = pagination.page <= 1;
                nextBtn.disabled = pagination.page >= pagination.total_pages;
                
                paginationDiv.classList.remove('hidden');
            }
        </script>
    </body>
    </html>
  `)
})

// 主催者新規登録画面
app.get('/admin/organizers/new', async (c) => {
  const { DB } = c.env
  
  // 都道府県リスト取得
  const { results: prefs } = await DB.prepare(`
    SELECT id, name FROM prefs ORDER BY id
  `).all()
  
  const prefOptions = prefs.map(p => `<option value="${p.id}">${p.name}</option>`).join('')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>主催者新規登録 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-pink-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-building"></i>
                    主催者新規登録
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/organizers" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-building"></i>主催者管理
                    </a></li>
                    <li><span class="text-pink-600 font-semibold">新規登録</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-lg shadow p-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6">主催者情報入力</h2>
                    
                    <form id="organizerForm" class="space-y-6">
                        <!-- 基本情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">基本情報</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        主催者名（正式名称） <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="name" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 京王観光株式会社">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        部署・支店名
                                    </label>
                                    <input type="text" id="branch_office" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: スポーツ支店">
                                </div>
                            </div>
                        </div>

                        <!-- 住所情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">所在地</h3>
                            
                            <div class="space-y-4">
                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            郵便番号
                                        </label>
                                        <input type="text" id="zip" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                               placeholder="例: 182-0024">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            都道府県
                                        </label>
                                        <select id="pref_id" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                            <option value="">選択してください</option>
                                            ${prefOptions}
                                        </select>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        住所
                                    </label>
                                    <input type="text" id="addr" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 東京都 調布市布田3-1-7 池田ビル5階">
                                </div>
                            </div>
                        </div>

                        <!-- 連絡先情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">連絡先</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        電話番号 <span class="text-red-500">*</span>
                                    </label>
                                    <input type="tel" id="tel" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 042-484-2881">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        FAX番号
                                    </label>
                                    <input type="tel" id="fax" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 042-484-1321">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        メールアドレス <span class="text-red-500">*</span>
                                    </label>
                                    <input type="email" id="email" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: keiosports@keio-kanko.co.jp">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        パスワード <span class="text-red-500">*</span>
                                    </label>
                                    <input type="password" id="password" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="管理画面ログイン用パスワード">
                                </div>
                            </div>
                        </div>

                        <!-- 営業情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">営業情報</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        営業時間
                                    </label>
                                    <input type="text" id="business_hours" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 平日 09：00～18：00">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        定休日
                                    </label>
                                    <input type="text" id="closed_days" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 土日祝： 休業">
                                </div>
                            </div>

                            <div class="mt-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    営業に関する備考
                                </label>
                                <textarea id="business_notes" rows="2"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                          placeholder="例: ＊通信販売の商品の為窓口での受付は承っておりません。"></textarea>
                            </div>
                        </div>

                        <!-- 登録情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">登録情報</h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        観光庁登録番号
                                    </label>
                                    <input type="text" id="registration_number" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="例: 観光庁長官登録旅行業第10号">
                                </div>

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            協会名
                                        </label>
                                        <input type="text" id="association_name" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                               placeholder="例: 一般社団法人日本旅行業協会">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            会員情報
                                        </label>
                                        <input type="text" id="association_membership" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                               placeholder="例: （JATA）正会員">
                                    </div>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            旅行業務取扱管理者役職
                                        </label>
                                        <input type="text" id="travel_manager_title" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                               placeholder="例: 総合旅行業務取扱管理者">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            旅行業務取扱管理者名
                                        </label>
                                        <input type="text" id="travel_manager_name" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                               placeholder="例: 原　祥造">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- その他 -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        備考
                                    </label>
                                    <textarea id="remarks" rows="3"
                                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                              placeholder="その他の情報"></textarea>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        公開状態
                                    </label>
                                    <select id="reg_flg" 
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                        <option value="1">有効</option>
                                        <option value="0">無効</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-6">
                            <button type="submit" 
                                    class="flex-1 bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-save mr-2"></i>登録する
                            </button>
                            <a href="/admin/organizers" 
                               class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('organizerForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    name: document.getElementById('name').value,
                    branch_office: document.getElementById('branch_office').value || null,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    tel: document.getElementById('tel').value,
                    fax: document.getElementById('fax').value || null,
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value,
                    business_hours: document.getElementById('business_hours').value || null,
                    closed_days: document.getElementById('closed_days').value || null,
                    business_notes: document.getElementById('business_notes').value || null,
                    registration_number: document.getElementById('registration_number').value || null,
                    association_name: document.getElementById('association_name').value || null,
                    association_membership: document.getElementById('association_membership').value || null,
                    travel_manager_title: document.getElementById('travel_manager_title').value || null,
                    travel_manager_name: document.getElementById('travel_manager_name').value || null,
                    remarks: document.getElementById('remarks').value || null,
                    reg_flg: parseInt(document.getElementById('reg_flg').value)
                }

                try {
                    await axios.post('/api/organizers', data)
                    alert('主催者を登録しました！')
                    window.location.href = '/admin/organizers'
                } catch (error) {
                    alert('登録に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})

// 主催者登録API
app.post('/api/organizers', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    const result = await DB.prepare(`
      INSERT INTO organizers (
        name, branch_office, zip, pref_id, addr, tel, fax, email, password,
        business_hours, closed_days, business_notes,
        registration_number, association_name, association_membership,
        travel_manager_title, travel_manager_name,
        remarks, reg_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.branch_office,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.fax,
      data.email,
      data.password,
      data.business_hours,
      data.closed_days,
      data.business_notes,
      data.registration_number,
      data.association_name,
      data.association_membership,
      data.travel_manager_title,
      data.travel_manager_name,
      data.remarks,
      data.reg_flg
    ).run()

    return c.json({ id: result.meta.last_row_id, message: '主催者を登録しました' })
  } catch (error) {
    console.error('主催者登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 主催者詳細表示
app.get('/admin/organizers/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  const { results } = await DB.prepare(`
    SELECT o.*, p.name as pref_name
    FROM organizers o
    LEFT JOIN prefs p ON o.pref_id = p.id
    WHERE o.id = ?
  `).bind(id).all()
  
  const org = results[0]
  if (!org) {
    return c.text('主催者が見つかりません', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${org.name} - 主催者詳細 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-pink-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-building"></i>
                    主催者詳細
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/organizers" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-building"></i>主催者管理
                    </a></li>
                    <li><span class="text-pink-600 font-semibold">詳細</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">${org.name}</h2>
                    <a href="/admin/organizers/${org.id}/edit" 
                       class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg">
                        <i class="fas fa-edit"></i> 編集
                    </a>
                </div>

                <div class="bg-white rounded-lg shadow p-8 space-y-8">
                    <!-- 基本情報 -->
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-info-circle text-pink-600"></i>基本情報
                        </h3>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">主催者名</dt>
                                <dd class="mt-1 text-lg font-semibold text-gray-900">${org.name}</dd>
                            </div>
                            ${org.branch_office ? `
                            <div>
                                <dt class="text-sm font-medium text-gray-500">部署・支店</dt>
                                <dd class="mt-1 text-lg text-gray-900">${org.branch_office}</dd>
                            </div>
                            ` : ''}
                        </div>
                    </div>

                    <!-- 所在地 -->
                    ${org.zip || org.pref_name || org.addr ? `
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-map-marker-alt text-pink-600"></i>所在地
                        </h3>
                        <div class="space-y-2">
                            ${org.zip ? `<p class="text-gray-700">〒${org.zip}</p>` : ''}
                            ${org.pref_name || org.addr ? `<p class="text-gray-700">${org.pref_name ? org.pref_name + ' ' : ''}${org.addr || ''}</p>` : ''}
                        </div>
                    </div>
                    ` : ''}

                    <!-- 連絡先 -->
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-phone text-pink-600"></i>連絡先
                        </h3>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <dt class="text-sm font-medium text-gray-500">電話番号</dt>
                                <dd class="mt-1 text-gray-900">TEL　${org.tel}</dd>
                            </div>
                            ${org.fax ? `
                            <div>
                                <dt class="text-sm font-medium text-gray-500">FAX番号</dt>
                                <dd class="mt-1 text-gray-900">FAX　${org.fax}</dd>
                            </div>
                            ` : ''}
                            <div>
                                <dt class="text-sm font-medium text-gray-500">メールアドレス</dt>
                                <dd class="mt-1 text-gray-900">E-mail： ${org.email}</dd>
                            </div>
                        </div>
                    </div>

                    <!-- 営業情報 -->
                    ${org.business_hours || org.closed_days || org.business_notes ? `
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-clock text-pink-600"></i>営業情報
                        </h3>
                        <div class="space-y-2">
                            ${org.business_hours ? `<p class="text-gray-700">営業時間 ： ${org.business_hours}</p>` : ''}
                            ${org.closed_days ? `<p class="text-gray-700">${org.closed_days}</p>` : ''}
                            ${org.business_notes ? `<p class="text-gray-700 mt-2">${org.business_notes}</p>` : ''}
                        </div>
                    </div>
                    ` : ''}

                    <!-- 登録情報 -->
                    ${org.registration_number || org.association_name || org.travel_manager_name ? `
                    <div class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-certificate text-pink-600"></i>登録情報
                        </h3>
                        <div class="space-y-2">
                            ${org.registration_number ? `<p class="text-gray-700">${org.registration_number}</p>` : ''}
                            ${org.association_name ? `<p class="text-gray-700">${org.association_name}${org.association_membership ? org.association_membership : ''}</p>` : ''}
                            ${org.travel_manager_name ? `<p class="text-gray-700">${org.travel_manager_title || '旅行業務取扱管理者'}：${org.travel_manager_name}</p>` : ''}
                        </div>
                    </div>
                    ` : ''}

                    <!-- その他 -->
                    ${org.remarks ? `
                    <div>
                        <h3 class="text-lg font-semibold text-gray-700 mb-4 flex items-center gap-2">
                            <i class="fas fa-sticky-note text-pink-600"></i>備考
                        </h3>
                        <p class="text-gray-700 whitespace-pre-wrap">${org.remarks}</p>
                    </div>
                    ` : ''}
                </div>

                <div class="mt-6">
                    <a href="/admin/organizers" 
                       class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg inline-block">
                        <i class="fas fa-arrow-left mr-2"></i>一覧に戻る
                    </a>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

// 主催者編集画面
app.get('/admin/organizers/:id/edit', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  const { results } = await DB.prepare(`
    SELECT * FROM organizers WHERE id = ?
  `).bind(id).all()
  
  const org = results[0]
  if (!org) {
    return c.text('主催者が見つかりません', 404)
  }

  // 都道府県リスト取得
  const { results: prefs } = await DB.prepare(`
    SELECT id, name FROM prefs ORDER BY id
  `).all()
  
  const prefOptions = prefs.map(p => 
    `<option value="${p.id}" ${p.id === org.pref_id ? 'selected' : ''}>${p.name}</option>`
  ).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${org.name} - 主催者編集 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-pink-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-building"></i>
                    主催者編集
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/organizers" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-building"></i>主催者管理
                    </a></li>
                    <li><span class="text-pink-600 font-semibold">編集</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-lg shadow p-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6">主催者情報編集</h2>
                    
                    <form id="organizerForm" class="space-y-6">
                        <!-- 基本情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">基本情報</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        主催者名（正式名称） <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="name" value="${org.name}" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        部署・支店名
                                    </label>
                                    <input type="text" id="branch_office" value="${org.branch_office || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>
                            </div>
                        </div>

                        <!-- 住所情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">所在地</h3>
                            
                            <div class="space-y-4">
                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            郵便番号
                                        </label>
                                        <input type="text" id="zip" value="${org.zip || ''}" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            都道府県
                                        </label>
                                        <select id="pref_id" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                            <option value="">選択してください</option>
                                            ${prefOptions}
                                        </select>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        住所
                                    </label>
                                    <input type="text" id="addr" value="${org.addr || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>
                            </div>
                        </div>

                        <!-- 連絡先情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">連絡先</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        電話番号 <span class="text-red-500">*</span>
                                    </label>
                                    <input type="tel" id="tel" value="${org.tel}" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        FAX番号
                                    </label>
                                    <input type="tel" id="fax" value="${org.fax || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        メールアドレス <span class="text-red-500">*</span>
                                    </label>
                                    <input type="email" id="email" value="${org.email}" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        パスワード <span class="text-gray-500 text-xs">(変更する場合のみ入力)</span>
                                    </label>
                                    <input type="password" id="password" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500"
                                           placeholder="変更しない場合は空欄">
                                </div>
                            </div>
                        </div>

                        <!-- 営業情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">営業情報</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        営業時間
                                    </label>
                                    <input type="text" id="business_hours" value="${org.business_hours || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        定休日
                                    </label>
                                    <input type="text" id="closed_days" value="${org.closed_days || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>
                            </div>

                            <div class="mt-4">
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    営業に関する備考
                                </label>
                                <textarea id="business_notes" rows="2"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">${org.business_notes || ''}</textarea>
                            </div>
                        </div>

                        <!-- 登録情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">登録情報</h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        観光庁登録番号
                                    </label>
                                    <input type="text" id="registration_number" value="${org.registration_number || ''}" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                </div>

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            協会名
                                        </label>
                                        <input type="text" id="association_name" value="${org.association_name || ''}" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            会員情報
                                        </label>
                                        <input type="text" id="association_membership" value="${org.association_membership || ''}" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                    </div>
                                </div>

                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            旅行業務取扱管理者役職
                                        </label>
                                        <input type="text" id="travel_manager_title" value="${org.travel_manager_title || ''}" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            旅行業務取扱管理者名
                                        </label>
                                        <input type="text" id="travel_manager_name" value="${org.travel_manager_name || ''}" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- その他 -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                            
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        備考
                                    </label>
                                    <textarea id="remarks" rows="3"
                                              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">${org.remarks || ''}</textarea>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        公開状態
                                    </label>
                                    <select id="reg_flg" 
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-pink-500">
                                        <option value="1" ${org.reg_flg ? 'selected' : ''}>有効</option>
                                        <option value="0" ${!org.reg_flg ? 'selected' : ''}>無効</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-6">
                            <button type="submit" 
                                    class="flex-1 bg-pink-600 hover:bg-pink-700 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-save mr-2"></i>更新する
                            </button>
                            <a href="/admin/organizers/${org.id}" 
                               class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('organizerForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    name: document.getElementById('name').value,
                    branch_office: document.getElementById('branch_office').value || null,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    tel: document.getElementById('tel').value,
                    fax: document.getElementById('fax').value || null,
                    email: document.getElementById('email').value,
                    business_hours: document.getElementById('business_hours').value || null,
                    closed_days: document.getElementById('closed_days').value || null,
                    business_notes: document.getElementById('business_notes').value || null,
                    registration_number: document.getElementById('registration_number').value || null,
                    association_name: document.getElementById('association_name').value || null,
                    association_membership: document.getElementById('association_membership').value || null,
                    travel_manager_title: document.getElementById('travel_manager_title').value || null,
                    travel_manager_name: document.getElementById('travel_manager_name').value || null,
                    remarks: document.getElementById('remarks').value || null,
                    reg_flg: parseInt(document.getElementById('reg_flg').value)
                }

                // パスワードが入力されている場合のみ追加
                const password = document.getElementById('password').value
                if (password) {
                    data.password = password
                }

                try {
                    await axios.put('/api/organizers/${org.id}', data)
                    alert('主催者情報を更新しました！')
                    window.location.href = '/admin/organizers/${org.id}'
                } catch (error) {
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})

// 主催者更新API
app.put('/api/organizers/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()

  try {
    // パスワード更新がある場合とない場合で分岐
    let query = `
      UPDATE organizers SET
        name = ?,
        branch_office = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        tel = ?,
        fax = ?,
        email = ?,
        business_hours = ?,
        closed_days = ?,
        business_notes = ?,
        registration_number = ?,
        association_name = ?,
        association_membership = ?,
        travel_manager_title = ?,
        travel_manager_name = ?,
        remarks = ?,
        reg_flg = ?,
        modified_at = datetime('now', 'localtime')
    `
    
    const params = [
      data.name,
      data.branch_office,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.fax,
      data.email,
      data.business_hours,
      data.closed_days,
      data.business_notes,
      data.registration_number,
      data.association_name,
      data.association_membership,
      data.travel_manager_title,
      data.travel_manager_name,
      data.remarks,
      data.reg_flg
    ]

    if (data.password) {
      query += `, password = ?`
      params.push(data.password)
    }

    query += ` WHERE id = ?`
    params.push(id)

    await DB.prepare(query).bind(...params).run()

    return c.json({ message: '主催者情報を更新しました' })
  } catch (error) {
    console.error('主催者更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

