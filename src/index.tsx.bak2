app.get('/mypage', (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>マイページ | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-indigo-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-user-circle"></i>
                    マイページ
                </h1>
                <p class="text-indigo-100 mt-2">予約履歴の確認・管理</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-alt"></i>イベント一覧
                    </a></li>
                    <li><a href="/mypage" class="text-indigo-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-user-circle"></i>マイページ
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-2xl mx-auto">
                <div class="bg-white rounded-lg shadow-md p-8">
                    <div class="text-center mb-8">
                        <div class="inline-flex items-center justify-center w-20 h-20 bg-indigo-100 rounded-full mb-4">
                            <i class="fas fa-user-circle text-4xl text-indigo-600"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-gray-800 mb-2">予約履歴を確認</h2>
                        <p class="text-gray-600">
                            ご予約時に入力されたメールアドレスを入力してください
                        </p>
                    </div>

                    <form id="mypageForm" class="space-y-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-envelope text-indigo-600 mr-1"></i>
                                メールアドレス <span class="text-red-600">*</span>
                            </label>
                            <input type="email" id="email" name="email" required 
                                   class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition text-lg"
                                   placeholder="example@example.com">
                            <p class="text-sm text-gray-500 mt-2">
                                <i class="fas fa-info-circle"></i>
                                ご予約時に入力したメールアドレスを正確に入力してください
                            </p>
                        </div>

                        <button type="submit" 
                                class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-6 rounded-lg text-lg flex items-center justify-center gap-2 transition shadow-lg">
                            <i class="fas fa-search"></i>
                            予約を検索
                        </button>
                    </form>

                    <div class="mt-8 pt-6 border-t border-gray-200">
                        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                            <h3 class="font-semibold text-gray-800 mb-2 flex items-center gap-2">
                                <i class="fas fa-shield-alt text-blue-600"></i>
                                プライバシーについて
                            </h3>
                            <p class="text-sm text-gray-600">
                                入力されたメールアドレスは予約情報の確認のみに使用され、第三者に提供されることはありません。
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('mypageForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const email = document.getElementById('email').value;
                
                if (!email) {
                    alert('メールアドレスを入力してください');
                    return;
                }
                
                // メールアドレスをURLエンコードして遷移
                window.location.href = '/mypage/bookings?email=' + encodeURIComponent(email);
            });
        </script>
    </body>
    </html>
  `)
})

// マイページ - 予約履歴一覧
app.get('/mypage/bookings', async (c) => {
  const { DB } = c.env
  const email = c.req.query('email')

  if (!email) {
    return c.redirect('/mypage')
  }

  // 顧客情報取得
  const customer = await DB.prepare(`
    SELECT * FROM customers WHERE email = ?
  `).bind(email).first()

  if (!customer) {
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>予約が見つかりません | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
      </head>
      <body class="bg-gray-50 min-h-screen">
          <header class="bg-indigo-600 text-white shadow-lg">
              <div class="container mx-auto px-4 py-6">
                  <h1 class="text-3xl font-bold flex items-center gap-3">
                      <i class="fas fa-user-circle"></i>
                      マイページ
                  </h1>
              </div>
          </header>

          <nav class="bg-white shadow-md border-b">
              <div class="container mx-auto px-4">
                  <ul class="flex gap-6 py-4">
                      <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-home"></i>トップページ
                      </a></li>
                      <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-calendar-alt"></i>イベント一覧
                      </a></li>
                      <li><a href="/mypage" class="text-indigo-600 font-semibold flex items-center gap-2">
                          <i class="fas fa-user-circle"></i>マイページ
                      </a></li>
                  </ul>
              </div>
          </nav>

          <main class="container mx-auto px-4 py-8">
              <div class="max-w-2xl mx-auto">
                  <div class="bg-yellow-50 border-2 border-yellow-400 rounded-lg p-8 text-center">
                      <div class="text-yellow-600 mb-4">
                          <i class="fas fa-exclamation-triangle text-6xl"></i>
                      </div>
                      <h2 class="text-2xl font-bold text-gray-800 mb-4">予約が見つかりません</h2>
                      <p class="text-gray-600 mb-6">
                          入力されたメールアドレス「${email}」での予約は見つかりませんでした。<br>
                          メールアドレスをご確認の上、再度お試しください。
                      </p>
                      <a href="/mypage" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                          <i class="fas fa-arrow-left mr-2"></i>
                          戻る
                      </a>
                  </div>
              </div>
          </main>

          <footer class="bg-gray-800 text-white mt-12">
              <div class="container mx-auto px-4 py-6 text-center">
                  <p>&copy; 2025 イベント予約管理システム</p>
              </div>
          </footer>
      </body>
      </html>
    `)
  }

  // 予約情報を取得
  const { results: bookings } = await DB.prepare(`
    SELECT 
      pb.*,
      p.name as product_name,
      ps.date,
      ps.stock_name,
      ps.price_band,
      e.name as event_name,
      e.id as event_id
    FROM product_bookings pb
    JOIN products p ON pb.product_id = p.id
    JOIN events e ON p.event_id = e.id
    LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
    WHERE pb.customer_id = ?
    ORDER BY pb.created_at DESC
  `).bind(customer.id).all()

  // イベント別にグループ化
  const bookingsByEvent = {}
  bookings.forEach(booking => {
    const eventId = booking.event_id
    if (!bookingsByEvent[eventId]) {
      bookingsByEvent[eventId] = {
        event_name: booking.event_name,
        event_id: eventId,
        bookings: [],
        total: 0
      }
    }
    bookingsByEvent[eventId].bookings.push(booking)
    bookingsByEvent[eventId].total += booking.price * booking.quantity
  })

  const eventGroups = Object.values(bookingsByEvent)

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約履歴 | マイページ</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-indigo-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-user-circle"></i>
                    マイページ
                </h1>
                <p class="text-indigo-100 mt-2">ようこそ、${customer.family_name} ${customer.first_name} 様</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-alt"></i>イベント一覧
                    </a></li>
                    <li><a href="/mypage" class="text-indigo-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-user-circle"></i>マイページ
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-6xl mx-auto">
                <!-- お客様情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-id-card text-indigo-600"></i>
                        お客様情報
                    </h2>
                    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">お名前</p>
                            <p class="font-semibold text-gray-800">${customer.family_name} ${customer.first_name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">フリガナ</p>
                            <p class="font-semibold text-gray-800">${customer.family_kana || ''} ${customer.first_kana || ''}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">メールアドレス</p>
                            <p class="font-semibold text-gray-800">${customer.email}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">電話番号</p>
                            <p class="font-semibold text-gray-800">${customer.tel}</p>
                        </div>
                    </div>
                </div>

                <!-- 予約履歴 -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
                        <i class="fas fa-history text-indigo-600"></i>
                        予約履歴（全${bookings.length}件）
                    </h2>

                    ${eventGroups.length === 0 ? `
                        <div class="text-center py-12">
                            <div class="text-gray-400 mb-4">
                                <i class="fas fa-inbox text-6xl"></i>
                            </div>
                            <p class="text-gray-600 text-lg">予約履歴はありません</p>
                        </div>
                    ` : eventGroups.map(group => `
                        <div class="border-2 border-gray-200 rounded-lg p-6 mb-6 last:mb-0">
                            <div class="flex items-center justify-between mb-4 pb-4 border-b border-gray-200">
                                <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                                    <i class="fas fa-calendar-check text-blue-600"></i>
                                    ${group.event_name}
                                </h3>
                                <a href="/events/${group.event_id}" 
                                   class="text-blue-600 hover:text-blue-700 font-semibold flex items-center gap-1 text-sm">
                                    イベント詳細
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>

                            <div class="space-y-4">
                                ${group.bookings.map(booking => `
                                    <div class="flex items-start justify-between ${booking.enable_flg === 0 ? 'opacity-50' : ''}">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2">
                                                <h4 class="font-semibold text-gray-800">${booking.product_name}</h4>
                                                ${booking.enable_flg === 0 ? `
                                                    <span class="bg-red-100 text-red-800 text-xs font-semibold px-2 py-1 rounded">
                                                        <i class="fas fa-times-circle"></i> キャンセル済み
                                                    </span>
                                                ` : ''}
                                            </div>
                                            ${booking.date ? `
                                                <p class="text-sm text-gray-600 mt-1">
                                                    <i class="fas fa-calendar mr-1"></i>
                                                    ${new Date(booking.date + 'T00:00:00').toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' })}
                                                    ${booking.stock_name ? ` ${booking.stock_name}` : ''}
                                                </p>
                                            ` : ''}
                                            ${booking.price_band ? `
                                                <p class="text-sm text-gray-500 mt-1">
                                                    <i class="fas fa-tag mr-1"></i>
                                                    ${booking.price_band}
                                                </p>
                                            ` : ''}
                                            <p class="text-xs text-gray-500 mt-1">
                                                <i class="fas fa-clock mr-1"></i>
                                                予約日時: ${new Date(booking.created_at).toLocaleString('ja-JP')}
                                            </p>
                                        </div>
                                        <div class="text-right ml-4">
                                            <p class="text-sm text-gray-600">数量: ${booking.quantity}</p>
                                            <p class="text-lg font-bold text-gray-800">¥${(booking.price * booking.quantity).toLocaleString()}</p>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>

                            <div class="mt-6 pt-4 border-t-2 border-gray-300">
                                <div class="flex justify-between items-center">
                                    <span class="text-lg font-bold text-gray-800">イベント合計</span>
                                    <span class="text-2xl font-bold text-indigo-600">¥${group.total.toLocaleString()}</span>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>

                <!-- お問い合わせ情報 -->
                <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-question-circle text-blue-600"></i>
                        予約に関するお問い合わせ
                    </h3>
                    <p class="text-sm text-gray-700 mb-3">
                        予約内容の変更やキャンセルをご希望の場合は、各イベントの主催者までお問い合わせください。
                    </p>
                    <div class="flex gap-4">
                        <a href="/mypage" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                            <i class="fas fa-arrow-left mr-2"></i>
                            別のメールアドレスで検索
                        </a>
                        <a href="/events" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-6 rounded-lg transition">
                            <i class="fas fa-list mr-2"></i>
                            イベント一覧
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

