                        </div>

                        <!-- 権限設定 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">権限設定</h3>
                            
                            <div class="space-y-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        権限 <span class="text-red-500">*</span>
                                    </label>
                                    <select id="role" required 
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                        <option value="">選択してください</option>
                                        <option value="system_admin">システム管理者</option>
                                        <option value="admin">管理者（京王観光）</option>
                                        <option value="branch">支店（京王観光）</option>
                                        <option value="client">クライアント</option>
                                    </select>
                                    <p class="text-sm text-gray-500 mt-1">
                                        <i class="fas fa-info-circle text-blue-500"></i>
                                        管理者：全支店アクセス可 / 支店：所属支店のみアクセス（追加権限で複数支店可）
                                    </p>
                                </div>
                                
                                <!-- 京王観光設定（管理者・支店選択時に表示） -->
                                <div id="keio-section" style="display: none;" class="bg-blue-50 p-4 rounded-lg space-y-4">
                                    <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                                        <i class="fas fa-building text-blue-600"></i>
                                        京王観光アカウント設定
                                    </h4>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            所属支店（主担当） <span id="branch-required-mark" class="text-red-500" style="display: none;">*</span>
                                        </label>
                                        <select id="primary_branch_code" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                            <option value="">選択してください（任意）</option>
                                        </select>
                                        <p class="text-sm text-gray-500 mt-1">
                                            <span id="admin-branch-note" style="display: none;">
                                                <i class="fas fa-info-circle text-blue-500"></i>
                                                管理者は全支店にアクセス可能です。所属支店の指定は任意です。
                                            </span>
                                            <span id="branch-branch-note" style="display: none;">
                                                <i class="fas fa-info-circle text-blue-500"></i>
                                                支店担当者の主な所属支店を選択してください（必須）
                                            </span>
                                        </p>
                                    </div>
                                    
                                    <!-- 追加アクセス権限（支店のみ表示） -->
                                    <div id="branch-access-section" style="display: none;">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            追加アクセス権限（任意）
                                        </label>
                                        <div class="bg-white p-4 rounded border border-gray-300 max-h-64 overflow-y-auto">
                                            <div id="accessible-branches-checkboxes" class="grid grid-cols-2 gap-2">
                                                <!-- JavaScriptで動的に生成 -->
                                            </div>
                                        </div>
                                        <p class="text-sm text-gray-500 mt-1">
                                            複数選択可。所属支店以外で管理したい支店を選択してください
                                        </p>
                                    </div>
                                </div>
                                
                                <!-- クライアント設定（クライアント選択時に表示） -->
                                <div id="client-section" style="display: none;" class="bg-green-50 p-4 rounded-lg space-y-4">
                                    <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                                        <i class="fas fa-users text-green-600"></i>
                                        クライアント設定
                                    </h4>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            所属クライアント企業 <span class="text-red-500">*</span>
                                        </label>
                                        <select id="client_id" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                            <option value="">選択してください</option>
                                            ${clientsOptions}
                                        </select>
                                        <p class="text-sm text-gray-500 mt-1">
                                            アクセス範囲：自社のイベント・商品・予約のみ
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- その他 -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    状態
                                </label>
                                <select id="enable_flg" 
                                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                    <option value="1">有効</option>
                                    <option value="0">無効</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-6">
                            <button type="submit" 
                                    class="flex-1 bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-save mr-2"></i>登録する
                            </button>
                            <a href="/admin/accounts" 
                               class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            let branchesData = [];
            
            // ページ読み込み時に支店データを取得
            async function loadBranches() {
                try {
                    const response = await axios.get('/api/branches');
                    branchesData = response.data.data;
                    
                    // 所属支店プルダウンを生成
                    const primaryBranchSelect = document.getElementById('primary_branch_code');
                    branchesData.forEach(branch => {
                        const option = document.createElement('option');
                        option.value = branch.branch_code;
                        option.textContent = branch.branch_full_name;
                        primaryBranchSelect.appendChild(option);
                    });
                    
                    // チェックボックスを生成
                    renderAccessibleBranches();
                } catch (error) {
                    console.error('支店データ取得エラー:', error);
                }
            }
            
            // 追加アクセス権限のチェックボックスを生成
            function renderAccessibleBranches() {
                const container = document.getElementById('accessible-branches-checkboxes');
                container.innerHTML = '';
                
                const selectedPrimaryBranch = document.getElementById('primary_branch_code').value;
                
                branchesData.forEach(branch => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center';
                    
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.id = 'branch_' + branch.branch_code;
                    checkbox.value = branch.branch_code;
                    checkbox.className = 'branch-checkbox mr-2';
                    checkbox.disabled = branch.branch_code === selectedPrimaryBranch;
                    
                    const label = document.createElement('label');
                    label.htmlFor = 'branch_' + branch.branch_code;
                    label.textContent = branch.branch_full_name;
                    label.className = 'text-sm ' + (checkbox.disabled ? 'text-gray-400' : 'text-gray-700');
                    
                    div.appendChild(checkbox);
                    div.appendChild(label);
                    container.appendChild(div);
                });
            }
            
            // 権限選択時の動的表示制御
            document.getElementById('role').addEventListener('change', function() {
                const role = this.value;
                const keioSection = document.getElementById('keio-section');
                const clientSection = document.getElementById('client-section');
                const branchAccessSection = document.getElementById('branch-access-section');
                const branchRequiredMark = document.getElementById('branch-required-mark');
                const adminBranchNote = document.getElementById('admin-branch-note');
                const branchBranchNote = document.getElementById('branch-branch-note');
                const primaryBranchSelect = document.getElementById('primary_branch_code');
                
                // 全セクションを非表示
                keioSection.style.display = 'none';
                clientSection.style.display = 'none';
                branchAccessSection.style.display = 'none';
                branchRequiredMark.style.display = 'none';
                adminBranchNote.style.display = 'none';
                branchBranchNote.style.display = 'none';
                
                if (role === 'admin') {
                    // 管理者：京王観光設定を表示（所属支店は任意）
                    keioSection.style.display = 'block';
                    adminBranchNote.style.display = 'inline';
                    primaryBranchSelect.required = false;
                    primaryBranchSelect.querySelector('option[value=""]').textContent = '選択してください（任意）';
                } else if (role === 'branch') {
                    // 支店：京王観光設定 + 追加アクセス権限を表示（所属支店は必須）
                    keioSection.style.display = 'block';
                    branchAccessSection.style.display = 'block';
                    branchRequiredMark.style.display = 'inline';
                    branchBranchNote.style.display = 'inline';
                    primaryBranchSelect.required = true;
                    primaryBranchSelect.querySelector('option[value=""]').textContent = '選択してください';
                } else if (role === 'client') {
                    // クライアント設定を表示
                    clientSection.style.display = 'block';
                }
            });
            
            // 所属支店変更時にチェックボックスを再生成
            document.getElementById('primary_branch_code').addEventListener('change', function() {
                renderAccessibleBranches();
            });
            
            // フォーム送信
            document.getElementById('accountForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const role = document.getElementById('role').value;
                
                // 支店の場合、所属支店が必須
                if (role === 'branch') {
                    const primaryBranch = document.getElementById('primary_branch_code').value;
                    if (!primaryBranch) {
                        alert('支店の場合、所属支店（主担当）の選択は必須です');
                        return;
                    }
                }
                
                // 基本データ
                const data = {
                    login_id: document.getElementById('login_id').value,
                    password: document.getElementById('password').value,
                    person_name: document.getElementById('person_name').value,
                    email: document.getElementById('email').value,
                    role: role,
                    enable_flg: parseInt(document.getElementById('enable_flg').value)
                }
                
                // 権限に応じた追加データ
                if (role === 'admin' || role === 'branch') {
                    // 京王観光アカウント
                    data.account_type = 'keio';
                    data.primary_branch_code = document.getElementById('primary_branch_code').value || null;
                    
                    if (role === 'branch') {
                        // 追加アクセス権限を取得
                        const checkboxes = document.querySelectorAll('.branch-checkbox:checked');
                        const accessibleBranches = Array.from(checkboxes).map(cb => cb.value);
                        data.accessible_branches = JSON.stringify(accessibleBranches);
                    }
                    
                    data.client_id = null;
                } else if (role === 'client') {
                    // クライアントアカウント
                    data.account_type = 'client';
                    data.client_id = document.getElementById('client_id').value || null;
                    data.primary_branch_code = null;
                    data.accessible_branches = null;
                } else {
                    // システム管理者
                    data.account_type = 'keio';
                    data.client_id = null;
                    data.primary_branch_code = null;
                    data.accessible_branches = null;
                }

                try {
                    await axios.post('/api/accounts', data)
                    alert('アカウントを登録しました！')
                    window.location.href = '/admin/accounts'
                } catch (error) {
                    alert('登録に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
            
            // ページ読み込み時に支店データを取得
            loadBranches();
        </script>
    </body>
    </html>
  `)
})

// ========================================
// アカウント管理API
// ========================================

// API: 支店一覧取得
app.get('/api/branches', async (c) => {
  const { DB } = c.env
  
  try {
    // 有効な支店のみを表示順でソート
    const { results: branches } = await DB.prepare(`
      SELECT 
        id,
        branch_code,
        branch_name,
        branch_full_name,
        display_order
      FROM branches
      WHERE enable_flg = 1
      ORDER BY display_order ASC
    `).all()
    
    return c.json({
      success: true,
      data: branches
    })
  } catch (error) {
    console.error('支店一覧取得エラー:', error)
    return c.json({
      success: false,
      error: '支店一覧の取得に失敗しました'
    }, 500)
  }
})

// API: アカウント一覧取得（ページネーション・検索対応）
app.get('/api/accounts', async (c) => {
  const { DB } = c.env
  
  try {
    // クエリパラメータ取得
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '20')
    const offset = (page - 1) * perPage
    
    // 検索条件
    const loginId = c.req.query('login_id') || ''
    const personName = c.req.query('person_name') || ''
    const email = c.req.query('email') || ''
    const role = c.req.query('role') || ''
    const clientId = c.req.query('client_id') || ''
    
    // WHERE句の構築
    let whereConditions = []
    let bindings = []
    
    if (loginId) {
      whereConditions.push('a.login_id LIKE ?')
      bindings.push(`%${loginId}%`)
    }
    if (personName) {
      whereConditions.push('a.person_name LIKE ?')
      bindings.push(`%${personName}%`)
    }
    if (email) {
      whereConditions.push('a.email LIKE ?')
      bindings.push(`%${email}%`)
    }
    if (role) {
      whereConditions.push('a.role = ?')
      bindings.push(role)
    }
    if (clientId) {
      whereConditions.push('a.client_id = ?')
      bindings.push(clientId)
    }
    
    const whereClause = whereConditions.length > 0 
      ? 'WHERE ' + whereConditions.join(' AND ')
      : ''
    
    // 総件数取得
    const { results: countResult } = await DB.prepare(`
      SELECT COUNT(*) as total
      FROM accounts a
      ${whereClause}
    `).bind(...bindings).all()
    
    const total = countResult[0].total
    
    // データ取得
    const { results: accounts } = await DB.prepare(`
      SELECT 
        a.id,
        a.login_id,
        a.person_name,
        a.email,
        a.role,
        a.client_id,
        a.enable_flg,
        a.created_at,
        a.modified_at,
        a.account_type,
        a.primary_branch_code,
        a.accessible_branches,
        c.name as client_name
      FROM accounts a
      LEFT JOIN clients c ON a.client_id = c.id
      ${whereClause}
      ORDER BY a.created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...bindings, perPage, offset).all()
    
    return c.json({
      data: accounts,
      pagination: {
        page,
        per_page: perPage,
        total,
        total_pages: Math.ceil(total / perPage)
      }
    })
  } catch (error) {
    console.error('アカウント一覧取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント登録API
app.post('/api/accounts', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    // ログインIDの重複チェック
    const existing = await DB.prepare(`
      SELECT id FROM accounts WHERE login_id = ?
    `).bind(data.login_id).first()
    
    if (existing) {
      return c.json({ error: 'このログインIDは既に使用されています' }, 400)
    }

    const result = await DB.prepare(`
      INSERT INTO accounts (
        client_id, login_id, password, person_name, email, role, enable_flg,
        account_type, primary_branch_code, accessible_branches
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.client_id || null,
      data.login_id,
      data.password,
      data.person_name,
      data.email,
      data.role,
      data.enable_flg,
      data.account_type || 'keio',
      data.primary_branch_code || null,
      data.accessible_branches || null
    ).run()

    return c.json({ id: result.meta.last_row_id, message: 'アカウントを登録しました' })
  } catch (error) {
    console.error('アカウント登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント詳細取得API
app.get('/api/accounts/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const account = await DB.prepare(`
      SELECT 
        a.id,
        a.login_id,
        a.person_name,
        a.email,
        a.role,
        a.client_id,
        a.enable_flg,
        a.created_at,
        a.modified_at,
        c.name as client_name
      FROM accounts a
      LEFT JOIN clients c ON a.client_id = c.id
      WHERE a.id = ?
    `).bind(id).first()
    
    if (!account) {
      return c.json({ error: 'アカウントが見つかりません' }, 404)
    }
    
    return c.json(account)
  } catch (error) {
    console.error('アカウント詳細取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント更新API
app.put('/api/accounts/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // ログインIDの重複チェック（自分以外）
    if (data.login_id) {
      const existing = await DB.prepare(`
        SELECT id FROM accounts WHERE login_id = ? AND id != ?
      `).bind(data.login_id, id).first()
      
      if (existing) {
        return c.json({ error: 'このログインIDは既に使用されています' }, 400)
      }
    }
    
    // 更新フィールドの構築
    let updateFields = []
    let bindings = []
    
    if (data.login_id !== undefined) {
      updateFields.push('login_id = ?')
      bindings.push(data.login_id)
    }
    if (data.password !== undefined && data.password !== '') {
      updateFields.push('password = ?')
      bindings.push(data.password)
    }
    if (data.person_name !== undefined) {
      updateFields.push('person_name = ?')
      bindings.push(data.person_name)
    }
    if (data.email !== undefined) {
      updateFields.push('email = ?')
      bindings.push(data.email)
    }
    if (data.role !== undefined) {
      updateFields.push('role = ?')
      bindings.push(data.role)
    }
    if (data.client_id !== undefined) {
      updateFields.push('client_id = ?')
      bindings.push(data.client_id || null)
    }
    if (data.enable_flg !== undefined) {
      updateFields.push('enable_flg = ?')
      bindings.push(data.enable_flg)
    }
    if (data.account_type !== undefined) {
      updateFields.push('account_type = ?')
      bindings.push(data.account_type || 'keio')
    }
    if (data.primary_branch_code !== undefined) {
      updateFields.push('primary_branch_code = ?')
      bindings.push(data.primary_branch_code || null)
    }
    if (data.accessible_branches !== undefined) {
      updateFields.push('accessible_branches = ?')
      bindings.push(data.accessible_branches || null)
    }
    
    updateFields.push('modified_at = datetime("now", "localtime")')
    
    bindings.push(id)
    
    await DB.prepare(`
      UPDATE accounts 
      SET ${updateFields.join(', ')}
      WHERE id = ?
    `).bind(...bindings).run()
    
    return c.json({ message: 'アカウントを更新しました' })
  } catch (error) {
    console.error('アカウント更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント編集画面
app.get('/admin/accounts/:id/edit', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  // アカウント情報を取得
  const account = await DB.prepare(`
    SELECT * FROM accounts WHERE id = ?
  `).bind(id).first()
  
  if (!account) {
    return c.text('アカウントが見つかりません', 404)
  }
  
  // クライアント一覧を取得
  const { results: clients } = await DB.prepare(`
    SELECT id, name FROM clients ORDER BY name
  `).all()
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>アカウント編集 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-amber-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-user-shield"></i>
                    アカウント編集
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/accounts" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-user-shield"></i>アカウント管理
                    </a></li>
                    <li><span class="text-amber-600 font-semibold">編集</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <div class="bg-white rounded-lg shadow p-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-6">アカウント情報編集</h2>
                    
                    <form id="accountForm" class="space-y-6">
                        <input type="hidden" id="account_id" value="${account.id}">
                        
                        <!-- 基本情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">基本情報</h3>
                            
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        ログインID <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="login_id" required value="${account.login_id}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 font-mono">
                                    <p class="text-sm text-gray-500 mt-1">英数字とアンダースコア</p>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        パスワード
                                    </label>
                                    <input type="password" id="password" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500"
                                           placeholder="変更する場合のみ入力">
                                    <p class="text-sm text-gray-500 mt-1">変更しない場合は空欄</p>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        担当者名 <span class="text-red-500">*</span>
                                    </label>
                                    <input type="text" id="person_name" required value="${account.person_name}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        メールアドレス <span class="text-red-500">*</span>
                                    </label>
                                    <input type="email" id="email" required value="${account.email}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                </div>
                            </div>
                        </div>

                        <!-- 権限設定 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">権限設定</h3>
                            
                            <div class="space-y-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        権限 <span class="text-red-500">*</span>
                                    </label>
                                    <select id="role" required 
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                        <option value="system_admin" ${account.role === 'system_admin' ? 'selected' : ''}>システム管理者</option>
                                        <option value="admin" ${account.role === 'admin' ? 'selected' : ''}>管理者（京王観光）</option>
                                        <option value="branch" ${account.role === 'branch' ? 'selected' : ''}>支店（京王観光）</option>
                                        <option value="client" ${account.role === 'client' ? 'selected' : ''}>クライアント</option>
                                    </select>
                                    <p class="text-sm text-gray-500 mt-1">
                                        <i class="fas fa-info-circle text-blue-500"></i>
                                        管理者：全支店アクセス可 / 支店：所属支店のみアクセス（追加権限で複数支店可）
                                    </p>
                                </div>
                                
                                <!-- 京王観光設定（管理者・支店選択時に表示） -->
                                <div id="keio-section" style="display: none;" class="bg-blue-50 p-4 rounded-lg space-y-4">
                                    <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                                        <i class="fas fa-building text-blue-600"></i>
                                        京王観光アカウント設定
                                    </h4>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            所属支店（主担当） <span id="branch-required-mark" class="text-red-500" style="display: none;">*</span>
                                        </label>
                                        <select id="primary_branch_code" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                            <option value="">選択してください（任意）</option>
                                        </select>
                                        <p class="text-sm text-gray-500 mt-1">
                                            <span id="admin-branch-note" style="display: none;">
                                                <i class="fas fa-info-circle text-blue-500"></i>
                                                管理者は全支店にアクセス可能です。所属支店の指定は任意です。
                                            </span>
                                            <span id="branch-branch-note" style="display: none;">
                                                <i class="fas fa-info-circle text-blue-500"></i>
                                                支店担当者の主な所属支店を選択してください（必須）
                                            </span>
                                        </p>
                                    </div>
                                    
                                    <!-- 追加アクセス権限（支店のみ表示） -->
                                    <div id="branch-access-section" style="display: none;">
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            追加アクセス権限（任意）
                                        </label>
                                        <div class="bg-white p-4 rounded border border-gray-300 max-h-64 overflow-y-auto">
                                            <div id="accessible-branches-checkboxes" class="grid grid-cols-2 gap-2">
                                                <!-- JavaScriptで動的に生成 -->
                                            </div>
                                        </div>
                                        <p class="text-sm text-gray-500 mt-1">
                                            複数選択可。所属支店以外で管理したい支店を選択してください
                                        </p>
                                    </div>
                                </div>
                                
                                <!-- クライアント設定（クライアント選択時に表示） -->
                                <div id="client-section" style="display: none;" class="bg-green-50 p-4 rounded-lg space-y-4">
                                    <h4 class="font-semibold text-gray-800 flex items-center gap-2">
                                        <i class="fas fa-users text-green-600"></i>
                                        クライアント設定
                                    </h4>
                                    
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            所属クライアント企業 <span class="text-red-500">*</span>
                                        </label>
                                        <select id="client_id" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                            <option value="">選択してください</option>
                                            ${clients.map(client => 
                                              `<option value="${client.id}" ${account.client_id == client.id ? 'selected' : ''}>${client.name}</option>`
                                            ).join('')}
                                        </select>
                                        <p class="text-sm text-gray-500 mt-1">
                                            アクセス範囲：自社のイベント・商品・予約のみ
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- その他 -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    状態
                                </label>
                                <select id="enable_flg" 
                                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500">
                                    <option value="1" ${account.enable_flg ? 'selected' : ''}>有効</option>
                                    <option value="0" ${!account.enable_flg ? 'selected' : ''}>無効</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-6">
                            <button type="submit" 
                                    class="bg-amber-600 hover:bg-amber-700 text-white px-8 py-3 rounded-lg font-semibold flex items-center gap-2">
                                <i class="fas fa-save"></i>
                                更新
                            </button>
                            <a href="/admin/accounts" 
                               class="bg-gray-300 hover:bg-gray-400 text-gray-700 px-8 py-3 rounded-lg font-semibold flex items-center gap-2">
                                <i class="fas fa-times"></i>
                                キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            let branchesData = [];
            const currentAccount = ${JSON.stringify(account)};
            
            // ページ読み込み時に支店データを取得
            async function loadBranches() {
                try {
                    const response = await axios.get('/api/branches');
                    branchesData = response.data.data;
                    
                    // 所属支店プルダウンを生成
                    const primaryBranchSelect = document.getElementById('primary_branch_code');
                    branchesData.forEach(branch => {
                        const option = document.createElement('option');
                        option.value = branch.branch_code;
                        option.textContent = branch.branch_full_name;
                        if (currentAccount.primary_branch_code === branch.branch_code) {
                            option.selected = true;
                        }
                        primaryBranchSelect.appendChild(option);
                    });
                    
                    // チェックボックスを生成
                    renderAccessibleBranches();
                    
                    // 現在の権限に応じて表示を初期化
                    updateSectionDisplay(currentAccount.role);
                } catch (error) {
                    console.error('支店データ取得エラー:', error);
                }
            }
            
            // 追加アクセス権限のチェックボックスを生成
            function renderAccessibleBranches() {
                const container = document.getElementById('accessible-branches-checkboxes');
                container.innerHTML = '';
                
                const selectedPrimaryBranch = document.getElementById('primary_branch_code').value;
                const currentAccessible = currentAccount.accessible_branches 
                    ? JSON.parse(currentAccount.accessible_branches) 
                    : [];
                
                branchesData.forEach(branch => {
                    const div = document.createElement('div');
                    div.className = 'flex items-center';
                    
                    const checkbox = document.createElement('input');
                    checkbox.type = 'checkbox';
                    checkbox.id = 'branch_' + branch.branch_code;
                    checkbox.value = branch.branch_code;
                    checkbox.className = 'branch-checkbox mr-2';
                    checkbox.disabled = branch.branch_code === selectedPrimaryBranch;
                    checkbox.checked = currentAccessible.includes(branch.branch_code);
                    
                    const label = document.createElement('label');
                    label.htmlFor = 'branch_' + branch.branch_code;
                    label.textContent = branch.branch_full_name;
                    label.className = 'text-sm ' + (checkbox.disabled ? 'text-gray-400' : 'text-gray-700');
                    
                    div.appendChild(checkbox);
                    div.appendChild(label);
                    container.appendChild(div);
                });
            }
            
            // セクション表示を更新
            function updateSectionDisplay(role) {
                const keioSection = document.getElementById('keio-section');
                const clientSection = document.getElementById('client-section');
                const branchAccessSection = document.getElementById('branch-access-section');
                const branchRequiredMark = document.getElementById('branch-required-mark');
                const adminBranchNote = document.getElementById('admin-branch-note');
                const branchBranchNote = document.getElementById('branch-branch-note');
                const primaryBranchSelect = document.getElementById('primary_branch_code');
                
                // 全セクションを非表示
                keioSection.style.display = 'none';
                clientSection.style.display = 'none';
                branchAccessSection.style.display = 'none';
                branchRequiredMark.style.display = 'none';
                adminBranchNote.style.display = 'none';
                branchBranchNote.style.display = 'none';
                
                if (role === 'admin') {
                    keioSection.style.display = 'block';
                    adminBranchNote.style.display = 'inline';
                    primaryBranchSelect.required = false;
                } else if (role === 'branch') {
                    keioSection.style.display = 'block';
                    branchAccessSection.style.display = 'block';
                    branchRequiredMark.style.display = 'inline';
                    branchBranchNote.style.display = 'inline';
                    primaryBranchSelect.required = true;
                } else if (role === 'client') {
                    clientSection.style.display = 'block';
                }
            }
            
            // 権限選択時の動的表示制御
            document.getElementById('role').addEventListener('change', function() {
                updateSectionDisplay(this.value);
            });
            
            // 所属支店変更時にチェックボックスを再生成
            document.getElementById('primary_branch_code').addEventListener('change', function() {
                renderAccessibleBranches();
            });
            
            // フォーム送信
            document.getElementById('accountForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const role = document.getElementById('role').value;
                const id = document.getElementById('account_id').value;
                
                // 支店の場合、所属支店が必須
                if (role === 'branch') {
                    const primaryBranch = document.getElementById('primary_branch_code').value;
                    if (!primaryBranch) {
                        alert('支店の場合、所属支店（主担当）の選択は必須です');
                        return;
                    }
                }
                
                // 基本データ
                const data = {
                    login_id: document.getElementById('login_id').value,
                    person_name: document.getElementById('person_name').value,
                    email: document.getElementById('email').value,
                    role: role,
                    enable_flg: parseInt(document.getElementById('enable_flg').value)
                }
                
                // パスワードが入力されている場合のみ追加
                const password = document.getElementById('password').value;
                if (password) {
                    data.password = password;
                }
                
                // 権限に応じた追加データ
                if (role === 'admin' || role === 'branch') {
                    data.account_type = 'keio';
                    data.primary_branch_code = document.getElementById('primary_branch_code').value || null;
                    
                    if (role === 'branch') {
                        const checkboxes = document.querySelectorAll('.branch-checkbox:checked');
                        const accessibleBranches = Array.from(checkboxes).map(cb => cb.value);
                        data.accessible_branches = JSON.stringify(accessibleBranches);
                    }
                    
                    data.client_id = null;
                } else if (role === 'client') {
                    data.account_type = 'client';
                    data.client_id = document.getElementById('client_id').value || null;
                    data.primary_branch_code = null;
                    data.accessible_branches = null;
                } else {
                    data.account_type = 'keio';
                    data.client_id = null;
                    data.primary_branch_code = null;
                    data.accessible_branches = null;
                }
                
                try {
                    const response = await fetch(\`/api/accounts/\${id}\`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    })
                    
                    const result = await response.json()
                    
                    if (response.ok) {
                        alert(result.message || 'アカウントを更新しました')
                        window.location.href = '/admin/accounts'
                    } else {
                        alert('エラー: ' + (result.error || '更新に失敗しました'))
                    }
                } catch (error) {
                    console.error('更新エラー:', error)
                    alert('エラー: ' + error.message)
                }
            })
            
            // ページ読み込み時に支店データを取得
            loadBranches();
        </script>
    </body>
    </html>
  `)
})

// ========================================
// 予約管理API
// ========================================

// API: 予約一覧取得（ページネーション・検索対応）
app.get('/api/bookings', async (c) => {
  const { DB } = c.env
  
  try {
    // クエリパラメータ取得
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '20')
    const offset = (page - 1) * perPage
    
    // 検索条件
    const bookingNumber = c.req.query('booking_number') || ''
    const email = c.req.query('email') || ''
    const eventName = c.req.query('event_name') || ''
    const dateFrom = c.req.query('date_from') || ''
    const dateTo = c.req.query('date_to') || ''
    const bookingStatus = c.req.query('booking_status') || ''
    const paymentStatus = c.req.query('payment_status') || ''
    const branchCode = c.req.query('branch_code') || ''
    
    // WHERE句の構築
    let whereConditions = ['1=1']
    let bindings = []
    
    if (bookingNumber) {
      whereConditions.push('pb.booking_number LIKE ?')
      bindings.push(`%${bookingNumber}%`)
    }
    if (email) {
      whereConditions.push('c.email LIKE ?')
      bindings.push(`%${email}%`)
    }
    if (eventName) {
      whereConditions.push('e.name LIKE ?')
      bindings.push(`%${eventName}%`)
    }
    if (dateFrom) {
      whereConditions.push('DATE(pb.created_at) >= ?')
      bindings.push(dateFrom)
    }
    if (dateTo) {
      whereConditions.push('DATE(pb.created_at) <= ?')
      bindings.push(dateTo)
    }
    if (bookingStatus) {
      whereConditions.push('pb.booking_status = ?')
      bindings.push(bookingStatus)
    }
    if (paymentStatus) {
      whereConditions.push('pb.payment_status = ?')
      bindings.push(paymentStatus)
    }
    if (branchCode) {
      whereConditions.push('pb.branch_code = ?')
      bindings.push(branchCode)
    }
    
    const whereClause = whereConditions.join(' AND ')
    
    // 総件数取得
    const { results: countResult } = await DB.prepare(`
      SELECT COUNT(*) as total
      FROM product_bookings pb
      LEFT JOIN customers c ON pb.customer_id = c.id
      LEFT JOIN products p ON pb.product_id = p.id
      LEFT JOIN events e ON p.event_id = e.id
      WHERE ${whereClause}
    `).bind(...bindings).all()
    
    const total = countResult[0].total
    
    // データ取得
    const { results: bookings } = await DB.prepare(`
      SELECT 
        pb.id,
        pb.booking_number,
        pb.customer_id,
        pb.product_id,
        pb.quantity,
        pb.price,
        pb.booking_status,
        pb.payment_status,
        pb.branch_code,
        pb.participation_date,
        pb.created_at,
        pb.modified_at,
        c.family_name,
        c.first_name,
        c.email,
        c.tel,
        p.name as product_name,
        p.event_id,
        e.name as event_name
      FROM product_bookings pb
      LEFT JOIN customers c ON pb.customer_id = c.id
      LEFT JOIN products p ON pb.product_id = p.id
      LEFT JOIN events e ON p.event_id = e.id
      WHERE ${whereClause}
      ORDER BY pb.created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...bindings, perPage, offset).all()
    
    return c.json({
      data: bookings,
      pagination: {
        page,
        per_page: perPage,
        total,
        total_pages: Math.ceil(total / perPage)
      }
    })
  } catch (error) {
    console.error('予約一覧取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 予約詳細取得
app.get('/api/bookings/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const booking = await DB.prepare(`
      SELECT 
        pb.*,
        c.family_name,
        c.first_name,
        c.email,
        c.tel,
        c.zip,
        c.pref_id,
        c.city,
        c.addr,
        c.bldg,
        p.name as product_name,
        p.event_id,
        e.name as event_name
      FROM product_bookings pb
      LEFT JOIN customers c ON pb.customer_id = c.id
      LEFT JOIN products p ON pb.product_id = p.id
      LEFT JOIN events e ON p.event_id = e.id
      WHERE pb.id = ?
    `).bind(id).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    return c.json(booking)
  } catch (error) {
    console.error('予約詳細取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 予約更新
app.put('/api/bookings/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // Base64ファイルの処理（QRコード、PDF）
    // 注意: 実際の本番環境では、ファイルをCloudflare R2などに保存してURLを返すべきです
    // ここでは簡易的にBase64をそのまま保存します（小さいファイルのみ推奨）
    if (data.qr_code && data.qr_code.startsWith('data:')) {
      data.qr_code_url = data.qr_code  // Base64データURLをそのまま保存
    }
    if (data.pdf_file && data.pdf_file.startsWith('data:')) {
      data.pdf_file_url = data.pdf_file  // Base64データURLをそのまま保存
    }
    
    // price_itemsがある場合、メイン商品の価格と数量を更新
    if (data.price_items && Array.isArray(data.price_items)) {
      const mainItem = data.price_items.find(item => item.isMain) || data.price_items[0]
      if (mainItem) {
        data.price = mainItem.price
        data.quantity = mainItem.quantity
      }
    }
    
    // 更新フィールドの構築
    let updateFields = []
    let bindings = []
    
    if (data.product_id !== undefined) {
      updateFields.push('product_id = ?')
      bindings.push(data.product_id)
    }
    if (data.quantity !== undefined) {
      updateFields.push('quantity = ?')
      bindings.push(data.quantity)
    }
    if (data.price !== undefined) {
      updateFields.push('price = ?')
      bindings.push(data.price)
    }
    if (data.booking_status !== undefined) {
      updateFields.push('booking_status = ?')
      bindings.push(data.booking_status)
    }
    if (data.payment_status !== undefined) {
      updateFields.push('payment_status = ?')
      bindings.push(data.payment_status)
    }
    if (data.booking_number !== undefined) {
      updateFields.push('booking_number = ?')
      bindings.push(data.booking_number)
    }
    if (data.qr_code_url !== undefined) {
      updateFields.push('qr_code_url = ?')
      bindings.push(data.qr_code_url)
    }
    if (data.pdf_file_url !== undefined) {
      updateFields.push('pdf_file_url = ?')
      bindings.push(data.pdf_file_url)
    }
    if (data.price_items !== undefined) {
      updateFields.push('price_items = ?')
      bindings.push(JSON.stringify(data.price_items))
    }
    if (data.remarks !== undefined) {
      updateFields.push('remarks = ?')
      bindings.push(data.remarks)
    }
    
    if (updateFields.length === 0) {
      return c.json({ error: '更新するフィールドがありません' }, 400)
    }
    
    updateFields.push('modified_at = datetime("now", "localtime")')
    
    bindings.push(id)
    
    await DB.prepare(`
      UPDATE product_bookings 
      SET ${updateFields.join(', ')}
      WHERE id = ?
    `).bind(...bindings).run()
    
    return c.json({ message: '予約を更新しました' })
  } catch (error) {
    console.error('予約更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

