// イベント詳細ページ（お客様側）
app.get('/events/:id', routeAccessControl('customer'), async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  const event = await DB.prepare(`
    SELECT * FROM events WHERE id = ? AND enable_flg = 1
  `).bind(eventId).first<Event>()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  // 商品取得
  const { results: products } = await DB.prepare(`
    SELECT p.*, pp.price, pp.category_name
    FROM products p
    LEFT JOIN product_prices pp ON p.id = pp.product_id
    WHERE p.event_id = ? AND p.enable_flg = 1
    ORDER BY p.id
  `).bind(eventId).all<Product & ProductPrice>()

  const productsHtml = products.map(product => `
    <div class="bg-white rounded-lg shadow p-4 border border-gray-200">
      <h4 class="font-bold text-lg text-gray-800 mb-2">${product.name}</h4>
      <p class="text-gray-600 text-sm mb-3">${product.description || ''}</p>
      <div class="flex items-center justify-between">
        <span class="text-2xl font-bold text-blue-600">¥${product.price?.toLocaleString() || '---'}</span>
        <a href="/events/${eventId}/booking?product_id=${product.id}" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition text-sm inline-block">
          <i class="fas fa-shopping-cart mr-1"></i>予約する
        </a>
      </div>
    </div>
  `).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${event.name} | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-blue-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold">${event.name}</h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-alt"></i>イベント一覧
                    </a></li>
                    <li><a href="/mypage" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-user-circle"></i>マイページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-8 mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">イベント詳細</h2>
                <div class="prose max-w-none">
                    <p class="text-gray-700 whitespace-pre-wrap">${event.detail || ''}</p>
                </div>
                
                ${event.contact ? `
                <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                    <h3 class="font-bold text-gray-800 mb-2 flex items-center gap-2">
                        <i class="fas fa-info-circle text-blue-600"></i>お問い合わせ
                    </h3>
                    <p class="text-gray-700 whitespace-pre-wrap text-sm">${event.contact}</p>
                </div>
                ` : ''}
            </div>

            <div class="bg-white rounded-lg shadow-md p-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center gap-2">
                    <i class="fas fa-ticket-alt text-blue-600"></i>
                    販売中の商品
                </h2>
                
                ${products.length > 0 ? `
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    ${productsHtml}
                </div>
                ` : '<p class="text-center text-gray-500 py-8">現在販売中の商品はありません</p>'}
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

// イベント申込画面（Vue.js 3ベース・お客様側）
app.get('/events/:id/booking', routeAccessControl('customer'), async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  // イベント情報取得
  const event = await DB.prepare(`
    SELECT * FROM events WHERE id = ? AND enable_flg = 1
  `).bind(eventId).first()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>チケット購入 - ${event.name}</title>
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
        <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Noto Sans JP', sans-serif;
                line-height: 1.6;
                color: #333;
                background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
                min-height: 100vh;
            }

            /* Hero Section */
            .hero {
                position: relative;
                height: 300px;
                background: linear-gradient(135deg, rgba(220, 38, 38, 0.9), rgba(37, 99, 235, 0.9)),
                            url('https://placehold.co/1920x600/1a1a1a/ffffff?text=Event+Booking') center/cover;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                text-align: center;
                margin-bottom: 40px;
            }

            .hero-content {
                z-index: 2;
                padding: 20px;
            }

            .hero h1 {
                font-size: 2.5rem;
                font-weight: 900;
                margin-bottom: 15px;
                text-shadow: 2px 2px 8px rgba(0,0,0,0.3);
            }

            .hero p {
                font-size: 1.2rem;
                font-weight: 500;
            }

            /* Container */
            .container {
                max-width: 1000px;
                margin: 0 auto;
                padding: 0 20px 60px;
            }

            /* Event Info */
            .event-info {
                background: white;
                border-radius: 15px;
                padding: 30px;
                margin-bottom: 30px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            }

            .event-info h2 {
                font-size: 1.8rem;
                color: #dc2626;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 15px;
                margin-top: 20px;
            }

            .info-item {
                display: flex;
                align-items: start;
                gap: 10px;
            }

            .info-item i {
                color: #2563eb;
                margin-top: 4px;
            }

            .info-item strong {
                display: block;
                color: #dc2626;
                margin-bottom: 5px;
            }

            /* Purchase Form */
            .purchase-form {
                background: white;
                border-radius: 15px;
                padding: 30px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            }

            .form-section {
                margin-bottom: 40px;
                padding-bottom: 30px;
                border-bottom: 2px solid #f3f4f6;
            }

            .form-section:last-child {
                border-bottom: none;
            }

            .form-section h3 {
                font-size: 1.5rem;
                color: #1f2937;
                margin-bottom: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .form-section h3 i {
                color: #dc2626;
            }

            .required {
                color: #dc2626;
                font-size: 0.9rem;
                margin-left: 5px;
            }

            /* Date Selection */
            .date-options {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
                gap: 15px;
            }

            .date-option {
                position: relative;
            }

            .date-option input[type="radio"] {
                position: absolute;
                opacity: 0;
            }

            .date-label {
                display: block;
                padding: 20px;
                border: 3px solid #e5e7eb;
                border-radius: 10px;
                cursor: pointer;
                transition: all 0.3s ease;
                text-align: center;
                font-weight: 600;
                background: #f9fafb;
            }

            .date-option input[type="radio"]:checked + .date-label {
                border-color: #dc2626;
                background: linear-gradient(135deg, #fee2e2, #dbeafe);
                transform: scale(1.05);
            }

            .date-label:hover {
                border-color: #dc2626;
            }

            /* Product/Ticket Selection */
            .ticket-grid {
                display: grid;
                gap: 15px;
            }

            .ticket-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px;
                border: 2px solid #e5e7eb;
                border-radius: 10px;
                background: #f9fafb;
                transition: all 0.3s ease;
            }

            .ticket-item:hover {
                border-color: #2563eb;
                background: #eff6ff;
            }

            .ticket-info {
                flex: 1;
            }

            .ticket-name {
                font-size: 1.1rem;
                font-weight: 600;
                color: #1f2937;
                margin-bottom: 5px;
            }

            .ticket-price {
                font-size: 1.3rem;
                font-weight: 700;
                color: #dc2626;
            }

            .ticket-price.free {
                color: #059669;
            }

            .ticket-controls {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .quantity-control {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .quantity-btn {
                width: 40px;
                height: 40px;
                border: 2px solid #dc2626;
                background: white;
                color: #dc2626;
                border-radius: 8px;
                font-size: 1.2rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .quantity-btn:hover:not(:disabled) {
                background: #dc2626;
                color: white;
            }

            .quantity-btn:disabled {
                opacity: 0.3;
                cursor: not-allowed;
            }

            .quantity-input {
                width: 60px;
                height: 40px;
                text-align: center;
                border: 2px solid #e5e7eb;
                border-radius: 8px;
                font-size: 1.1rem;
                font-weight: 600;
            }

            /* Options Section */
            .option-item {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px;
                border: 2px solid #e5e7eb;
                border-radius: 10px;
                background: #f9fafb;
                transition: all 0.3s ease;
                margin-bottom: 15px;
            }

            .option-item:hover {
                border-color: #059669;
                background: #f0fdf4;
            }

            .option-info {
                flex: 1;
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .option-icon {
                font-size: 2rem;
            }

            .option-img {
                width: 64px;
                height: 64px;
                object-fit: cover;
                border-radius: 8px;
            }

            .option-name {
                font-size: 1.1rem;
                font-weight: 600;
                color: #1f2937;
                margin-bottom: 5px;
            }

            .option-price {
                font-size: 1.1rem;
                font-weight: 700;
                color: #059669;
            }

            /* Total Section */
            .total-section {
                background: linear-gradient(135deg, #fee2e2, #dbeafe);
                border-radius: 15px;
                padding: 30px;
                margin-bottom: 30px;
            }

            .total-breakdown {
                margin-bottom: 20px;
            }

            .breakdown-item {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 10px 0;
                font-size: 1.1rem;
            }

            .breakdown-label {
                font-weight: 500;
                color: #4b5563;
            }

            .breakdown-value {
                font-weight: 700;
                color: #1f2937;
                font-size: 1.2rem;
            }

            .total-final {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 20px 0;
                border-top: 3px solid #dc2626;
                margin-top: 15px;
            }

            .total-label {
                font-size: 1.5rem;
                font-weight: 700;
                color: #1f2937;
            }

            .total-amount {
                font-size: 2.5rem;
                font-weight: 900;
                color: #dc2626;
            }

            /* Submit Button */
            .submit-btn {
                width: 100%;
                padding: 20px;
                background: linear-gradient(135deg, #dc2626, #991b1b);
                color: white;
                border: none;
                border-radius: 15px;
                font-size: 1.3rem;
                font-weight: 700;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

            .submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 15px 35px rgba(220, 38, 38, 0.4);
            }

            .submit-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
                transform: none;
            }

            .error-message {
                color: #dc2626;
                background: #fee2e2;
                padding: 15px;
                border-radius: 10px;
                margin-bottom: 20px;
            }

            /* Badge */
            .badge {
                display: inline-block;
                padding: 5px 15px;
                background: #dc2626;
                color: white;
                border-radius: 20px;
                font-size: 0.9rem;
                font-weight: 600;
                margin-left: 10px;
            }

            .badge.gold {
                background: linear-gradient(135deg, #fbbf24, #f59e0b);
            }

            .badge.silver {
                background: linear-gradient(135deg, #cbd5e1, #94a3b8);
            }

            .badge.blue {
                background: linear-gradient(135deg, #60a5fa, #3b82f6);
            }

            /* Responsive */
            @media (max-width: 768px) {
                .hero h1 {
                    font-size: 1.8rem;
                }

                .hero p {
                    font-size: 1rem;
                }

                .ticket-item {
                    flex-direction: column;
                    gap: 15px;
                    text-align: center;
                }

                .option-item {
                    flex-direction: column;
                    gap: 15px;
                    text-align: center;
                }

                .total-amount {
                    font-size: 2rem;
                }
            }

            /* Animation */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .form-section {
                animation: fadeInUp 0.6s ease backwards;
            }

            .form-section:nth-child(1) { animation-delay: 0.1s; }
            .form-section:nth-child(2) { animation-delay: 0.2s; }
            .form-section:nth-child(3) { animation-delay: 0.3s; }
            .form-section:nth-child(4) { animation-delay: 0.4s; }

            .loading {
                text-align: center;
                padding: 40px;
                font-size: 1.2rem;
                color: #6b7280;
            }
        </style>
    </head>
    <body>
        <div id="app">
            <!-- Hero Section -->
            <section class="hero">
                <div class="hero-content">
                    <h1>チケット購入</h1>
                    <p>{{ event.name }}</p>
                </div>
            </section>

            <!-- Main Container -->
            <div class="container">
                <!-- Loading -->
                <div v-if="loading" class="loading">
                    <i class="fas fa-spinner fa-spin"></i> 読み込み中...
                </div>

                <!-- Error Message -->
                <div v-if="errorMessage" class="error-message">
                    {{ errorMessage }}
                </div>

                <!-- Event Info -->
                <div v-if="!loading && !errorMessage" class="event-info">
                    <h2><i class="fas fa-info-circle"></i>イベント概要</h2>
                    <div class="info-grid">
                        <div class="info-item">
                            <i class="fas fa-calendar-alt"></i>
                            <div>
                                <strong>イベント名</strong>
                                {{ event.name }}
                            </div>
                        </div>
                        <div class="info-item">
                            <i class="fas fa-map-marker-alt"></i>
                            <div>
                                <strong>会場</strong>
                                {{ event.venue || '-' }}
                            </div>
                        </div>
                        <div class="info-item" v-if="event.organizer">
                            <i class="fas fa-building"></i>
                            <div>
                                <strong>主催</strong>
                                {{ event.organizer }}
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Purchase Form -->
                <form v-if="!loading && !errorMessage" class="purchase-form" @submit.prevent="submitBooking">
                    <!-- Date Selection -->
                    <div class="form-section">
                        <h3>
                            <i class="fas fa-calendar-check"></i>
                            日付を選択<span class="required">※必須</span>
                        </h3>
                        <p style="color: #dc2626; font-weight: 600; margin-bottom: 15px; font-size: 0.95rem;">
                            <i class="fas fa-info-circle"></i> 日付により料金が異なる場合があります
                        </p>
                        <div class="date-options">
                            <div v-for="stock in stocks" :key="stock.id" class="date-option">
                                <input type="radio" :id="'date-' + stock.id" name="date" :value="stock.id" v-model="selectedStock" @change="onStockChange">
                                <label :for="'date-' + stock.id" class="date-label">
                                    <div style="font-size: 1.2rem;">{{ formatDate(stock.date) }}</div>
                                    <div style="font-size: 0.9rem; color: #6b7280; margin-top: 5px;">{{ stock.stock_name || '' }}</div>
                                    <div style="font-size: 0.85rem; color: #9ca3af; margin-top: 5px;">残り {{ stock.available }} 席</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Product Selection -->
                    <div class="form-section">
                        <h3>
                            <i class="fas fa-ticket-alt"></i>
                            商品・枚数を選択
                        </h3>
                        <div class="ticket-grid">
                            <div v-for="product in products" :key="product.id" class="ticket-item">
                                <div class="ticket-info">
                                    <div class="ticket-name">
                                        {{ product.name }}
                                        <span v-if="product.price_name" class="badge">{{ product.price_name }}</span>
                                    </div>
                                    <div class="ticket-price" :class="{ free: product.price === 0 }">
                                        {{ product.price === 0 ? '無料' : '¥' + product.price.toLocaleString() }}
                                    </div>
                                </div>
                                <div class="ticket-controls">
                                    <div class="quantity-control">
                                        <button type="button" class="quantity-btn" @click="decreaseQuantity('product', product.id)" :disabled="productQuantities[product.id] <= 0">−</button>
                                        <input type="number" class="quantity-input" :value="productQuantities[product.id] || 0" readonly>
                                        <button type="button" class="quantity-btn" @click="increaseQuantity('product', product.id)" :disabled="productQuantities[product.id] >= 10">+</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Options Selection -->
                    <div v-if="options.length > 0" class="form-section">
                        <h3>
                            <i class="fas fa-plus-circle"></i>
                            オプションを選択
                        </h3>
                        <div v-for="option in options" :key="option.id" class="option-item">
                            <div class="option-info">
                                <img v-if="option.image_url" :src="option.image_url" :alt="option.name" class="option-img" @error="onImageError">
                                <div v-else class="option-icon">📦</div>
                                <div>
                                    <div class="option-name">{{ option.name }}</div>
                                    <div class="option-price">¥{{ option.price.toLocaleString() }}</div>
                                </div>
                            </div>
                            <div class="ticket-controls">
                                <div class="quantity-control">
                                    <button type="button" class="quantity-btn" @click="decreaseQuantity('option', option.id)" :disabled="optionQuantities[option.id] <= 0">−</button>
                                    <input type="number" class="quantity-input" :value="optionQuantities[option.id] || 0" readonly>
                                    <button type="button" class="quantity-btn" @click="increaseQuantity('option', option.id)" :disabled="optionQuantities[option.id] >= 10">+</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Section -->
                    <div class="total-section">
                        <div class="total-breakdown">
                            <div class="breakdown-item">
                                <span class="breakdown-label"><i class="fas fa-ticket-alt"></i> 商品料金</span>
                                <span class="breakdown-value">¥{{ productTotal.toLocaleString() }}</span>
                            </div>
                            <div class="breakdown-item">
                                <span class="breakdown-label"><i class="fas fa-plus-circle"></i> オプション料金</span>
                                <span class="breakdown-value">¥{{ optionTotal.toLocaleString() }}</span>
                            </div>
                        </div>
                        <div class="total-final">
                            <span class="total-label">合計金額</span>
                            <span class="total-amount">¥{{ grandTotal.toLocaleString() }}</span>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="submit-btn" :disabled="!canSubmit || submitting">
                        <i class="fas fa-check-circle"></i>
                        <span v-if="submitting">処理中...</span>
                        <span v-else>予約を確定する</span>
                    </button>
                </form>
            </div>
        </div>

        <script>
            const { createApp } = Vue;

            createApp({
                data() {
                    return {
                        eventId: ${eventId},
                        event: ${JSON.stringify(event)},
                        loading: true,
                        errorMessage: '',
                        stocks: [],
                        products: [],
                        options: [],
                        selectedStock: null,
                        productQuantities: {},
                        optionQuantities: {},
                        submitting: false
                    }
                },
                computed: {
                    productTotal() {
                        let total = 0;
                        this.products.forEach(product => {
                            const qty = this.productQuantities[product.id] || 0;
                            total += product.price * qty;
                        });
                        return total;
                    },
                    optionTotal() {
                        let total = 0;
                        this.options.forEach(option => {
                            const qty = this.optionQuantities[option.id] || 0;
                            total += option.price * qty;
                        });
                        return total;
                    },
                    grandTotal() {
                        return this.productTotal + this.optionTotal;
                    },
                    canSubmit() {
                        if (!this.selectedStock) return false;
                        const hasProducts = Object.values(this.productQuantities).some(qty => qty > 0);
                        return hasProducts && this.grandTotal > 0;
                    }
                },
                methods: {
                    async loadData() {
                        try {
                            // 在庫情報取得（今後30日分）
                            const stocksRes = await axios.get('/api/stocks', {
                                params: {
                                    event_id: this.eventId,
                                    days: 30
                                }
                            });
                            this.stocks = stocksRes.data.stocks || [];

                            // 商品情報取得
                            const productsRes = await axios.get('/api/products', {
                                params: { event_id: this.eventId }
                            });
                            this.products = productsRes.data.products || [];

                            // 商品数量初期化
                            this.products.forEach(product => {
                                this.productQuantities[product.id] = 0;
                            });

                            // オプション情報取得
                            const optionsRes = await axios.get('/api/options', {
                                params: { event_id: this.eventId }
                            });
                            this.options = optionsRes.data.options || [];

                            // オプション数量初期化
                            this.options.forEach(option => {
                                this.optionQuantities[option.id] = 0;
                            });

                            this.loading = false;
                        } catch (error) {
                            console.error('データ取得エラー:', error);
                            this.errorMessage = 'データの読み込みに失敗しました。';
                            this.loading = false;
                        }
                    },
                    formatDate(dateStr) {
                        const date = new Date(dateStr + 'T00:00:00');
                        const options = { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' };
                        return date.toLocaleDateString('ja-JP', options);
                    },
                    increaseQuantity(type, id) {
                        if (type === 'product') {
                            if ((this.productQuantities[id] || 0) < 10) {
                                this.productQuantities[id] = (this.productQuantities[id] || 0) + 1;
                            }
                        } else if (type === 'option') {
                            if ((this.optionQuantities[id] || 0) < 10) {
                                this.optionQuantities[id] = (this.optionQuantities[id] || 0) + 1;
                            }
                        }
                    },
                    decreaseQuantity(type, id) {
                        if (type === 'product') {
                            if ((this.productQuantities[id] || 0) > 0) {
                                this.productQuantities[id] = this.productQuantities[id] - 1;
                            }
                        } else if (type === 'option') {
                            if ((this.optionQuantities[id] || 0) > 0) {
                                this.optionQuantities[id] = this.optionQuantities[id] - 1;
                            }
                        }
                    },
                    onStockChange() {
                        // 日付変更時の処理（必要に応じて価格更新など）
                        console.log('Stock changed:', this.selectedStock);
                    },
                    onImageError(event) {
                        event.target.src = '/static/images/no-image.svg';
                    },
                    async submitBooking() {
                        if (!this.canSubmit || this.submitting) return;

                        // 簡易バリデーション
                        if (!this.selectedStock) {
                            alert('日付を選択してください');
                            return;
                        }

                        const hasProducts = Object.values(this.productQuantities).some(qty => qty > 0);
                        if (!hasProducts) {
                            alert('商品を1つ以上選択してください');
                            return;
                        }

                        this.submitting = true;

                        try {
                            // 予約データ作成
                            const bookingData = {
                                event_id: this.eventId,
                                stock_id: this.selectedStock,
                                products: [],
                                options: []
                            };

                            // 商品データ追加
                            this.products.forEach(product => {
                                const qty = this.productQuantities[product.id] || 0;
                                if (qty > 0) {
                                    bookingData.products.push({
                                        product_id: product.id,
                                        quantity: qty,
                                        price: product.price
                                    });
                                }
                            });

                            // オプションデータ追加
                            this.options.forEach(option => {
                                const qty = this.optionQuantities[option.id] || 0;
                                if (qty > 0) {
                                    bookingData.options.push({
                                        option_id: option.id,
                                        quantity: qty,
                                        price: option.price
                                    });
                                }
                            });

                            // 予約API呼び出し（仮実装：実際の顧客情報入力画面への遷移が必要）
                            console.log('予約データ:', bookingData);
                            
                            // 仮の実装：アラート表示後、イベント詳細に戻る
                            alert('予約機能は開発中です。\\n\\n選択内容:\\n- 日付: ' + this.formatDate(this.stocks.find(s => s.id === this.selectedStock).date) + '\\n- 合計金額: ¥' + this.grandTotal.toLocaleString() + '\\n\\n実際の運用では、顧客情報入力画面に遷移します。');
                            
                            // イベント詳細に戻る
                            window.location.href = '/events/' + this.eventId;

                        } catch (error) {
                            console.error('予約エラー:', error);
                            alert('予約の処理中にエラーが発生しました。');
                        } finally {
                            this.submitting = false;
                        }
                    }
                },
                mounted() {
                    this.loadData();
                }
            }).mount('#app');
        </script>
    </body>
    </html>
  `)
})

// 予約完了画面（お客様側）
app.get('/events/:id/booking/complete', routeAccessControl('customer'), async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const customerId = c.req.query('customer_id')

  // イベント情報取得
  const event = await DB.prepare(`
    SELECT * FROM events WHERE id = ? AND enable_flg = 1
  `).bind(eventId).first()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  // 顧客情報取得
  const customer = await DB.prepare(`
    SELECT * FROM customers WHERE id = ?
  `).bind(customerId).first()

  // 予約情報取得
  const { results: bookings } = await DB.prepare(`
    SELECT 
      pb.*,
      p.name as product_name,
      ps.date,
      ps.stock_name,
      ps.price_band
    FROM product_bookings pb
    JOIN products p ON pb.product_id = p.id
    LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
    WHERE pb.customer_id = ?
    ORDER BY pb.id DESC
  `).bind(customerId).all()

  // 合計金額計算
  let totalAmount = 0
  bookings.forEach(booking => {
    totalAmount += booking.price * booking.quantity
  })

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約完了 - ${event.name} | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-green-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-check-circle"></i>
                    予約完了
                </h1>
                <p class="text-green-100 mt-2">${event.name}</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-calendar-alt"></i>イベント一覧
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <!-- 完了メッセージ -->
                <div class="bg-green-50 border-2 border-green-500 rounded-lg p-8 mb-8 text-center">
                    <div class="text-green-600 mb-4">
                        <i class="fas fa-check-circle text-6xl"></i>
                    </div>
                    <h2 class="text-3xl font-bold text-gray-800 mb-2">予約が完了しました！</h2>
                    <p class="text-gray-600 text-lg">
                        ご予約ありがとうございます。<br>
                        ご登録のメールアドレスに確認メールをお送りしました。
                    </p>
                </div>

                <!-- 予約番号 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-barcode text-blue-600"></i>
                        予約番号
                    </h3>
                    <div class="bg-gray-100 rounded-lg p-4 text-center">
                        <p class="text-3xl font-mono font-bold text-blue-600">#${String(customerId).padStart(8, '0')}</p>
                    </div>
                </div>

                <!-- 予約内容 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-list text-blue-600"></i>
                        予約内容
                    </h3>
                    
                    ${bookings.map(booking => `
                    <div class="border-b border-gray-200 pb-4 mb-4 last:border-b-0 last:mb-0 last:pb-0">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <h4 class="font-bold text-gray-800">${booking.product_name}</h4>
                                ${booking.date ? `
                                <p class="text-sm text-gray-600">
                                    日時: ${new Date(booking.date + 'T00:00:00').toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' })}
                                    ${booking.stock_name ? ` ${booking.stock_name}` : ''}
                                </p>
                                ` : ''}
                                ${booking.price_band ? `<p class="text-sm text-gray-500">価格帯: ${booking.price_band}</p>` : ''}
                            </div>
                            <div class="text-right">
                                <p class="text-sm text-gray-600">数量: ${booking.quantity}</p>
                                <p class="text-lg font-bold text-gray-800">¥${(booking.price * booking.quantity).toLocaleString()}</p>
                            </div>
                        </div>
                    </div>
                    `).join('')}
                    
                    <div class="mt-6 pt-4 border-t-2 border-gray-300">
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-bold text-gray-800">合計金額</span>
                            <span class="text-2xl font-bold text-blue-600">¥${totalAmount.toLocaleString()}</span>
                        </div>
                    </div>
                </div>

                <!-- お客様情報 -->
                ${customer ? `
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-user text-blue-600"></i>
                        お客様情報
                    </h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">お名前</p>
                            <p class="font-semibold text-gray-800">${customer.family_name} ${customer.first_name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">フリガナ</p>
                            <p class="font-semibold text-gray-800">${customer.family_kana || ''} ${customer.first_kana || ''}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">メールアドレス</p>
                            <p class="font-semibold text-gray-800">${customer.email}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">電話番号</p>
                            <p class="font-semibold text-gray-800">${customer.tel}</p>
                        </div>
                    </div>
                </div>
                ` : ''}

                <!-- 注意事項 -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle text-yellow-600"></i>
                        ご確認ください
                    </h3>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li>予約確認メールをご確認ください</li>
                        <li>当日は予約番号をお控えの上、ご来場ください</li>
                        <li>キャンセル・変更については、お問い合わせください</li>
                    </ul>
                </div>

                <!-- アクションボタン -->
                <div class="flex gap-4">
                    <a href="/events/${eventId}" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg text-center transition">
                        <i class="fas fa-arrow-left mr-2"></i>
                        イベント詳細に戻る
                    </a>
                    <a href="/events" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg text-center transition">
                        <i class="fas fa-list mr-2"></i>
                        イベント一覧を見る
                    </a>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

