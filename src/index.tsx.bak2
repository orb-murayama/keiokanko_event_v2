                                <div class="md:col-span-2">
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        メールアドレス <span class="text-red-500">*</span>
                                    </label>
                                    <input type="email" id="email" required 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500"
                                           placeholder="例: yamada@example.com">
                                </div>
                            </div>
                        </div>

                        <!-- 住所情報 -->
                        <div class="border-b pb-6">
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">住所</h3>
                            
                            <div class="space-y-4">
                                <div class="grid md:grid-cols-2 gap-6">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            郵便番号
                                        </label>
                                        <input type="text" id="zip" 
                                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500"
                                               placeholder="例: 100-0001">
                                    </div>

                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-2">
                                            都道府県
                                        </label>
                                        <select id="pref_id" 
                                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500">
                                            <option value="">選択してください</option>
                                            ${prefOptions}
                                        </select>
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-2">
                                        住所
                                    </label>
                                    <input type="text" id="addr" 
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500"
                                           placeholder="例: 千代田区千代田1-1">
                                </div>
                            </div>
                        </div>

                        <!-- その他 -->
                        <div>
                            <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                            
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    備考
                                </label>
                                <textarea id="remarks" rows="3"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-cyan-500"
                                          placeholder="その他の情報"></textarea>
                            </div>
                        </div>

                        <div class="flex gap-4 pt-6">
                            <button type="submit" 
                                    class="flex-1 bg-cyan-600 hover:bg-cyan-700 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-save mr-2"></i>登録する
                            </button>
                            <a href="/admin/clients" 
                               class="flex-1 bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold text-center">
                                <i class="fas fa-times mr-2"></i>キャンセル
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('clientForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    client_code: document.getElementById('client_code').value || null,
                    name: document.getElementById('name').value,
                    branch_office: document.getElementById('branch_office').value || null,
                    contactable_person: document.getElementById('contactable_person').value,
                    position: document.getElementById('position').value || null,
                    tel: document.getElementById('tel').value,
                    fax: document.getElementById('fax').value || null,
                    email: document.getElementById('email').value,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    remarks: document.getElementById('remarks').value || null
                }

                try {
                    await axios.post('/api/clients', data)
                    alert('クライアントを登録しました！')
                    window.location.href = '/admin/clients'
                } catch (error) {
                    alert('登録に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})

// クライアント登録API
app.post('/api/clients', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    const result = await DB.prepare(`
      INSERT INTO clients (
        client_code, name, branch_office, contactable_person, position, tel, fax, email,
        zip, pref_id, addr, remarks, password, group_id, reg_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, '', 1, 1)
    `).bind(
      data.client_code,
      data.name,
      data.branch_office,
      data.contactable_person,
      data.position,
      data.tel,
      data.fax,
      data.email,
      data.zip,
      data.pref_id,
      data.addr,
      data.remarks
    ).run()

    return c.json({ id: result.meta.last_row_id, message: 'クライアントを登録しました' })
  } catch (error) {
    console.error('クライアント登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

