// ============================================
// 会員管理API（Members/Customers）
// ============================================

// API: 会員一覧取得（ページネーション・検索対応）
app.get('/api/members', async (c) => {
  const { DB } = c.env
  
  try {
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '20')
    const offset = (page - 1) * perPage
    const search = c.req.query('search') || ''
    
    let whereClause = ''
    let bindParams = []
    
    if (search) {
      whereClause = `WHERE (c.email LIKE ? OR c.family_name LIKE ? OR c.first_name LIKE ? OR c.tel LIKE ? OR c.mobile LIKE ?)`
      const searchPattern = `%${search}%`
      bindParams = [searchPattern, searchPattern, searchPattern, searchPattern, searchPattern]
    }
    
    const countQuery = `SELECT COUNT(*) as total FROM customers c ${whereClause}`
    const countResult = await DB.prepare(countQuery).bind(...bindParams).first()
    const total = countResult.total
    
    const dataQuery = `
      SELECT c.id, c.email, c.family_name, c.first_name, c.family_kana, c.first_kana,
             c.sex, c.birth, c.mobile, c.tel, c.zip, c.pref_id, c.city, c.addr, c.bldg,
             c.enable_flg, c.created_at, c.modified_at, p.name as pref_name
      FROM customers c
      LEFT JOIN prefs p ON c.pref_id = p.id
      ${whereClause}
      ORDER BY c.id DESC
      LIMIT ? OFFSET ?
    `
    const { results: members } = await DB.prepare(dataQuery).bind(...bindParams, perPage, offset).all()
    
    return c.json({
      data: members,
      pagination: { page: page, per_page: perPage, total: total, total_pages: Math.ceil(total / perPage) },
      search: search
    })
  } catch (error) {
    console.error('Error fetching members:', error)
    return c.json({ error: '会員一覧の取得に失敗しました' }, 500)
  }
})

// API: 会員詳細取得
app.get('/api/members/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const member = await DB.prepare(`
      SELECT c.*, p.name as pref_name
      FROM customers c
      LEFT JOIN prefs p ON c.pref_id = p.id
      WHERE c.id = ?
    `).bind(id).first()
    
    if (!member) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    return c.json(member)
  } catch (error) {
    console.error('Error fetching member:', error)
    return c.json({ error: '会員情報の取得に失敗しました' }, 500)
  }
})

// API: 会員新規登録
app.post('/api/members', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    if (!data.email || !data.family_name || !data.first_name || !data.tel) {
      return c.json({ error: 'メールアドレス、氏名、電話番号は必須です' }, 400)
    }
    
    const existing = await DB.prepare(`SELECT id FROM customers WHERE email = ?`).bind(data.email).first()
    
    if (existing) {
      return c.json({ error: 'このメールアドレスは既に登録されています' }, 409)
    }
    
    let sexValue = null
    if (data.sex === 'male') sexValue = 1
    else if (data.sex === 'female') sexValue = 2
    else if (data.sex === 'other') sexValue = 3
    
    const result = await DB.prepare(`
      INSERT INTO customers (
        email, family_name, first_name, family_kana, first_kana,
        sex, birth, tel, mobile, fax, zip, pref_id, city, addr, bldg,
        company_name, department_name, remark, password, enable_flg,
        created_at, modified_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      data.email, data.family_name, data.first_name, data.family_kana || null, data.first_kana || null,
      sexValue, data.birth || null, data.tel, data.mobile || null, data.fax || null,
      data.zip || null, data.pref_id || null, data.city || null, data.addr || null, data.bldg || null,
      data.company_name || null, data.department_name || null, data.remark || null,
      data.password || null, data.enable_flg !== undefined ? data.enable_flg : 1
    ).run()
    
    return c.json({ id: result.meta.last_row_id, message: '会員を登録しました' })
  } catch (error) {
    console.error('Error creating member:', error)
    return c.json({ error: '会員の登録に失敗しました' }, 500)
  }
})

// API: 会員更新
app.put('/api/members/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    const existing = await DB.prepare(`SELECT id, email FROM customers WHERE id = ?`).bind(id).first()
    
    if (!existing) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    if (data.email && data.email !== existing.email) {
      const duplicate = await DB.prepare(`SELECT id FROM customers WHERE email = ? AND id != ?`).bind(data.email, id).first()
      
      if (duplicate) {
        return c.json({ error: 'このメールアドレスは既に登録されています' }, 409)
      }
    }
    
    let sexValue = null
    if (data.sex === 'male') sexValue = 1
    else if (data.sex === 'female') sexValue = 2
    else if (data.sex === 'other') sexValue = 3
    else if (data.sex) sexValue = data.sex
    
    await DB.prepare(`
      UPDATE customers SET
        email = ?, family_name = ?, first_name = ?, family_kana = ?, first_kana = ?,
        sex = ?, birth = ?, tel = ?, mobile = ?, fax = ?, zip = ?, pref_id = ?,
        city = ?, addr = ?, bldg = ?, company_name = ?, department_name = ?, remark = ?,
        password = ?, enable_flg = ?, modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.email, data.family_name, data.first_name, data.family_kana || null, data.first_kana || null,
      sexValue, data.birth || null, data.tel, data.mobile || null, data.fax || null,
      data.zip || null, data.pref_id || null, data.city || null, data.addr || null, data.bldg || null,
      data.company_name || null, data.department_name || null, data.remark || null,
      data.password || null, data.enable_flg !== undefined ? data.enable_flg : 1, id
    ).run()
    
    return c.json({ message: '会員情報を更新しました' })
  } catch (error) {
    console.error('Error updating member:', error)
    return c.json({ error: '会員情報の更新に失敗しました' }, 500)
  }
})

// API: 会員削除（論理削除）
app.delete('/api/members/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const existing = await DB.prepare(`SELECT id FROM customers WHERE id = ?`).bind(id).first()
    
    if (!existing) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    await DB.prepare(`
      UPDATE customers SET enable_flg = 0, canceled_at = datetime('now', 'localtime') WHERE id = ?
    `).bind(id).run()
    
    return c.json({ message: '会員を削除しました' })
  } catch (error) {
    console.error('Error deleting member:', error)
    return c.json({ error: '会員の削除に失敗しました' }, 500)
  }
})

