            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('vendorForm').addEventListener('submit', async (e) => {
                e.preventDefault()
                
                const data = {
                    name: document.getElementById('name').value,
                    branch_office: document.getElementById('branch_office').value || null,
                    zip: document.getElementById('zip').value || null,
                    pref_id: document.getElementById('pref_id').value || null,
                    addr: document.getElementById('addr').value || null,
                    tel: document.getElementById('tel').value,
                    fax: document.getElementById('fax').value || null,
                    email: document.getElementById('email').value,
                    password: document.getElementById('password').value,
                    business_hours: document.getElementById('business_hours').value || null,
                    closed_days: document.getElementById('closed_days').value || null,
                    business_notes: document.getElementById('business_notes').value || null,
                    registration_number: document.getElementById('registration_number').value || null,
                    association_name: document.getElementById('association_name').value || null,
                    association_membership: document.getElementById('association_membership').value || null,
                    travel_manager_title: document.getElementById('travel_manager_title').value || null,
                    travel_manager_name: document.getElementById('travel_manager_name').value || null,
                    remarks: document.getElementById('remarks').value || null,
                    reg_flg: parseInt(document.getElementById('reg_flg').value)
                }

                try {
                    await axios.post('/api/vendors', data)
                    alert('販売会社を登録しました！')
                    window.location.href = '/admin/vendors'
                } catch (error) {
                    alert('登録に失敗しました: ' + (error.response?.data?.error || error.message))
                }
            })
        </script>
    </body>
    </html>
  `)
})

// 販売会社編集画面
app.get('/admin/vendors/:id/edit', async (c) => {
  const { DB } = c.env
  const vendorId = c.req.param('id')
  
  const { results } = await DB.prepare(`
    SELECT * FROM vendors WHERE id = ?
  `).bind(vendorId).all()
  
  if (results.length === 0) {
    return c.text('販売会社が見つかりません', 404)
  }
  
  const vendor = results[0]
  
  // 都道府県リスト取得
  const { results: prefs } = await DB.prepare(`
    SELECT id, name FROM prefs ORDER BY id
  `).all()
  
  const prefOptions = prefs.map(p => 
    `<option value="${p.id}" ${vendor.pref_id == p.id ? 'selected' : ''}>${p.name}</option>`
  ).join('')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>販売会社編集 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-amber-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-store"></i>
                    販売会社編集
                </h1>
            </div>
        </header>

        <main class="container mx-auto px-4 py-8 max-w-2xl">
            <div class="bg-white rounded-lg shadow-md p-6">
                <form id="vendorForm">
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">会社名 <span class="text-red-500">*</span></label>
                        <input type="text" name="name" value="${vendor.name}" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">担当者名</label>
                        <input type="text" name="contact_person" value="${vendor.contact_person || ''}" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">電話番号</label>
                        <input type="tel" name="tel" value="${vendor.tel || ''}" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">メールアドレス</label>
                        <input type="email" name="email" value="${vendor.email || ''}" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">住所</label>
                        <textarea name="address" rows="3" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">${vendor.address || ''}</textarea>
                    </div>
                    
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">パスワード（変更する場合のみ入力）</label>
                        <input type="password" name="password" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500">
                    </div>
                    
                    <div class="flex gap-4">
                        <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg">
                            <i class="fas fa-save mr-2"></i>更新する
                        </button>
                        <a href="/admin/vendors" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-3 rounded-lg">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </a>
                    </div>
                </form>
            </div>
        </main>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('vendorForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                const data = Object.fromEntries(formData.entries());
                
                // パスワードが空の場合は削除
                if (!data.password) {
                    delete data.password;
                }
                
                try {
                    const response = await axios.put('/api/vendors/${vendorId}', data);
                    alert('販売会社を更新しました！');
                    window.location.href = '/admin/vendors';
                } catch (error) {
                    console.error('Error:', error);
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            });
        </script>
    </body>
    </html>
  `)
})

// API - 販売会社一覧取得
app.get('/api/vendors', async (c) => {
  const { DB } = c.env
  const { results } = await DB.prepare('SELECT * FROM vendors ORDER BY created_at DESC').all()
  return c.json(results)
})

// API - 販売会社登録
app.post('/api/vendors', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    const result = await DB.prepare(`
      INSERT INTO vendors (
        name, branch_office, zip, pref_id, addr, tel, fax, email, password,
        business_hours, closed_days, business_notes,
        registration_number, association_name, association_membership,
        travel_manager_title, travel_manager_name,
        remarks, reg_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.branch_office,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.fax,
      data.email,
      data.password,
      data.business_hours,
      data.closed_days,
      data.business_notes,
      data.registration_number,
      data.association_name,
      data.association_membership,
      data.travel_manager_title,
      data.travel_manager_name,
      data.remarks,
      data.reg_flg
    ).run()

    return c.json({ id: result.meta.last_row_id, message: '販売会社を登録しました' })
  } catch (error) {
    console.error('販売会社登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 販売会社更新
app.put('/api/vendors/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()

  try {
    // パスワード更新がある場合とない場合で分岐
    let query = `
      UPDATE vendors SET
        name = ?,
        branch_office = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        tel = ?,
        fax = ?,
        email = ?,
        business_hours = ?,
        closed_days = ?,
        business_notes = ?,
        registration_number = ?,
        association_name = ?,
        association_membership = ?,
        travel_manager_title = ?,
        travel_manager_name = ?,
        remarks = ?,
        reg_flg = ?,
        modified_at = datetime('now', 'localtime')
    `
    
    const params = [
      data.name,
      data.branch_office,
      data.zip,
      data.pref_id,
      data.addr,
      data.tel,
      data.fax,
      data.email,
      data.business_hours,
      data.closed_days,
      data.business_notes,
      data.registration_number,
      data.association_name,
      data.association_membership,
      data.travel_manager_title,
      data.travel_manager_name,
      data.remarks,
      data.reg_flg
    ]

    if (data.password) {
      query += `, password = ?`
      params.push(data.password)
    }

    query += ` WHERE id = ?`
    params.push(id)

    await DB.prepare(query).bind(...params).run()

    return c.json({ message: '販売会社情報を更新しました' })
  } catch (error) {
    console.error('販売会社更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 販売会社詳細表示
app.get('/admin/vendors/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  const { results } = await DB.prepare(`
    SELECT v.*, p.name as pref_name
    FROM vendors v
    LEFT JOIN prefs p ON v.pref_id = p.id
    WHERE v.id = ?
  `).bind(id).all()
  
  if (results.length === 0) {
    return c.text('販売会社が見つかりません', 404)
  }
  
  const vendor = results[0]
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>販売会社詳細 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-amber-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-store"></i>
                    販売会社詳細
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/vendors" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-store"></i>販売会社管理
                    </a></li>
                    <li><span class="text-amber-600 font-semibold">販売会社詳細</span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8 max-w-4xl">
            <div class="bg-white rounded-lg shadow-lg p-8">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">${vendor.name}</h2>
                    <a href="/admin/vendors/${vendor.id}/edit" class="bg-amber-600 hover:bg-amber-700 text-white px-6 py-3 rounded-lg flex items-center gap-2">
                        <i class="fas fa-edit"></i>編集
                    </a>
                </div>

                <div class="space-y-8">
                    <!-- 基本情報 -->
                    <section class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">基本情報</h3>
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">販売会社ID</label>
                                <div class="text-gray-800">${vendor.vendor_code || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">部署・支店名</label>
                                <div class="text-gray-800">${vendor.branch_office || '-'}</div>
                            </div>
                        </div>
                    </section>

                    <!-- 所在地 -->
                    <section class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">所在地</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">郵便番号</label>
                                <div class="text-gray-800">${vendor.zip || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">都道府県</label>
                                <div class="text-gray-800">${vendor.pref_name || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">住所</label>
                                <div class="text-gray-800">${vendor.addr || '-'}</div>
                            </div>
                        </div>
                    </section>

                    <!-- 連絡先 -->
                    <section class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">連絡先</h3>
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">電話番号</label>
                                <div class="text-gray-800">${vendor.tel || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">FAX番号</label>
                                <div class="text-gray-800">${vendor.fax || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">メールアドレス</label>
                                <div class="text-gray-800">${vendor.email || '-'}</div>
                            </div>
                        </div>
                    </section>

                    <!-- 営業情報 -->
                    <section class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">営業情報</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">営業時間</label>
                                <div class="text-gray-800">${vendor.business_hours || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">定休日</label>
                                <div class="text-gray-800">${vendor.closed_days || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">営業に関する備考</label>
                                <div class="text-gray-800 whitespace-pre-wrap">${vendor.business_notes || '-'}</div>
                            </div>
                        </div>
                    </section>

                    <!-- 登録情報 -->
                    <section class="border-b pb-6">
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">登録情報</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">観光庁登録番号</label>
                                <div class="text-gray-800">${vendor.registration_number || '-'}</div>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">協会名</label>
                                    <div class="text-gray-800">${vendor.association_name || '-'}</div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">会員情報</label>
                                    <div class="text-gray-800">${vendor.association_membership || '-'}</div>
                                </div>
                            </div>
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">旅行業務取扱管理者役職</label>
                                    <div class="text-gray-800">${vendor.travel_manager_title || '-'}</div>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-500 mb-1">旅行業務取扱管理者名</label>
                                    <div class="text-gray-800">${vendor.travel_manager_name || '-'}</div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- その他 -->
                    <section>
                        <h3 class="text-lg font-semibold text-gray-700 mb-4">その他</h3>
                        <div class="space-y-3">
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">備考</label>
                                <div class="text-gray-800 whitespace-pre-wrap">${vendor.remarks || '-'}</div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-500 mb-1">公開状態</label>
                                <div>
                                    <span class="px-2 py-1 text-xs rounded ${vendor.reg_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                        ${vendor.reg_flg ? '有効' : '無効'}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

// API - 販売会社削除
app.delete('/api/vendors/:id', async (c) => {
  const { DB } = c.env
  const vendorId = c.req.param('id')
  
  try {
    await DB.prepare('DELETE FROM vendors WHERE id = ?').bind(vendorId).run()
    return c.json({ message: '販売会社を削除しました' })
  } catch (error) {
    console.error('販売会社削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

export default app
