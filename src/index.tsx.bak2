  `)
})

// 管理画面 - イベント管理（完全API化）
app.get('/admin/events', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>イベント管理 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-purple-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-calendar-plus"></i>
                    イベント管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/events" class="text-purple-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-calendar-plus"></i>イベント管理
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">イベント一覧</h2>
                    <a href="/admin/events/new" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition inline-block">
                        <i class="fas fa-plus mr-2"></i>新規イベント登録
                    </a>
                </div>

                <!-- 検索フォーム -->
                <form id="searchForm" class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">イベント名</label>
                            <input type="text" id="searchName" 
                                   placeholder="イベント名で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">担当支店</label>
                            <select id="searchBranchCode" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべて</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">クライアント</label>
                            <select id="searchClientId" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべて</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">主催者</label>
                            <select id="searchVendorId" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべて</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">開催期間（From）</label>
                            <input type="date" id="searchDateFrom"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mt-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">開催期間（To）</label>
                            <input type="date" id="searchDateTo"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </button>
                    </div>
                </form>

                <!-- ローディング表示 -->
                <div id="loading" class="text-center py-8 hidden">
                    <i class="fas fa-spinner fa-spin text-4xl text-blue-600"></i>
                    <p class="mt-4 text-gray-600">読み込み中...</p>
                </div>

                <!-- イベント一覧テーブル -->
                <div id="eventsTableContainer" class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">ID</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">イベント名</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">タイプ</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">担当支店</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">主催者</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">開催期間</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">状態</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">操作</th>
                            </tr>
                        </thead>
                        <tbody id="eventsTableBody">
                            <tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">イベントを読み込んでいます...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- ページネーション -->
                <div id="pagination" class="mt-6 flex items-center justify-between hidden">
                    <div class="text-sm text-gray-600">
                        <span id="paginationInfo"></span>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="goToPage(currentPage - 1)" id="prevPageBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition disabled:opacity-50" disabled>
                            <i class="fas fa-chevron-left"></i> 前へ
                        </button>
                        <button onclick="goToPage(currentPage + 1)" id="nextPageBtn" class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 transition disabled:opacity-50" disabled>
                            次へ <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // グローバル変数
            let currentPage = 1;
            let perPage = 20;
            let categoryMap = {};
            
            // ページ読み込み時の初期化
            document.addEventListener('DOMContentLoaded', async () => {
                await loadCategories();
                await loadBranches();
                await loadClients();
                await loadVendors();
                await loadEvents();
            });
            
            // カテゴリマスタを読み込み
            async function loadCategories() {
                try {
                    const response = await axios.get('/api/v1/categories?per_page=1000');
                    response.data.data.forEach(cat => {
                        categoryMap[cat.id] = cat.name;
                    });
                } catch (error) {
                    console.error('カテゴリ読み込みエラー:', error);
                }
            }
            
            // 支店一覧を読み込み
            async function loadBranches() {
                try {
                    const response = await axios.get('/api/branches?per_page=1000');
                    const select = document.getElementById('searchBranchCode');
                    response.data.data.forEach(branch => {
                        const option = document.createElement('option');
                        option.value = branch.branch_code;
                        option.textContent = branch.branch_full_name;
                        select.appendChild(option);
                    });
                } catch (error) {
                    console.error('支店読み込みエラー:', error);
                }
            }
            
            // クライアント一覧を読み込み
            async function loadClients() {
                try {
                    const response = await axios.get('/api/v1/clients?per_page=1000');
                    const select = document.getElementById('searchClientId');
                    response.data.data.forEach(client => {
                        const option = document.createElement('option');
                        option.value = client.id;
                        option.textContent = client.name;
                        select.appendChild(option);
                    });
                } catch (error) {
                    console.error('クライアント読み込みエラー:', error);
                }
            }
            
            // 主催者一覧を読み込み
            async function loadVendors() {
                try {
                    const response = await axios.get('/api/v1/organizers?per_page=1000');
                    const select = document.getElementById('searchVendorId');
                    response.data.data.forEach(vendor => {
                        const option = document.createElement('option');
                        option.value = vendor.id;
                        option.textContent = vendor.name;
                        select.appendChild(option);
                    });
                } catch (error) {
                    console.error('主催者読み込みエラー:', error);
                }
            }
            
            // イベント一覧を読み込み
            async function loadEvents(page = 1) {
                const loading = document.getElementById('loading');
                const tableBody = document.getElementById('eventsTableBody');
                
                loading.classList.remove('hidden');
                
                try {
                    // 検索パラメータを取得
                    const name = document.getElementById('searchName').value;
                    const branchCode = document.getElementById('searchBranchCode').value;
                    const clientId = document.getElementById('searchClientId').value;
                    const vendorId = document.getElementById('searchVendorId').value;
                    const dateFrom = document.getElementById('searchDateFrom').value;
                    const dateTo = document.getElementById('searchDateTo').value;
                    
                    // APIリクエストパラメータを構築
                    const params = new URLSearchParams({
                        page: page,
                        per_page: perPage
                    });
                    
                    if (name) params.append('name', name);
                    if (branchCode) params.append('branch_code', branchCode);
                    if (clientId) params.append('client_id', clientId);
                    if (vendorId) params.append('vendor_id', vendorId);
                    if (dateFrom) params.append('event_start_date_from', dateFrom);
                    if (dateTo) params.append('event_start_date_to', dateTo);
                    
                    // API呼び出し
                    const response = await axios.get(\`/api/v1/events?\${params.toString()}\`);
                    const { data: events, pagination } = response.data;
                    
                    // テーブルボディをクリア
                    tableBody.innerHTML = '';
                    
                    if (events.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">イベントがありません</td></tr>';
                    } else {
                        events.forEach(event => {
                            const row = createEventRow(event);
                            tableBody.innerHTML += row;
                        });
                    }
                    
                    // ページネーション更新
                    updatePagination(pagination);
                    currentPage = page;
                    
                } catch (error) {
                    console.error('イベント読み込みエラー:', error);
                    tableBody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-red-500">エラーが発生しました: ' + error.message + '</td></tr>';
                } finally {
                    loading.classList.add('hidden');
                }
            }
            
            // イベント行のHTMLを生成
            function createEventRow(event) {
                // 開催期間のフォーマット
                let eventPeriod = '-';
                if (event.event_start_date && event.event_end_date) {
                    const startDate = new Date(event.event_start_date).toLocaleDateString('ja-JP');
                    const endDate = new Date(event.event_end_date).toLocaleDateString('ja-JP');
                    eventPeriod = startDate + ' 〜 ' + endDate;
                } else if (event.event_start_date) {
                    eventPeriod = new Date(event.event_start_date).toLocaleDateString('ja-JP');
                }
                
                // カテゴリタグを生成
                let categoryTags = '';
                if (event.category) {
                    try {
                        const categoryIds = JSON.parse(event.category);
                        if (Array.isArray(categoryIds) && categoryIds.length > 0) {
                            categoryTags = categoryIds.map(id => {
                                const categoryName = categoryMap[id] || \`ID:\${id}\`;
                                return \`<span class="inline-block px-2 py-1 text-xs bg-purple-100 text-purple-700 rounded-full mr-1 mb-1">\${categoryName}</span>\`;
                            }).join('');
                        }
                    } catch (e) {
                        // JSON解析失敗時は文字列として表示
                        categoryTags = \`<span class="inline-block px-2 py-1 text-xs bg-gray-100 text-gray-700 rounded-full">\${event.category}</span>\`;
                    }
                }
                
                // イベントタイプバッジを生成
                let eventTypeBadge = '';
                let eventNamePrefix = '';
                
                const eventType = event.event_type || 'standalone';
                if (eventType === 'parent') {
                    eventTypeBadge = '<span class="px-2 py-1 text-xs bg-blue-100 text-blue-800 rounded"><i class="fas fa-folder mr-1"></i>親イベント</span>';
                } else if (eventType === 'child') {
                    eventTypeBadge = '<span class="px-2 py-1 text-xs bg-green-100 text-green-800 rounded"><i class="fas fa-level-down-alt mr-1"></i>子イベント</span>';
                    eventNamePrefix = '　└─ '; // インデント表示
                } else {
                    eventTypeBadge = '<span class="px-2 py-1 text-xs bg-gray-100 text-gray-800 rounded"><i class="fas fa-file mr-1"></i>単独</span>';
                }
                
                const eventName = event.name.replace(/'/g, "\\\\'");
                
                return \`
                <tr class="hover:bg-gray-50 \${eventType === 'child' ? 'bg-green-50' : ''}">
                    <td class="px-4 py-3 border-b">\${event.id}</td>
                    <td class="px-4 py-3 border-b">
                        <div class="font-semibold">\${eventNamePrefix}\${event.name}</div>
                        \${categoryTags ? \`<div class="mt-2 flex flex-wrap">\${categoryTags}</div>\` : ''}
                    </td>
                    <td class="px-4 py-3 border-b">
                        \${eventTypeBadge}
                    </td>
                    <td class="px-4 py-3 border-b text-sm text-gray-600">
                        \${event.branch_name || '-'}
                    </td>
                    <td class="px-4 py-3 border-b text-sm text-gray-600">
                        <div>\${event.vendor_name || '-'}</div>
                        \${event.client_name ? \`<div class="text-xs text-gray-500 mt-1">クライアント: \${event.client_name}</div>\` : ''}
                    </td>
                    <td class="px-4 py-3 border-b text-sm text-gray-600">
                        \${eventPeriod}
                    </td>
                    <td class="px-4 py-3 border-b">
                        <span class="px-2 py-1 text-xs rounded \${event.enable_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                            \${event.enable_flg ? '有効' : '無効'}
                        </span>
                    </td>
                    <td class="px-4 py-3 border-b">
                        <div class="flex gap-2 flex-wrap">
                            <a href="/admin/bookings?event_id=\${event.id}" class="text-indigo-600 hover:text-indigo-800">
                                <i class="fas fa-calendar-check"></i>予約
                            </a>
                            <a href="/admin/events/\${event.id}/edit" class="text-blue-600 hover:text-blue-800">
                                <i class="fas fa-edit"></i>編集
                            </a>
                            <a href="/admin/events/\${event.id}/form-fields" class="text-orange-600 hover:text-orange-800">
                                <i class="fas fa-wpforms"></i>フォーム
                            </a>
                            <a href="/admin/products?event_id=\${event.id}&event_name=\${encodeURIComponent(event.name)}" class="text-green-600 hover:text-green-800">
                                <i class="fas fa-box"></i>商品
                            </a>
                            <a href="/admin/options?event_id=\${event.id}&event_name=\${encodeURIComponent(event.name)}" class="text-teal-600 hover:text-teal-800">
                                <i class="fas fa-list-ul"></i>オプション
                            </a>
                            <button onclick="copyEvent(\${event.id}, '\${eventName}')" class="text-purple-600 hover:text-purple-800">
                                <i class="fas fa-copy"></i>コピー
                            </button>
                            <button onclick="deleteEvent(\${event.id}, '\${eventName}')" class="text-red-600 hover:text-red-800">
                                <i class="fas fa-trash"></i>削除
                            </button>
                        </div>
                    </td>
                </tr>
                \`;
            }
            
            // ページネーション更新
            function updatePagination(pagination) {
                const paginationDiv = document.getElementById('pagination');
                const paginationInfo = document.getElementById('paginationInfo');
                const prevBtn = document.getElementById('prevPageBtn');
                const nextBtn = document.getElementById('nextPageBtn');
                
                if (pagination.total > 0) {
                    paginationDiv.classList.remove('hidden');
                    
                    const start = (pagination.page - 1) * pagination.per_page + 1;
                    const end = Math.min(pagination.page * pagination.per_page, pagination.total);
                    paginationInfo.textContent = \`\${start}〜\${end}件 / 全\${pagination.total}件 (ページ \${pagination.page}/\${pagination.total_pages})\`;
                    
                    prevBtn.disabled = pagination.page <= 1;
                    nextBtn.disabled = pagination.page >= pagination.total_pages;
                } else {
                    paginationDiv.classList.add('hidden');
                }
            }
            
            // ページ移動
            function goToPage(page) {
                loadEvents(page);
            }
            
            // 検索フォーム送信
            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                loadEvents(1);
            });
            
            // 検索リセット
            function resetSearch() {
                document.getElementById('searchName').value = '';
                document.getElementById('searchBranchCode').value = '';
                document.getElementById('searchClientId').value = '';
                document.getElementById('searchVendorId').value = '';
                document.getElementById('searchDateFrom').value = '';
                document.getElementById('searchDateTo').value = '';
                loadEvents(1);
            }
            
            // イベントコピー
            async function copyEvent(eventId, eventName) {
                if (!confirm(\`「\${eventName}」をコピーしますか？\\nコピー後のイベント名は「コピー \${eventName}」となり、公開状態は無効になります。\`)) {
                    return;
                }
                
                try {
                    const response = await axios.post(\`/api/events/\${eventId}/copy\`);
                    alert('イベントをコピーしました！');
                    loadEvents(currentPage);
                } catch (error) {
                    console.error('Error:', error);
                    alert('コピーに失敗しました: ' + (error.response?.data?.error || error.message));
                }
            }
            
            // イベント削除
            async function deleteEvent(eventId, eventName) {
                if (!confirm(\`「\${eventName}」を削除してもよろしいですか？\\nこの操作は取り消せません。\`)) {
                    return;
                }
                
                try {
                    const response = await axios.delete(\`/api/events/\${eventId}\`);
                    alert('イベントを削除しました！');
                    loadEvents(currentPage);
                } catch (error) {
                    console.error('Error:', error);
                    alert('削除に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            }
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 商品管理
app.get('/admin/products', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>商品管理 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-green-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-box"></i>
                    商品管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/products" class="text-green-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-box"></i>商品管理
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">商品一覧</h2>
                    <a href="/admin/products/new" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition inline-block">
                        <i class="fas fa-plus mr-2"></i>新規商品登録
                    </a>
                </div>

                <form id="searchForm" method="GET" action="/admin/products" class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">商品名</label>
                            <input type="text" name="name" id="searchName"
                                   placeholder="商品名で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">イベント</label>
                            <select name="event_id" id="searchEventId"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべてのイベント</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">状態</label>
                            <select name="status" id="searchStatus" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべて</option>
                                <option value="1">販売中</option>
                                <option value="0">停止中</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button type="submit" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <a href="/admin/products" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </a>
                    </div>
                </form>

                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">ID</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">画像</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">商品名</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">イベント</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">価格</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">状態</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">操作</th>
                            </tr>
                        </thead>
                        <tbody id="productsTableBody">
                            <tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">読み込み中...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- ページネーション -->
                <div id="pagination" class="mt-6 flex items-center justify-between">
                    <div class="text-sm text-gray-700">
                        <span id="paginationInfo">全 0 件中 0 - 0 件を表示</span>
                    </div>
                    <div class="flex gap-2">
                        <button id="prevPage" onclick="changePage(currentPage - 1)" 
                                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-left mr-1"></i>前へ
                        </button>
                        <button id="nextPage" onclick="changePage(currentPage + 1)" 
                                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50 disabled:cursor-not-allowed">
                            次へ<i class="fas fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            let currentPage = 1;
            const perPage = 20;
            let totalPages = 1;
            let searchParams = {};
            
            // ページ読み込み時に商品一覧を取得
            document.addEventListener('DOMContentLoaded', async function() {
                console.log('=== Products List Initialization START ===');
                
                // URLパラメータを取得
                const urlParams = new URLSearchParams(window.location.search);
                const searchName = urlParams.get('name') || '';
                const searchEventId = urlParams.get('event_id') || '';
                const searchStatus = urlParams.get('status') || '';
                
                // イベント一覧を読み込み
                try {
                    const eventsRes = await axios.get('/api/v1/events?per_page=1000');
                    const events = eventsRes.data.data;
                    const selectEl = document.getElementById('searchEventId');
                    
                    events.forEach(event => {
                        const option = document.createElement('option');
                        option.value = event.id;
                        option.textContent = event.name;
                        selectEl.appendChild(option);
                    });
                } catch (error) {
                    console.error('イベント一覧取得エラー:', error);
                }
                
                // 検索フォームの値を復元
                if (searchName) {
                    document.getElementById('searchName').value = searchName;
                    searchParams.name = searchName;
                }
                if (searchEventId) {
                    document.getElementById('searchEventId').value = searchEventId;
                    searchParams.event_id = searchEventId;
                }
                if (searchStatus) {
                    document.getElementById('searchStatus').value = searchStatus;
                    searchParams.status = searchStatus;
                }
                
                await loadProducts();
            });
            
            // 検索フォーム送信
            document.getElementById('searchForm').addEventListener('submit', function(e) {
                e.preventDefault();
                searchParams = {};
                
                const name = document.getElementById('searchName').value;
                const eventId = document.getElementById('searchEventId').value;
                const status = document.getElementById('searchStatus').value;
                
                if (name) searchParams.name = name;
                if (eventId) searchParams.event_id = eventId;
                if (status) searchParams.status = status;
                
                currentPage = 1;
                loadProducts();
            });
            
            // 商品一覧を読み込む関数
            async function loadProducts() {
                try {
                    const tbody = document.getElementById('productsTableBody');
                    tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-500"><i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...</td></tr>';
                    
                    // APIリクエスト
                    let apiUrl = \`/api/v1/products?page=\${currentPage}&per_page=\${perPage}\`;
                    if (searchParams.name) apiUrl += '&name=' + encodeURIComponent(searchParams.name);
                    if (searchParams.event_id) apiUrl += '&event_id=' + encodeURIComponent(searchParams.event_id);
                    if (searchParams.status) apiUrl += '&status=' + encodeURIComponent(searchParams.status);
                    
                    console.log('Loading products:', apiUrl);
                    const productsRes = await axios.get(apiUrl);
                    const products = productsRes.data.data;
                    const pagination = productsRes.data.pagination;
                    
                    console.log('Products loaded:', products.length);
                    console.log('Pagination:', pagination);
                    
                    if (products.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">商品がありません</td></tr>';
                        document.getElementById('pagination').classList.add('hidden');
                    } else {
                        tbody.innerHTML = products.map(product => \`
                            <tr class="hover:bg-gray-50">
                                <td class="px-4 py-3 border-b">\${product.id}</td>
                                <td class="px-4 py-3 border-b">
                                    <img src="\${product.image_url || '/static/images/no-image.svg'}" 
                                         alt="\${product.name}" 
                                         class="w-16 h-16 object-cover rounded border border-gray-200"
                                         onerror="this.src='/static/images/no-image.svg'">
                                </td>
                                <td class="px-4 py-3 border-b font-semibold">\${product.name}</td>
                                <td class="px-4 py-3 border-b text-sm text-gray-600">\${product.event_name || '-'}</td>
                                <td class="px-4 py-3 border-b text-lg font-bold text-blue-600">
                                    ¥\${product.price ? product.price.toLocaleString() : '---'}
                                </td>
                                <td class="px-4 py-3 border-b">
                                    <span class="px-2 py-1 text-xs rounded \${product.enable_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}">
                                        \${product.enable_flg ? '販売中' : '停止中'}
                                    </span>
                                </td>
                                <td class="px-4 py-3 border-b">
                                    <div class="flex gap-2">
                                        <a href="/admin/products/\${product.id}/edit" class="text-blue-600 hover:text-blue-800">
                                            <i class="fas fa-edit"></i>編集
                                        </a>
                                        <a href="/admin/products/\${product.id}/stocks" class="text-green-600 hover:text-green-800">
                                            <i class="fas fa-boxes"></i>在庫
                                        </a>
                                        <a href="/admin/products/\${product.id}/shared-stocks" class="text-teal-600 hover:text-teal-800">
                                            <i class="fas fa-warehouse"></i>共有在庫
                                        </a>
                                        <button onclick="copyProduct(\${product.id}, '\${escapeHtml(product.name)}')" class="text-purple-600 hover:text-purple-800">
                                            <i class="fas fa-copy"></i>コピー
                                        </button>
                                        <button onclick="deleteProduct(\${product.id}, '\${escapeHtml(product.name)}')" class="text-red-600 hover:text-red-800">
                                            <i class="fas fa-trash"></i>削除
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        \`).join('');
                        
                        // ページネーション情報を更新
                        totalPages = pagination.total_pages;
                        const start = (currentPage - 1) * perPage + 1;
                        const end = Math.min(currentPage * perPage, pagination.total);
                        document.getElementById('paginationInfo').textContent = 
                            \`全 \${pagination.total} 件中 \${start} - \${end} 件を表示\`;
                        
                        // ボタンの状態を更新
                        document.getElementById('prevPage').disabled = currentPage === 1;
                        document.getElementById('nextPage').disabled = currentPage === totalPages;
                        document.getElementById('pagination').classList.remove('hidden');
                    }
                } catch (error) {
                    console.error('Error loading products:', error);
                    document.getElementById('productsTableBody').innerHTML = 
                        '<tr><td colspan="6" class="px-4 py-8 text-center text-red-500">データの読み込みに失敗しました</td></tr>';
                }
            }
            
            // ページ変更
            function changePage(page) {
                if (page < 1 || page > totalPages) return;
                currentPage = page;
                loadProducts();
            }
            
            // HTML エスケープ
            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            async function copyProduct(productId, productName) {
                if (!confirm('「' + productName + '」をコピーしますか？\\nコピー後の商品名は「コピー ' + productName + '」となり、販売状態は停止中になります。')) {
                    return;
                }
                
                try {
                    const response = await axios.post('/api/products/' + productId + '/copy');
                    alert('商品をコピーしました！');
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('コピーに失敗しました: ' + (error.response?.data?.error || error.message));
                }
            }
            
            async function deleteProduct(productId, productName) {
                if (!confirm('「' + productName + '」を削除してもよろしいですか？\\nこの操作は取り消せません。')) {
                    return;
                }
                
                try {
                    const response = await axios.delete('/api/products/' + productId);
                    alert('商品を削除しました！');
                    window.location.reload();
                } catch (error) {
                    console.error('Error:', error);
                    alert('削除に失敗しました: ' + (error.response?.data?.error || error.message));
                }
            }
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - オプション管理
// 管理画面 - オプション管理（API化版）
app.get('/admin/options', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>オプション管理 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-purple-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-list-ul"></i>
                    オプション管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><a href="/admin/options" class="text-purple-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-list-ul"></i>オプション管理
                    </a></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold text-gray-800">オプション一覧</h2>
                    <a href="/admin/options/new" class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition inline-block">
                        <i class="fas fa-plus mr-2"></i>新規オプション登録
                    </a>
                </div>

                <form method="GET" action="/admin/options" class="mb-6 p-4 bg-gray-50 rounded-lg">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">オプション名</label>
                            <input type="text" id="searchName" placeholder="オプション名で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">イベント名</label>
                            <input type="text" id="searchEventName" placeholder="イベント名で検索"
                                   class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">状態</label>
                            <select id="searchStatus" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                                <option value="">すべて</option>
                                <option value="1">販売中</option>
                                <option value="0">停止中</option>
                            </select>
                        </div>
                    </div>
                    <div class="flex gap-2 mt-4">
                        <button type="button" onclick="searchOptions()" class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </button>
                    </div>
                </div>

                <div id="loadingMessage" class="text-center py-8">
                    <i class="fas fa-spinner fa-spin text-4xl text-blue-600"></i>
                    <p class="mt-2 text-gray-600">読み込み中...</p>
                </div>

                <div id="optionsList" class="overflow-x-auto hidden">
                    <table class="w-full">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">ID</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">画像</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">オプション名</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">イベント</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">カテゴリー</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">価格</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">状態</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold text-gray-700">操作</th>
                            </tr>
                        </thead>
                        <tbody id="optionsTableBody">
                        </tbody>
                    </table>
                </div>

                <!-- ページネーション -->
                <div id="pagination" class="mt-6 flex items-center justify-between hidden">
                    <div class="text-sm text-gray-700">
                        <span id="paginationInfo">全 0 件中 0 - 0 件を表示</span>
                    </div>
                    <div class="flex gap-2">
                        <button id="prevPage" onclick="changePage(currentPage - 1)" 
                                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-left mr-1"></i>前へ
                        </button>
                        <button id="nextPage" onclick="changePage(currentPage + 1)" 
                                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-lg hover:bg-gray-400 disabled:opacity-50 disabled:cursor-not-allowed">
                            次へ<i class="fas fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <!-- 共有在庫設定モーダル（オプション管理画面用） -->
        <div id="sharedStockModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
            <div class="relative top-20 mx-auto p-5 border w-full max-w-4xl shadow-lg rounded-md bg-white">
                <div class="flex justify-between items-center mb-4">
                    <h3 id="modalTitle" class="text-lg font-semibold text-gray-900">
                        <i class="fas fa-warehouse text-teal-600 mr-2"></i>
                        共有在庫設定: <span id="targetName"></span>
                    </h3>
                    <button onclick="closeSharedStockModal()" class="text-gray-400 hover:text-gray-500">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <div class="mb-6">
                    <h4 class="font-semibold text-gray-700 mb-3">現在の共有在庫設定</h4>
                    <div id="currentSharedStocks" class="border rounded p-3 bg-gray-50 min-h-[100px]">
                        <p class="text-gray-500 text-sm">読み込み中...</p>
                    </div>
                </div>

                <div class="border-t pt-4">
                    <h4 class="font-semibold text-gray-700 mb-3">新しい共有在庫を追加</h4>
                    <form id="addSharedStockForm" class="space-y-4">
                        <div class="grid grid-cols-3 gap-4">
                            <div class="col-span-2">
                                <label class="block text-sm font-medium text-gray-700 mb-1">共有在庫プール <span class="text-red-500">*</span></label>
                                <select id="sharedStockPoolId" required class="w-full border border-gray-300 rounded px-3 py-2">
                                    <option value="">選択してください</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">消費数 <span class="text-red-500">*</span></label>
                                <input type="number" id="consumeQuantity" value="1" min="1" required class="w-full border border-gray-300 rounded px-3 py-2">
                                <p class="text-xs text-gray-500 mt-1">1予約あたりの在庫消費数</p>
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">表示名（オプション）</label>
                            <input type="text" id="stockName" placeholder="例: 駐車場" class="w-full border border-gray-300 rounded px-3 py-2">
                        </div>
                        <div class="flex justify-end">
                            <button type="submit" class="px-4 py-2 bg-teal-600 text-white rounded hover:bg-teal-700">
                                <i class="fas fa-plus mr-2"></i>追加
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            let currentPage = 1;
            const perPage = 20;
            let totalPages = 1;
            let searchParams = {};
            
            // ページ読み込み時にオプション一覧を取得
            document.addEventListener('DOMContentLoaded', async () => {
                // URLパラメータから検索条件を取得
                const params = new URLSearchParams(window.location.search);
                const name = params.get('name') || '';
                const eventName = params.get('event_name') || '';
                const status = params.get('status') || '';
                
                if (name) {
                    document.getElementById('searchName').value = name;
                    searchParams.name = name;
                }
                if (eventName) {
                    document.getElementById('searchEventName').value = eventName;
                    searchParams.event_name = eventName;
                }
                if (status) {
                    document.getElementById('searchStatus').value = status;
                    searchParams.status = status;
                }
                
                await loadOptions();
            });
            
            async function loadOptions() {
                const loadingMessage = document.getElementById('loadingMessage');
                const optionsList = document.getElementById('optionsList');
                const tableBody = document.getElementById('optionsTableBody');
                
                try {
                    loadingMessage.classList.remove('hidden');
                    optionsList.classList.add('hidden');
                    
                    // クエリパラメータを構築
                    let apiUrl = \`/api/options?page=\${currentPage}&per_page=\${perPage}\`;
                    if (searchParams.name) apiUrl += '&name=' + encodeURIComponent(searchParams.name);
                    if (searchParams.event_name) apiUrl += '&event_name=' + encodeURIComponent(searchParams.event_name);
                    if (searchParams.status !== undefined && searchParams.status !== '') {
                        apiUrl += '&status=' + encodeURIComponent(searchParams.status);
                    }
                    
                    console.log('Loading options:', apiUrl);
                    const response = await axios.get(apiUrl);
                    const options = response.data.options;
                    const pagination = response.data.pagination;
                    
                    console.log('Options loaded:', options.length);
                    console.log('Pagination:', pagination);
                    
                    // テーブルをレンダリング
                    if (options.length === 0) {
                        tableBody.innerHTML = '<tr><td colspan="8" class="px-4 py-8 text-center text-gray-500">オプションがありません</td></tr>';
                        document.getElementById('pagination').classList.add('hidden');
                    } else {
                        tableBody.innerHTML = options.map(option => {
                            const statusClass = option.enable_flg ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800';
                            const statusText = option.enable_flg ? '販売中' : '停止中';
                            const priceText = option.prices ? \`¥\${parseInt(option.prices).toLocaleString()}\` : '---';
                            
                            return \`
                                <tr class="hover:bg-gray-50">
                                    <td class="px-4 py-3 border-b">\${option.id}</td>
                                    <td class="px-4 py-3 border-b">
                                        <img src="\${option.image_url || '/static/images/no-image.svg'}" 
                                             alt="\${escapeHtml(option.name)}" 
                                             class="w-16 h-16 object-cover rounded border border-gray-200"
                                             onerror="this.src='/static/images/no-image.svg'">
                                    </td>
                                    <td class="px-4 py-3 border-b font-semibold">\${escapeHtml(option.name)}</td>
                                    <td class="px-4 py-3 border-b text-sm text-gray-600">\${escapeHtml(option.event_name || '-')}</td>
                                    <td class="px-4 py-3 border-b text-sm">
                                        <span class="px-2 py-1 bg-purple-100 text-purple-800 rounded">\${escapeHtml(option.category_name || '-')}</span>
                                    </td>
                                    <td class="px-4 py-3 border-b text-lg font-bold text-blue-600">
                                        \${priceText}
                                    </td>
                                    <td class="px-4 py-3 border-b">
                                        <span class="px-2 py-1 text-xs rounded \${statusClass}">
                                            \${statusText}
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 border-b">
                                        <div class="flex gap-2">
                                            <a href="/admin/options/\${option.id}/edit" class="text-blue-600 hover:text-blue-800">
                                                <i class="fas fa-edit"></i>編集
                                            </a>
                                            <a href="/admin/options/\${option.id}/stocks" class="text-green-600 hover:text-green-800">
                                                <i class="fas fa-box"></i>在庫管理
                                            </a>
                                            <a href="/admin/options/\${option.id}/shared-stocks" class="text-teal-600 hover:text-teal-800">
                                                <i class="fas fa-warehouse"></i>共有在庫
                                            </a>
                                            <button onclick="copyOption(\${option.id}, '\${escapeHtml(option.name).replace(/'/g, "\\\\'")}' )" class="text-purple-600 hover:text-purple-800">
                                                <i class="fas fa-copy"></i>コピー
                                            </button>
                                            <button onclick="deleteOption(\${option.id}, '\${escapeHtml(option.name).replace(/'/g, "\\\\'")}' )" class="text-red-600 hover:text-red-800">
                                                <i class="fas fa-trash"></i>削除
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            \`;
                        }).join('');
                        
                        // ページネーション情報を更新
                        if (pagination) {
                            totalPages = pagination.total_pages;
                            const start = (currentPage - 1) * perPage + 1;
                            const end = Math.min(currentPage * perPage, pagination.total);
                            document.getElementById('paginationInfo').textContent = 
                                \`全 \${pagination.total} 件中 \${start} - \${end} 件を表示\`;
                            
                            // ボタンの状態を更新
                            document.getElementById('prevPage').disabled = currentPage === 1;
                            document.getElementById('nextPage').disabled = currentPage === totalPages;
                            document.getElementById('pagination').classList.remove('hidden');
                        }
                    }
                    
                    loadingMessage.classList.add('hidden');
                    optionsList.classList.remove('hidden');
                } catch (error) {
                    console.error('Error loading options:', error);
                    loadingMessage.innerHTML = '<p class="text-red-600"><i class="fas fa-exclamation-circle mr-2"></i>データの読み込みに失敗しました</p>';
                }
            }
            
            async function searchOptions() {
                const name = document.getElementById('searchName').value;
                const eventName = document.getElementById('searchEventName').value;
                const status = document.getElementById('searchStatus').value;
                
                searchParams = {};
                if (name) searchParams.name = name;
                if (eventName) searchParams.event_name = eventName;
                if (status) searchParams.status = status;
                
                currentPage = 1;
                await loadOptions();
            }
            
            function resetSearch() {
                document.getElementById('searchName').value = '';
                document.getElementById('searchEventName').value = '';
                document.getElementById('searchStatus').value = '';
                searchParams = {};
                currentPage = 1;
                loadOptions();
            }
            
            // ページ変更
            function changePage(page) {
                if (page < 1 || page > totalPages) return;
                currentPage = page;
                loadOptions();
            }
            
            // HTML エスケープ
            function escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
            
            async function copyOption(optionId, optionName) {
                if (!confirm(\`「\${optionName}」をコピーしますか?\\nコピー後のオプション名は「コピー \${optionName}」となり、販売状態は停止中になります。\`)) {
                    return;
                }
                
                try {
                    await axios.post(\`/api/options/\${optionId}/copy\`);
                    alert('オプションをコピーしました！');
                    await loadOptions();
                } catch (error) {
                    console.error('Error:', error);
                    alert(\`コピーに失敗しました: \${error.response?.data?.error || error.message}\`);
                }
            }
            
            async function deleteOption(optionId, optionName) {
                if (!confirm(\`「\${optionName}」を削除してもよろしいですか?\\nこの操作は取り消せません。\`)) {
                    return;
                }
                
                try {
                    await axios.delete(\`/api/options/\${optionId}\`);
                    alert('オプションを削除しました！');
                    await loadOptions();
                } catch (error) {
                    console.error('Error:', error);
                    alert(\`削除に失敗しました: \${error.response?.data?.error || error.message}\`);
                }
            }
        </script>
    </body>
    </html>
  `)
})

// 管理画面 - 予約管理
app.get('/admin/bookings', async (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約管理 | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-indigo-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-calendar-check"></i>
                    予約管理
                </h1>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <ul class="flex gap-6 py-4">
                    <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-home"></i>トップページ
                    </a></li>
                    <li><a href="/admin" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                        <i class="fas fa-cog"></i>管理画面
                    </a></li>
                    <li><span class="text-indigo-600 font-semibold flex items-center gap-2">
                        <i class="fas fa-calendar-check"></i>予約管理
                    </span></li>
                </ul>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <!-- 検索フォーム -->
            <div class="bg-white rounded-lg shadow p-4 mb-6">
                <form id="searchForm" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">予約番号</label>
                        <input type="text" id="searchBookingNumber" placeholder="予約番号で検索" 
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">会員メール</label>
                        <input type="text" id="searchEmail" placeholder="メールアドレスで検索"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">イベント名</label>
                        <input type="text" id="searchEventName" placeholder="イベント名で検索"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">予約日（開始）</label>
                        <input type="date" id="searchDateFrom"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">予約日（終了）</label>
                        <input type="date" id="searchDateTo"
                               class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">予約ステータス</label>
                        <select id="searchBookingStatus" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                            <option value="">すべて</option>
                            <option value="reserved">予約済み</option>
                            <option value="confirmed">予約完了</option>
                            <option value="cancel_requested">キャンセル申込</option>
                            <option value="cancelled">キャンセル済み</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">決済ステータス</label>
                        <select id="searchPaymentStatus" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                            <option value="">すべて</option>
                            <option value="pending">未決済</option>
                            <option value="paid">決済完了</option>
                            <option value="refund_pending">返金待ち</option>
                            <option value="refunded">返金済み</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">担当支店</label>
                        <select id="searchBranchCode" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500">
                            <option value="">すべて</option>
                            <option value="01">東京中央支店</option>
                            <option value="02">東京南支店</option>
                            <option value="03">東京北支店</option>
                            <option value="04">東京西支店</option>
                            <option value="05">東京東支店</option>
                            <option value="06">横浜支店</option>
                            <option value="07">川崎支店</option>
                            <option value="08">千葉支店</option>
                            <option value="09">埼玉支店</option>
                            <option value="10">名古屋支店</option>
                            <option value="11">京都支店</option>
                            <option value="12">札幌支店</option>
                            <option value="13">仙台支店</option>
                            <option value="14">大阪支店</option>
                            <option value="15">大阪西支店</option>
                            <option value="16">福岡支店</option>
                            <option value="17">広島支店</option>
                            <option value="18">神戸支店</option>
                        </select>
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700">
                            <i class="fas fa-search mr-2"></i>検索
                        </button>
                        <button type="button" onclick="resetSearch()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400">
                            <i class="fas fa-redo mr-2"></i>リセット
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-white rounded-lg shadow">
                <div class="p-6 border-b flex justify-between items-center">
                    <h2 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-list mr-2 text-indigo-600"></i>
                        予約一覧
                    </h2>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">予約番号</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">会員名</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">担当支店</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">イベント</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">商品</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">参加日</th>
                                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">数量</th>
                                <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">金額</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">予約ステータス</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">決済ステータス</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">予約日</th>
                                <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">操作</th>
                            </tr>
                        </thead>
                        <tbody id="bookings-tbody" class="bg-white divide-y divide-gray-200">
                            <tr>
                                <td colspan="12" class="px-4 py-8 text-center text-gray-500">
                                    <i class="fas fa-spinner fa-spin mr-2"></i>読み込み中...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- ページネーション -->
                <div id="pagination" class="px-6 py-4 border-t bg-gray-50 flex justify-between items-center">
                    <div id="pagination-info" class="text-sm text-gray-700"></div>
                    <div class="flex gap-2">
                        <button id="prev-page" onclick="changePage(currentPage - 1)" 
                                class="px-4 py-2 border rounded-lg hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                            <i class="fas fa-chevron-left mr-1"></i>前へ
                        </button>
                        <button id="next-page" onclick="changePage(currentPage + 1)"
                                class="px-4 py-2 border rounded-lg hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed">
                            次へ<i class="fas fa-chevron-right ml-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <script>
            let currentPage = 1;
            let perPage = 20;
            let totalPages = 1;
            let searchParams = {};

            async function loadBookings() {
                try {
                    console.log('予約データをAPIから取得中...');
                    const params = new URLSearchParams({
                        page: currentPage,
                        per_page: perPage,
                        ...searchParams
                    });
                    
                    const response = await fetch(\`/api/bookings?\${params}\`);
                    if (!response.ok) {
                        throw new Error(\`HTTP error! status: \${response.status}\`);
                    }
                    
                    const result = await response.json();
                    console.log('取得した予約データ:', result);
                    
                    const tbody = document.getElementById('bookings-tbody');
                    
                    if (!result.data || result.data.length === 0) {
                        tbody.innerHTML = \`
                            <tr>
                                <td colspan="12" class="px-4 py-8 text-center text-gray-500">
                                    <i class="fas fa-info-circle mr-2"></i>データがありません
                                </td>
                            </tr>
                        \`;
                        document.getElementById('pagination').classList.add('hidden');
                        return;
                    }
                    
                    tbody.innerHTML = result.data.map(booking => {
                        // 予約ステータスのラベル
                        let bookingStatusLabel = '予約済み';
                        let bookingStatusClass = 'bg-green-100 text-green-800';
                        if (booking.booking_status === 'confirmed') {
                            bookingStatusLabel = '予約完了';
                            bookingStatusClass = 'bg-blue-100 text-blue-800';
                        } else if (booking.booking_status === 'cancel_requested') {
                            bookingStatusLabel = 'キャンセル申込';
                            bookingStatusClass = 'bg-orange-100 text-orange-800';
                        } else if (booking.booking_status === 'cancelled') {
                            bookingStatusLabel = 'キャンセル済み';
                            bookingStatusClass = 'bg-red-100 text-red-800';
                        }
                        
                        // 決済ステータスのラベル
                        let paymentStatusLabel = '未決済';
                        let paymentStatusClass = 'bg-yellow-100 text-yellow-800';
                        if (booking.payment_status === 'paid') {
                            paymentStatusLabel = '決済完了';
                            paymentStatusClass = 'bg-blue-100 text-blue-800';
                        } else if (booking.payment_status === 'refund_pending') {
                            paymentStatusLabel = '返金待ち';
                            paymentStatusClass = 'bg-orange-100 text-orange-800';
                        } else if (booking.payment_status === 'refunded') {
                            paymentStatusLabel = '返金済み';
                            paymentStatusClass = 'bg-purple-100 text-purple-800';
                        }
                        
                        // 支店名マッピング
                        const branchNames = {
                            '01': '東京中央支店',
                            '02': '東京南支店',
                            '03': '東京北支店',
                            '04': '東京西支店',
                            '05': '東京東支店',
                            '06': '横浜支店',
                            '07': '川崎支店',
                            '08': '千葉支店',
                            '09': '埼玉支店',
                            '10': '名古屋支店',
                            '11': '京都支店',
                            '12': '札幌支店',
                            '13': '仙台支店',
                            '14': '大阪支店',
                            '15': '大阪西支店',
                            '16': '福岡支店',
                            '17': '広島支店',
                            '18': '神戸支店'
                        };
                        const branchName = booking.branch_code ? (branchNames[booking.branch_code] || booking.branch_code) : '-';
                        
                        // 参加日のフォーマット
                        const participationDate = booking.participation_date 
                            ? new Date(booking.participation_date).toLocaleDateString('ja-JP')
                            : '-';
                        
                        return \`
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 border-b font-mono text-sm">\${booking.booking_number || '-'}</td>
                            <td class="px-4 py-3 border-b">\${booking.family_name || ''} \${booking.first_name || ''}</td>
                            <td class="px-4 py-3 border-b text-sm">\${branchName}</td>
                            <td class="px-4 py-3 border-b text-sm">\${booking.event_name || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${booking.product_name || '-'}</td>
                            <td class="px-4 py-3 border-b text-sm">\${participationDate}</td>
                            <td class="px-4 py-3 border-b text-right">\${booking.quantity || 0}</td>
                            <td class="px-4 py-3 border-b text-right font-semibold">¥\${(booking.price || 0).toLocaleString()}</td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 rounded-full text-xs font-semibold \${bookingStatusClass}">\${bookingStatusLabel}</span>
                            </td>
                            <td class="px-4 py-3 border-b">
                                <span class="px-2 py-1 rounded-full text-xs font-semibold \${paymentStatusClass}">\${paymentStatusLabel}</span>
                            </td>
                            <td class="px-4 py-3 border-b text-sm">\${booking.created_at ? new Date(booking.created_at).toLocaleDateString('ja-JP') : '-'}</td>
                            <td class="px-4 py-3 border-b">
                                <a href="/admin/bookings/\${booking.id}" class="text-blue-600 hover:text-blue-800">
                                    <i class="fas fa-eye"></i>詳細
                                </a>
                            </td>
                        </tr>
                    \`;
                    }).join('');
                    
                    // ページネーション更新
                    totalPages = result.pagination.total_pages;
                    document.getElementById('pagination-info').textContent = 
                        \`全 \${result.pagination.total} 件中 \${(currentPage - 1) * perPage + 1} - \${Math.min(currentPage * perPage, result.pagination.total)} 件を表示\`;
                    document.getElementById('prev-page').disabled = currentPage === 1;
                    document.getElementById('next-page').disabled = currentPage >= totalPages;
                    document.getElementById('pagination').classList.remove('hidden');
                    
                } catch (error) {
                    console.error('予約一覧の取得に失敗:', error);
                    document.getElementById('bookings-tbody').innerHTML = \`
                        <tr>
                            <td colspan="12" class="px-4 py-8 text-center text-red-500">
                                <i class="fas fa-exclamation-triangle mr-2"></i>
                                データの取得に失敗しました: \${error.message}
                            </td>
                        </tr>
                    \`;
                }
            }

            function changePage(page) {
                if (page < 1 || page > totalPages) return;
                currentPage = page;
                loadBookings();
            }

            // 検索フォーム送信
            document.getElementById('searchForm').addEventListener('submit', (e) => {
                e.preventDefault();
                currentPage = 1;
                searchParams = {
                    booking_number: document.getElementById('searchBookingNumber').value,
                    email: document.getElementById('searchEmail').value,
                    event_name: document.getElementById('searchEventName').value,
                    date_from: document.getElementById('searchDateFrom').value,
                    date_to: document.getElementById('searchDateTo').value,
                    booking_status: document.getElementById('searchBookingStatus').value,
                    payment_status: document.getElementById('searchPaymentStatus').value,
                    branch_code: document.getElementById('searchBranchCode').value
                };
                loadBookings();
            });

            // 検索リセット
            function resetSearch() {
                document.getElementById('searchBookingNumber').value = '';
                document.getElementById('searchEmail').value = '';
                document.getElementById('searchEventName').value = '';
                document.getElementById('searchDateFrom').value = '';
                document.getElementById('searchDateTo').value = '';
                document.getElementById('searchBookingStatus').value = '';
                document.getElementById('searchPaymentStatus').value = '';
                document.getElementById('searchBranchCode').value = '';
                currentPage = 1;
                searchParams = {};
                loadBookings();
            }

            // 初期読み込み
            document.addEventListener('DOMContentLoaded', () => {
                loadBookings();
            });
        </script>
    </body>
    </html>
  `)
})

// 予約詳細画面（編集モーダル付き）
app.get('/admin/bookings/:id', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('id')

  // 予約情報と関連データを取得
  const booking = await DB.prepare(`
    SELECT 
      pb.*,
      c.id as customer_id,
      c.family_name,
      c.first_name,
      c.email,
      c.tel,
      c.zip,
      c.pref_id,
      c.city,
      c.addr,
      c.bldg,
      pref.name as pref_name,
      p.id as product_id,
      p.name as product_name,
      p.description as product_description,
      e.id as event_id,
      e.name as event_name,
      cl.name as client_name,
      cl.client_code,
      org.name as organizer_name,
      org.email as organizer_email,
      org.tel as organizer_tel,
      v.name as vendor_name,
      v.email as vendor_email,
      v.tel as vendor_tel
    FROM product_bookings pb
    LEFT JOIN customers c ON pb.customer_id = c.id
    LEFT JOIN prefs pref ON c.pref_id = pref.id
    LEFT JOIN products p ON pb.product_id = p.id
    LEFT JOIN events e ON p.event_id = e.id
    LEFT JOIN clients cl ON e.customer_client_id = cl.id
    LEFT JOIN organizers org ON pb.organizer_id = org.id
    LEFT JOIN vendors v ON pb.vendor_id = v.id
    WHERE pb.id = ?
  `).bind(bookingId).first()

  if (!booking) {
    return c.html('<h1>予約が見つかりません</h1>', 404)
  }

  // 予約番号生成（必要な場合）
  if (!booking.booking_number && booking.event_id && booking.client_code) {
    const sequence = String(booking.id).padStart(6, '0')
    const bookingNumber = `${booking.event_id}-${booking.client_code}-${sequence}`
    
    await DB.prepare(`
      UPDATE product_bookings SET booking_number = ? WHERE id = ?
    `).bind(bookingNumber, booking.id).run()
    
    booking.booking_number = bookingNumber
  }

  // 予約ステータスのラベル
  let bookingStatusLabel = '予約済み'
  let bookingStatusClass = 'bg-green-100 text-green-800'
  if (booking.booking_status === 'confirmed') {
    bookingStatusLabel = '予約完了'
    bookingStatusClass = 'bg-blue-100 text-blue-800'
  } else if (booking.booking_status === 'cancel_requested') {
    bookingStatusLabel = 'キャンセル申込'
    bookingStatusClass = 'bg-orange-100 text-orange-800'
  } else if (booking.booking_status === 'cancelled') {
    bookingStatusLabel = 'キャンセル済み'
    bookingStatusClass = 'bg-red-100 text-red-800'
  }

  // 決済ステータスのラベル
  let paymentStatusLabel = '未決済'
  let paymentStatusClass = 'bg-yellow-100 text-yellow-800'
  if (booking.payment_status === 'paid') {
    paymentStatusLabel = '決済完了'
    paymentStatusClass = 'bg-blue-100 text-blue-800'
  } else if (booking.payment_status === 'refund_pending') {
    paymentStatusLabel = '返金待ち'
    paymentStatusClass = 'bg-orange-100 text-orange-800'
  } else if (booking.payment_status === 'refunded') {
    paymentStatusLabel = '返金済み'
    paymentStatusClass = 'bg-purple-100 text-purple-800'
  }

  // 商品合計金額
  const productTotal = booking.price * booking.quantity

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約詳細 ${booking.booking_number || bookingId} | イベント予約管理システム</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <nav class="bg-gradient-to-r from-blue-600 to-blue-800 text-white shadow-lg">
            <div class="container mx-auto px-4 py-3">
                <div class="flex items-center justify-between">
                    <h1 class="text-2xl font-bold">
                        <i class="fas fa-calendar-alt mr-2"></i>
                        イベント予約管理システム
                    </h1>
                    <div class="flex gap-4">
                        <a href="/" class="hover:text-blue-200 transition"><i class="fas fa-home mr-1"></i>トップ</a>
                        <a href="/admin" class="hover:text-blue-200 transition"><i class="fas fa-cog mr-1"></i>管理画面</a>
                        <a href="/admin/bookings" class="hover:text-blue-200 transition"><i class="fas fa-clipboard-list mr-1"></i>予約管理</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-6xl mx-auto">
                <!-- ヘッダー -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex justify-between items-start">
                        <div>
                            <h2 class="text-3xl font-bold text-gray-800 mb-2">
                                <i class="fas fa-file-invoice mr-2 text-orange-600"></i>予約詳細
                            </h2>
                            <div class="flex gap-4 items-center mt-3">
                                <div class="text-lg">
                                    <span class="text-gray-600">予約番号:</span>
                                    <span class="font-mono font-bold text-blue-700 ml-2">${booking.booking_number || '-'}</span>
                                </div>
                                <span class="px-3 py-1 rounded-full text-sm font-semibold ${bookingStatusClass}">
                                    ${bookingStatusLabel}
                                </span>
                                <span class="px-3 py-1 rounded-full text-sm font-semibold ${paymentStatusClass}">
                                    ${paymentStatusLabel}
                                </span>
                            </div>
                        </div>
                        <div class="flex gap-2">
                            <button onclick="openEditModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-edit mr-2"></i>編集
                            </button>
                            <a href="/admin/bookings" class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg font-semibold">
                                <i class="fas fa-arrow-left mr-2"></i>一覧に戻る
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 1カラムレイアウト -->
                <div class="space-y-6">
                    <!-- イベント・予約情報 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-calendar-check mr-2 text-blue-600"></i>イベント・予約情報
                            </h3>
                            <div class="space-y-3">
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">クライアント企業名</label>
                                        <p class="text-gray-900 font-semibold">${booking.client_name || '-'}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">イベント名</label>
                                        <p class="text-gray-900 font-semibold">${booking.event_name || '-'}</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">
                                            <i class="fas fa-building mr-1 text-purple-600"></i>主催者
                                        </label>
                                        <p class="text-gray-900 font-semibold">${booking.organizer_name || '-'}</p>
                                        ${booking.organizer_email ? `<p class="text-xs text-gray-600 mt-1"><i class="fas fa-envelope mr-1"></i>${booking.organizer_email}</p>` : ''}
                                        ${booking.organizer_tel ? `<p class="text-xs text-gray-600"><i class="fas fa-phone mr-1"></i>${booking.organizer_tel}</p>` : ''}
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">
                                            <i class="fas fa-store mr-1 text-green-600"></i>販売者
                                        </label>
                                        <p class="text-gray-900 font-semibold">${booking.vendor_name || '-'}</p>
                                        ${booking.vendor_email ? `<p class="text-xs text-gray-600 mt-1"><i class="fas fa-envelope mr-1"></i>${booking.vendor_email}</p>` : ''}
                                        ${booking.vendor_tel ? `<p class="text-xs text-gray-600"><i class="fas fa-phone mr-1"></i>${booking.vendor_tel}</p>` : ''}
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">
                                            <i class="fas fa-calendar-day mr-1 text-red-600"></i>参加日
                                        </label>
                                        <p class="text-gray-900 font-bold text-lg">${booking.participation_date ? new Date(booking.participation_date).toLocaleDateString('ja-JP', {year: 'numeric', month: 'long', day: 'numeric'}) : '-'}</p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">予約日時</label>
                                        <p class="text-gray-900">${new Date(booking.created_at).toLocaleString('ja-JP')}</p>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-600 mb-1">数量</label>
                                        <p class="text-gray-900 text-xl font-bold text-blue-600">${booking.quantity}名</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 会員情報 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-user mr-2 text-green-600"></i>会員情報
                            </h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-1">会員名</label>
                                    <p class="text-gray-900 font-semibold">${booking.family_name || ''} ${booking.first_name || ''}</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-1">メールアドレス</label>
                                    <p class="text-gray-900">${booking.email || '-'}</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-1">電話番号</label>
                                    <p class="text-gray-900">${booking.tel || '-'}</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-1">住所</label>
                                    <p class="text-gray-900 text-sm">
                                        〒${booking.zip || ''}<br>
                                        ${booking.pref_name || ''} ${booking.city || ''}<br>
                                        ${booking.addr || ''}<br>
                                        ${booking.bldg || ''}
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- 参加者情報 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-user mr-2 text-orange-600"></i>参加者情報
                            </h3>
                            ${booking.participants ? (() => {
                                const participants = JSON.parse(booking.participants);
                                const p = participants[0]; // 最初の参加者のみ取得
                                if (!p) return '<p class="text-gray-500">参加者情報が登録されていません</p>';
                                return `
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <label class="block text-sm font-medium text-gray-600 mb-1">氏名</label>
                                            <p class="text-gray-900 font-semibold text-lg">${p.name}</p>
                                            <p class="text-gray-600 text-sm">${p.kana || ''}</p>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-600 mb-1">年齢・性別</label>
                                            <p class="text-gray-900 font-semibold">${p.age || '-'}歳 / ${p.gender === 'male' ? '男性' : p.gender === 'female' ? '女性' : 'その他'}</p>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-600 mb-1">メールアドレス</label>
                                            <p class="text-gray-900">${p.email || '-'}</p>
                                        </div>
                                        <div>
                                            <label class="block text-sm font-medium text-gray-600 mb-1">電話番号</label>
                                            <p class="text-gray-900">${p.tel || '-'}</p>
                                        </div>
                                    </div>
                                `;
                            })() : '<p class="text-gray-500">参加者情報が登録されていません</p>'}
                        </div>

                        <!-- 商品・料金内訳 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-shopping-cart mr-2 text-green-600"></i>商品・料金内訳
                            </h3>
                            
                            <!-- 商品 -->
                            <div class="mb-4">
                                <div class="flex justify-between items-center py-3 border-b">
                                    <div>
                                        <p class="font-semibold text-gray-800">${booking.product_name || '-'}</p>
                                        <p class="text-sm text-gray-600">${booking.product_description || ''}</p>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm text-gray-600">¥${(booking.price || 0).toLocaleString()} × ${booking.quantity}</p>
                                        <p class="text-lg font-bold text-gray-900">¥${productTotal.toLocaleString()}</p>
                                    </div>
                                </div>
                            </div>

                            <!-- 合計 -->
                            <div class="flex justify-between items-center pt-4 border-t-2">
                                <p class="text-xl font-bold text-gray-800">合計金額</p>
                                <p class="text-2xl font-bold text-blue-600">¥${productTotal.toLocaleString()}</p>
                            </div>
                        </div>

                        <!-- ファイル・添付資料 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-file-alt mr-2 text-purple-600"></i>ファイル・添付資料
                            </h3>
                            <div class="space-y-4">
                                <!-- QRコード -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        <i class="fas fa-qrcode mr-1"></i>QRコード
                                    </label>
                                    ${booking.qr_code_url ? `
                                        <div class="border border-gray-300 rounded-lg p-3 bg-gray-50">
                                            <img src="${booking.qr_code_url}" alt="QRコード" class="max-w-xs mx-auto">
                                        </div>
                                    ` : '<p class="text-gray-500 text-sm">未登録</p>'}
                                </div>
                                
                                <!-- PDF -->
                                <div>
                                    <label class="block text-sm font-medium text-gray-600 mb-2">
                                        <i class="fas fa-file-pdf mr-1"></i>予約関連PDF
                                    </label>
                                    ${booking.pdf_file_url ? `
                                        <a href="${booking.pdf_file_url}" target="_blank" 
                                           class="inline-flex items-center px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg">
                                            <i class="fas fa-download mr-2"></i>PDFを表示
                                        </a>
                                    ` : '<p class="text-gray-500 text-sm">未登録</p>'}
                                </div>
                            </div>
                        </div>

                        <!-- 決済情報 -->
                        <div class="bg-white rounded-lg shadow-md p-6">
                            <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                <i class="fas fa-credit-card mr-2 text-indigo-600"></i>決済情報
                            </h3>
                            <div class="space-y-4">
                                <!-- クレジットカード決済 -->
                                ${booking.payment_method === 'credit_card' ? `
                                    <div class="p-4 bg-indigo-50 border border-indigo-200 rounded-lg">
                                        <div class="flex items-center gap-2 mb-3">
                                            <i class="fas fa-credit-card text-indigo-600 text-xl"></i>
                                            <span class="font-bold text-indigo-900">クレジットカード決済</span>
                                        </div>
                                        <div class="grid grid-cols-2 gap-3 text-sm">
                                            <div>
                                                <label class="block text-xs font-medium text-gray-700 mb-1">決済日時</label>
                                                <p class="text-gray-900 font-semibold">${booking.payment_date ? new Date(booking.payment_date).toLocaleString('ja-JP') : '-'}</p>
                                            </div>
                                            <div>
                                                <label class="block text-xs font-medium text-gray-700 mb-1">決済番号</label>
                                                <p class="text-gray-900 font-mono text-xs">${booking.payment_transaction_id || '-'}</p>
                                            </div>
                                        </div>
                                    </div>
                                ` : ''}

                                <!-- 銀行振込 -->
                                ${booking.payment_method === 'bank_transfer' && booking.bank_transfer_info ? (() => {
                                    const info = JSON.parse(booking.bank_transfer_info);
                                    return `
                                        <div class="p-4 bg-green-50 border border-green-200 rounded-lg">
                                            <div class="flex items-center gap-2 mb-3">
                                                <i class="fas fa-university text-green-600 text-xl"></i>
                                                <span class="font-bold text-green-900">銀行振込</span>
                                            </div>
                                            <div class="space-y-2 text-sm">
                                                <div class="grid grid-cols-2 gap-3">
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">金融機関</label>
                                                        <p class="text-gray-900 font-semibold">${info.bank_name || '-'}</p>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">支店名</label>
                                                        <p class="text-gray-900">${info.branch_name || '-'}</p>
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-3 gap-3">
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">口座種別</label>
                                                        <p class="text-gray-900">${info.account_type || '-'}</p>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">口座番号</label>
                                                        <p class="text-gray-900 font-mono">${info.account_number || '-'}</p>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">口座名義</label>
                                                        <p class="text-gray-900 text-xs">${info.account_holder || '-'}</p>
                                                    </div>
                                                </div>
                                                <div class="grid grid-cols-2 gap-3 mt-3 pt-3 border-t">
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">入金日</label>
                                                        <p class="text-gray-900 font-semibold">${booking.payment_date ? new Date(booking.payment_date).toLocaleDateString('ja-JP') : '未入金'}</p>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">振込期限</label>
                                                        <p class="text-red-600 font-semibold">${info.transfer_deadline || '-'}</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                })() : ''}

                                <!-- コンビニ決済 -->
                                ${booking.payment_method === 'convenience_store' && booking.convenience_store_info ? (() => {
                                    const info = JSON.parse(booking.convenience_store_info);
                                    return `
                                        <div class="p-4 bg-yellow-50 border border-yellow-200 rounded-lg">
                                            <div class="flex items-center gap-2 mb-3">
                                                <i class="fas fa-store text-yellow-600 text-xl"></i>
                                                <span class="font-bold text-yellow-900">コンビニ決済</span>
                                            </div>
                                            <div class="space-y-2 text-sm">
                                                <div class="grid grid-cols-2 gap-3">
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">利用コンビニ</label>
                                                        <p class="text-gray-900 font-semibold text-lg">${info.store_name || '-'}</p>
                                                    </div>
                                                    <div>
                                                        <label class="block text-xs font-medium text-gray-700 mb-1">入金日</label>
                                                        <p class="text-gray-900 font-semibold">${booking.payment_date ? new Date(booking.payment_date).toLocaleDateString('ja-JP') : '未入金'}</p>
                                                    </div>
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-medium text-gray-700 mb-1">支払い番号</label>
                                                    <p class="text-gray-900 font-mono text-lg bg-white p-2 rounded border">${info.payment_code || '-'}</p>
                                                </div>
                                                <div>
                                                    <label class="block text-xs font-medium text-gray-700 mb-1">支払い期限</label>
                                                    <p class="text-red-600 font-semibold">${info.payment_deadline || '-'}</p>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                })() : ''}

                                ${!booking.payment_method ? '<p class="text-gray-500">決済情報が登録されていません</p>' : ''}
                            </div>
                        </div>

                        <!-- 設問回答 -->
                        ${booking.survey_answers ? `
                            <div class="bg-white rounded-lg shadow-md p-6">
                                <h3 class="text-xl font-bold text-gray-800 mb-4 border-b pb-2">
                                    <i class="fas fa-question-circle mr-2 text-purple-600"></i>設問回答
                                </h3>
                                <div class="space-y-4">
                                    ${(() => {
                                        const answers = JSON.parse(booking.survey_answers);
                                        return answers.map((qa, index) => `
                                            <div class="p-4 bg-purple-50 border border-purple-200 rounded-lg">
                                                <div class="mb-2">
                                                    <span class="inline-block px-2 py-1 bg-purple-600 text-white text-xs font-semibold rounded mr-2">Q${index + 1}</span>
                                                    <span class="text-gray-800 font-semibold">${qa.question}</span>
                                                </div>
                                                <div class="pl-8">
                                                    <span class="inline-block px-2 py-1 bg-white text-purple-900 text-xs font-semibold rounded mr-2">A</span>
                                                    <span class="text-gray-900">${qa.answer}</span>
                                                </div>
                                            </div>
                                        `).join('');
                                    })()}
                                </div>
                            </div>
                        ` : ''}
                    </div>
            </div>
        </main>

        <!-- 編集モーダル -->
        <div id="editModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                <div class="sticky top-0 bg-white border-b px-6 py-4 flex justify-between items-center">
                    <h2 class="text-2xl font-bold text-gray-800">
                        <i class="fas fa-edit mr-2 text-blue-600"></i>予約編集
                    </h2>
                    <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-600">
                        <i class="fas fa-times text-2xl"></i>
                    </button>
                </div>

                <form id="editForm" class="p-6">
                    <!-- 価格・料金内訳 -->
                    <div class="mb-6">
                        <div class="flex justify-between items-center mb-3">
                            <h3 class="text-lg font-bold text-gray-800">
                                <i class="fas fa-yen-sign mr-2 text-green-600"></i>商品・料金内訳
                            </h3>
                            <button type="button" onclick="addPriceItem()" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm font-semibold">
                                <i class="fas fa-plus mr-2"></i>項目追加
                            </button>
                        </div>
                        
                        <div id="priceItemsContainer" class="space-y-3">
                            <!-- メイン商品 -->
                            <div class="price-item border-2 border-blue-300 rounded-lg p-4 bg-blue-50" data-item-id="main">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="px-2 py-1 bg-blue-600 text-white text-xs font-semibold rounded">メイン商品</span>
                                </div>
                                <div class="grid grid-cols-4 gap-3">
                                    <div class="col-span-2">
                                        <label class="block text-xs font-semibold text-gray-700 mb-1">商品名</label>
                                        <input type="text" class="item-name w-full px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-100" 
                                            value="${booking.product_name || ''}" readonly>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-700 mb-1">単価</label>
                                        <input type="number" class="item-price w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                            value="${booking.price}" min="0" onchange="updateTotal()">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-semibold text-gray-700 mb-1">数量</label>
                                        <input type="number" class="item-quantity w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                            value="${booking.quantity}" min="1" onchange="updateTotal()">
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mt-4 flex justify-end items-center gap-4 p-4 bg-gray-50 rounded-lg">
                            <span class="text-lg font-bold text-gray-700">合計金額:</span>
                            <span id="calculatedTotal" class="text-2xl font-bold text-blue-600">¥${productTotal.toLocaleString()}</span>
                        </div>
                    </div>

                    <!-- ステータス -->
                    <div class="mb-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-3">
                            <i class="fas fa-tasks mr-2 text-red-600"></i>ステータス
                        </h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">予約ステータス</label>
                                <select id="bookingStatus" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="reserved" ${booking.booking_status === 'reserved' ? 'selected' : ''}>予約済み</option>
                                    <option value="confirmed" ${booking.booking_status === 'confirmed' ? 'selected' : ''}>予約完了</option>
                                    <option value="cancel_requested" ${booking.booking_status === 'cancel_requested' ? 'selected' : ''}>キャンセル申込</option>
                                    <option value="cancelled" ${booking.booking_status === 'cancelled' ? 'selected' : ''}>キャンセル済み</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">決済ステータス</label>
                                <select id="paymentStatus" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <option value="pending" ${booking.payment_status === 'pending' ? 'selected' : ''}>未決済</option>
                                    <option value="paid" ${booking.payment_status === 'paid' ? 'selected' : ''}>決済完了</option>
                                    <option value="refund_pending" ${booking.payment_status === 'refund_pending' ? 'selected' : ''}>返金待ち</option>
                                    <option value="refunded" ${booking.payment_status === 'refunded' ? 'selected' : ''}>返金済み</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- ファイルアップロード -->
                    <div class="mb-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-3">
                            <i class="fas fa-file-upload mr-2 text-purple-600"></i>ファイル
                        </h3>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-qrcode mr-1"></i>QRコード画像
                                </label>
                                <input type="file" id="qrCodeFile" accept="image/*" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                <p class="text-xs text-gray-500 mt-1">PNG, JPG形式（最大5MB）</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    <i class="fas fa-file-pdf mr-1"></i>予約関連PDF
                                </label>
                                <input type="file" id="pdfFile" accept=".pdf" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
                                <p class="text-xs text-gray-500 mt-1">PDF形式（最大10MB）</p>
                            </div>
                        </div>
                    </div>

                    <!-- ボタン -->
                    <div class="flex gap-4 pt-4 border-t">
                        <button type="submit" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold">
                            <i class="fas fa-save mr-2"></i>更新する
                        </button>
                        <button type="button" onclick="closeEditModal()" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-3 rounded-lg font-semibold">
                            <i class="fas fa-times mr-2"></i>キャンセル
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const bookingId = ${bookingId};
            let itemCounter = 0;
            
            // 既存の価格項目を取得（JSON形式で保存されている場合）
            const existingPriceItems = ${booking.price_items ? JSON.stringify(JSON.parse(booking.price_items)) : JSON.stringify([{name: booking.product_name || '商品', price: booking.price || 0, quantity: booking.quantity || 1, isMain: true}])};
            
            // ページ読み込み時に既存の価格項目を表示
            window.addEventListener('DOMContentLoaded', () => {
                const container = document.getElementById('priceItemsContainer');
                container.innerHTML = '';
                
                existingPriceItems.forEach((item, index) => {
                    itemCounter++;
                    const newItem = document.createElement('div');
                    newItem.className = 'price-item border border-gray-200 rounded-lg p-4 bg-gray-50';
                    newItem.dataset.itemId = 'item-' + itemCounter;
                    newItem.innerHTML = \`
                        <div class="flex items-center gap-2 mb-2">
                            <span class="px-2 py-1 \${item.isMain ? 'bg-blue-600' : 'bg-purple-600'} text-white text-xs font-semibold rounded">
                                \${item.isMain ? 'メイン商品' : 'オプション'}
                            </span>
                            \${!item.isMain ? \`
                                <button type="button" onclick="removePriceItem(this)" class="ml-auto text-red-600 hover:text-red-800 text-sm">
                                    <i class="fas fa-trash mr-1"></i>削除
                                </button>
                            \` : ''}
                        </div>
                        <div class="grid grid-cols-4 gap-3">
                            <div class="col-span-2">
                                <label class="block text-xs font-semibold text-gray-700 mb-1">項目名</label>
                                <input type="text" class="item-name w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                    value="\${item.name}" placeholder="項目名を入力" \${item.isMain ? 'readonly' : ''}>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">単価</label>
                                <input type="number" class="item-price w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                    value="\${item.price}" min="0" onchange="updateTotal()">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1">数量</label>
                                <input type="number" class="item-quantity w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                    value="\${item.quantity}" min="1" onchange="updateTotal()">
                            </div>
                        </div>
                    \`;
                    container.appendChild(newItem);
                });
                
                updateTotal();
            });

            function openEditModal() {
                document.getElementById('editModal').classList.remove('hidden');
                document.getElementById('editModal').classList.add('flex');
                updateTotal();
            }

            function closeEditModal() {
                document.getElementById('editModal').classList.add('hidden');
                document.getElementById('editModal').classList.remove('flex');
            }

            // 項目追加
            function addPriceItem() {
                itemCounter++;
                const container = document.getElementById('priceItemsContainer');
                const newItem = document.createElement('div');
                newItem.className = 'price-item border border-gray-200 rounded-lg p-4 bg-gray-50';
                newItem.dataset.itemId = 'new-' + itemCounter;
                newItem.innerHTML = \`
                    <div class="flex items-center gap-2 mb-2">
                        <span class="px-2 py-1 bg-purple-600 text-white text-xs font-semibold rounded">オプション</span>
                        <button type="button" onclick="removePriceItem(this)" class="ml-auto text-red-600 hover:text-red-800 text-sm">
                            <i class="fas fa-trash mr-1"></i>削除
                        </button>
                    </div>
                    <div class="grid grid-cols-4 gap-3">
                        <div class="col-span-2">
                            <label class="block text-xs font-semibold text-gray-700 mb-1">項目名</label>
                            <input type="text" class="item-name w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                value="" placeholder="項目名を入力">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">単価</label>
                            <input type="number" class="item-price w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                value="0" min="0" onchange="updateTotal()">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1">数量</label>
                            <input type="number" class="item-quantity w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" 
                                value="1" min="1" onchange="updateTotal()">
                        </div>
                    </div>
                \`;
                container.appendChild(newItem);
                updateTotal();
            }

            // 項目削除
            function removePriceItem(button) {
                if (!confirm('この項目を削除しますか？')) return;
                const item = button.closest('.price-item');
                item.remove();
                updateTotal();
            }

            // 合計更新
            function updateTotal() {
                let total = 0;
                document.querySelectorAll('.price-item').forEach(item => {
                    const price = parseInt(item.querySelector('.item-price').value) || 0;
                    const quantity = parseInt(item.querySelector('.item-quantity').value) || 0;
                    total += price * quantity;
                });
                document.getElementById('calculatedTotal').textContent = '¥' + total.toLocaleString();
            }

            // フォーム送信
            document.getElementById('editForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                if (!confirm('予約情報を更新しますか？')) {
                    return;
                }

                // 商品・料金内訳を配列化
                const priceItems = [];
                document.querySelectorAll('.price-item').forEach((item, index) => {
                    const name = item.querySelector('.item-name').value;
                    const price = parseInt(item.querySelector('.item-price').value) || 0;
                    const quantity = parseInt(item.querySelector('.item-quantity').value) || 0;
                    priceItems.push({
                        name,
                        price,
                        quantity,
                        isMain: index === 0
                    });
                });

                const requestData = {
                    booking_status: document.getElementById('bookingStatus').value,
                    payment_status: document.getElementById('paymentStatus').value,
                    price_items: priceItems
                };

                // QRコードファイル
                const qrFile = document.getElementById('qrCodeFile').files[0];
                if (qrFile) {
                    if (qrFile.size > 5 * 1024 * 1024) {
                        alert('QRコード画像は5MB以下にしてください');
                        return;
                    }
                    const qrBase64 = await fileToBase64(qrFile);
                    requestData.qr_code = qrBase64;
                }

                // PDFファイル
                const pdfFile = document.getElementById('pdfFile').files[0];
                if (pdfFile) {
                    if (pdfFile.size > 10 * 1024 * 1024) {
                        alert('PDFファイルは10MB以下にしてください');
                        return;
                    }
                    const pdfBase64 = await fileToBase64(pdfFile);
                    requestData.pdf_file = pdfBase64;
                }

                try {
                    await axios.put(\`/api/bookings/\${bookingId}\`, requestData, {
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });

                    alert('予約情報を更新しました');
                    location.reload();
                } catch (error) {
                    alert('更新に失敗しました: ' + (error.response?.data?.error || error.message));
                    console.error(error);
                }
            });

            // ファイルをBase64に変換
            function fileToBase64(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                });
            }
        </script>
    </body>
    </html>
  `)
})

// イベントフォーム処理関数（新規登録・編集）
const handleEventForm = async (c: any) => {
  const eventId = c.req.param('id')
  const isEditMode = !!eventId
  
  return c.html(`
    <!DOCTYPE html>
