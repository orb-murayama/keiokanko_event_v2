// 主催者更新API
// API: 主催者一覧取得
app.get('/api/organizers', requireAuth, async (c) => {
  const { DB } = c.env
  
  try {
    // クエリパラメータを取得
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '0')
    const name = c.req.query('name') || ''
    const email = c.req.query('email') || ''
    
    // ページネーションが指定されていない場合は全件取得（イベントフォーム等で使用）
    if (perPage === 0) {
      const { results } = await DB.prepare(`
        SELECT * FROM organizers ORDER BY created_at DESC
      `).all()
      
      return c.json(results)
    }
    
    // ページネーション用のクエリ構築
    let whereClause = 'WHERE 1=1'
    const bindings = []
    
    if (name) {
      whereClause += ' AND name LIKE ?'
      bindings.push(`%${name}%`)
    }
    
    if (email) {
      whereClause += ' AND email LIKE ?'
      bindings.push(`%${email}%`)
    }
    
    // 総件数を取得
    const countQuery = `SELECT COUNT(*) as total FROM organizers ${whereClause}`
    const countResult = await DB.prepare(countQuery).bind(...bindings).first()
    const total = countResult.total
    
    // データを取得
    const offset = (page - 1) * perPage
    const dataQuery = `
      SELECT * FROM organizers 
      ${whereClause}
      ORDER BY created_at DESC 
      LIMIT ? OFFSET ?
    `
    const { results } = await DB.prepare(dataQuery)
      .bind(...bindings, perPage, offset)
      .all()
    
    return c.json({
      data: results,
      pagination: {
        current_page: page,
        per_page: perPage,
        total: total,
        total_pages: Math.ceil(total / perPage),
        from: offset + 1,
        to: Math.min(offset + perPage, total)
      }
    })
  } catch (error) {
    console.error('Error fetching organizers:', error)
    return c.json({ error: 'Failed to fetch organizers' }, 500)
  }
})

// API: 主催者詳細取得
app.get('/api/organizers/:id', requireAuth, async (c) => {
