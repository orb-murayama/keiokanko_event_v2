// 予約完了画面（お客様側）
app.get('/events/:id/booking/complete', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const memberId = c.req.query('member_id')

  // イベント情報取得
  const event = await DB.prepare(`
    SELECT * FROM events WHERE id = ? AND enable_flg = 1 AND deleted_at IS NULL
  `).bind(eventId).first()

  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }

  // 顧客情報取得
  const customer = await DB.prepare(`
    SELECT * FROM members WHERE id = ?
  `).bind(customerId).first()

  // 予約情報取得
  const { results: bookings } = await DB.prepare(`
    SELECT 
      pb.*,
      p.name as product_name,
      ps.date,
      ps.stock_name,
      ps.price_band
    FROM product_bookings pb
    JOIN products p ON pb.product_id = p.id
    LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
    WHERE pb.member_id = ?
    ORDER BY pb.id DESC
  `).bind(customerId).all()

  // 合計金額計算
  let totalAmount = 0
  bookings.forEach(booking => {
    totalAmount += booking.price * booking.quantity
  })

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
