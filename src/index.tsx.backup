// API: 商品の価格帯一覧取得
app.get('/api/products/:id/prices', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')

  const result = await DB.prepare(`
    SELECT * FROM product_prices 
    WHERE product_id = ?
    ORDER BY price_band, display_order, id
  `).bind(productId).all()

  return c.json({ prices: result.results })
})

// API: 商品の価格帯追加
app.post('/api/products/:id/prices', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const data = await c.req.json()

  const result = await DB.prepare(`
    INSERT INTO product_prices (
      product_id, price_band, category_name, price, 
      created_at, modified_at
    ) VALUES (?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
  `).bind(
    productId,
    data.price_band || 'A',
    data.category_name || '',
    data.price
  ).run()

  return c.json({ 
    success: true, 
    message: '価格帯を追加しました',
    id: result.meta.last_row_id 
  })
})

// API: 商品の価格帯削除
app.delete('/api/products/:productId/prices/:priceId', async (c) => {
  const { DB } = c.env
  const priceId = c.req.param('priceId')

  await DB.prepare(`
    DELETE FROM product_prices WHERE id = ?
  `).bind(priceId).run()

  return c.json({ success: true, message: '価格帯を削除しました' })
})

// ========================================
// 共有在庫ヘルパー関数
// ========================================

// 商品の共有在庫を確認し、利用可能かチェック
async function checkProductSharedStock(DB: any, productId: number, quantity: number): Promise<{ available: boolean, pools: any[], message?: string }> {
  // 商品に紐付けられた共有在庫プールを取得
  const { results: sharedStocks } = await DB.prepare(`
    SELECT ps.*, sp.*
    FROM product_shared_stock_pools ps
    INNER JOIN shared_stock_pools sp ON ps.shared_stock_pool_id = sp.id
    WHERE ps.product_id = ? AND ps.enable_flg = 1 AND sp.enable_flg = 1
    ORDER BY ps.priority
  `).bind(productId).all()

  if (sharedStocks.length === 0) {
    return { available: true, pools: [] } // 共有在庫なし = チェック不要
  }

  // 各共有在庫プールの在庫をチェック
  for (const sharedStock of sharedStocks) {
    const requiredQuantity = quantity * (sharedStock.consume_quantity || 1)
    const availableStock = sharedStock.total_stock - sharedStock.booked

    if (availableStock < requiredQuantity) {
      return {
        available: false,
        pools: sharedStocks,
        message: `共有在庫「${sharedStock.pool_name}」が不足しています（必要: ${requiredQuantity}, 利用可能: ${availableStock}）`
      }
    }
  }

  return { available: true, pools: sharedStocks }
}

// オプションの共有在庫を確認
async function checkOptionSharedStock(DB: any, optionId: number, quantity: number): Promise<{ available: boolean, pools: any[], message?: string }> {
  const { results: sharedStocks } = await DB.prepare(`
    SELECT os.*, sp.*
    FROM option_shared_stocks os
    INNER JOIN shared_stock_pools sp ON os.shared_stock_pool_id = sp.id
    WHERE os.option_id = ? AND os.enable_flg = 1 AND sp.enable_flg = 1
    ORDER BY os.priority
  `).bind(optionId).all()

  if (sharedStocks.length === 0) {
    return { available: true, pools: [] }
  }

  for (const sharedStock of sharedStocks) {
    const requiredQuantity = quantity * (sharedStock.consume_quantity || 1)
    const availableStock = sharedStock.total_stock - sharedStock.booked

    if (availableStock < requiredQuantity) {
      return {
        available: false,
        pools: sharedStocks,
        message: `共有在庫「${sharedStock.pool_name}」が不足しています（必要: ${requiredQuantity}, 利用可能: ${availableStock}）`
      }
    }
  }

  return { available: true, pools: sharedStocks }
}

// 共有在庫を減算
async function decrementSharedStock(DB: any, pools: any[], quantity: number) {
  for (const pool of pools) {
    const consumeQuantity = quantity * (pool.consume_quantity || 1)
    await DB.prepare(`
      UPDATE shared_stock_pools
      SET booked = booked + ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(consumeQuantity, pool.id).run()
  }
}

// 共有在庫を増加（キャンセル時）
async function incrementSharedStock(DB: any, pools: any[], quantity: number) {
  for (const pool of pools) {
    const consumeQuantity = quantity * (pool.consume_quantity || 1)
    await DB.prepare(`
      UPDATE shared_stock_pools
      SET booked = booked - ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(consumeQuantity, pool.id).run()
  }
}

