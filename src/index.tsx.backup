  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '100', 10)
  const name = c.req.query('name')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (name) {
    conditions.push('name LIKE ?')
    params.push('%' + name + '%')
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得
  const countQuery = `SELECT COUNT(*) as total FROM organizers ${whereClause}`
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      id,
      name,
      email,
      tel,
      created_at,
      modified_at
    FROM organizers 
    ${whereClause}
    ORDER BY name ASC
    LIMIT ? OFFSET ?
  `
  const { results: organizers } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: organizers,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API v1: 顧客企業一覧取得
app.get('/api/v1/products', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const eventId = c.req.query('event_id')
  const name = c.req.query('name')
  const eventName = c.req.query('event_name')
  const status = c.req.query('status')
  const enableFlg = c.req.query('enable_flg')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築（削除済み商品を除外）
  const conditions = ['p.deleted_at IS NULL']
  const params = []
  
  if (eventId) {
    conditions.push('p.event_id = ?')
    params.push(parseInt(eventId, 10))
  }
  
  if (name) {
    // INSTR関数で部分一致検索（長い文字列にも対応）
    conditions.push('INSTR(p.name, ?) > 0')
    params.push(name.trim())
  }
  
  if (eventName) {
    // INSTR関数で部分一致検索（長い文字列にも対応）
    conditions.push('INSTR(e.name, ?) > 0')
    params.push(eventName.trim())
  }
  
  if (status !== undefined && status !== '') {
    conditions.push('p.enable_flg = ?')
    params.push(parseInt(status, 10))
  }
  
  if (enableFlg !== undefined) {
    conditions.push('p.enable_flg = ?')
    params.push(parseInt(enableFlg, 10))
  }
  
  const whereClause = 'WHERE ' + conditions.join(' AND ')
  
  // 総数取得（JOINを含める）
  const countQuery = `
    SELECT COUNT(*) as total 
    FROM products p
    LEFT JOIN events e ON p.event_id = e.id
    ${whereClause}
  `
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      p.*,
      e.name as event_name
    FROM products p
    LEFT JOIN events e ON p.event_id = e.id
    ${whereClause}
    ORDER BY p.created_at DESC
    LIMIT ? OFFSET ?
  `
  const { results: products } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: products,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API v1: 予約一覧取得
app.get('/api/v1/bookings', async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const eventId = c.req.query('event_id')
  const clientId = c.req.query('client_id')
  const branchCode = c.req.query('branch_code')
  const bookingNumber = c.req.query('booking_number')
  const bookingStatus = c.req.query('booking_status')
  const paymentStatus = c.req.query('payment_status')
  const createdAtFrom = c.req.query('created_at_from')
  const createdAtTo = c.req.query('created_at_to')
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (eventId) {
    conditions.push('p.event_id = ?')
    params.push(parseInt(eventId, 10))
  }
  
  if (clientId) {
    conditions.push('e.client_id = ?')
    params.push(parseInt(clientId, 10))
  }
  
  if (branchCode) {
    conditions.push('pb.branch_code LIKE ?')
    params.push('%' + branchCode + '%')
  }
  
  if (bookingNumber) {
    conditions.push('pb.booking_number LIKE ?')
    params.push('%' + bookingNumber + '%')
  }
  
  if (bookingStatus) {
    conditions.push('pb.booking_status = ?')
    params.push(bookingStatus)
  }
  
  if (paymentStatus) {
    conditions.push('pb.payment_status = ?')
    params.push(paymentStatus)
  }
  
  if (createdAtFrom) {
    conditions.push('pb.created_at >= ?')
    params.push(createdAtFrom)
  }
  
  if (createdAtTo) {
    conditions.push('pb.created_at <= ?')
    params.push(createdAtTo + ' 23:59:59')
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得
  const countQuery = `
    SELECT COUNT(*) as total 
    FROM product_bookings pb
    LEFT JOIN products p ON pb.product_id = p.id
    ${whereClause}
  `
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT 
      pb.*,
      p.name as product_name,
      e.name as event_name,
      (c.family_name || ' ' || c.first_name) as customer_name,
      c.email as customer_email
    FROM product_bookings pb
    LEFT JOIN products p ON pb.product_id = p.id
    LEFT JOIN events e ON p.event_id = e.id
    LEFT JOIN members c ON pb.member_id = c.id
    ${whereClause}
    ORDER BY pb.created_at DESC
    LIMIT ? OFFSET ?
  `
  const { results: bookings } = await DB.prepare(dataQuery)
    .bind(...params, perPage, offset)
    .all()
  
  // レスポンス構築
  return c.json({
    data: bookings,
    pagination: {
      page,
      per_page: perPage,
      total,
      total_pages: Math.ceil(total / perPage)
    }
  })
})

// API: 予約詳細取得
app.get('/api/v1/bookings/:id', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('id')
  
  try {
    // 予約詳細を取得（顧客情報を含む）
    const booking = await DB.prepare(`
      SELECT 
        pb.*,
        p.name as product_name,
        e.name as event_name,
        (c.family_name || ' ' || c.first_name) as customer_name,
        c.email as customer_email,
        c.mobile as customer_phone,
        c.tel as customer_tel,
        (c.zip || ' ' || COALESCE(c.city, '') || ' ' || COALESCE(c.addr, '') || ' ' || COALESCE(c.bldg, '')) as customer_address
      FROM product_bookings pb
      LEFT JOIN products p ON pb.product_id = p.id
      LEFT JOIN events e ON p.event_id = e.id
      LEFT JOIN members c ON pb.member_id = c.id
      WHERE pb.id = ?
    `).bind(bookingId).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    return c.json({ booking })
  } catch (error) {
    console.error('予約詳細取得エラー:', error)
    return c.json({ error: '予約詳細の取得に失敗しました' }, 500)
  }
})

// ============================================
// v2 API: 新予約管理システム
// ============================================

// API v2: 予約一覧取得（ビュー使用）
// 支店管理者は担当イベントの予約のみ取得可能
app.get('/api/v2/bookings', requireAuth, async (c) => {
  const { DB } = c.env
  const account = c.get('account')
  
  try {
    // クエリパラメータを取得
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '50')
    const offset = (page - 1) * perPage
    
    const eventId = c.req.query('event_id')
    const bookingNumber = c.req.query('booking_number')
    const bookingStatus = c.req.query('booking_status')
    const paymentStatus = c.req.query('payment_status')
    const createdAtFrom = c.req.query('created_at_from')
    const createdAtTo = c.req.query('created_at_to')
    
    // WHERE句を構築
    const conditions = []
    const params = []
    
    // 支店管理者の場合、担当イベントのみに制限
    if (account.role === 'branch') {
      const assignedEventIds = await getAssignedEventIds(DB, account.id)
      if (assignedEventIds.length === 0) {
        // 担当イベントがない場合は空配列を返す
        return c.json({
          data: [],
          pagination: { page, per_page: perPage, total: 0, total_pages: 0 }
        })
      }
      const placeholders = assignedEventIds.map(() => '?').join(',')
      conditions.push(`event_id IN (${placeholders})`)
      params.push(...assignedEventIds)
    }
    
    if (eventId) {
      conditions.push('event_id = ?')
      params.push(eventId)
    }
    if (bookingNumber) {
      conditions.push('booking_number LIKE ?')
      params.push(`%${bookingNumber}%`)
    }
    if (bookingStatus) {
      conditions.push('booking_status = ?')
      params.push(bookingStatus)
    }
    if (paymentStatus) {
      conditions.push('latest_payment_status = ?')
      params.push(paymentStatus)
    }
    if (createdAtFrom) {
      conditions.push('date(created_at) >= ?')
      params.push(createdAtFrom)
    }
    if (createdAtTo) {
      conditions.push('date(created_at) <= ?')
      params.push(createdAtTo)
    }
    
    const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : ''
    
    // 総件数を取得
    const countResult = await DB.prepare(`
      SELECT COUNT(*) as total
      FROM v_bookings_list
      ${whereClause}
    `).bind(...params).first()
    
    const total = countResult?.total || 0
    
    // 予約一覧を取得
    const bookings = await DB.prepare(`
      SELECT *
      FROM v_bookings_list
      ${whereClause}
      ORDER BY created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...params, perPage, offset).all()
    
    return c.json({
      data: bookings.results || [],
      pagination: {
        page,
        per_page: perPage,
        total,
        total_pages: Math.ceil(total / perPage)
      }
    })
  } catch (error: any) {
    console.error('予約一覧取得エラー:', error)
    return c.json({ error: '予約一覧の取得に失敗しました' }, 500)
  }
})

// API v2: 予約詳細取得（予約番号ベース）
// 支店管理者は担当イベントの予約のみアクセス可能
app.get('/api/v2/bookings/:booking_number', requireAuth, async (c) => {
  try {
    const { DB } = c.env
    const bookingNumber = c.req.param('booking_number')
    const account = c.get('account')
    
    // デバッグログ: account の存在を確認
    if (!account) {
      console.error('❌ account が undefined です')
      return c.json({ error: 'アカウント情報が取得できません' }, 500)
    }
    
    console.log('予約詳細取得リクエスト:', {
      bookingNumber,
      accountRole: account.role,
      accountId: account.id
    })
    // 予約グループを取得
    const booking = await DB.prepare(`
      SELECT 
        b.*,
        m.family_name || ' ' || m.first_name AS customer_name,
        m.email AS customer_email,
        m.mobile AS customer_phone,
        m.tel AS customer_tel,
        (m.zip || ' ' || COALESCE(m.addr, '')) AS customer_address,
        e.name AS event_name,
        e.event_start_date,
        e.event_end_date,
        cl.name AS client_name,
        org.name AS organizer_name
      FROM bookings b
      LEFT JOIN members m ON b.member_id = m.id
      LEFT JOIN events e ON b.event_id = e.id
      LEFT JOIN clients cl ON e.client_id = cl.id
      LEFT JOIN organizers org ON e.organizer_id = org.id
      WHERE b.booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!booking) {
      console.log('予約が見つかりません:', bookingNumber)
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    console.log('予約情報取得成功:', booking.booking_number, 'イベントID:', booking.event_id)
    
    // 支店管理者の場合、担当イベントかチェック
    if (account.role === 'branch') {
      const assignedEventIds = await getAssignedEventIds(DB, account.id)
      console.log('支店管理者の担当イベント:', assignedEventIds)
      if (!assignedEventIds.includes(booking.event_id)) {
        console.log('アクセス権限なし - イベントID:', booking.event_id)
        return c.json({ error: 'この予約へのアクセス権限がありません' }, 403)
      }
    }
    
    // 決済情報を取得
    const payments = await DB.prepare(`
      SELECT 
        bp.*,
        (
          SELECT COUNT(*)
          FROM booking_items bi
          WHERE bi.payment_id = bp.id
        ) AS item_count,
        (
          SELECT COALESCE(SUM(bi.quantity), 0)
          FROM booking_items bi
          WHERE bi.payment_id = bp.id AND bi.status = 'active'
        ) AS total_participants
      FROM booking_payments bp
      WHERE bp.booking_number = ?
      ORDER BY bp.created_at ASC
    `).bind(bookingNumber).all()
    
    // 予約明細を取得（price_categoryを含む）
    const items = await DB.prepare(`
      SELECT 
        bi.*,
        p.name AS product_name,
        o.name AS option_name,
        bi.price_category
      FROM booking_items bi
      LEFT JOIN products p ON bi.item_type = 'product' AND bi.item_id = p.id
      LEFT JOIN options o ON bi.item_type = 'option' AND bi.item_id = o.id
      WHERE bi.booking_id = ?
      ORDER BY bi.created_at ASC
    `).bind(booking.id).all()
    
    // 返金履歴を取得
    const refunds = await DB.prepare(`
      SELECT 
        rh.*,
        bp.payment_number,
        bi.item_name
      FROM refund_history rh
      LEFT JOIN booking_payments bp ON rh.payment_id = bp.id
      LEFT JOIN booking_items bi ON rh.booking_item_id = bi.id
      WHERE bp.booking_number = ?
      ORDER BY rh.refund_date DESC
    `).bind(bookingNumber).all()
    
    // 料金サマリーを計算
    const paymentsData = payments.results || []
    const itemsData = items.results || []
    
    // 取引金額 = 予約明細の小計合計
    const transactionAmount = itemsData.reduce((sum: number, item: any) => sum + (item.subtotal || 0), 0)
    
    // 決済済み = payment_status = 'completed'
    const paidAmount = paymentsData
      .filter((p: any) => p.payment_status === 'completed' && p.payment_type !== 'refund')
      .reduce((sum: number, p: any) => sum + (p.amount || 0), 0)
    
    // 決済待ち = payment_status = 'pending'
    const pendingAmount = paymentsData
      .filter((p: any) => p.payment_status === 'pending')
      .reduce((sum: number, p: any) => sum + (p.amount || 0), 0)
    
    // 返金待ち = payment_status = 'refund_pending' AND payment_type = 'refund'
    const refundPendingAmount = paymentsData
      .filter((p: any) => p.payment_status === 'refund_pending' && p.payment_type === 'refund')
      .reduce((sum: number, p: any) => sum + (p.amount || 0), 0)
    
    // 返金済み = payment_status = 'refunded' AND payment_type = 'refund'
    const refundedAmount = paymentsData
      .filter((p: any) => p.payment_status === 'refunded' && p.payment_type === 'refund')
      .reduce((sum: number, p: any) => sum + (p.amount || 0), 0)
    
    // 未請求金額 = 取引金額 - 決済済み - 決済待ち - 返金待ち
    const unbilledAmount = transactionAmount - paidAmount - pendingAmount - refundPendingAmount
    
    // 合計金額 = 取引金額 - 返金済み
    const totalAmount = transactionAmount - refundedAmount
    
    return c.json({
      booking,
      payments: paymentsData,
      items: itemsData,
      refunds: refunds.results || [],
      payment_summary: {
        transaction_amount: transactionAmount,
        paid_amount: paidAmount,
        pending_amount: pendingAmount,
        refund_pending_amount: refundPendingAmount,
        unbilled_amount: unbilledAmount,
        refunded_amount: refundedAmount,
        total_amount: totalAmount
      }
    })
  } catch (error: any) {
    console.error('❌❌❌ 予約詳細取得エラー ❌❌❌')
    console.error('エラーメッセージ:', error?.message || 'メッセージなし')
    console.error('エラー型:', typeof error)
    console.error('エラー全体:', JSON.stringify(error, Object.getOwnPropertyNames(error)))
    console.error('エラースタック:', error?.stack || 'スタックなし')
    
    return c.json({ 
      error: '予約詳細の取得に失敗しました',
      details: error?.message || String(error),
      errorType: typeof error,
      stack: error?.stack || 'No stack'
    }, 500)
  }
})

