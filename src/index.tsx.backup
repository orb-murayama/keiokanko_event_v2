})

// API v2: 決済明細作成（追加決済依頼用）
app.post('/api/v2/booking-payments', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const { booking_number, payment_type, payment_method, amount, payment_due_date, remarks } = body
    
    console.log('決済明細作成リクエスト:', {
      booking_number,
      payment_type,
      payment_method,
      amount,
      payment_due_date,
      remarks
    })
    
    // 必須フィールドチェック
    if (!booking_number || !payment_type || !payment_method || !amount) {
      return c.json({ error: '必須パラメータが不足しています' }, 400)
    }
    
    // 予約の存在確認
    const booking = await DB.prepare(`
      SELECT id, booking_number, event_id FROM bookings WHERE booking_number = ?
    `).bind(booking_number).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // イベントの決済設定を取得
    const event = await DB.prepare(`
      SELECT 
        bank_transfer_deadline,
        convenience_payment_deadline
      FROM events
      WHERE id = ?
    `).bind(booking.event_id).first()
    
    // 支払期限の計算（指定がない場合）
    let dueDate = payment_due_date
    if (!dueDate) {
      const deadlineDays = payment_method === 'bank_transfer' 
        ? (event?.bank_transfer_deadline || 7)
        : (event?.convenience_payment_deadline || 7)
      
      const date = new Date()
      date.setDate(date.getDate() + deadlineDays)
      dueDate = date.toISOString().split('T')[0]
    }
    
    // 決済番号を生成（PAY + YYYYMMDD + 連番）
    const today = new Date().toISOString().split('T')[0].replace(/-/g, '')
    const lastPayment = await DB.prepare(`
      SELECT payment_number FROM booking_payments 
      WHERE payment_number LIKE ? 
      ORDER BY payment_number DESC 
      LIMIT 1
    `).bind(`PAY${today}-%`).first()
    
    let sequence = 1
    if (lastPayment) {
      const lastSeq = parseInt(lastPayment.payment_number.split('-')[1])
      sequence = lastSeq + 1
    }
    const paymentNumber = `PAY${today}-${String(sequence).padStart(3, '0')}`
    
    // 決済明細を作成
    const result = await DB.prepare(`
      INSERT INTO booking_payments (
        booking_id,
        booking_number,
        payment_number,
        payment_type,
        payment_method,
        payment_status,
        amount,
        payment_due_date,
        remarks,
        created_at,
        modified_at
      ) VALUES (?, ?, ?, ?, ?, 'pending', ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      booking.id,
      booking_number,
      paymentNumber,
      payment_type,
      payment_method,
      amount,
      dueDate,
      remarks || null
    ).run()
    
    console.log('決済明細作成成功:', {
      payment_number: paymentNumber,
      id: result.meta.last_row_id
    })
    
    return c.json({
      success: true,
      payment_number: paymentNumber,
      payment_id: result.meta.last_row_id,
      payment_due_date: dueDate,
      message: '決済依頼を作成しました'
    })
    
  } catch (error) {
    console.error('決済明細作成エラー:', error)
    return c.json({ error: error.message || '決済明細の作成に失敗しました' }, 500)
  }
})

