})

// ==================== Booking Files API ====================

// PDFファイルアップロードAPI
app.post('/api/booking-files/upload', async (c) => {
  const { DB, BOOKING_FILES } = c.env
  
  try {
    const body = await c.req.parseBody()
    const pdfFile = body['pdf_file']
    const bookingNumber = body['booking_number'] as string
    const displayFilename = body['display_filename'] as string
    const downloadLimit = parseInt(body['download_limit'] as string) || 0
    
    // バリデーション
    if (!pdfFile || typeof pdfFile === 'string') {
      return c.json({ error: 'PDFファイルがアップロードされていません' }, 400)
    }
    
    if (!bookingNumber) {
      return c.json({ error: '予約番号が指定されていません' }, 400)
    }
    
    if (!displayFilename) {
      return c.json({ error: '表示ファイル名が入力されていません' }, 400)
    }
    
    // ファイルサイズチェック (10MB = 10 * 1024 * 1024 bytes)
    const fileSize = pdfFile.size
    if (fileSize > 10 * 1024 * 1024) {
      return c.json({ error: 'ファイルサイズが10MBを超えています' }, 400)
    }
    
    // MIMEタイプチェック
    if (pdfFile.type !== 'application/pdf') {
      return c.json({ error: 'PDFファイルのみアップロード可能です' }, 400)
    }
    
    // 予約が存在するか確認
    const booking = await DB.prepare(`
      SELECT id FROM bookings WHERE booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // ユニークなファイルキーを生成
    const timestamp = Date.now()
    const randomStr = Math.random().toString(36).substring(7)
    const fileKey = `bookings/${bookingNumber}/${timestamp}_${randomStr}.pdf`
    
    // R2にファイルをアップロード
    const fileBuffer = await pdfFile.arrayBuffer()
    await BOOKING_FILES.put(fileKey, fileBuffer, {
      httpMetadata: {
        contentType: 'application/pdf'
      },
      customMetadata: {
        bookingNumber: bookingNumber,
        originalFilename: pdfFile.name,
        displayFilename: displayFilename
      }
    })
    
    // データベースに登録
    const result = await DB.prepare(`
      INSERT INTO booking_files (
        booking_number,
        file_key,
        original_filename,
        display_filename,
        file_size,
        download_limit,
        download_count
      ) VALUES (?, ?, ?, ?, ?, ?, 0)
    `).bind(
      bookingNumber,
      fileKey,
      pdfFile.name,
      displayFilename,
      fileSize,
      downloadLimit
    ).run()
    
    return c.json({
      success: true,
      file_id: result.meta.last_row_id,
      file_key: fileKey,
      display_filename: displayFilename,
      file_size: fileSize
    })
  } catch (error) {
    console.error('PDFアップロードエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 予約に紐づくファイル一覧取得API
app.get('/api/booking-files/:booking_number', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    const files = await DB.prepare(`
      SELECT
        id,
        booking_number,
        file_key,
        original_filename,
        display_filename,
        file_size,
        download_limit,
        download_count,
        created_at
      FROM booking_files
      WHERE booking_number = ?
      ORDER BY created_at DESC
    `).bind(bookingNumber).all()
    
    return c.json({
      booking_number: bookingNumber,
      files: files.results || []
    })
  } catch (error) {
    console.error('ファイル一覧取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ファイル編集API
app.put('/api/booking-files/:id', async (c) => {
  const { DB } = c.env
  const fileId = c.req.param('id')
  
  try {
    const body = await c.req.json()
    const { display_filename, download_limit } = body
    
    if (!display_filename) {
      return c.json({ error: '表示ファイル名が入力されていません' }, 400)
    }
    
    const result = await DB.prepare(`
      UPDATE booking_files
      SET display_filename = ?,
          download_limit = ?,
          modified_at = CURRENT_TIMESTAMP
      WHERE id = ?
    `).bind(display_filename, download_limit || 0, fileId).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: 'ファイルが見つかりません' }, 404)
    }
    
    return c.json({ success: true })
  } catch (error) {
    console.error('ファイル編集エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ファイル削除API
app.delete('/api/booking-files/:id', async (c) => {
  const { DB, BOOKING_FILES } = c.env
  const fileId = c.req.param('id')
  
  try {
    // ファイル情報を取得
    const file = await DB.prepare(`
      SELECT file_key FROM booking_files WHERE id = ?
    `).bind(fileId).first()
    
    if (!file) {
      return c.json({ error: 'ファイルが見つかりません' }, 404)
    }
    
    // R2からファイルを削除
    await BOOKING_FILES.delete(file.file_key as string)
    
    // データベースから削除
    await DB.prepare(`
      DELETE FROM booking_files WHERE id = ?
    `).bind(fileId).run()
    
    return c.json({ success: true })
  } catch (error) {
    console.error('ファイル削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ファイルダウンロード＆プレビューAPI
app.get('/api/booking-files/download/:id', async (c) => {
  const { DB, BOOKING_FILES } = c.env
  const fileId = c.req.param('id')
  const preview = c.req.query('preview') === 'true'
  
  try {
    // ファイル情報を取得
    const file = await DB.prepare(`
      SELECT
        id,
        file_key,
        display_filename,
        download_limit,
        download_count
      FROM booking_files
      WHERE id = ?
    `).bind(fileId).first() as any
    
    if (!file) {
      return c.json({ error: 'ファイルが見つかりません' }, 404)
    }
    
    // プレビュー以外の場合、ダウンロード回数をチェック
    if (!preview && file.download_limit > 0 && file.download_count >= file.download_limit) {
      return c.json({ error: 'ダウンロード回数の上限に達しています' }, 403)
    }
    
    // R2からファイルを取得
    const object = await BOOKING_FILES.get(file.file_key)
    
    if (!object) {
      return c.json({ error: 'ファイルが見つかりません' }, 404)
    }
    
    // プレビュー以外の場合、ダウンロード回数をインクリメント
    if (!preview) {
      await DB.prepare(`
        UPDATE booking_files
        SET download_count = download_count + 1,
            modified_at = CURRENT_TIMESTAMP
        WHERE id = ?
      `).bind(fileId).run()
    }
    
    // ファイルを返す
    const headers = new Headers()
    headers.set('Content-Type', 'application/pdf')
    
    if (preview) {
      // プレビュー表示
      headers.set('Content-Disposition', 'inline')
    } else {
      // ダウンロード
      headers.set('Content-Disposition', `attachment; filename="${encodeURIComponent(file.display_filename)}"`)
    }
    
    return new Response(object.body, { headers })
  } catch (error) {
    console.error('ファイルダウンロードエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

