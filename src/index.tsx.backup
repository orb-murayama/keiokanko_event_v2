// GMO決済コールバック用ページ（公開アクセス - 認証不要）
// GETとPOST両方に対応（GMOはPOSTでコールバックを送る）
app.get('/payment-callback.html', (c) => {
  return c.html(paymentCallbackHtml)
})
app.get('/payment-callback', (c) => {
  return c.html(paymentCallbackHtml)
})
app.post('/payment-callback.html', async (c) => {
  try {
    // POSTボディを取得
    const body = await c.req.parseBody()
    console.log('📬 GMO POSTコールバック受信:', body)
    
    // URLクエリパラメータも取得
    const url = new URL(c.req.url)
    const urlParams = new URLSearchParams(url.search)
    
    // resultパラメータ（JWT形式）をデコード
    let decodedData: any = {}
    if (body.result && typeof body.result === 'string') {
      try {
        // JWTの形式: header.payload.signature
        const parts = body.result.split('.')
        if (parts.length >= 2) {
          // Base64デコード（URLセーフでない場合もあるため、両方試す）
          const payload = parts[0]
          const decodedPayload = atob(payload.replace(/-/g, '+').replace(/_/g, '/'))
          decodedData = JSON.parse(decodedPayload)
          console.log('🔓 GMO resultパラメータをデコード:', decodedData)
        }
      } catch (e) {
        console.error('⚠️ resultパラメータのデコードに失敗:', e)
      }
    }
    
    // パラメータをマージ（優先順位: URLクエリ > decodedData > POSTボディ）
    const params = new URLSearchParams()
    
    // 1. POSTボディの通常パラメータ
    for (const [key, value] of Object.entries(body)) {
      if (typeof value === 'string' && key !== 'result') {
        params.append(key, value)
      }
    }
    
    // 2. decodedDataから取得（transactionresult内のデータ）
    if (decodedData.transactionresult) {
      const tr = decodedData.transactionresult
      if (tr.OrderID) params.set('OrderID', tr.OrderID)
      if (tr.Result) params.set('Result', tr.Result)
      if (tr.Paymethod) params.set('PayType', tr.Paymethod)
      if (tr.ErrCode) params.set('errCode', tr.ErrCode)
      if (tr.ErrInfo) params.set('errInfo', tr.ErrInfo)
    }
    
    // 3. URLクエリパラメータ（最優先）
    for (const [key, value] of urlParams.entries()) {
      params.set(key, value)
    }
    
    // 4. GMO詳細情報をBase64エンコードして追加（JSON全体を保持）
    if (Object.keys(decodedData).length > 0) {
      const gmoDetailsBase64 = btoa(JSON.stringify(decodedData))
      params.set('gmo_details', gmoDetailsBase64)
      console.log('📦 GMO詳細情報をBase64エンコード（長さ:', gmoDetailsBase64.length, '）')
    }
    
    console.log('✅ 統合パラメータ:', Object.fromEntries(params.entries()))
    
    // GETリダイレクト（URLバーに表示）
    const redirectUrl = `/payment-callback?${params.toString()}`
    console.log('🔄 リダイレクト:', redirectUrl)
    return c.redirect(redirectUrl, 302)
  } catch (error) {
    console.error('❌ POSTコールバック処理エラー:', error)
    // エラーが発生してもリダイレクト（最低限の情報で）
    return c.redirect('/payment-callback?error=callback_processing_failed', 302)
  }
})
