// API - オプションのコピー
app.post('/api/options/:id/copy', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  try {
    // 元のオプション情報を取得
    const { results } = await DB.prepare(`
      SELECT * FROM options WHERE id = ? AND deleted_at IS NULL
    `).bind(optionId).all()
    
    if (results.length === 0) {
      return c.json({ error: 'オプションが見つかりません' }, 404)
    }
    
    const original = results[0]
    const originalName = original.name
    
    // オプションをコピー（名前に「コピー 」を接頭辞として付ける、制御カラムも含む）
    const result = await DB.prepare(`
      INSERT INTO options (
        name, description, remarks, event_id, option_category_id, 
        sales_start, sales_end, closing_trade, purchase_limit,
        note, image_url, enable_flg, created_at, modified_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      'コピー ' + original.name,
      original.description,
      original.remarks,
      original.event_id,
      original.option_category_id,
      original.sales_start,
      original.sales_end,
      original.closing_trade,
      original.purchase_limit,
      original.note,
      original.image_url
    ).run()
    
    const newOptionId = result.meta.last_row_id
    
    // 元のオプションの在庫データを取得
    const { results: stocks } = await DB.prepare(`
      SELECT * FROM option_stocks WHERE option_id = ?
    `).bind(optionId).all()
    
    // 在庫データをコピー
    if (stocks.length > 0) {
      for (const stock of stocks) {
        await DB.prepare(`
          INSERT INTO option_stocks (
            option_id, date, stock_name, price, stock, booked,
            total_stock, available_stock, enable_flg, shared_pool_id,
            created_at, modified_at
          ) VALUES (?, ?, ?, ?, ?, 0, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
        `).bind(
          newOptionId,
          stock.date,
          stock.stock_name,
          stock.price,
          stock.stock,
          stock.total_stock || stock.stock,
          stock.available_stock || stock.stock,
          stock.enable_flg,
          stock.shared_pool_id
        ).run()
      }
    }
    
    return c.json({ 
      message: 'オプション「' + originalName + '」を在庫と共にコピーしました',
      newOptionId: newOptionId,
      copiedStocks: stocks.length
    })
  } catch (error) {
    console.error('オプションコピーエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - オプションの削除（論理削除）
// API: オプション更新
app.put('/api/options/:id', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    // オプションの存在確認
    const option = await DB.prepare(`
      SELECT id FROM options WHERE id = ? AND deleted_at IS NULL
    `).bind(parseInt(optionId)).first()
    
    if (!option) {
      return c.json({ error: 'オプションが見つかりません' }, 404)
    }
    
    // 部分更新をサポート：送信されたフィールドのみ更新
    const updates: string[] = []
    const params: any[] = []
    
    if (data.name !== undefined) {
      updates.push('name = ?')
      params.push(data.name)
    }
    if (data.description !== undefined) {
      updates.push('description = ?')
      params.push(data.description || '')
    }
    if (data.remarks !== undefined) {
      updates.push('remarks = ?')
      params.push(data.remarks || '')
    }
    if (data.event_id !== undefined) {
      updates.push('event_id = ?')
      params.push(parseInt(data.event_id))
    }
    if (data.option_category_id !== undefined) {
      updates.push('option_category_id = ?')
      params.push(parseInt(data.option_category_id))
    }
    if (data.enable_flg !== undefined) {
      updates.push('enable_flg = ?')
      params.push(parseInt(data.enable_flg))
    }
    if (data.image_url !== undefined) {
      updates.push('image_url = ?')
      params.push(data.image_url || null)
    }
    
    if (updates.length === 0) {
      return c.json({ error: '更新するフィールドが指定されていません' }, 400)
    }
    
    // modified_atを追加
    updates.push('modified_at = datetime(\'now\', \'localtime\')')
    
    // オプション情報を更新
    const query = `UPDATE options SET ${updates.join(', ')} WHERE id = ?`
    params.push(parseInt(optionId))
    
    await DB.prepare(query).bind(...params).run()
    
    return c.json({ 
      success: true, 
      message: 'オプションを更新しました' 
    })
  } catch (error) {
    console.error('オプション更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

app.delete('/api/options/:id', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  try {
    // オプションの存在確認
    const { results } = await DB.prepare(`
      SELECT id FROM options WHERE id = ? AND deleted_at IS NULL
    `).bind(optionId).all()
    
    if (results.length === 0) {
      return c.json({ error: 'オプションが見つかりません' }, 404)
    }
    
    // 論理削除（deleted_atを設定）
    await DB.prepare(`
      UPDATE options 
      SET deleted_at = datetime('now', 'localtime'),
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(optionId).run()
    
    return c.json({ message: 'オプションを削除しました' })
  } catch (error) {
    console.error('オプション削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

