// API: イベント一覧取得
// 全ロールがアクセス可能（公開・非公開すべて閲覧可）
app.get('/api/events', requireAuth, async (c) => {
  const { DB } = c.env
  const account = c.get('account')
  
  // クエリパラメータ取得
  const page = parseInt(c.req.query('page') || '1', 10)
  const perPage = parseInt(c.req.query('per_page') || '50', 10)
  const name = c.req.query('name')
  const branchCode = c.req.query('branch_code')
  const clientId = c.req.query('client_id')
  const vendorId = c.req.query('vendor_id')
  const eventStartDateFrom = c.req.query('event_start_date_from')
  const eventStartDateTo = c.req.query('event_start_date_to')
  const enableFlg = c.req.query('enable_flg')
  const category = c.req.query('category')
  const eventType = c.req.query('event_type')
  const includeDeleted = c.req.query('include_deleted') === '1'
  const sort = c.req.query('sort') || 'event_start_date'
  const order = c.req.query('order') || 'desc'
  
  // ページネーション計算
  const offset = (page - 1) * perPage
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  // 削除済みフィルタ（管理画面のみ制御可能）
  if (!includeDeleted) {
    conditions.push('e.deleted_at IS NULL')
  }
  
  // 検索フィルタ
  if (name) {
    conditions.push('e.name LIKE ?')
    params.push('%' + name + '%')
  }
  
  if (category) {
    conditions.push('e.category = ?')
    params.push(category)
  }
  
  if (eventType) {
    conditions.push('e.event_type = ?')
    params.push(eventType)
  }
  
  // 管理画面用フィルタ
  if (clientId) {
    conditions.push('e.customer_client_id = ?')
    params.push(parseInt(clientId, 10))
  }
  
  if (vendorId) {
    conditions.push('e.client_id = ?')
    params.push(parseInt(vendorId, 10))
  }
  
  if (eventStartDateFrom) {
    conditions.push('e.event_start_date >= ?')
    params.push(eventStartDateFrom)
  }
  
  if (eventStartDateTo) {
    conditions.push('e.event_start_date <= ?')
    params.push(eventStartDateTo)
  }
  
  if (enableFlg !== undefined) {
    conditions.push('e.enable_flg = ?')
    params.push(parseInt(enableFlg, 10))
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  try {
    // 総数取得
    const countQuery = `SELECT COUNT(*) as total FROM events e ${whereClause}`
    const countResult = await DB.prepare(countQuery).bind(...params).first()
    const total = countResult?.total || 0
    
    // ソート順検証
    const validSortColumns = ['id', 'name', 'event_start_date', 'created_at']
    const sortColumn = validSortColumns.includes(sort) ? sort : 'event_start_date'
    const sortOrder = order.toLowerCase() === 'asc' ? 'ASC' : 'DESC'
    
    // データ取得
    const dataQuery = `
      SELECT 
        e.id,
        e.name,
        e.detail,
        e.location,
        e.contact,
        e.event_start_date,
        e.event_end_date,
        e.registration_start_date,
        e.registration_end_date,
        e.event_url,
        e.category,
        e.enable_flg,
        e.payment_flg,
        e.organizer_id,
        e.customer_client_id,
        e.client_id,
        e.admin_email,
        e.created_at,
        e.modified_at,
        e.deleted_at,
        c.name as client_name,
        v.name as vendor_name
      FROM events e
      LEFT JOIN clients c ON e.customer_client_id = c.id
      LEFT JOIN clients v ON e.client_id = v.id
      ${whereClause}
      ORDER BY e.${sortColumn} ${sortOrder}
      LIMIT ? OFFSET ?
    `
    
    const { results: events } = await DB.prepare(dataQuery)
      .bind(...params, perPage, offset)
      .all()
    
    // レスポンス構築
    return c.json({
      data: events,
      pagination: {
        page,
        per_page: perPage,
        total,
        total_pages: Math.ceil(total / perPage)
      }
    })
  } catch (error) {
    console.error('Error fetching events:', error)
    return c.json({ error: 'イベント一覧の取得に失敗しました' }, 500)
  }
})

