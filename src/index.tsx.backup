// API: 商品に共有在庫を一括追加
app.post('/api/products/:id/shared-stocks/batch', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // 必須フィールドチェック
    if (!data.pool_name || !data.date_start) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 日付範囲を取得
    const startDate = new Date(data.date_start)
    const endDate = data.date_end ? new Date(data.date_end) : startDate
    const dates = []
    
    for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
      dates.push(d.toISOString().split('T')[0])
    }
    
    let addedCount = 0
    let errors = []
    
    for (const date of dates) {
      // 該当する共有在庫プールを検索
      const pool = await DB.prepare(`
        SELECT id FROM shared_stock_pools
        WHERE pool_name = ? 
          AND (pool_code IS NULL AND ? IS NULL OR pool_code = ?)
          AND date = ?
          AND enable_flg = 1
      `).bind(
        data.pool_name,
        data.pool_code || null,
        data.pool_code || null,
        date
      ).first()
      
      if (!pool) {
        errors.push(`${date}: 該当する共有在庫プールが見つかりません`)
        continue
      }
      
      // 既存の設定をチェック
      const existing = await DB.prepare(`
        SELECT id FROM product_shared_stock_pools
        WHERE product_id = ? AND shared_stock_pool_id = ?
          AND (price_band IS NULL AND ? IS NULL OR price_band = ?)
      `).bind(
        parseInt(productId),
        pool.id,
        data.price_band || null,
        data.price_band || null
      ).first()
      
      if (existing) {
        errors.push(`${date}: 既に設定済みです`)
        continue
      }
      
      // 共有在庫設定を追加
      await DB.prepare(`
        INSERT INTO product_shared_stock_pools 
        (product_id, shared_stock_pool_id, stock_name, price_band, enable_flg)
        VALUES (?, ?, ?, ?, 1)
      `).bind(
        parseInt(productId),
        pool.id,
        data.stock_name || null,
        data.price_band || null
      ).run()
      
      addedCount++
    }
    
    return c.json({
      success: true,
      added_count: addedCount,
      errors: errors.length > 0 ? errors : null,
      message: `${addedCount}件の共有在庫を追加しました`
    })
  } catch (error) {
    console.error('Shared stock batch creation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 商品の共有在庫設定を削除
app.delete('/api/products/:id/shared-stocks/:linkId', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const linkId = c.req.param('linkId')
  
  try {
    // 設定が存在するかチェック
    const existing = await DB.prepare(`
      SELECT * FROM product_shared_stock_pools
      WHERE id = ? AND product_id = ?
    `).bind(parseInt(linkId), parseInt(productId)).first()
    
    if (!existing) {
      return c.json({ error: '共有在庫設定が見つかりません' }, 404)
    }
    
    // 設定を削除
    await DB.prepare(`
      DELETE FROM product_shared_stock_pools WHERE id = ?
    `).bind(parseInt(linkId)).run()
    
    return c.json({
      success: true,
      message: '共有在庫設定を削除しました'
    })
  } catch (error) {
    console.error('Shared stock deletion error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 管理画面 - オプションの共有在庫設定
app.get('/admin/options/:id/shared-stocks', routeAccessControl('admin'), async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')

  // オプション情報を取得
  const { results: options } = await DB.prepare(`
    SELECT * FROM options WHERE id = ?
  `).bind(optionId).all()

  if (options.length === 0) {
    return c.text('オプションが見つかりません', 404)
  }

  const option = options[0]

  // 現在の共有在庫設定を取得
  const { results: sharedStocks } = await DB.prepare(`
    SELECT oss.*, ssp.pool_name, ssp.pool_code, ssp.date, ssp.time_slot_label,
           ssp.total_stock, ssp.booked, ssp.available_stock
    FROM option_shared_stocks oss
    JOIN shared_stock_pools ssp ON oss.shared_stock_pool_id = ssp.id
    WHERE oss.option_id = ? AND oss.enable_flg = 1 AND ssp.enable_flg = 1
    ORDER BY ssp.date ASC, ssp.time_slot_start
  `).bind(optionId).all()

  // 利用可能な共有在庫プール（プール名単位）を取得
  const { results: availablePools } = await DB.prepare(`
    SELECT DISTINCT pool_name, pool_code
    FROM shared_stock_pools
    WHERE enable_flg = 1
    ORDER BY pool_name
  `).all()

  const sharedStocksHtml = sharedStocks.length > 0 ? sharedStocks.map(stock => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 border-b">
        <div class="font-medium text-gray-900">${stock.pool_name}</div>
        ${stock.pool_code ? `<div class="text-xs text-gray-500">コード: ${stock.pool_code}</div>` : ''}
      </td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">${stock.date}</td>
      <td class="px-4 py-3 border-b text-sm text-gray-700">
        ${stock.time_slot_label || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-right">
        <span class="font-semibold text-blue-600">${stock.price ? stock.price.toLocaleString() : '-'}</span>
        ${stock.price ? '<span class="text-xs text-gray-500">円</span>' : ''}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <span class="font-semibold ${stock.available_stock > 0 ? 'text-green-600' : 'text-gray-400'}">
          ${stock.available_stock}
        </span>
        <span class="text-gray-500">/ ${stock.total_stock}</span>
      </td>
      <td class="px-4 py-3 border-b">
        ${stock.stock_name || '<span class="text-gray-400">-</span>'}
      </td>
      <td class="px-4 py-3 border-b text-center">
        <button onclick="deleteSharedStock(${stock.id})" class="text-red-600 hover:text-red-800">
          <i class="fas fa-trash"></i> 削除
        </button>
      </td>
    </tr>
  `).join('') : '<tr><td colspan="7" class="px-4 py-8 text-center text-gray-500">まだ共有在庫が設定されていません</td></tr>'

  const poolsOptions = availablePools.map(pool => {
    const label = pool.pool_code ? `${pool.pool_name} (${pool.pool_code})` : pool.pool_name
    return `<option value="${pool.pool_name}|${pool.pool_code || ''}">${label}</option>`
  }).join('')

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>${option.name} - 共有在庫設定 | 管理画面</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100">
        <div class="min-h-screen">
            <nav class="bg-white shadow-sm mb-6">
                <div class="max-w-7xl mx-auto px-4 py-4">
                    <div class="flex items-center justify-between">
                        <a href="/admin/options" class="text-blue-600 hover:text-blue-800">
                            <i class="fas fa-arrow-left mr-2"></i>オプション一覧に戻る
                        </a>
                        <h1 class="text-xl font-bold text-gray-800">${option.name} - 共有在庫設定</h1>
                    </div>
                </div>
            </nav>

            <div class="max-w-7xl mx-auto px-4">
                <!-- オプション情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-puzzle-piece mr-2 text-purple-600"></i>オプション情報
                    </h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">オプション名</p>
                            <p class="text-lg font-semibold">${option.name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">オプションID</p>
                            <p class="text-lg font-semibold">${option.id}</p>
                        </div>
                    </div>
                </div>

                <!-- 共有在庫追加フォーム（期間一括登録） -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-plus-circle mr-2 text-green-600"></i>共有在庫を追加（期間一括登録）
                    </h2>
                    <form id="addSharedStockForm" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                共有在庫プール <span class="text-red-600">*</span>
                            </label>
                            <select id="poolSelect" required
                                class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <option value="">選択してください</option>
                                ${poolsOptions}
                            </select>
                            <p class="text-xs text-gray-500 mt-1">プール名単位で選択</p>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    開始日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateStart" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    終了日 <span class="text-red-600">*</span>
                                </label>
                                <input type="date" id="dateEnd" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    料金 <span class="text-red-600">*</span>
                                </label>
                                <input type="number" id="price" min="0" required
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                                <p class="text-xs text-gray-500 mt-1">円</p>
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    表示名（オプション）
                                </label>
                                <input type="text" id="stockName" placeholder="例: バス座席"
                                    class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500">
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <button type="submit"
                                class="flex-1 bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition font-semibold">
                                <i class="fas fa-plus mr-2"></i>共有在庫を一括追加
                            </button>
                            <button type="button" onclick="document.getElementById('addSharedStockForm').reset()"
                                class="flex-1 bg-gray-300 text-gray-700 px-6 py-2 rounded-lg hover:bg-gray-400 transition font-semibold">
                                <i class="fas fa-redo mr-2"></i>リセット
                            </button>
                        </div>
                    </form>
                </div>

                <!-- 現在の共有在庫設定 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-4">
                        <i class="fas fa-list mr-2 text-blue-600"></i>設定済み共有在庫
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">プール名</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">日付</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">時間帯</th>
                                    <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase">料金</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">利用可能</th>
                                    <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase">表示名</th>
                                    <th class="px-4 py-3 text-center text-xs font-medium text-gray-500 uppercase">操作</th>
                                </tr>
                            </thead>
                            <tbody id="sharedStocksTable">
                                ${sharedStocksHtml}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            const optionId = ${optionId};

            // 共有在庫追加（期間一括登録）
            document.getElementById('addSharedStockForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const poolValue = document.getElementById('poolSelect').value;
                const [pool_name, pool_code] = poolValue.split('|');

                const data = {
                    pool_name,
                    pool_code: pool_code || null,
                    date_start: document.getElementById('dateStart').value,
                    date_end: document.getElementById('dateEnd').value,
                    price: parseInt(document.getElementById('price').value),
                    stock_name: document.getElementById('stockName').value || null
                };

                try {
                    const response = await axios.post(\`/api/options/\${optionId}/shared-stocks/batch\`, data);
                    alert(response.data.message || '共有在庫を追加しました');
                    window.location.reload();
                } catch (error) {
                    alert('追加に失敗しました: ' + (error.response?.data?.error || error.message));
                    console.error(error);
                }
            });

            // 共有在庫削除
            async function deleteSharedStock(linkId) {
                if (!confirm('この共有在庫設定を削除してもよろしいですか？')) return;

                try {
                    await axios.delete(\`/api/options/\${optionId}/shared-stocks/\${linkId}\`);
                    alert('共有在庫設定を削除しました');
                    window.location.reload();
                } catch (error) {
                    alert('削除に失敗しました');
                    console.error(error);
                }

        document.addEventListener('DOMContentLoaded', async () => {
            await loadOptionInfo();
            await loadStocks();
        });
    </script>
</body>
</html>
  `)
})


// API - イベント登録
// API: イベント作成
app.post('/api/events', requireAuth, async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.client_id || !data.customer_client_id || !data.contact) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントURL、開催期間、受付期間の必須チェック
    if (!data.event_url || !data.event_start_date || !data.event_end_date || !data.registration_start_date || !data.registration_end_date) {
      return c.json({ error: 'イベントURL、開催期間、受付期間は必須です' }, 400)
    }
    
    // イベントURLの一意性チェック
    const existingEvent = await DB.prepare(`
      SELECT id FROM events WHERE event_url = ?
    `).bind(data.event_url).first()
    
    if (existingEvent) {
      return c.json({ error: 'このイベントURLは既に使用されています' }, 400)
    }
    
    // コンビニ店舗を配列からJSONに変換
    const convenienceStores = data.convenience_stores ? JSON.stringify(data.convenience_stores) : null
    
    // イベントを登録（全項目対応）
    const result = await DB.prepare(`
      INSERT INTO events (
        name, detail, location, contact, remarks, thanks_msg,
        name_en, detail_en, location_en, contact_en, remarks_en, thanks_msg_en,
        organizer_id, client_id, customer_client_id, vendor_id, enable_flg,
        event_url, category, date_selection_type,
        event_type, parent_event_id,
        event_start_date, event_end_date,
        registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, admin_cc_email, sender_name, sender_email,
        email_signature, email_signature_en,
        payment_flg, payment_methods, payment_credit_card, payment_bank_transfer, payment_convenience_store,
        bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name,
        store_code, bank_transfer_deadline, convenience_payment_deadline,
        available_convenience_stores,
        credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        cancel_policy, cancellation_policy_details,
        cancellation_days_1, cancellation_rate_1,
        cancellation_days_2, cancellation_rate_2,
        form_field_settings,
        auto_reply_enabled,
        auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en,
        image_url
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.detail || '',
      data.location || null,
      data.contact,
      data.remarks || '',
      data.thanks_msg || '',
      data.name_en || null,
      data.detail_en || null,
      data.location_en || null,
      data.contact_en || null,
      data.remarks_en || null,
      data.thanks_msg_en || null,
      data.client_id ? parseInt(data.client_id) : null, // organizer_id
      data.customer_client_id ? parseInt(data.customer_client_id) : parseInt(data.client_id), // client_id
      data.customer_client_id ? parseInt(data.customer_client_id) : null,
      data.vendor_id ? parseInt(data.vendor_id) : null,
      parseInt(data.enable_flg) || 1,
      data.event_url || null,
      data.category || null,
      data.date_selection_type || 'button',
      data.event_type || 'standalone',
      data.parent_event_id ? parseInt(data.parent_event_id) : null,
      data.event_start_date || null,
      data.event_end_date || null,
      data.registration_start_date || null,
      data.registration_end_date || null,
      data.admin_login_start_date || null,
      data.admin_login_end_date || null,
      data.admin_email || null,
      data.admin_cc_email || null,
      data.sender_name || null,
      data.sender_email || null,
      data.email_signature || null,
      data.email_signature_en || null,
      parseInt(data.payment_flg) || 0,
      parseInt(data.payment_methods) || 0,
      data.payment_credit_card ? 1 : 0,
      data.payment_bank_transfer ? 1 : 0,
      data.payment_convenience_store ? 1 : 0,
      data.bank_name || null,
      data.bank_branch || null,
      data.bank_account_type || null,
      data.bank_account_number || null,
      data.bank_account_name || null,
      data.store_code || null,
      parseInt(data.bank_transfer_deadline) || 7,
      parseInt(data.convenience_payment_deadline) || 7,
      convenienceStores,
      data.credit_fee_type || 'none',
      parseFloat(data.credit_fee_percentage) || 0,
      parseInt(data.credit_fee_fixed) || 0,
      data.bank_fee_type || 'none',
      parseFloat(data.bank_fee_percentage) || 0,
      parseInt(data.bank_fee_fixed) || 0,
      data.convenience_fee_type || 'none',
      parseFloat(data.convenience_fee_percentage) || 0,
      parseInt(data.convenience_fee_fixed) || 0,
      data.cancel_policy || null,
      data.cancellation_policy_details || null,
      parseInt(data.cancellation_days_1) || null,
      parseInt(data.cancellation_rate_1) || null,
      parseInt(data.cancellation_days_2) || null,
      parseInt(data.cancellation_rate_2) || null,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}',
      data.auto_reply_enabled ? 1 : 0,
      data.auto_reply_credit_payment || null,
      data.auto_reply_bank_payment || null,
      data.auto_reply_convenience_payment || null,
      data.auto_reply_credit_cancel || null,
      data.auto_reply_bank_cancel || null,
      data.auto_reply_convenience_cancel || null,
      data.auto_reply_credit_refund || null,
      data.auto_reply_bank_deposit || null,
      data.auto_reply_bank_refund || null,
      data.auto_reply_convenience_deposit || null,
      data.auto_reply_convenience_refund || null,
      data.auto_reply_credit_payment_en || null,
      data.auto_reply_bank_payment_en || null,
      data.auto_reply_convenience_payment_en || null,
      data.auto_reply_credit_cancel_en || null,
      data.auto_reply_bank_cancel_en || null,
      data.auto_reply_convenience_cancel_en || null,
      data.auto_reply_credit_refund_en || null,
      data.auto_reply_bank_deposit_en || null,
      data.auto_reply_bank_refund_en || null,
      data.auto_reply_convenience_deposit_en || null,
      data.auto_reply_convenience_refund_en || null,
      data.image_url || null
    ).run()
    
    return c.json({ 
      success: true, 
      event: { id: result.meta.last_row_id },
      message: 'イベントを登録しました' 
    })
  } catch (error) {
    console.error('Event registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - イベント更新
// API: イベント更新
// 支店管理者は enable_flg（公開設定）の変更不可
app.put('/api/events/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const account = c.get('account')
  
  try {
    const data = await c.req.json()
    console.log('イベント更新リクエスト - Event ID:', eventId)
    console.log('リクエストデータ:', JSON.stringify(data, null, 2))
    
    // 支店管理者は enable_flg（公開設定）の変更不可
    if (account.role === 'branch' && 'enable_flg' in data) {
      // 現在の enable_flg を取得
      const currentEvent = await DB.prepare('SELECT enable_flg FROM events WHERE id = ?').bind(eventId).first()
      if (currentEvent && currentEvent.enable_flg !== data.enable_flg) {
        return c.json({ error: '公開設定の変更権限がありません' }, 403)
      }
    }
    
    // 必須フィールドチェック
    if (!data.name || !data.contact) {
      console.error('必須フィールドエラー - name:', data.name, 'contact:', data.contact)
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントURL、開催期間、受付期間の必須チェック
    if (!data.event_url || !data.event_start_date || !data.event_end_date || !data.registration_start_date || !data.registration_end_date) {
      console.error('必須フィールドエラー:', {
        event_url: data.event_url,
        event_start_date: data.event_start_date,
        event_end_date: data.event_end_date,
        registration_start_date: data.registration_start_date,
        registration_end_date: data.registration_end_date
      })
      return c.json({ error: 'イベントURL、開催期間、受付期間は必須です' }, 400)
    }
    
    // イベントURLの一意性チェック（自分以外のイベントで同じURLが使われていないか確認）
    const existingEvent = await DB.prepare(`
      SELECT id FROM events WHERE event_url = ? AND id != ?
    `).bind(data.event_url, eventId).first()
    
    if (existingEvent) {
      return c.json({ error: 'このイベントURLは既に使用されています' }, 400)
    }
    
    // コンビニ店舗を配列からJSONに変換
    console.log('convenience_stores受信:', data.convenience_stores, typeof data.convenience_stores)
    let convenienceStores = null
    if (data.convenience_stores) {
      if (typeof data.convenience_stores === 'string') {
        // 文字列の場合はそのまま使用
        convenienceStores = data.convenience_stores
      } else if (Array.isArray(data.convenience_stores)) {
        // 配列の場合はJSON化
        convenienceStores = JSON.stringify(data.convenience_stores)
      }
    }
    console.log('convenience_stores変換後:', convenienceStores)
    
    // イベントを更新（全項目対応）
    const result = await DB.prepare(`
      UPDATE events
      SET name = ?,
          detail = ?,
          location = ?,
          contact = ?,
          remarks = ?,
          thanks_msg = ?,
          name_en = ?,
          detail_en = ?,
          location_en = ?,
          contact_en = ?,
          remarks_en = ?,
          thanks_msg_en = ?,
          enable_flg = ?,
          payment_flg = ?,
          payment_methods = ?,
          payment_credit_card = ?,
          payment_bank_transfer = ?,
          payment_convenience_store = ?,
          event_url = ?,
          category = ?,
          date_selection_type = ?,
          event_type = ?,
          parent_event_id = ?,
          event_start_date = ?,
          event_end_date = ?,
          registration_start_date = ?,
          registration_end_date = ?,
          admin_login_start_date = ?,
          admin_login_end_date = ?,
          admin_email = ?,
          admin_cc_email = ?,
          sender_name = ?,
          sender_email = ?,
          email_signature = ?,
          email_signature_en = ?,
          customer_client_id = ?,
          client_id = ?,
          organizer_id = ?,
          vendor_id = ?,
          bank_name = ?,
          bank_branch = ?,
          bank_account_type = ?,
          bank_account_number = ?,
          bank_account_name = ?,
          store_code = ?,
          bank_transfer_deadline = ?,
          convenience_payment_deadline = ?,
          available_convenience_stores = ?,
          credit_fee_type = ?,
          credit_fee_percentage = ?,
          credit_fee_fixed = ?,
          bank_fee_type = ?,
          bank_fee_percentage = ?,
          bank_fee_fixed = ?,
          convenience_fee_type = ?,
          convenience_fee_percentage = ?,
          convenience_fee_fixed = ?,
          cancel_policy = ?,
          cancellation_policy_details = ?,
          cancellation_days_1 = ?,
          cancellation_rate_1 = ?,
          cancellation_days_2 = ?,
          cancellation_rate_2 = ?,
          form_field_settings = ?,
          auto_reply_enabled = ?,
          auto_reply_credit_payment = ?,
          auto_reply_bank_payment = ?,
          auto_reply_convenience_payment = ?,
          auto_reply_credit_cancel = ?,
          auto_reply_bank_cancel = ?,
          auto_reply_convenience_cancel = ?,
          auto_reply_credit_refund = ?,
          auto_reply_bank_deposit = ?,
          auto_reply_bank_refund = ?,
          auto_reply_convenience_deposit = ?,
          auto_reply_convenience_refund = ?,
          auto_reply_credit_payment_en = ?,
          auto_reply_bank_payment_en = ?,
          auto_reply_convenience_payment_en = ?,
          auto_reply_credit_cancel_en = ?,
          auto_reply_bank_cancel_en = ?,
          auto_reply_convenience_cancel_en = ?,
          auto_reply_credit_refund_en = ?,
          auto_reply_bank_deposit_en = ?,
          auto_reply_bank_refund_en = ?,
          auto_reply_convenience_deposit_en = ?,
          auto_reply_convenience_refund_en = ?,
          image_url = ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.name,
      data.detail || '',
      data.location || null,
      data.contact,
      data.remarks || '',
      data.thanks_msg || '',
      data.name_en || null,
      data.detail_en || null,
      data.location_en || null,
      data.contact_en || null,
      data.remarks_en || null,
      data.thanks_msg_en || null,
      parseInt(data.enable_flg) || 1,
      parseInt(data.payment_flg) || 0,
      parseInt(data.payment_methods) || 0,
      data.payment_credit_card ? 1 : 0,
      data.payment_bank_transfer ? 1 : 0,
      data.payment_convenience_store ? 1 : 0,
      data.event_url || null,
      data.category || null,
      data.date_selection_type || 'button',
      data.event_type || 'standalone',
      data.parent_event_id ? parseInt(data.parent_event_id) : null,
      data.event_start_date || null,
      data.event_end_date || null,
      data.registration_start_date || null,
      data.registration_end_date || null,
      data.admin_login_start_date || null,
      data.admin_login_end_date || null,
      data.admin_email || null,
      data.admin_cc_email || null,
      data.sender_name || null,
      data.sender_email || null,
      data.email_signature || null,
      data.email_signature_en || null,
      data.customer_client_id ? parseInt(data.customer_client_id) : null,
      data.client_id ? parseInt(data.client_id) : null,
      data.organizer_id ? parseInt(data.organizer_id) : null,
      data.vendor_id ? parseInt(data.vendor_id) : null,
      data.bank_name || null,
      data.bank_branch || null,
      data.bank_account_type || null,
      data.bank_account_number || null,
      data.bank_account_name || null,
      data.store_code || null,
      parseInt(data.bank_transfer_deadline) || 7,
      parseInt(data.convenience_payment_deadline) || 7,
      convenienceStores,
      data.credit_fee_type || 'none',
      parseFloat(data.credit_fee_percentage) || 0,
      parseInt(data.credit_fee_fixed) || 0,
      data.bank_fee_type || 'none',
      parseFloat(data.bank_fee_percentage) || 0,
      parseInt(data.bank_fee_fixed) || 0,
      data.convenience_fee_type || 'none',
      parseFloat(data.convenience_fee_percentage) || 0,
      parseInt(data.convenience_fee_fixed) || 0,
      data.cancel_policy || null,
      data.cancellation_policy_details || null,
      parseInt(data.cancellation_days_1) || null,
      parseInt(data.cancellation_rate_1) || null,
      parseInt(data.cancellation_days_2) || null,
      parseInt(data.cancellation_rate_2) || null,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}',
      data.auto_reply_enabled ? 1 : 0,
      data.auto_reply_credit_payment || null,
      data.auto_reply_bank_payment || null,
      data.auto_reply_convenience_payment || null,
      data.auto_reply_credit_cancel || null,
      data.auto_reply_bank_cancel || null,
      data.auto_reply_convenience_cancel || null,
      data.auto_reply_credit_refund || null,
      data.auto_reply_bank_deposit || null,
      data.auto_reply_bank_refund || null,
      data.auto_reply_convenience_deposit || null,
      data.auto_reply_convenience_refund || null,
      data.auto_reply_credit_payment_en || null,
      data.auto_reply_bank_payment_en || null,
      data.auto_reply_convenience_payment_en || null,
      data.auto_reply_credit_cancel_en || null,
      data.auto_reply_bank_cancel_en || null,
      data.auto_reply_convenience_cancel_en || null,
      data.auto_reply_credit_refund_en || null,
      data.auto_reply_bank_deposit_en || null,
      data.auto_reply_bank_refund_en || null,
      data.auto_reply_convenience_deposit_en || null,
      data.auto_reply_convenience_refund_en || null,
      data.image_url || null,
      eventId
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    return c.json({ 
      success: true,
      message: 'イベントを更新しました',
      event: { id: parseInt(eventId) }
    })
  } catch (error) {
    console.error('Event update error:', error)
    console.error('Error message:', error.message)
    console.error('Error stack:', error.stack)
    return c.json({ error: error.message || 'イベント更新に失敗しました' }, 500)
  }
})

// API - オプション在庫の追加（期間一括登録）
// API: オプション在庫一覧取得
app.get('/api/options/:id/stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')

  try {
    const { results: stocks } = await DB.prepare(`
      SELECT 
        id,
        option_id,
        date,
        stock_name,
        price,
        total_stock,
        booked,
        available_stock,
        enable_flg,
        created_at,
        modified_at
      FROM option_stocks
      WHERE option_id = ? AND enable_flg = 1
      ORDER BY date ASC
    `).bind(optionId).all()

    return c.json(stocks)
  } catch (error) {
    console.error('Error fetching option stocks:', error)
    return c.json({ error: 'Failed to fetch stocks' }, 500)
  }
})

app.post('/api/options/:id/stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  try {
    const { dateStart, dateEnd, stockName, price, totalStock } = await c.req.json()

    if (!dateStart || !dateEnd || price === undefined || totalStock === undefined) {
      return c.json({ success: false, message: '必須項目が不足しています' }, 400)
    }

    const start = new Date(dateStart)
    const end = new Date(dateEnd)

    if (start > end) {
      return c.json({ success: false, message: '開始日は終了日より前の日付を指定してください' }, 400)
    }

    // 日付ごとにループして登録
    let insertCount = 0
    for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
      const dateStr = d.toISOString().split('T')[0]

      // 重複チェック
      const { results: existing } = await DB.prepare(`
        SELECT id FROM option_stocks 
        WHERE option_id = ? AND date = ? AND stock_name IS ?
      `).bind(optionId, dateStr, stockName || null).all()

      if (existing.length > 0) {
        continue // 既存の在庫がある場合はスキップ
      }

      // 在庫を登録
      await DB.prepare(`
        INSERT INTO option_stocks (option_id, date, stock_name, price, total_stock, booked, available_stock, enable_flg)
        VALUES (?, ?, ?, ?, ?, 0, ?, 1)
      `).bind(optionId, dateStr, stockName || null, price, totalStock, totalStock).run()

      insertCount++
    }

    return c.json({ success: true, message: `${insertCount}件の在庫を登録しました`, count: insertCount })
  } catch (error: any) {
    console.error('在庫追加エラー:', error)
    return c.json({ success: false, message: error.message }, 500)
  }
})

// API - オプション在庫の削除
app.delete('/api/options/:id/stocks/:stockId', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('stockId')
  
  try {
    // enable_flgを0に設定（論理削除）
    await DB.prepare(`
      UPDATE option_stocks SET enable_flg = 0, modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(stockId).run()

    return c.json({ success: true, message: '在庫を削除しました' })
  } catch (error: any) {
    console.error('在庫削除エラー:', error)
    return c.json({ success: false, message: error.message }, 500)
  }
})

// API: オプション在庫の更新
app.put('/api/options/:id/stocks/:stockId', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('stockId')
  
  try {
    const { date, stock_name, price, total_stock } = await c.req.json()
    
    if (!date || total_stock === undefined) {
      return c.json({ success: false, message: '必須項目が不足しています' }, 400)
    }

    // available_stockを再計算
    const { results: existing } = await DB.prepare(`
      SELECT booked FROM option_stocks WHERE id = ?
    `).bind(stockId).all()

    if (existing.length === 0) {
      return c.json({ success: false, message: '在庫が見つかりません' }, 404)
    }

    const booked = existing[0].booked || 0
    const available_stock = total_stock - booked

    await DB.prepare(`
      UPDATE option_stocks 
      SET date = ?, stock_name = ?, price = ?, total_stock = ?, available_stock = ?, 
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(date, stock_name || null, price, total_stock, available_stock, stockId).run()

    return c.json({ success: true, message: '在庫を更新しました' })
  } catch (error: any) {
    console.error('在庫更新エラー:', error)
    return c.json({ success: false, message: error.message }, 500)
  }
})

// API - CSV出力（予約データ）
// 支店管理者は担当イベントのみ
app.get('/api/bookings/export/csv', requireAuth, async (c) => {
  const { DB } = c.env
  const account = c.get('account')
  
  try {
    const eventId = c.req.query('event_id')
    
    // 支店管理者の場合、担当イベントチェック
    if (account.role === 'branch') {
      if (!eventId) {
        return c.json({ error: 'イベントIDが必要です' }, 400)
      }
      const assignedEventIds = await getAssignedEventIds(DB, account.id)
      if (!assignedEventIds.includes(parseInt(eventId))) {
        return c.json({ error: 'このイベントへのアクセス権限がありません' }, 403)
      }
    }
    
    let query = `
      SELECT 
        pb.id as booking_id,
        e.name as event_name,
        p.name as product_name,
        ps.date as booking_date,
        ps.stock_name,
        c.family_name,
        c.first_name,
        c.email,
        c.tel,
        pb.quantity,
        pb.price,
        (pb.quantity * pb.price) as total_price,
        pb.enable_flg,
        pb.created_at
      FROM product_bookings pb
      JOIN members c ON pb.member_id = c.id
      JOIN products p ON pb.product_id = p.id
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
      WHERE pb.enable_flg = 1
    `
    
    const params = []
    if (eventId) {
      query += ` AND e.id = ?`
      params.push(parseInt(eventId))
    }
    
    query += ` ORDER BY pb.created_at DESC`
    
    const stmt = DB.prepare(query)
    const { results: bookings } = params.length > 0 ? await stmt.bind(...params).all() : await stmt.all()
    
    // CSV形式に変換
    let csv = '\uFEFF' // UTF-8 BOM for Excel
    csv += '予約ID,イベント名,商品名,予約日,時間帯,姓,名,メールアドレス,電話番号,数量,単価,合計金額,ステータス,予約日時\n'
    
    bookings.forEach(booking => {
      csv += [
        booking.booking_id,
        `"${booking.event_name}"`,
        `"${booking.product_name}"`,
        booking.booking_date || '',
        `"${booking.stock_name || ''}"`,
        `"${booking.family_name}"`,
        `"${booking.first_name}"`,
        booking.email,
        booking.tel,
        booking.quantity,
        booking.price,
        booking.total_price,
        booking.enable_flg === 1 ? '有効' : 'キャンセル',
        booking.created_at
      ].join(',') + '\n'
    })
    
    return new Response(csv, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename="bookings_${new Date().toISOString().slice(0, 10)}.csv"`
      }
    })
  } catch (error) {
    console.error('CSV export error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - レポート（売上集計）
app.get('/api/reports/sales', async (c) => {
  const { DB } = c.env
  
  try {
    const eventId = c.req.query('event_id')
    
    // イベント別売上集計
    let eventSalesQuery = `
      SELECT 
        e.id as event_id,
        e.name as event_name,
        COUNT(DISTINCT pb.id) as total_bookings,
        SUM(pb.quantity) as total_quantity,
        SUM(pb.quantity * pb.price) as total_sales
      FROM events e
      LEFT JOIN products p ON e.id = p.event_id
      LEFT JOIN product_bookings pb ON p.id = pb.product_id AND pb.enable_flg = 1
    `
    
    const eventParams = []
    if (eventId) {
      eventSalesQuery += ` WHERE e.id = ?`
      eventParams.push(parseInt(eventId))
    }
    
    eventSalesQuery += ` GROUP BY e.id, e.name ORDER BY total_sales DESC`
    
    const eventStmt = DB.prepare(eventSalesQuery)
    const { results: eventSales } = eventParams.length > 0 ? await eventStmt.bind(...eventParams).all() : await eventStmt.all()
    
    // 商品別売上集計
    let productSalesQuery = `
      SELECT 
        p.id as product_id,
        p.name as product_name,
        e.name as event_name,
        COUNT(pb.id) as total_bookings,
        SUM(pb.quantity) as total_quantity,
        SUM(pb.quantity * pb.price) as total_sales
      FROM products p
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_bookings pb ON p.id = pb.product_id AND pb.enable_flg = 1
    `
    
    const productParams = []
    if (eventId) {
      productSalesQuery += ` WHERE e.id = ?`
      productParams.push(parseInt(eventId))
    }
    
    productSalesQuery += ` GROUP BY p.id, p.name, e.name ORDER BY total_sales DESC`
    
    const productStmt = DB.prepare(productSalesQuery)
    const { results: productSales } = productParams.length > 0 ? await productStmt.bind(...productParams).all() : await productStmt.all()
    
    // オプション別売上集計
    let optionSalesQuery = `
      SELECT 
        o.id as option_id,
        o.name as option_name,
        e.name as event_name,
        COUNT(ob.id) as total_bookings,
        SUM(ob.quantity) as total_quantity,
        SUM(ob.quantity * ob.price) as total_sales
      FROM options o
      JOIN events e ON o.event_id = e.id
      LEFT JOIN option_bookings ob ON o.id = ob.option_id AND ob.enable_flg = 1
    `
    
    const optionParams = []
    if (eventId) {
      optionSalesQuery += ` WHERE e.id = ?`
      optionParams.push(parseInt(eventId))
    }
    
    optionSalesQuery += ` GROUP BY o.id, o.name, e.name ORDER BY total_sales DESC`
    
    const optionStmt = DB.prepare(optionSalesQuery)
    const { results: optionSales } = optionParams.length > 0 ? await optionStmt.bind(...optionParams).all() : await optionStmt.all()
    
    return c.json({
      success: true,
      eventSales,
      productSales,
      optionSales
    })
  } catch (error) {
    console.error('Sales report error:', error)
    return c.json({ error: error.message }, 500)
  }
})

