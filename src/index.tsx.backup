                            </div>
                            <div class="text-right">
                                <p class="text-sm text-gray-600">数量: ${booking.quantity}</p>
                                <p class="text-lg font-bold text-gray-800">¥${(booking.price * booking.quantity).toLocaleString()}</p>
                            </div>
                        </div>
                    </div>
                    `).join('')}
                    
                    <div class="mt-6 pt-4 border-t-2 border-gray-300">
                        <div class="flex justify-between items-center">
                            <span class="text-xl font-bold text-gray-800">合計金額</span>
                            <span class="text-2xl font-bold text-blue-600">¥${totalAmount.toLocaleString()}</span>
                        </div>
                    </div>
                </div>

                <!-- お客様情報 -->
                ${customer ? `
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-user text-blue-600"></i>
                        お客様情報
                    </h3>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">お名前</p>
                            <p class="font-semibold text-gray-800">${customer.family_name} ${customer.first_name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">フリガナ</p>
                            <p class="font-semibold text-gray-800">${customer.family_kana || ''} ${customer.first_kana || ''}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">メールアドレス</p>
                            <p class="font-semibold text-gray-800">${customer.email}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">電話番号</p>
                            <p class="font-semibold text-gray-800">${customer.tel}</p>
                        </div>
                    </div>
                </div>
                ` : ''}

                <!-- 注意事項 -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-6">
                    <h3 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-exclamation-triangle text-yellow-600"></i>
                        ご確認ください
                    </h3>
                    <ul class="list-disc list-inside space-y-2 text-gray-700">
                        <li>予約確認メールをご確認ください</li>
                        <li>当日は予約番号をお控えの上、ご来場ください</li>
                        <li>キャンセル・変更については、お問い合わせください</li>
                    </ul>
                </div>

                <!-- アクションボタン -->
                <div class="flex gap-4">
                    <a href="/events/${eventId}" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg text-center transition">
                        <i class="fas fa-arrow-left mr-2"></i>
                        イベント詳細に戻る
                    </a>
                    <a href="/events" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-bold py-3 px-6 rounded-lg text-center transition">
                        <i class="fas fa-list mr-2"></i>
                        イベント一覧を見る
                    </a>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2025 イベント予約管理システム</p>
            </div>
        </footer>
    </body>
    </html>
  `)
})

// マイページ - メールアドレス入力画面（予約フローのauth-emailと統合）
app.get('/mypage', (c) => {
  // 予約フローと同じauth-email.htmlを使用（完全共通化）
  // クエリパラメータで次の遷移先を /mypage/bookings に指定
  const url = new URL(c.req.url)
  url.searchParams.set('next', '/mypage/bookings')
  
  // auth-email.htmlにリダイレクト
  return c.redirect(`/auth-email?next=/mypage/bookings`)
})

// マイページ - OTP検証画面
app.get('/mypage/bookings', async (c) => {
  const { DB } = c.env
  
  try {
    console.log('🔍 [Mypage] Starting mypage/bookings request')
    
    // セッショントークンを確認
    const sessionToken = getCookie(c, 'mypage_session_token')
    console.log('🔍 [Mypage] Session token:', sessionToken ? 'exists' : 'missing')
    
    if (!sessionToken) {
      console.log('🔍 [Mypage] Redirecting to /mypage (no session token)')
      return c.redirect('/mypage')
    }
    
    console.log('🔍 [Mypage] Querying otp_codes table')
    // セッショントークンからメールアドレスを取得
    const otpRecord = await DB.prepare(`
      SELECT email, used_at FROM otp_codes 
      WHERE session_token = ? AND is_used = 1
      ORDER BY used_at DESC
      LIMIT 1
    `).bind(sessionToken).first()
    
    console.log('🔍 [Mypage] OTP record:', otpRecord ? 'found' : 'not found')
    
    if (!otpRecord) {
      console.log('🔍 [Mypage] Redirecting to /mypage (no OTP record)')
      return c.redirect('/mypage')
    }
    
    // セッショントークンの有効期限確認（24時間）
    const usedAt = new Date(otpRecord.used_at)
    const now = new Date()
    const diffHours = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    console.log('🔍 [Mypage] Session age (hours):', diffHours)
    
    if (diffHours > 24) {
      console.log('🔍 [Mypage] Redirecting to /mypage (session expired)')
      return c.redirect('/mypage')
    }
    
    const email = otpRecord.email
    console.log('🔍 [Mypage] Email:', email)

  // 顧客情報取得
  console.log('🔍 [Mypage] Querying members table')
  const customer = await DB.prepare(`
    SELECT * FROM members WHERE email = ?
  `).bind(email).first()
  
  console.log('🔍 [Mypage] Customer:', customer ? `found (id: ${customer.id})` : 'not found')

  if (!customer) {
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>予約が見つかりません | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
      </head>
      <body class="bg-gray-50 min-h-screen">
          <header class="bg-indigo-600 text-white shadow-lg">
              <div class="container mx-auto px-4 py-6">
                  <h1 class="text-3xl font-bold flex items-center gap-3">
                      <i class="fas fa-user-circle"></i>
                      マイページ
                  </h1>
              </div>
          </header>

          <nav class="bg-white shadow-md border-b">
              <div class="container mx-auto px-4">
                  <ul class="flex gap-6 py-4">
                      <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-home"></i>トップページ
                      </a></li>
                      <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                          <i class="fas fa-calendar-alt"></i>イベント一覧
                      </a></li>
                      <li><a href="/mypage" class="text-indigo-600 font-semibold flex items-center gap-2">
                          <i class="fas fa-user-circle"></i>マイページ
                      </a></li>
                  </ul>
              </div>
          </nav>

          <main class="container mx-auto px-4 py-8">
              <div class="max-w-2xl mx-auto">
                  <div class="bg-yellow-50 border-2 border-yellow-400 rounded-lg p-8 text-center">
                      <div class="text-yellow-600 mb-4">
                          <i class="fas fa-exclamation-triangle text-6xl"></i>
                      </div>
                      <h2 class="text-2xl font-bold text-gray-800 mb-4">予約が見つかりません</h2>
                      <p class="text-gray-600 mb-6">
                          入力されたメールアドレス「${email}」での予約は見つかりませんでした。<br>
                          メールアドレスをご確認の上、再度お試しください。
                      </p>
                      <a href="/mypage" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                          <i class="fas fa-arrow-left mr-2"></i>
                          戻る
                      </a>
                  </div>
              </div>
          </main>

          <footer class="bg-gray-800 text-white mt-12">
              <div class="container mx-auto px-4 py-6 text-center">
                  <p>&copy; 2025 イベント予約管理システム</p>
              </div>
          </footer>
      </body>
      </html>
    `)
  }

  // 予約情報を取得（予約番号ごとに集約）
  console.log('🔍 [Mypage] Querying bookings for customer ID:', customer.id)
  
  let bookings = []
  try {
    // 予約一覧を取得（支払い情報も含む）
    const bookingResult = await DB.prepare(`
      SELECT 
        b.id,
        b.booking_number,
        b.event_id,
        b.status,
        b.created_at,
        e.name as event_name,
        bp.payment_status,
        bp.amount as payment_amount,
        bp.payment_method
      FROM bookings b
      JOIN events e ON b.event_id = e.id
      LEFT JOIN booking_payments bp ON b.booking_number = bp.booking_number
      WHERE b.member_id = ?
      ORDER BY b.created_at DESC
    `).bind(customer.id).all()
    
    const rawBookings = bookingResult.results || []
    console.log('🔍 [Mypage] Found bookings:', rawBookings.length)
    
    // 各予約の詳細を取得
    for (const booking of rawBookings) {
      // 商品明細の合計金額を計算（支払い情報がない場合のフォールバック）
      const itemsResult = await DB.prepare(`
        SELECT 
          SUM(quantity * unit_price) as total_amount
        FROM booking_items
        WHERE booking_id = ?
      `).bind(booking.id).first()
      
      // 参加日を取得（booking_itemsのstock_idからproduct_stocksテーブルを参照）
      const dateResult = await DB.prepare(`
        SELECT ps.date
        FROM booking_items bi
        LEFT JOIN product_stocks ps ON bi.stock_id = ps.id
        WHERE bi.booking_id = ? AND ps.date IS NOT NULL
        ORDER BY ps.date ASC
        LIMIT 1
      `).bind(booking.id).first()
      
      bookings.push({
        booking_id: booking.id,
        booking_number: booking.booking_number,
        event_id: booking.event_id,
        event_name: booking.event_name,
        status: booking.status,
        payment_status: booking.payment_status || 'pending',
        payment_amount: booking.payment_amount || itemsResult?.total_amount || 0,
        participation_date: dateResult?.date || null,
        created_at: booking.created_at
      })
    }
    
    console.log('🔍 [Mypage] Total bookings:', bookings.length)
  } catch (dbError) {
    console.error('❌ [Mypage] Database query error:', dbError)
    throw new Error(`Database query failed: ${dbError.message}`)
  }

  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約履歴 | マイページ</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-50 min-h-screen">
        <header class="bg-indigo-600 text-white shadow-lg">
            <div class="container mx-auto px-4 py-6">
                <h1 class="text-3xl font-bold flex items-center gap-3">
                    <i class="fas fa-user-circle"></i>
                    マイページ
                </h1>
                <p class="text-indigo-100 mt-2">ようこそ、${customer.family_name} ${customer.first_name} 様</p>
            </div>
        </header>

        <nav class="bg-white shadow-md border-b">
            <div class="container mx-auto px-4">
                <div class="flex justify-between items-center py-4">
                    <ul class="flex gap-6">
                        <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                            <i class="fas fa-home"></i>トップページ
                        </a></li>
                        <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                            <i class="fas fa-calendar-alt"></i>イベント一覧
                        </a></li>
                        <li><a href="/mypage" class="text-indigo-600 font-semibold flex items-center gap-2">
                            <i class="fas fa-user-circle"></i>マイページ
                        </a></li>
                    </ul>
                    <button id="logoutBtn" class="text-red-600 hover:text-red-800 font-semibold flex items-center gap-2">
                        <i class="fas fa-sign-out-alt"></i>ログアウト
                    </button>
                </div>
            </div>
        </nav>

        <main class="container mx-auto px-4 py-8">
            <div class="max-w-6xl mx-auto">
                <!-- お客様情報 -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-id-card text-indigo-600"></i>
                        お客様情報
                    </h2>
                    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div>
                            <p class="text-sm text-gray-600">お名前</p>
                            <p class="font-semibold text-gray-800">${customer.family_name} ${customer.first_name}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">フリガナ</p>
                            <p class="font-semibold text-gray-800">${customer.family_kana || ''} ${customer.first_kana || ''}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">メールアドレス</p>
                            <p class="font-semibold text-gray-800">${customer.email}</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-600">電話番号</p>
                            <p class="font-semibold text-gray-800">${customer.tel}</p>
                        </div>
                    </div>
                </div>

                <!-- 予約履歴 -->
                <div class="bg-white rounded-lg shadow-md p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
                        <i class="fas fa-history text-indigo-600"></i>
                        予約履歴（全${bookings.length}件）
                    </h2>

                    ${bookings.length === 0 ? `
                        <div class="text-center py-12">
                            <div class="text-gray-400 mb-4">
                                <i class="fas fa-inbox text-6xl"></i>
                            </div>
                            <p class="text-gray-600 text-lg">予約履歴はありません</p>
                        </div>
                    ` : `
                        <div class="space-y-4">
                            ${bookings.map(booking => `
                                <div class="border-2 border-gray-200 rounded-lg p-4 hover:border-indigo-300 hover:shadow-md transition">
                                    <!-- 予約番号とステータス -->
                                    <div class="flex items-center justify-between mb-3 pb-3 border-b border-gray-200">
                                        <div class="flex items-center gap-3">
                                            <span class="text-lg font-bold text-gray-900">
                                                <i class="fas fa-ticket-alt text-indigo-600 mr-2"></i>
                                                ${booking.booking_number}
                                            </span>
                                            ${booking.status === 'active' ? `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                                    <i class="fas fa-check-circle mr-1"></i> 予約確定
                                                </span>
                                            ` : booking.status === 'cancelled' ? `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                                    <i class="fas fa-times-circle mr-1"></i> キャンセル
                                                </span>
                                            ` : `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                                                    ${booking.status}
                                                </span>
                                            `}
                                        </div>
                                        <a href="/mypage/booking/${booking.booking_id}" 
                                           class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-4 rounded-lg transition flex items-center gap-2">
                                            <i class="fas fa-info-circle"></i> 詳細を見る
                                        </a>
                                    </div>
                                    
                                    <!-- 予約情報グリッド -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                                        <!-- イベント名 -->
                                        <div>
                                            <p class="text-xs text-gray-500 mb-1">イベント名</p>
                                            <p class="font-semibold text-gray-900">${booking.event_name}</p>
                                        </div>
                                        
                                        <!-- 参加日 -->
                                        <div>
                                            <p class="text-xs text-gray-500 mb-1">参加日</p>
                                            <p class="font-semibold text-gray-900">
                                                <i class="fas fa-calendar-alt text-blue-600 mr-1"></i>
                                                ${booking.participation_date ? new Date(booking.participation_date + 'T00:00:00').toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }) : '-'}
                                            </p>
                                        </div>
                                        
                                        <!-- 金額 -->
                                        <div>
                                            <p class="text-xs text-gray-500 mb-1">金額</p>
                                            <p class="text-lg font-bold text-indigo-600">
                                                ¥${booking.payment_amount.toLocaleString()}
                                            </p>
                                        </div>
                                        
                                        <!-- 支払いステータス -->
                                        <div>
                                            <p class="text-xs text-gray-500 mb-1">支払いステータス</p>
                                            ${booking.payment_status === 'completed' ? `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 inline-block">
                                                    <i class="fas fa-check mr-1"></i> 支払済み
                                                </span>
                                            ` : booking.payment_status === 'pending' ? `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800 inline-block">
                                                    <i class="fas fa-clock mr-1"></i> 未払い
                                                </span>
                                            ` : booking.payment_status === 'failed' ? `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800 inline-block">
                                                    <i class="fas fa-exclamation-circle mr-1"></i> 失敗
                                                </span>
                                            ` : `
                                                <span class="px-3 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800 inline-block">
                                                    ${booking.payment_status}
                                                </span>
                                            `}
                                        </div>
                                    </div>
                                    
                                    <!-- 予約日時 -->
                                    <div class="mt-3 pt-3 border-t border-gray-200">
                                        <p class="text-xs text-gray-500">
                                            <i class="fas fa-clock mr-1"></i>
                                            予約日時: ${new Date(booking.created_at).toLocaleString('ja-JP')}
                                        </p>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    `}
                </div>

                <!-- お問い合わせ情報 -->
                <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-question-circle text-blue-600"></i>
                        予約に関するお問い合わせ
                    </h3>
                    <p class="text-sm text-gray-700 mb-3">
                        予約内容の変更やキャンセルをご希望の場合は、各イベントの主催者までお問い合わせください。
                    </p>
                    <div class="flex gap-4">
                        <a href="/mypage" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                            <i class="fas fa-arrow-left mr-2"></i>
                            別のメールアドレスで検索
                        </a>
                        <a href="/events" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold py-2 px-6 rounded-lg transition">
                            <i class="fas fa-list mr-2"></i>
                            イベント一覧
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <footer class="bg-gray-800 text-white mt-12">
            <div class="container mx-auto px-4 py-6 text-center">
                <p>&copy; 2026 イベント予約管理システム</p>
            </div>
        </footer>
        
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // ログアウトボタン
            document.getElementById('logoutBtn').addEventListener('click', async () => {
                if (!confirm('ログアウトしますか？')) {
                    return;
                }
                
                try {
                    await axios.post('/api/mypage/logout');
                    window.location.href = '/mypage';
                } catch (error) {
                    console.error('ログアウトエラー:', error);
                    alert('ログアウトに失敗しました');
                }
            });
        </script>
    </body>
    </html>
  `)
  } catch (error) {
    console.error('❌ [Mypage] Error:', error)
    const errorMessage = error instanceof Error ? error.message : String(error)
    const errorStack = error instanceof Error ? error.stack : ''
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>エラー | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
      </head>
      <body class="bg-gray-50 min-h-screen flex items-center justify-center">
          <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8">
              <div class="text-red-600 mb-4 text-center">
                  <i class="fas fa-exclamation-circle text-6xl"></i>
              </div>
              <h2 class="text-2xl font-bold text-gray-800 mb-4 text-center">エラーが発生しました</h2>
              <div class="bg-red-50 border border-red-200 rounded p-4 mb-6">
                  <p class="text-sm font-semibold text-red-800 mb-2">エラーメッセージ:</p>
                  <p class="text-sm text-red-700 mb-4">${errorMessage}</p>
                  ${errorStack ? `
                    <details class="text-xs text-gray-600">
                      <summary class="cursor-pointer font-semibold">スタックトレース</summary>
                      <pre class="mt-2 overflow-auto bg-gray-100 p-2 rounded">${errorStack}</pre>
                    </details>
                  ` : ''}
              </div>
              <div class="text-center">
                  <a href="/mypage" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                      戻る
                  </a>
              </div>
          </div>
      </body>
      </html>
    `, 500)
  }
})

// ==========================================
// マイページ - 予約詳細
// ==========================================
app.get('/mypage/booking/:id', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('id')
  
  try {
    // セッショントークンを確認
    const sessionToken = getCookie(c, 'mypage_session_token')
    if (!sessionToken) {
      return c.redirect('/mypage')
    }
    
    // セッショントークンからメールアドレスを取得
    const otpRecord = await DB.prepare(`
      SELECT email, used_at FROM otp_codes 
      WHERE session_token = ? AND is_used = 1
      ORDER BY used_at DESC
      LIMIT 1
    `).bind(sessionToken).first()
    
    if (!otpRecord) {
      return c.redirect('/mypage')
    }
    
    // セッションの有効期限確認（24時間）
    const usedAt = new Date(otpRecord.used_at)
    const now = new Date()
    const diffHours = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    if (diffHours > 24) {
      return c.redirect('/mypage')
    }
    
    const email = otpRecord.email
    
    // 顧客情報取得
    console.log('🔍 [Mypage] Fetching customer for email:', email)
    const customer = await DB.prepare(`
      SELECT * FROM members WHERE email = ?
    `).bind(email).first()
    
    console.log('🔍 [Mypage] Customer found:', customer ? `id=${customer.id}` : 'not found')
    
    if (!customer) {
      return c.redirect('/mypage/bookings')
    }
    
    // 予約情報を取得（イベント情報を含む）
    console.log('🔍 [Mypage] Fetching booking - booking_id:', bookingId, 'member_id:', customer.id)
    const booking = await DB.prepare(`
      SELECT 
        b.*,
        e.name as event_name,
        e.location as event_location
      FROM bookings b
      JOIN events e ON b.event_id = e.id
      WHERE b.id = ? AND b.member_id = ?
    `).bind(bookingId, customer.id).first()
    
    console.log('🔍 [Mypage] Booking found:', booking ? `booking_number=${booking.booking_number}` : 'not found')
    
    if (!booking) {
      return c.html(`
        <!DOCTYPE html>
        <html lang="ja">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>予約が見つかりません | マイページ</title>
            <script src="https://cdn.tailwindcss.com"></script>
        </head>
        <body class="bg-gray-50 min-h-screen flex items-center justify-center">
            <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8 text-center">
                <div class="text-red-600 mb-4">
                    <i class="fas fa-exclamation-circle text-6xl"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-800 mb-4">予約が見つかりません</h2>
                <p class="text-gray-600 mb-6">指定された予約は存在しないか、アクセス権限がありません。</p>
                <a href="/mypage/bookings" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                    予約一覧に戻る
                </a>
            </div>
        </body>
        </html>
      `)
    }
    
    // 予約商品を取得
    console.log('🔍 [Mypage] Fetching booking items for booking_id:', bookingId)
    const itemsResult = await DB.prepare(`
      SELECT * FROM booking_items WHERE booking_id = ? ORDER BY id
    `).bind(bookingId).all()
    
    const items = itemsResult.results || []
    console.log('🔍 [Mypage] Found items:', items.length)
    
    // 支払い情報を取得（決済履歴）
    console.log('🔍 [Mypage] Fetching payments for booking_number:', booking.booking_number)
    const paymentsResult = await DB.prepare(`
      SELECT * FROM booking_payments WHERE booking_number = ? ORDER BY created_at DESC
    `).bind(booking.booking_number).all()
    
    const payments = paymentsResult.results || []
    console.log('🔍 [Mypage] Payments found:', payments.length)
    
    // お客様メッセージを取得
    console.log('🔍 [Mypage] Fetching messages for booking_id:', bookingId)
    const messagesResult = await DB.prepare(`
      SELECT * FROM booking_messages 
      WHERE booking_id = ? AND display_on_mypage = 1 
      ORDER BY created_at DESC
    `).bind(bookingId).all()
    
    const messages = messagesResult.results || []
    console.log('🔍 [Mypage] Messages found:', messages.length)
    
    // 添付ファイルを取得
    console.log('🔍 [Mypage] Fetching files for booking_number:', booking.booking_number)
    const filesResult = await DB.prepare(`
      SELECT * FROM booking_files WHERE booking_number = ? ORDER BY created_at DESC
    `).bind(booking.booking_number).all()
    
    const files = filesResult.results || []
    console.log('🔍 [Mypage] Files found:', files.length)
    
    // 合計金額を計算
    const totalAmount = items.length > 0 
      ? items.reduce((sum, item) => sum + (item.quantity * item.unit_price), 0) 
      : 0
    
    // 決済済み金額を計算
    const paidAmount = payments
      .filter(p => p.payment_status === 'completed')
      .reduce((sum, p) => sum + p.amount, 0)
    
    // 決済待ち金額を計算
    const pendingAmount = payments
      .filter(p => p.payment_status === 'pending')
      .reduce((sum, p) => sum + p.amount, 0)
    
    console.log('🔍 [Mypage] Amount summary - Total:', totalAmount, 'Paid:', paidAmount, 'Pending:', pendingAmount)
    
    // 参加者情報をパース
    const itemsWithParticipants = items.map(item => {
      let participants = []
      try {
        if (item.participants) {
          participants = JSON.parse(item.participants)
        }
      } catch (e) {
        console.error('❌ Failed to parse participants:', e)
      }
      return { ...item, parsedParticipants: participants }
    })
    
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>予約詳細 - ${booking.booking_number} | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
          <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
          <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
      </head>
      <body class="bg-gray-50 min-h-screen" id="app">
          <header class="bg-indigo-600 text-white shadow-lg">
              <div class="container mx-auto px-4 py-6">
                  <h1 class="text-3xl font-bold flex items-center gap-3">
                      <i class="fas fa-file-invoice"></i>
                      予約詳細
                  </h1>
              </div>
          </header>

          <nav class="bg-white shadow-md border-b">
              <div class="container mx-auto px-4">
                  <div class="flex justify-between items-center py-4">
                      <ul class="flex gap-6">
                          <li><a href="/" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                              <i class="fas fa-home"></i>トップページ
                          </a></li>
                          <li><a href="/events" class="text-gray-700 hover:text-blue-600 flex items-center gap-2">
                              <i class="fas fa-calendar-alt"></i>イベント一覧
                          </a></li>
                          <li><a href="/mypage/bookings" class="text-indigo-600 font-semibold flex items-center gap-2">
                              <i class="fas fa-user-circle"></i>マイページ
                          </a></li>
                      </ul>
                  </div>
              </div>
          </nav>

          <main class="container mx-auto px-4 py-8">
              <div class="max-w-4xl mx-auto">
                  <!-- パンくずリスト -->
                  <div class="mb-6">
                      <a href="/mypage/bookings" class="text-indigo-600 hover:text-indigo-800 flex items-center gap-2">
                          <i class="fas fa-arrow-left"></i> 予約一覧に戻る
                      </a>
                  </div>

                  <!-- 予約番号とステータス -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <div class="flex items-center justify-between flex-wrap gap-4">
                          <div>
                              <h2 class="text-2xl font-bold text-gray-900 mb-2">
                                  <i class="fas fa-ticket-alt text-indigo-600 mr-2"></i>
                                  ${booking.booking_number}
                              </h2>
                              <p class="text-sm text-gray-500">予約日時: ${new Date(booking.created_at).toLocaleString('ja-JP')}</p>
                          </div>
                          <div class="flex gap-3 flex-wrap">
                              ${booking.status === 'active' ? `
                                  <span class="px-4 py-2 text-sm font-semibold rounded-full bg-green-100 text-green-800">
                                      <i class="fas fa-check-circle mr-1"></i> 予約確定
                                  </span>
                              ` : booking.status === 'cancelled' ? `
                                  <span class="px-4 py-2 text-sm font-semibold rounded-full bg-red-100 text-red-800">
                                      <i class="fas fa-times-circle mr-1"></i> キャンセル
                                  </span>
                              ` : `
                                  <span class="px-4 py-2 text-sm font-semibold rounded-full bg-gray-100 text-gray-800">
                                      ${booking.status}
                                  </span>
                              `}
                          </div>
                      </div>
                  </div>

                  ${messages.length > 0 ? `
                  <!-- お客様メッセージ -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-comments text-indigo-600"></i>
                          お客様メッセージ
                      </h3>
                      <div class="space-y-4">
                          ${messages.map(msg => `
                              <div class="border-l-4 border-indigo-500 bg-indigo-50 p-4 rounded">
                                  <div class="flex items-center justify-between mb-2">
                                      <span class="font-semibold text-gray-900">${msg.title}</span>
                                      <span class="text-xs text-gray-500">${new Date(msg.created_at).toLocaleString('ja-JP')}</span>
                                  </div>
                                  <p class="text-gray-700 text-sm whitespace-pre-wrap">${msg.message}</p>
                                  ${msg.send_status === 'sent' ? `
                                      <div class="mt-2 text-xs text-gray-500">
                                          <i class="fas fa-check text-green-600"></i> 送信済み (${new Date(msg.sent_at).toLocaleString('ja-JP')})
                                      </div>
                                  ` : `
                                      <div class="mt-2 text-xs text-gray-500">
                                          <i class="fas fa-clock text-yellow-600"></i> 送信予定 (${new Date(msg.scheduled_send_at).toLocaleString('ja-JP')})
                                      </div>
                                  `}
                              </div>
                          `).join('')}
                      </div>
                  </div>
                  ` : ''}

                  <!-- イベント情報 -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-calendar-check text-indigo-600"></i>
                          イベント情報
                      </h3>
                      <div class="grid md:grid-cols-2 gap-4">
                          <div>
                              <p class="text-sm text-gray-500">イベント名</p>
                              <p class="font-semibold text-gray-900">${booking.event_name}</p>
                          </div>
                          ${booking.event_location ? `
                          <div>
                              <p class="text-sm text-gray-500">開催場所</p>
                              <p class="font-semibold text-gray-900">${booking.event_location}</p>
                          </div>
                          ` : ''}
                      </div>
                  </div>

                  <!-- 料金情報 -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-yen-sign text-indigo-600"></i>
                          料金情報
                      </h3>
                      <div class="grid md:grid-cols-2 gap-4">
                          <div class="flex justify-between items-center border-b pb-2">
                              <span class="text-gray-600">取引金額</span>
                              <span class="font-bold text-gray-900">¥${totalAmount.toLocaleString()}</span>
                          </div>
                          <div class="flex justify-between items-center border-b pb-2">
                              <span class="text-gray-600">決済済み</span>
                              <span class="font-bold text-green-600">¥${paidAmount.toLocaleString()}</span>
                          </div>
                          <div class="flex justify-between items-center border-b pb-2">
                              <span class="text-gray-600">決済待ち</span>
                              <span class="font-bold text-yellow-600">¥${pendingAmount.toLocaleString()}</span>
                          </div>
                          <div class="flex justify-between items-center border-b pb-2">
                              <span class="text-gray-600 font-semibold">合計金額</span>
                              <span class="font-bold text-indigo-600 text-lg">¥${totalAmount.toLocaleString()}</span>
                          </div>
                      </div>
                  </div>

                  <!-- 予約明細 -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-list-alt text-indigo-600"></i>
                          予約明細
                      </h3>
                      <div class="overflow-x-auto">
                          <table class="w-full text-sm">
                              <thead class="bg-gray-100">
                                  <tr>
                                      <th class="px-4 py-2 text-left">商品名</th>
                                      <th class="px-4 py-2 text-left">料金カテゴリ</th>
                                      <th class="px-4 py-2 text-center">数量</th>
                                      <th class="px-4 py-2 text-right">単価</th>
                                      <th class="px-4 py-2 text-right">小計</th>
                                      <th class="px-4 py-2 text-left">参加日</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  ${itemsWithParticipants.map(item => `
                                      <tr class="border-b hover:bg-gray-50">
                                          <td class="px-4 py-3">
                                              <div class="font-semibold text-gray-900">${item.item_name}</div>
                                              <div class="text-xs text-gray-500">${item.item_type === 'product' ? '商品' : 'オプション'}</div>
                                          </td>
                                          <td class="px-4 py-3 text-gray-700">${item.price_category || '-'}</td>
                                          <td class="px-4 py-3 text-center font-semibold">${item.quantity}</td>
                                          <td class="px-4 py-3 text-right text-gray-700">¥${item.unit_price.toLocaleString()}</td>
                                          <td class="px-4 py-3 text-right font-bold text-gray-900">¥${item.subtotal.toLocaleString()}</td>
                                          <td class="px-4 py-3 text-gray-700">${item.participation_date ? new Date(item.participation_date).toLocaleDateString('ja-JP') : '-'}</td>
                                      </tr>
                                      <!-- 参加者情報と編集ボタン -->
                                      <tr class="border-b bg-gray-50">
                                          <td colspan="6" class="px-8 py-4">
                                              ${item.parsedParticipants && item.parsedParticipants.length > 0 ? `
                                                  <div class="flex items-center justify-between mb-2">
                                                      <div class="font-semibold text-gray-700">
                                                          <i class="fas fa-users text-indigo-600 mr-2"></i>
                                                          参加者情報
                                                      </div>
                                                      <button 
                                                          onclick="openParticipantModal(${item.id}, ${item.item_id}, '${item.item_name}', ${item.quantity}, ${JSON.stringify(item.parsedParticipants).replace(/"/g, '&quot;')})"
                                                          class="text-sm bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg transition inline-flex items-center gap-2"
                                                      >
                                                          <i class="fas fa-edit"></i>
                                                          編集
                                                      </button>
                                                  </div>
                                                  ${item.parsedParticipants.map((p, idx) => {
                                                    const hasData = p.lastname || p.firstname || p.age || p.gender || p.email || p.phone
                                                    return hasData ? `
                                                      <div class="text-sm text-gray-600 ml-6 mb-1">
                                                          <strong>参加者 ${idx + 1}:</strong>
                                                          ${p.lastname || ''} ${p.firstname || ''}
                                                          ${p.age ? ` / 年齢: ${p.age}` : ''}
                                                          ${p.gender === '1' ? ' / 男性' : p.gender === '2' ? ' / 女性' : p.gender === '9' ? ' / その他' : ''}
                                                          ${p.email ? ` / ${p.email}` : ''}
                                                          ${p.phone ? ` / ${p.phone}` : ''}
                                                      </div>
                                                    ` : `
                                                      <div class="text-sm text-gray-400 ml-6 mb-1">
                                                          <strong>参加者 ${idx + 1}:</strong> 未入力
                                                      </div>
                                                    `
                                                  }).join('')}
                                              ` : `
                                                  <div class="flex items-center justify-between">
                                                      <div class="text-sm text-gray-500">
                                                          <i class="fas fa-info-circle text-yellow-600 mr-2"></i>
                                                          参加者情報が未入力です
                                                      </div>
                                                      <button 
                                                          onclick="openParticipantModal(${item.id}, ${item.item_id}, '${item.item_name}', ${item.quantity}, [])"
                                                          class="text-sm bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-lg transition inline-flex items-center gap-2"
                                                      >
                                                          <i class="fas fa-edit"></i>
                                                          参加者情報を入力
                                                      </button>
                                                  </div>
                                              `}
                                          </td>
                                      </tr>
                                  `).join('')}
                              </tbody>
                              <tfoot class="bg-gray-100 font-bold">
                                  <tr>
                                      <td colspan="4" class="px-4 py-3 text-right">合計金額</td>
                                      <td class="px-4 py-3 text-right text-indigo-600 text-lg">¥${totalAmount.toLocaleString()}</td>
                                      <td></td>
                                  </tr>
                              </tfoot>
                          </table>
                      </div>
                  </div>

                  ${payments.length > 0 ? `
                  <!-- 決済履歴 -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-credit-card text-indigo-600"></i>
                          決済履歴
                      </h3>
                      <div class="overflow-x-auto">
                          <table class="w-full text-sm">
                              <thead class="bg-gray-100">
                                  <tr>
                                      <th class="px-4 py-2 text-left">種別</th>
                                      <th class="px-4 py-2 text-left">決済方法</th>
                                      <th class="px-4 py-2 text-right">金額</th>
                                      <th class="px-4 py-2 text-left">ステータス</th>
                                      <th class="px-4 py-2 text-left">決済日</th>
                                  </tr>
                              </thead>
                              <tbody>
                                  ${payments.map(pay => `
                                      <tr class="border-b hover:bg-gray-50">
                                          <td class="px-4 py-3">${pay.payment_type === 'immediate' ? '即時決済' : pay.payment_type}</td>
                                          <td class="px-4 py-3">
                                              ${pay.payment_method === 'credit' ? 'クレジットカード' : 
                                                pay.payment_method === 'bank' ? '銀行振込' :
                                                pay.payment_method === 'convenience' ? 'コンビニ決済' : pay.payment_method}
                                          </td>
                                          <td class="px-4 py-3 text-right font-semibold">¥${pay.amount.toLocaleString()}</td>
                                          <td class="px-4 py-3">
                                              ${pay.payment_status === 'completed' ? `
                                                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-800">
                                                      <i class="fas fa-check"></i> 完了
                                                  </span>
                                              ` : pay.payment_status === 'pending' ? `
                                                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                                                      <i class="fas fa-clock"></i> 保留
                                                  </span>
                                              ` : pay.payment_status === 'failed' ? `
                                                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                                                      <i class="fas fa-times"></i> 失敗
                                                  </span>
                                              ` : pay.payment_status}
                                          </td>
                                          <td class="px-4 py-3 text-gray-700">${pay.payment_date ? new Date(pay.payment_date).toLocaleString('ja-JP') : '-'}</td>
                                      </tr>
                                  `).join('')}
                              </tbody>
                          </table>
                      </div>
                  </div>
                  ` : ''}

                  ${files.length > 0 ? `
                  <!-- 添付ファイル -->
                  <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
                          <i class="fas fa-paperclip text-indigo-600"></i>
                          添付ファイル
                      </h3>
                      <div class="space-y-3">
                          ${files.map(file => `
                              <div class="flex items-center justify-between border rounded-lg p-4 hover:bg-gray-50">
                                  <div class="flex items-center gap-3">
                                      <i class="fas fa-file text-gray-400 text-2xl"></i>
                                      <div>
                                          <p class="font-semibold text-gray-900">${file.display_filename}</p>
                                          <p class="text-xs text-gray-500">
                                              サイズ: ${(file.file_size / 1024).toFixed(2)} KB
                                              ${file.download_limit > 0 ? ` / ダウンロード: ${file.download_count}/${file.download_limit}回` : ''}
                                          </p>
                                      </div>
                                  </div>
                                  <a 
                                      href="/api/files/download/${file.file_key}" 
                                      class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold transition"
                                      target="_blank"
                                  >
                                      <i class="fas fa-download mr-1"></i>
                                      ダウンロード
                                  </a>
                              </div>
                          `).join('')}
                      </div>
                  </div>
                  ` : ''}

                  <!-- お問い合わせ -->
                  <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                      <h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2">
                          <i class="fas fa-question-circle text-blue-600"></i>
                          予約に関するお問い合わせ
                      </h3>
                      <p class="text-sm text-gray-700 mb-3">
                          予約内容の変更やキャンセルをご希望の場合は、イベントの主催者までお問い合わせください。
                      </p>
                      <a href="/mypage/bookings" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2 px-6 rounded-lg transition">
                          <i class="fas fa-arrow-left mr-2"></i>
                          予約一覧に戻る
                      </a>
                  </div>
              </div>
          </main>

          <!-- 参加者情報編集モーダル -->
          <div id="participantModal" v-if="showModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4" @click.self="closeModal">
              <div class="bg-white rounded-lg shadow-xl max-w-4xl w-full max-h-[90vh] overflow-y-auto">
                  <div class="sticky top-0 bg-white border-b px-6 py-4 flex items-center justify-between">
                      <h3 class="text-xl font-bold text-gray-800">
                          <i class="fas fa-users text-indigo-600 mr-2"></i>
                          参加者情報編集 - {{ currentItemName }}
                      </h3>
                      <button @click="closeModal" class="text-gray-500 hover:text-gray-700 text-2xl">
                          <i class="fas fa-times"></i>
                      </button>
                  </div>
                  
                  <div class="p-6">
                      <!-- エラーメッセージ -->
                      <div v-if="errorMessage" class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-4">
                          <i class="fas fa-exclamation-circle mr-2"></i>
                          {{ errorMessage }}
                      </div>
                      
                      <!-- 成功メッセージ -->
                      <div v-if="successMessage" class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-lg mb-4">
                          <i class="fas fa-check-circle mr-2"></i>
                          {{ successMessage }}
                      </div>
                      
                      <!-- 参加者フォーム -->
                      <div v-for="(participant, index) in participants" :key="index" class="mb-6 p-4 border rounded-lg">
                          <h4 class="font-bold text-lg mb-4 text-indigo-600">
                              <i class="fas fa-user mr-2"></i>
                              参加者 {{ index + 1 }}
                          </h4>
                          
                          <!-- 氏名（漢字） -->
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4" v-if="shouldShowField('lastname_kanji') || shouldShowField('firstname_kanji')">
                              <div v-if="shouldShowField('lastname_kanji')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      姓（漢字）<span class="text-red-500 ml-1">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.lastname" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="山田"
                                  >
                              </div>
                              <div v-if="shouldShowField('firstname_kanji')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      名（漢字）<span class="text-red-500 ml-1">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.firstname" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="太郎"
                                  >
                              </div>
                          </div>
                          
                          <!-- 氏名（かな） -->
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4" v-if="shouldShowField('lastname_kana') || shouldShowField('firstname_kana')">
                              <div v-if="shouldShowField('lastname_kana')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      姓（かな）<span class="text-red-500 ml-1">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.lastname_kana" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="やまだ"
                                  >
                              </div>
                              <div v-if="shouldShowField('firstname_kana')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      名（かな）<span class="text-red-500 ml-1">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.firstname_kana" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="たろう"
                                  >
                              </div>
                          </div>
                          
                          <!-- 年齢・性別 -->
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                              <div v-if="shouldShowField('age')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      年齢<span v-if="isRequired('age')" class="text-red-500 ml-1">*</span>
                                  </label>
                                  <input 
                                      type="number" 
                                      v-model.number="participant.age" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="35"
                                  >
                              </div>
                              <div v-if="shouldShowField('gender')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      性別<span v-if="isRequired('gender')" class="text-red-500 ml-1">*</span>
                                  </label>
                                  <select 
                                      v-model="participant.gender" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                  >
                                      <option value="">選択してください</option>
                                      <option value="1">男性</option>
                                      <option value="2">女性</option>
                                      <option value="9">その他</option>
                                  </select>
                              </div>
                          </div>
                          
                          <!-- メール・電話 -->
                          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                              <div v-if="shouldShowField('email')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      メールアドレス
                                  </label>
                                  <input 
                                      type="email" 
                                      v-model="participant.email" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="example@example.com"
                                  >
                              </div>
                              <div v-if="shouldShowField('phone')">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      電話番号
                                  </label>
                                  <input 
                                      type="tel" 
                                      v-model="participant.phone" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="090-1234-5678"
                                  >
                              </div>
                          </div>
                          
                          <!-- カスタムフィールド（category=2のみ） -->
                          <template v-for="field in customFields" :key="field.id">
                              <div v-if="field.category === 2 && shouldShowCustomField(participant, field)" class="mb-4">
                                  <label class="block text-sm font-semibold text-gray-700 mb-2">
                                      {{ field.field_label }}
                                      <span v-if="field.is_required" class="text-red-500 ml-1">*</span>
                                  </label>
                                  
                                  <!-- テキスト入力 -->
                                  <input 
                                      v-if="field.field_type === 'text'"
                                      type="text" 
                                      v-model="participant.custom_fields[field.field_name]"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      :placeholder="field.placeholder || ''"
                                  >
                                  
                                  <!-- セレクト -->
                                  <select 
                                      v-else-if="field.field_type === 'select'"
                                      v-model="participant.custom_fields[field.field_name]"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                  >
                                      <option value="">選択してください</option>
                                      <option v-for="opt in field.field_options" :key="opt" :value="opt">
                                          {{ opt }}
                                      </option>
                                  </select>
                                  
                                  <!-- ラジオボタン -->
                                  <div v-else-if="field.field_type === 'radio'" class="space-y-2">
                                      <label v-for="opt in field.field_options" :key="opt" class="flex items-center">
                                          <input 
                                              type="radio" 
                                              :name="'field_' + field.id + '_' + index"
                                              :value="opt"
                                              v-model="participant.custom_fields[field.field_name]"
                                              class="mr-2"
                                          >
                                          <span>{{ opt }}</span>
                                      </label>
                                  </div>
                                  
                                  <!-- チェックボックス -->
                                  <div v-else-if="field.field_type === 'checkbox'" class="space-y-2">
                                      <label v-for="opt in field.field_options" :key="opt" class="flex items-center">
                                          <input 
                                              type="checkbox" 
                                              :value="opt"
                                              v-model="participant.custom_fields[field.field_name]"
                                              class="mr-2"
                                          >
                                          <span>{{ opt }}</span>
                                      </label>
                                  </div>
                                  
                                  <!-- テキストエリア -->
                                  <textarea 
                                      v-else-if="field.field_type === 'textarea'"
                                      v-model="participant.custom_fields[field.field_name]"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      :placeholder="field.placeholder || ''"
                                      rows="3"
                                  ></textarea>
                                  
                                  <small v-if="field.description" class="text-gray-500 mt-1 block">{{ field.description }}</small>
                              </div>
                          </template>
                      </div>
                      
                      <!-- 保存ボタン -->
                      <div class="flex justify-end gap-3 mt-6 pt-4 border-t">
                          <button 
                              @click="closeModal"
                              class="px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition"
                              :disabled="isLoading"
                          >
                              キャンセル
                          </button>
                          <button 
                              @click="saveParticipants"
                              class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg transition inline-flex items-center gap-2"
                              :disabled="isLoading"
                          >
                              <i class="fas fa-save"></i>
                              {{ isLoading ? '保存中...' : '保存' }}
                          </button>
                      </div>
                  </div>
              </div>
          </div>

          <footer class="bg-gray-800 text-white mt-12">
              <div class="container mx-auto px-4 py-6 text-center">
                  <p>&copy; 2026 イベント予約管理システム</p>
              </div>
          </footer>
          
          <script>
              const { createApp } = Vue
              
              const app = createApp({
                  data() {
                      return {
                          showModal: false,
                          currentItemId: null,
                          currentItemName: '',
                          participants: [],
                          formSettings: {},
                          customFields: [],
                          isLoading: false,
                          errorMessage: '',
                          successMessage: ''
                      }
                  },
                  methods: {
                      shouldShowField(fieldName) {
                          return this.formSettings[fieldName] === true
                      },
                      isRequired(fieldName) {
                          const requiredFields = ['age', 'gender']
                          return requiredFields.includes(fieldName)
                      },
                      shouldShowCustomField(participant, field) {
                          // category=2（参加者毎のフィールド）のみ表示
                          if (field.category !== 2) return false
                          
                          // 親フィールドがない場合は常に表示
                          if (!field.parent_field_id) return true
                          
                          // 親フィールドの値を取得
                          const parentField = this.customFields.find(f => f.id === field.parent_field_id)
                          if (!parentField) return true
                          
                          const parentValue = participant.custom_fields[parentField.field_name]
                          
                          // 親フィールドの値が条件と一致するか確認
                          return parentValue === field.parent_condition
                      },
                      async loadFormSettings(itemId) {
                          try {
                              const response = await axios.get(\`/api/auth/product-form-settings/\${itemId}\`)
                              this.formSettings = response.data.form_settings || {}
                              this.customFields = response.data.custom_fields || []
                              
                              // カスタムフィールドの初期化
                              this.participants.forEach(participant => {
                                  if (!participant.custom_fields) {
                                      participant.custom_fields = {}
                                  }
                                  this.customFields.forEach(field => {
                                      if (!(field.field_name in participant.custom_fields)) {
                                          // checkbox型は配列、それ以外は空文字列で初期化
                                          participant.custom_fields[field.field_name] = field.field_type === 'checkbox' ? [] : ''
                                      }
                                  })
                              })
                          } catch (error) {
                              console.error('フォーム設定の読み込みに失敗:', error)
                              // デフォルト設定
                              this.formSettings = {
                                  lastname_kanji: true,
                                  firstname_kanji: true,
                                  lastname_kana: true,
                                  firstname_kana: true,
                                  age: true,
                                  gender: true
                              }
                              this.customFields = []
                          }
                      },
                      async saveParticipants() {
                          this.isLoading = true
                          this.errorMessage = ''
                          this.successMessage = ''
                          
                          try {
                              const response = await axios.post(\`/api/mypage/booking/${booking.id}/update-participants\`, {
                                  item_id: this.currentItemId,
                                  participants: this.participants
                              })
                              
                              this.successMessage = '参加者情報を保存しました'
                              setTimeout(() => {
                                  location.reload()
                              }, 1500)
                          } catch (error) {
                              console.error('保存に失敗しました:', error)
                              this.errorMessage = error.response?.data?.error || '保存に失敗しました'
                          } finally {
                              this.isLoading = false
                          }
                      },
                      closeModal() {
                          this.showModal = false
                          this.currentItemId = null
                          this.currentItemName = ''
                          this.participants = []
                          this.errorMessage = ''
                          this.successMessage = ''
                      }
                  }
              })
              
              app.mount('#app')
              
              // グローバル関数（HTMLから呼び出し）
              window.openParticipantModal = async function(itemId, productId, itemName, quantity, existingParticipants) {
                  const vueApp = app._instance.proxy
                  
                  vueApp.currentItemId = itemId
                  vueApp.currentItemName = itemName
                  
                  // 参加者データの初期化
                  if (existingParticipants && existingParticipants.length > 0) {
                      vueApp.participants = existingParticipants.map(p => ({
                          lastname: p.lastname || '',
                          firstname: p.firstname || '',
                          lastname_kana: p.lastname_kana || '',
                          firstname_kana: p.firstname_kana || '',
                          age: p.age || null,
                          gender: p.gender || '',
                          email: p.email || '',
                          phone: p.phone || '',
                          custom_fields: p.custom_fields || {}
                      }))
                  } else {
                      // 新規作成
                      vueApp.participants = []
                      for (let i = 0; i < quantity; i++) {
                          vueApp.participants.push({
                              lastname: '',
                              firstname: '',
                              lastname_kana: '',
                              firstname_kana: '',
                              age: null,
                              gender: '',
                              email: '',
                              phone: '',
                              custom_fields: {}
                          })
                      }
                  }
                  
                  // フォーム設定を読み込み（productIdを使用）
                  await vueApp.loadFormSettings(productId)
                  
                  vueApp.showModal = true
              }
          </script>
      </body>
      </html>
    `)
  } catch (error) {
    console.error('❌ [Mypage] Booking detail error:', error)
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>エラー | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
      </head>
      <body class="bg-gray-50 min-h-screen flex items-center justify-center">
          <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8 text-center">
              <div class="text-red-600 mb-4">
                  <i class="fas fa-exclamation-circle text-6xl"></i>
              </div>
              <h2 class="text-2xl font-bold text-gray-800 mb-4">エラーが発生しました</h2>
              <p class="text-gray-600 mb-6">${error instanceof Error ? error.message : 'システムエラー'}</p>
              <a href="/mypage/bookings" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                  予約一覧に戻る
              </a>
          </div>
      </body>
      </html>
    `, 500)
  }
})

// ==========================================
// マイページ - 参加者情報更新API
// ==========================================

// 参加者情報更新API
app.post('/api/mypage/booking/:id/update-participants', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('id')
  
  try {
    // セッショントークンを確認
    const sessionToken = getCookie(c, 'mypage_session_token')
    if (!sessionToken) {
      return c.json({ error: 'セッションが無効です' }, 401)
    }
    
    // セッショントークンからメールアドレスを取得
    const otpRecord = await DB.prepare(`
      SELECT email, used_at FROM otp_codes 
      WHERE session_token = ? AND is_used = 1
      ORDER BY used_at DESC
      LIMIT 1
    `).bind(sessionToken).first()
    
    if (!otpRecord) {
      return c.json({ error: 'セッションが無効です' }, 401)
    }
    
    // セッションの有効期限確認（24時間）
    const usedAt = new Date(otpRecord.used_at)
    const now = new Date()
    const diffHours = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    if (diffHours > 24) {
      return c.json({ error: 'セッションの有効期限が切れました' }, 401)
    }
    
    const email = otpRecord.email
    
    // 顧客情報取得
    const customer = await DB.prepare(`
      SELECT * FROM members WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.json({ error: '会員情報が見つかりません' }, 404)
    }
    
    // 予約情報を取得（所有権確認）
    const booking = await DB.prepare(`
      SELECT * FROM bookings WHERE id = ? AND member_id = ?
    `).bind(bookingId, customer.id).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // リクエストボディから参加者情報を取得
    const { item_id, participants } = await c.req.json()
    
    if (!item_id || !participants || !Array.isArray(participants)) {
      return c.json({ error: '参加者情報が不正です' }, 400)
    }
    
    // booking_items を更新
    const item = await DB.prepare(`
      SELECT * FROM booking_items WHERE booking_id = ? AND id = ?
    `).bind(bookingId, item_id).first()
    
    if (!item) {
      return c.json({ error: '予約商品が見つかりません' }, 404)
    }
    
    // participants を JSON 文字列に変換
    const participantsJson = JSON.stringify(participants)
    
    // 更新
    await DB.prepare(`
      UPDATE booking_items 
      SET participants = ?, modified_at = datetime('now')
      WHERE id = ?
    `).bind(participantsJson, item_id).run()
    
    return c.json({ 
      success: true, 
      message: '参加者情報を更新しました' 
    })
    
  } catch (error) {
    console.error('❌ [Mypage] Participant update error:', error)
    return c.json({ 
      error: 'システムエラーが発生しました',
      details: error instanceof Error ? error.message : 'Unknown error'
    }, 500)
  }
})

// ==========================================
// マイページ - 参加者情報編集ページ
// ==========================================

app.get('/mypage/booking/:booking_id/edit-participants/:item_id', async (c) => {
  const { DB } = c.env
  const bookingId = c.req.param('booking_id')
  const itemId = c.req.param('item_id')
  
  try {
    // セッショントークンを確認
    const sessionToken = getCookie(c, 'mypage_session_token')
    if (!sessionToken) {
      return c.redirect('/mypage')
    }
    
    // セッショントークンからメールアドレスを取得
    const otpRecord = await DB.prepare(`
      SELECT email, used_at FROM otp_codes 
      WHERE session_token = ? AND is_used = 1
      ORDER BY used_at DESC
      LIMIT 1
    `).bind(sessionToken).first()
    
    if (!otpRecord) {
      return c.redirect('/mypage')
    }
    
    // セッションの有効期限確認（24時間）
    const usedAt = new Date(otpRecord.used_at)
    const now = new Date()
    const diffHours = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    if (diffHours > 24) {
      return c.redirect('/mypage')
    }
    
    const email = otpRecord.email
    
    // 顧客情報取得
    const customer = await DB.prepare(`
      SELECT * FROM members WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.redirect('/mypage')
    }
    
    // 予約情報を取得（所有権確認）
    const booking = await DB.prepare(`
      SELECT 
        b.*,
        e.id as event_id,
        e.name as event_name
      FROM bookings b
      JOIN events e ON b.event_id = e.id
      WHERE b.id = ? AND b.member_id = ?
    `).bind(bookingId, customer.id).first()
    
    if (!booking) {
      return c.html(`
        <!DOCTYPE html>
        <html lang="ja">
        <head>
            <meta charset="UTF-8">
            <title>エラー | マイページ</title>
            <script src="https://cdn.tailwindcss.com"></script>
        </head>
        <body class="bg-gray-50 min-h-screen flex items-center justify-center">
            <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8 text-center">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">予約が見つかりません</h2>
                <a href="/mypage/bookings" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                    予約一覧に戻る
                </a>
            </div>
        </body>
        </html>
      `)
    }
    
    // booking_items を取得
    const item = await DB.prepare(`
      SELECT * FROM booking_items WHERE booking_id = ? AND id = ?
    `).bind(bookingId, itemId).first()
    
    if (!item) {
      return c.html(`
        <!DOCTYPE html>
        <html lang="ja">
        <head>
            <meta charset="UTF-8">
            <title>エラー | マイページ</title>
            <script src="https://cdn.tailwindcss.com"></script>
        </head>
        <body class="bg-gray-50 min-h-screen flex items-center justify-center">
            <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8 text-center">
                <h2 class="text-2xl font-bold text-gray-800 mb-4">商品が見つかりません</h2>
                <a href="/mypage/booking/${bookingId}" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                    予約詳細に戻る
                </a>
            </div>
        </body>
        </html>
      `)
    }
    
    // 参加者情報をパース
    let participants = []
    try {
      if (item.participants) {
        participants = JSON.parse(item.participants)
      }
    } catch (e) {
      console.error('❌ Failed to parse participants:', e)
    }
    
    // 参加者が未入力の場合、数量分の空配列を生成
    if (participants.length === 0) {
      for (let i = 0; i < item.quantity; i++) {
        participants.push({
          lastname: '',
          firstname: '',
          lastname_kana: '',
          firstname_kana: '',
          last_name_en: '',
          first_name_en: '',
          age: '',
          gender: '',
          email: '',
          phone: '',
          birth: '',
          address: '',
          custom_fields: {}
        })
      }
    }
    
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <meta name="viewport" content="width=device-width, initial-scale=1.0">
          <title>参加者情報編集 | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
          <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
          <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
          <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
      </head>
      <body class="bg-gray-50 min-h-screen">
          <div id="app">
              <header class="bg-indigo-600 text-white shadow-lg">
                  <div class="container mx-auto px-4 py-6">
                      <h1 class="text-3xl font-bold flex items-center gap-3">
                          <i class="fas fa-users"></i>
                          参加者情報編集
                      </h1>
                  </div>
              </header>

              <main class="container mx-auto px-4 py-8">
                  <div class="max-w-4xl mx-auto">
                      <!-- パンくずリスト -->
                      <div class="mb-6">
                          <a href="/mypage/booking/${bookingId}" class="text-indigo-600 hover:text-indigo-800 flex items-center gap-2">
                              <i class="fas fa-arrow-left"></i> 予約詳細に戻る
                          </a>
                      </div>

                      <!-- 商品情報 -->
                      <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                          <h2 class="text-xl font-bold text-gray-900 mb-2">${item.item_name}</h2>
                          <p class="text-sm text-gray-600">料金カテゴリ: ${item.price_category || '-'}</p>
                          <p class="text-sm text-gray-600">数量: ${item.quantity}名</p>
                      </div>

                      <!-- エラーメッセージ -->
                      <div v-if="errorMessage" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-6">
                          {{ errorMessage }}
                      </div>

                      <!-- 成功メッセージ -->
                      <div v-if="successMessage" class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-6">
                          {{ successMessage }}
                      </div>

                      <!-- 参加者フォーム -->
                      <div v-for="(participant, index) in participants" :key="index" class="bg-white rounded-lg shadow-md p-6 mb-6">
                          <h3 class="text-lg font-bold text-gray-900 mb-4">
                              <i class="fas fa-user text-indigo-600 mr-2"></i>
                              参加者 {{ index + 1 }}
                          </h3>

                          <div class="grid md:grid-cols-2 gap-4">
                              <!-- 姓 -->
                              <div v-if="shouldShowField('lastname_kanji')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      姓 <span v-if="isRequired('lastname_kanji')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.lastname"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="山田"
                                  >
                              </div>

                              <!-- 名 -->
                              <div v-if="shouldShowField('firstname_kanji')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      名 <span v-if="isRequired('firstname_kanji')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.firstname"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="太郎"
                                  >
                              </div>

                              <!-- 姓（カナ） -->
                              <div v-if="shouldShowField('lastname_kana')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      姓（カナ） <span v-if="isRequired('lastname_kana')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.lastname_kana"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="ヤマダ"
                                  >
                              </div>

                              <!-- 名（カナ） -->
                              <div v-if="shouldShowField('firstname_kana')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      名（カナ） <span v-if="isRequired('firstname_kana')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="text" 
                                      v-model="participant.firstname_kana"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="タロウ"
                                  >
                              </div>

                              <!-- 年齢 -->
                              <div v-if="shouldShowField('age')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      年齢 <span v-if="isRequired('age')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="number" 
                                      v-model.number="participant.age"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="35"
                                      min="0"
                                      max="150"
                                  >
                              </div>

                              <!-- 性別 -->
                              <div v-if="shouldShowField('gender')">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      性別 <span v-if="isRequired('gender')" class="text-red-600">*</span>
                                  </label>
                                  <select 
                                      v-model="participant.gender"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                  >
                                      <option value="">選択してください</option>
                                      <option value="1">男性</option>
                                      <option value="2">女性</option>
                                      <option value="9">その他</option>
                                  </select>
                              </div>

                              <!-- メールアドレス -->
                              <div v-if="shouldShowField('email')" class="md:col-span-2">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      メールアドレス <span v-if="isRequired('email')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="email" 
                                      v-model="participant.email"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="example@example.com"
                                  >
                              </div>

                              <!-- 電話番号 -->
                              <div v-if="shouldShowField('phone')" class="md:col-span-2">
                                  <label class="block text-sm font-medium text-gray-700 mb-2">
                                      電話番号 <span v-if="isRequired('phone')" class="text-red-600">*</span>
                                  </label>
                                  <input 
                                      type="tel" 
                                      v-model="participant.phone"
                                      class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      placeholder="090-1234-5678"
                                  >
                              </div>

                              <!-- カスタムフィールド -->
                              <template v-for="field in customFields" :key="field.id">
                                  <div 
                                      v-show="shouldShowCustomField(participant, field)"
                                      :class="field.field_type === 'textarea' ? 'md:col-span-2' : ''"
                                  >
                                      <label class="block text-sm font-medium text-gray-700 mb-2">
                                          {{ field.field_label }}
                                          <span v-if="field.is_required" class="text-red-600">*</span>
                                      </label>

                                      <!-- テキスト -->
                                      <input 
                                          v-if="field.field_type === 'text'"
                                          type="text" 
                                          v-model="participant.custom_fields[field.field_name]"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                          :placeholder="field.placeholder || ''"
                                      >

                                      <!-- セレクト -->
                                      <select 
                                          v-else-if="field.field_type === 'select'"
                                          v-model="participant.custom_fields[field.field_name]"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                      >
                                          <option value="">選択してください</option>
                                          <option v-for="option in field.field_options" :key="option" :value="option">
                                              {{ option }}
                                          </option>
                                      </select>

                                      <!-- テキストエリア -->
                                      <textarea 
                                          v-else-if="field.field_type === 'textarea'"
                                          v-model="participant.custom_fields[field.field_name]"
                                          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                                          :placeholder="field.placeholder || ''"
                                          rows="3"
                                      ></textarea>

                                      <!-- ラジオボタン -->
                                      <div v-else-if="field.field_type === 'radio'" class="space-y-2">
                                          <div v-for="option in field.field_options" :key="option">
                                              <label class="inline-flex items-center">
                                                  <input 
                                                      type="radio" 
                                                      :name="'participant_' + index + '_radio_' + field.id"
                                                      :value="option"
                                                      v-model="participant.custom_fields[field.field_name]"
                                                      class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500"
                                                  >
                                                  <span class="ml-2">{{ option }}</span>
                                              </label>
                                          </div>
                                      </div>

                                      <!-- チェックボックス -->
                                      <div v-else-if="field.field_type === 'checkbox'" class="space-y-2">
                                          <div v-for="option in field.field_options" :key="option">
                                              <label class="inline-flex items-center">
                                                  <input 
                                                      type="checkbox" 
                                                      :value="option"
                                                      v-model="participant.custom_fields[field.field_name]"
                                                      class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500"
                                                  >
                                                  <span class="ml-2">{{ option }}</span>
                                              </label>
                                          </div>
                                      </div>

                                      <!-- 説明文 -->
                                      <small v-if="field.description" class="text-gray-600 text-xs block mt-1">
                                          {{ field.description }}
                                      </small>
                                  </div>
                              </template>
                          </div>
                      </div>

                      <!-- 保存ボタン -->
                      <div class="flex gap-4">
                          <button 
                              @click="saveParticipants"
                              :disabled="isLoading"
                              class="flex-1 bg-indigo-600 hover:bg-indigo-700 disabled:bg-gray-400 text-white font-bold py-3 px-8 rounded-lg transition"
                          >
                              <i class="fas fa-save mr-2"></i>
                              <span v-if="isLoading">保存中...</span>
                              <span v-else>参加者情報を保存</span>
                          </button>
                          <a 
                              href="/mypage/booking/${bookingId}"
                              class="bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-3 px-8 rounded-lg transition text-center"
                          >
                              キャンセル
                          </a>
                      </div>
                  </div>
              </main>
          </div>

          <script>
              const { createApp } = Vue;

              createApp({
                  data() {
                      return {
                          participants: ${JSON.stringify(participants)},
                          formSettings: {},
                          customFields: [],
                          isLoading: false,
                          errorMessage: '',
                          successMessage: ''
                      };
                  },
                  async mounted() {
                      await this.loadFormSettings();
                  },
                  methods: {
                      async loadFormSettings() {
                          try {
                              const response = await axios.get('/api/auth/product-form-settings/${item.item_id}');
                              this.formSettings = response.data.form_settings || {};
                              this.customFields = response.data.custom_fields || [];
                              
                              // カスタムフィールドの初期化（チェックボックスは配列、他は空文字列）
                              this.participants.forEach(participant => {
                                  if (!participant.custom_fields) {
                                      participant.custom_fields = {};
                                  }
                                  this.customFields.forEach(field => {
                                      if (field.category === 2 && !participant.custom_fields[field.field_name]) {
                                          // チェックボックスは配列で初期化
                                          if (field.field_type === 'checkbox') {
                                              participant.custom_fields[field.field_name] = [];
                                          } else {
                                              participant.custom_fields[field.field_name] = '';
                                          }
                                      }
                                  });
                              });
                          } catch (error) {
                              console.error('Failed to load form settings:', error);
                              // デフォルト設定
                              this.formSettings = {
                                  lastname_kanji: true,
                                  firstname_kanji: true,
                                  lastname_kana: true,
                                  firstname_kana: true,
                                  age: true,
                                  gender: true
                              };
                          }
                      },
                      shouldShowField(fieldName) {
                          return this.formSettings[fieldName] === true;
                      },
                      isRequired(fieldName) {
                          // 基本的な必須フィールド
                          return ['age', 'gender'].includes(fieldName);
                      },
                      // カスタムフィールドの表示判定（親子関係対応）
                      shouldShowCustomField(participant, field) {
                          // category=2（参加者毎）のフィールドのみ
                          if (field.category !== 2) {
                              return false;
                          }
                          
                          // 親フィールド条件チェック
                          if (field.parent_field_id && field.parent_condition) {
                              // 親フィールドを探す
                              const parentField = this.customFields.find(f => f.id === field.parent_field_id);
                              
                              if (parentField) {
                                  const parentValue = participant.custom_fields[parentField.field_name];
                                  // 親フィールドの値が条件と一致する場合のみ表示
                                  return parentValue === field.parent_condition;
                              }
                              return false;
                          }
                          return true;
                      },
                      async saveParticipants() {
                          this.isLoading = true;
                          this.errorMessage = '';
                          this.successMessage = '';

                          try {
                              const response = await axios.post(
                                  '/api/mypage/booking/${bookingId}/update-participants',
                                  {
                                      item_id: ${itemId},
                                      participants: this.participants
                                  }
                              );

                              if (response.data.success) {
                                  this.successMessage = '参加者情報を保存しました';
                                  // 3秒後に予約詳細ページへリダイレクト
                                  setTimeout(() => {
                                      window.location.href = '/mypage/booking/${bookingId}';
                                  }, 2000);
                              }
                          } catch (error) {
                              console.error('Save failed:', error);
                              this.errorMessage = error.response?.data?.error || '保存に失敗しました';
                          } finally {
                              this.isLoading = false;
                          }
                      }
                  }
              }).mount('#app');
          </script>
      </body>
      </html>
    `)
  } catch (error) {
    console.error('❌ [Mypage] Edit participants error:', error)
    return c.html(`
      <!DOCTYPE html>
      <html lang="ja">
      <head>
          <meta charset="UTF-8">
          <title>エラー | マイページ</title>
          <script src="https://cdn.tailwindcss.com"></script>
      </head>
      <body class="bg-gray-50 min-h-screen flex items-center justify-center">
          <div class="max-w-md mx-auto bg-white rounded-lg shadow-md p-8 text-center">
              <h2 class="text-2xl font-bold text-gray-800 mb-4">エラーが発生しました</h2>
              <p class="text-gray-600 mb-6">${error instanceof Error ? error.message : 'システムエラー'}</p>
              <a href="/mypage/bookings" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-8 rounded-lg transition">
                  予約一覧に戻る
              </a>
          </div>
      </body>
      </html>
    `, 500)
  }
})

// ==========================================
// ワンタイムパスワードログイン機能
// ==========================================

// ワンタイムパスワードログイン画面（メールアドレス入力）
app.get('/admin/login', (c) => {
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ワンタイムパスワードログイン</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-2xl">
            <!-- ヘッダー -->
            <div class="bg-blue-900 text-white rounded-t-lg p-6 shadow-lg">
                <h1 class="text-2xl font-bold flex items-center gap-3">
                    <i class="fas fa-shield-alt"></i>
                    ワンタイムパスワードログイン
                </h1>
            </div>

            <!-- メインコンテンツ -->
            <div class="bg-white rounded-b-lg shadow-lg p-8">
                <div class="mb-8">
                    <h2 class="text-xl font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-clock"></i>
                        ワンタイムパスワードログイン
                    </h2>
                    <p class="text-gray-600 text-sm">
                        セキュアなワンタイムパスワードでログインしてください
                    </p>
                </div>

                <form id="otpRequestForm" class="space-y-6">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-envelope text-blue-600"></i>
                            メールアドレス
                            <span class="text-red-600">*</span>
                        </label>
                        <input 
                            type="email" 
                            id="email" 
                            name="email" 
                            required
                            placeholder="example@keio.co.jp"
                            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base"
                        >
                        <span id="emailError" class="text-xs text-red-600 mt-1 hidden">
                            <i class="fas fa-exclamation-circle mr-1"></i>
                            メールアドレスを正しく入力してください
                        </span>
                    </div>

                    <button 
                        type="submit"
                        class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition font-semibold text-base flex items-center justify-center gap-2"
                    >
                        <i class="fas fa-key"></i>
                        ワンタイムパスワードを送信
                    </button>

                    <p class="text-xs text-gray-500 text-center">
                        登録されているメールアドレスに一度だけ使用できるパスワードを送信します
                    </p>
                </form>

                <!-- 特徴説明 -->
                <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle text-blue-600"></i>
                        ワンタイムパスワードの特徴
                    </h3>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>一度だけ使用可能:</strong> パスワードは一度の使用後に使用不可になります</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>有効期間:</strong> パスワードは10分間の有効です</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>高セキュリティ:</strong> 不正アクセスを防止し、安全性を高めています</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>メール送信:</strong> 登録済みのアドレスに新しいパスワードを送信します</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            document.getElementById('otpRequestForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const email = document.getElementById('email').value.trim();
                const emailError = document.getElementById('emailError');
                
                // 簡易バリデーション
                if (!email || !email.includes('@')) {
                    emailError.classList.remove('hidden');
                    return;
                }
                
                emailError.classList.add('hidden');
                
                // ワンタイムパスワード入力画面に遷移（メールアドレスをクエリパラメータで渡す）
                window.location.href = '/admin/login/otp?email=' + encodeURIComponent(email);
            });
        </script>
    </body>
    </html>
  `)
})

// ワンタイムパスワード入力画面
app.get('/admin/login/otp', (c) => {
  const email = c.req.query('email') || ''
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ワンタイムパスワード入力</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gray-100 min-h-screen flex items-center justify-center p-4">
        <div class="w-full max-w-2xl">
            <!-- ヘッダー -->
            <div class="bg-blue-900 text-white rounded-t-lg p-6 shadow-lg">
                <h1 class="text-2xl font-bold flex items-center gap-3">
                    <i class="fas fa-shield-alt"></i>
                    ワンタイムパスワードログイン
                </h1>
            </div>

            <!-- メインコンテンツ -->
            <div class="bg-white rounded-b-lg shadow-lg p-8">
                <div class="mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-clock"></i>
                        ワンタイムパスワード入力
                    </h2>
                    <p class="text-gray-600 text-sm">
                        メールで送信された一度だけ使用可能なパスワードを入力してください
                    </p>
                </div>

                <!-- 送信完了メッセージ -->
                <div class="mb-6 bg-green-50 border border-green-300 rounded-lg p-4">
                    <p class="text-green-800 text-sm font-semibold mb-2">
                        <i class="fas fa-check-circle mr-2"></i>
                        ワンタイムパスワード送信完了
                    </p>
                    <p class="text-green-700 text-sm mb-1">
                        <strong>${email}</strong> にワンタイムパスワードを送信しました。
                    </p>
                    <p class="text-green-600 text-xs">
                        メールを確認してパスワードを入力してください。
                    </p>
                    <p class="text-orange-600 text-xs mt-2 flex items-center gap-1">
                        <i class="fas fa-clock"></i>
                        <strong>有効期間:</strong> 00:39
                    </p>
                </div>

                <form id="otpLoginForm" class="space-y-6">
                    <input type="hidden" id="email" value="${email}">
                    
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center gap-2">
                            <i class="fas fa-key text-blue-600"></i>
                            ワンタイムパスワード
                            <span class="text-red-600">*</span>
                        </label>
                        <div class="relative">
                            <input 
                                type="password" 
                                id="otp" 
                                name="otp" 
                                required
                                placeholder="メールで送信されたワンタイム"
                                maxlength="6"
                                class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-base"
                            >
                            <button 
                                type="button" 
                                id="togglePassword"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700"
                            >
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span id="otpError" class="text-xs text-red-600 mt-1 hidden">
                            <i class="fas fa-exclamation-circle mr-1"></i>
                            パスワードが正しくありません
                        </span>
                    </div>

                    <div class="flex gap-4">
                        <button 
                            type="button"
                            onclick="window.location.href='/admin/login'"
                            class="flex-1 bg-gray-200 text-gray-700 py-3 rounded-lg hover:bg-gray-300 transition font-semibold text-base flex items-center justify-center gap-2"
                        >
                            <i class="fas fa-arrow-left"></i>
                            戻る
                        </button>
                        <button 
                            type="submit"
                            class="flex-1 bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition font-semibold text-base flex items-center justify-center gap-2"
                        >
                            <i class="fas fa-sign-in-alt"></i>
                            ログイン
                        </button>
                    </div>
                </form>

                <!-- 説明 -->
                <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <h3 class="text-sm font-bold text-gray-800 mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle text-blue-600"></i>
                        ワンタイムパスワードについて
                    </h3>
                    <ul class="space-y-2 text-sm text-gray-700">
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>一度だけ使用:</strong> パスワードは一度使用すると無効になります</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>有効期限:</strong> 10分間の有効です。期限切れの場合は再発行してください</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>正確な入力:</strong> メールに記載されたパスワードを正確に入力してください</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fas fa-check text-green-600 mt-1"></i>
                            <span><strong>ログイン後:</strong> 管理画面に自動リダイレクトします</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
        <script>
            // パスワード表示切替
            document.getElementById('togglePassword').addEventListener('click', function() {
                const otpInput = document.getElementById('otp');
                const icon = this.querySelector('i');
                
                if (otpInput.type === 'password') {
                    otpInput.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    otpInput.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });

            // ログイン処理
            document.getElementById('otpLoginForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const email = document.getElementById('email').value;
                const otp = document.getElementById('otp').value.trim();
                const otpError = document.getElementById('otpError');
                
                // テスト用: 9999 で認証成功
                if (otp === '9999') {
                    // セッションCookieを設定（簡易実装）
                    document.cookie = 'login=admin_id=1; path=/; max-age=86400';
                    
                    // 管理画面にリダイレクト
                    window.location.href = '/admin';
                } else {
                    // エラー表示
                    otpError.classList.remove('hidden');
                    document.getElementById('otp').classList.add('border-red-500');
                }
            });
        </script>
    </body>
    </html>
  `)
})

