                                    </label>
                                    <select id="pref_id" required
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                                        <option value="">選択してください</option>
                                        ${prefs.map(p => `<option value="${p.id}">${p.name}</option>`).join('')}
                                    </select>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        住所<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="addr" required
                                           placeholder="市区町村・番地・建物名"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                                </div>
                            </div>
                        </div>

                        <!-- 利用規約 -->
                        <div>
                            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                                <label class="flex items-start cursor-pointer">
                                    <input type="checkbox" id="agree_terms" required
                                           class="mt-1 w-5 h-5 text-purple-600 border-gray-300 rounded focus:ring-purple-500">
                                    <span class="ml-3 text-sm text-gray-700">
                                        <a href="/terms" target="_blank" class="text-blue-600 hover:underline font-semibold">利用規約</a>に同意します<span class="text-red-500 ml-1">*</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        <!-- エラーメッセージ -->
                        <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
                            <i class="fas fa-exclamation-circle mr-2"></i>
                            <span id="errorText"></span>
                        </div>

                        <!-- 送信ボタン -->
                        <div class="flex gap-4">
                            <button type="button" onclick="history.back()"
                                    class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 font-bold py-4 rounded-lg transition duration-200">
                                <i class="fas fa-arrow-left mr-2"></i>戻る
                            </button>
                            <button type="submit" id="registerBtn"
                                    class="flex-1 bg-purple-600 hover:bg-purple-700 text-white font-bold py-4 rounded-lg transition duration-200 shadow-lg">
                                <i class="fas fa-user-plus mr-2"></i>会員登録して予約を続ける
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            // パスワードバリデーション
            function validatePassword(password) {
                if (password.length < 8) {
                    return 'パスワードは8文字以上で入力してください';
                }
                if (!/[0-9]/.test(password)) {
                    return 'パスワードには数字を含めてください';
                }
                if (!/[a-z]/.test(password)) {
                    return 'パスワードには英小文字を含めてください';
                }
                if (!/[A-Z]/.test(password)) {
                    return 'パスワードには英大文字を含めてください';
                }
                return null;
            }

            document.getElementById('registerForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const password = document.getElementById('password').value;
                const passwordConfirm = document.getElementById('password_confirm').value;
                const registerBtn = document.getElementById('registerBtn');
                const errorMessage = document.getElementById('errorMessage');
                const errorText = document.getElementById('errorText');
                
                // エラーメッセージを非表示
                errorMessage.classList.add('hidden');
                
                // パスワードバリデーション
                const passwordError = validatePassword(password);
                if (passwordError) {
                    errorText.textContent = passwordError;
                    errorMessage.classList.remove('hidden');
                    return;
                }
                
                // パスワード一致確認
                if (password !== passwordConfirm) {
                    errorText.textContent = 'パスワードが一致しません';
                    errorMessage.classList.remove('hidden');
                    return;
                }
                
                // ボタンを無効化
                registerBtn.disabled = true;
                registerBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>登録中...';
                
                try {
                    const response = await axios.post('/api/booking/register', {
                        email: document.getElementById('email').value,
                        password: password,
                        family_name: document.getElementById('family_name').value,
                        first_name: document.getElementById('first_name').value,
                        family_kana: document.getElementById('family_kana').value,
                        first_kana: document.getElementById('first_kana').value,
                        birth: document.getElementById('birth').value,
                        sex: document.getElementById('sex').value,
                        tel: document.getElementById('tel').value,
                        zip: document.getElementById('zip').value,
                        pref_id: document.getElementById('pref_id').value,
                        addr: document.getElementById('addr').value
                    });
                    
                    if (response.data.success) {
                        // 登録成功：顧客情報入力画面へ
                        alert('会員登録が完了しました！');
                        window.location.href = '/booking/customer-info?event_id=${eventId}';
                    }
                } catch (error) {
                    // エラー表示
                    errorText.textContent = error.response?.data?.error || '登録に失敗しました';
                    errorMessage.classList.remove('hidden');
                    
                    // ボタンを再有効化
                    registerBtn.disabled = false;
                    registerBtn.innerHTML = '<i class="fas fa-user-plus mr-2"></i>会員登録して予約を続ける';
                }
            });
        </script>
    </body>
    </html>
  `)
})

// ========================
// 予約フロー：会員認証API
// ========================

// 会員登録API
app.post('/api/booking/register', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須項目チェック
    if (!data.email || !data.password || !data.family_name || !data.first_name ||
        !data.family_kana || !data.first_kana || !data.birth || !data.sex || !data.tel ||
        !data.zip || !data.pref_id || !data.addr) {
      return c.json({ error: '必須項目が入力されていません' }, 400)
    }
    
    // パスワードバリデーション
    if (data.password.length < 8) {
      return c.json({ error: 'パスワードは8文字以上で入力してください' }, 400)
    }
    if (!/[0-9]/.test(data.password)) {
      return c.json({ error: 'パスワードには数字を含めてください' }, 400)
    }
    if (!/[a-z]/.test(data.password)) {
      return c.json({ error: 'パスワードには英小文字を含めてください' }, 400)
    }
    if (!/[A-Z]/.test(data.password)) {
      return c.json({ error: 'パスワードには英大文字を含めてください' }, 400)
    }
    
    // メールアドレス重複チェック
    const existing = await DB.prepare(
      'SELECT id FROM members WHERE email = ?'
    ).bind(data.email).first()
    
    if (existing) {
      return c.json({ error: 'このメールアドレスは既に登録されています' }, 400)
    }
    
    // パスワードハッシュ化（簡易版：本番環境ではbcryptなど使用）
    const passwordHash = await hashPassword(data.password)
    
    // 会員登録
    const result = await DB.prepare(`
      INSERT INTO members (
        email, password_hash, family_name, first_name,
        family_kana, first_kana, birth, sex, tel, zip, pref_id, addr, enable_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)
    `).bind(
      data.email,
      passwordHash,
      data.family_name,
      data.first_name,
      data.family_kana,
      data.first_kana,
      data.birth,
      data.sex,
      data.tel,
      data.zip,
      parseInt(data.pref_id),
      data.addr
    ).run()
    
    const memberId = result.meta.last_row_id
    
    // セッション作成（簡易版：Cookieにmember_idを保存）
    c.header('Set-Cookie', `member_id=${memberId}; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400`)
    
    return c.json({
      success: true,
      member_id: memberId,
      message: '会員登録が完了しました'
    })
  } catch (error) {
    console.error('会員登録エラー:', error)
    return c.json({ error: '会員登録に失敗しました' }, 500)
  }
})

// ログインAPI
app.post('/api/booking/login', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須項目チェック
    if (!data.email || !data.password) {
      return c.json({ error: 'メールアドレスとパスワードを入力してください' }, 400)
    }
    
    // 会員検索
    const member = await DB.prepare(
      'SELECT * FROM members WHERE email = ? AND enable_flg = 1'
    ).bind(data.email).first()
    
    if (!member) {
      return c.json({ error: 'メールアドレスまたはパスワードが正しくありません' }, 401)
    }
    
    // パスワード検証
    const isValid = await verifyPassword(data.password, member.password_hash)
    
    if (!isValid) {
      return c.json({ error: 'メールアドレスまたはパスワードが正しくありません' }, 401)
    }
    
    // セッション作成
    c.header('Set-Cookie', `member_id=${member.id}; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400`)
    
    return c.json({
      success: true,
      member_id: member.id,
      message: 'ログインしました'
    })
  } catch (error) {
    console.error('ログインエラー:', error)
    return c.json({ error: 'ログインに失敗しました' }, 500)
  }
})

// パスワードハッシュ化（簡易版）
async function hashPassword(password: string): Promise<string> {
  // Web Crypto APIを使用してハッシュ化
  const encoder = new TextEncoder()
  const data = encoder.encode(password)
  const hashBuffer = await crypto.subtle.digest('SHA-256', data)
  const hashArray = Array.from(new Uint8Array(hashBuffer))
  const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('')
  return hashHex
}

// パスワード検証
async function verifyPassword(password: string, hash: string): Promise<boolean> {
  const passwordHash = await hashPassword(password)
  return passwordHash === hash
}

