// メールテンプレート新規作成
app.post('/api/v2/email-templates', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const { template_name, description, from_email, bcc_email, subject_template, body_template } = body
    
    // バリデーション
    if (!template_name || !from_email || !subject_template || !body_template) {
      return c.json({ error: '必須項目（テンプレート名、差出人、件名、本文）が入力されていません' }, 400)
    }
    
    // メールアドレスの形式チェック
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
    if (!emailRegex.test(from_email)) {
      return c.json({ error: '差出人のメールアドレスが正しくありません' }, 400)
    }
    
    if (bcc_email && !emailRegex.test(bcc_email)) {
      return c.json({ error: 'BCCのメールアドレスが正しくありません' }, 400)
    }
    
    // 同名テンプレートの確認
    const existing = await DB.prepare(`
      SELECT id FROM email_templates WHERE template_name = ?
    `).bind(template_name).first()
    
    if (existing) {
      return c.json({ error: 'この名前のテンプレートは既に存在します。別の名前を指定してください。' }, 409)
    }
    
    // テンプレート作成
    const result = await DB.prepare(`
      INSERT INTO email_templates (
        template_name, description, from_email, bcc_email,
        subject_template, body_template, is_active
      ) VALUES (?, ?, ?, ?, ?, ?, 1)
    `).bind(
      template_name,
      description || null,
      from_email,
      bcc_email || null,
      subject_template,
      body_template
    ).run()
    
    console.log('テンプレート作成成功:', { id: result.meta.last_row_id, template_name })
    
    return c.json({
      success: true,
      id: result.meta.last_row_id,
      message: `テンプレート「${template_name}」を保存しました`
    })
    
  } catch (error: any) {
    console.error('テンプレート作成エラー:', error)
    return c.json({ error: 'テンプレートの保存に失敗しました' }, 500)
  }
})

// メールプレビュー生成
// 一括メールプレビュー
// 支店管理者は担当イベントの予約のみ
app.post('/api/v2/bulk-emails/preview', requireAuth, async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    const { booking_number, subject_template, body_template } = data
    
    if (!booking_number || !subject_template || !body_template) {
      return c.json({ error: '必須パラメータが不足しています' }, 400)
    }
    
    // 予約情報を取得
    const booking = await DB.prepare(`
      SELECT 
        b.*,
        c.family_name,
        c.first_name,
        c.family_kana,
        c.first_kana,
        c.email,
        c.mobile,
        c.zip,
        c.address,
        e.name as event_name,
        e.event_start_date,
        e.event_end_date,
        cl.name AS client_name,
        org.name AS organizer_name
      FROM bookings b
      LEFT JOIN members c ON b.member_id = c.id
      LEFT JOIN events e ON b.event_id = e.id
      LEFT JOIN clients cl ON e.client_id = cl.id
      LEFT JOIN organizers org ON e.organizer_id = org.id
      WHERE b.booking_number = ?
    `).bind(booking_number).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // 件名と本文を埋め込み
    const filledSubject = fillEmailTemplate(subject_template, booking)
    const filledBody = fillEmailTemplate(body_template, booking)
    
    return c.json({
      success: true,
      preview: {
        to_email: booking.email,
        subject: filledSubject,
        body: filledBody
      }
    })
  } catch (error: any) {
    console.error('プレビュー生成エラー:', error)
    return c.json({ error: 'プレビュー生成に失敗しました' }, 500)
  }
})

// 一括メール登録
// 支店管理者は担当イベントの予約のみ
app.post('/api/v2/bulk-emails/register', requireAuth, async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    const { 
      from_email, 
      bcc_email, 
      subject_template, 
      body_template, 
      scheduled_send_at, 
      booking_numbers,
      template_id 
    } = data
    
    if (!from_email || !subject_template || !body_template || !scheduled_send_at || !booking_numbers || booking_numbers.length === 0) {
      return c.json({ error: '必須パラメータが不足しています' }, 400)
    }
    
    const jobId = `job_${Date.now()}_${Math.random().toString(36).substring(7)}`
    
    // バックグラウンド処理を開始
    c.executionCtx.waitUntil(
      processBulkEmails(DB, jobId, {
        from_email,
        bcc_email,
        subject_template,
        body_template,
        scheduled_send_at,
        booking_numbers,
        template_id
      })
    )
    
    return c.json({
      success: true,
      job_id: jobId,
      total: booking_numbers.length,
      message: 'メール登録を開始しました'
    })
  } catch (error: any) {
    console.error('一括メール登録エラー:', error)
    return c.json({ error: 'メール登録に失敗しました' }, 500)
  }
})

// ジョブステータス取得
app.get('/api/v2/bulk-emails/status/:jobId', async (c) => {
  const jobId = c.req.param('jobId')
  
  // 実装は簡略化：実際のステータスは KV などに保存する必要がある
  // ここでは完了状態を返す
  return c.json({
    success: true,
    job_id: jobId,
    status: 'completed',
    message: 'メール登録が完了しました'
  })
})

// メールテンプレート埋め込み関数
function fillEmailTemplate(template: string, booking: any): string {
  let filled = template
  
  // 予約情報
  filled = filled.replace(/{{booking_number}}/g, booking.booking_number || '')
  filled = filled.replace(/{{booking_status}}/g, booking.status || '')
  filled = filled.replace(/{{booker_name}}/g, booking.booker_name || '')
  filled = filled.replace(/{{booker_email}}/g, booking.booker_email || '')
  filled = filled.replace(/{{booker_phone}}/g, booking.booker_phone || '')
  
  // 顧客情報
  filled = filled.replace(/{{customer_name}}/g, `${booking.family_name || ''} ${booking.first_name || ''}`.trim())
  filled = filled.replace(/{{customer_name_kana}}/g, `${booking.family_kana || ''} ${booking.first_kana || ''}`.trim())
  filled = filled.replace(/{{customer_email}}/g, booking.email || '')
  filled = filled.replace(/{{customer_phone}}/g, booking.mobile || '')
  filled = filled.replace(/{{customer_zip}}/g, booking.zip || '')
  filled = filled.replace(/{{customer_address}}/g, booking.address || '')
  
  // イベント情報
  filled = filled.replace(/{{event_name}}/g, booking.event_name || '')
  filled = filled.replace(/{{event_start_date}}/g, booking.event_start_date || '')
  filled = filled.replace(/{{event_end_date}}/g, booking.event_end_date || '')
  filled = filled.replace(/{{client_name}}/g, booking.client_name || '')
  filled = filled.replace(/{{organizer_name}}/g, booking.organizer_name || '')
  
  // システム変数
  const today = new Date().toISOString().split('T')[0]
  filled = filled.replace(/{{today}}/g, today)
  
  return filled
}

// 一括メール処理（バックグラウンド）
async function processBulkEmails(
  DB: D1Database,
  jobId: string,
  params: {
    from_email: string
    bcc_email?: string
    subject_template: string
    body_template: string
    scheduled_send_at: string
    booking_numbers: string[]
    template_id?: number
  }
) {
  const { from_email, bcc_email, subject_template, body_template, scheduled_send_at, booking_numbers, template_id } = params
  
  console.log(`🚀 一括メール登録開始: ${jobId}`)
  console.log(`📧 対象予約数: ${booking_numbers.length}`)
  
  let registered = 0
  const errors: any[] = []
  
  for (const bookingNumber of booking_numbers) {
    try {
      // 予約情報を取得
      const booking = await DB.prepare(`
        SELECT 
          b.*,
          c.family_name,
          c.first_name,
          c.family_kana,
          c.first_kana,
          c.email,
          c.mobile,
          c.zip,
          c.address,
          e.name as event_name,
          e.event_start_date,
          e.event_end_date,
          cl.name AS client_name,
          org.name AS organizer_name
        FROM bookings b
        LEFT JOIN members c ON b.member_id = c.id
        LEFT JOIN events e ON b.event_id = e.id
        LEFT JOIN clients cl ON e.client_id = cl.id
        LEFT JOIN organizers org ON e.organizer_id = org.id
        WHERE b.booking_number = ?
      `).bind(bookingNumber).first()
      
      if (!booking) {
        errors.push({
          booking_number: bookingNumber,
          error: '予約が見つかりません'
        })
        continue
      }
      
      if (!booking.email) {
        errors.push({
          booking_number: bookingNumber,
          error: 'メールアドレスが登録されていません'
        })
        continue
      }
      
      // テンプレートを埋め込み
      const subject = fillEmailTemplate(subject_template, booking)
      const body = fillEmailTemplate(body_template, booking)
      
      // booking_emails テーブルに登録
      await DB.prepare(`
        INSERT INTO booking_emails (
          booking_number,
          from_email,
          to_email,
          bcc_email,
          subject,
          body,
          scheduled_send_at,
          send_status,
          template_id
        ) VALUES (?, ?, ?, ?, ?, ?, ?, 'pending', ?)
      `).bind(
        bookingNumber,
        from_email,
        booking.email,
        bcc_email || null,
        subject,
        body,
        scheduled_send_at,
        template_id || null
      ).run()
      
      registered++
      console.log(`✅ 登録完了: ${bookingNumber} -> ${booking.email}`)
    } catch (error: any) {
      console.error(`❌ 登録失敗: ${bookingNumber}`, error)
      errors.push({
        booking_number: bookingNumber,
        error: error.message
      })
    }
  }
  
  console.log(`✨ 一括メール登録完了: ${jobId}`)
  console.log(`   登録成功: ${registered}件`)
  console.log(`   登録失敗: ${errors.length}件`)
  
  // 結果をKVに保存（実装省略）
  // await KV.put(`bulk-email-job:${jobId}`, JSON.stringify({
  //   status: 'completed',
  //   registered,
  //   errors
  // }))
}

