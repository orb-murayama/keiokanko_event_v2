// API - OTP生成とメール送信
app.post('/api/auth/send-otp', async (c) => {
  const { DB } = c.env
  const { email } = await c.req.json()
  
  if (!email) {
    return c.json({ error: 'メールアドレスが必要です' }, 400)
  }
  
  try {
    // メールアドレスが登録されているか確認
    const customer = await DB.prepare(`
      SELECT * FROM members WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.json({ error: 'このメールアドレスでの予約が見つかりません' }, 404)
    }
    
    // 6桁のOTPコードを生成
    const otpCode = Math.floor(100000 + Math.random() * 900000).toString()
    
    // 有効期限を10分後に設定
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000).toISOString()
    
    // 既存の未使用OTPを無効化
    await DB.prepare(`
      UPDATE otp_codes 
      SET is_used = 1 
      WHERE email = ? AND is_used = 0
    `).bind(email).run()
    
    // 新しいOTPを保存
    await DB.prepare(`
      INSERT INTO otp_codes (email, code, expires_at)
      VALUES (?, ?, ?)
    `).bind(email, otpCode, expiresAt).run()
    
    // 本番環境ではメール送信サービスを使用
    // 開発環境ではコンソールにOTPを出力
    console.log('='.repeat(50))
    console.log('📧 OTP送信シミュレーション')
    console.log(`宛先: ${email}`)
    console.log(`OTPコード: ${otpCode}`)
    console.log(`有効期限: ${new Date(expiresAt).toLocaleString('ja-JP')}`)
    console.log('='.repeat(50))
    
    return c.json({ 
      success: true,
      message: 'ワンタイムパスワードを送信しました',
      // 開発環境でのテスト用（本番環境では削除すること）
      dev_otp: otpCode
    })
  } catch (error) {
    console.error('OTP generation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - OTP検証
app.post('/api/auth/verify-otp', async (c) => {
  const { DB } = c.env
  const { email, code } = await c.req.json()
  
  if (!email || !code) {
    return c.json({ error: 'メールアドレスとOTPコードが必要です' }, 400)
  }
  
  try {
    // OTPコードを取得
    const otp = await DB.prepare(`
      SELECT * FROM otp_codes 
      WHERE email = ? AND code = ? AND is_used = 0
      ORDER BY created_at DESC
      LIMIT 1
    `).bind(email, code).first()
    
    if (!otp) {
      // 試行回数をカウント（セキュリティ対策）
      await DB.prepare(`
        UPDATE otp_codes 
        SET attempt_count = attempt_count + 1
        WHERE email = ? AND is_used = 0
      `).bind(email).run()
      
      return c.json({ error: 'OTPコードが正しくありません' }, 401)
    }
    
    // 有効期限チェック
    const now = new Date()
    const expiresAt = new Date(otp.expires_at)
    
    if (now > expiresAt) {
      return c.json({ error: 'OTPコードの有効期限が切れています' }, 401)
    }
    
    // 試行回数チェック（5回まで）
    if (otp.attempt_count >= 5) {
      return c.json({ error: '試行回数が上限に達しました。新しいOTPを取得してください' }, 429)
    }
    
    // セッショントークン生成
    const sessionToken = crypto.randomUUID()
    
    // OTPを使用済みにし、セッショントークンを保存
    await DB.prepare(`
      UPDATE otp_codes 
      SET is_used = 1, 
          used_at = datetime('now', 'localtime'),
          session_token = ?
      WHERE id = ?
    `).bind(sessionToken, otp.id).run()
    
    // Cookieにセッショントークンを保存（24時間有効）
    c.header('Set-Cookie', `mypage_session_token=${sessionToken}; Path=/; HttpOnly; SameSite=Lax; Max-Age=86400`)
    
    return c.json({ 
      success: true,
      message: '認証に成功しました',
      email: email
    })
  } catch (error) {
    console.error('OTP verification error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - マイページセッション確認
app.get('/api/mypage/check-session', async (c) => {
  const { DB } = c.env
  const sessionToken = getCookie(c, 'mypage_session_token')
  
  if (!sessionToken) {
    return c.json({ authenticated: false }, 401)
  }
  
  try {
    const otpRecord = await DB.prepare(`
      SELECT email, used_at FROM otp_codes 
      WHERE session_token = ? AND is_used = 1
      ORDER BY used_at DESC
      LIMIT 1
    `).bind(sessionToken).first()
    
    if (!otpRecord) {
      return c.json({ authenticated: false }, 401)
    }
    
    // セッショントークンの有効期限確認（24時間）
    const usedAt = new Date(otpRecord.used_at)
    const now = new Date()
    const diffHours = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    if (diffHours > 24) {
      return c.json({ authenticated: false, reason: 'expired' }, 401)
    }
    
    return c.json({ 
      authenticated: true,
      email: otpRecord.email
    })
  } catch (error) {
    console.error('Session check error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - マイページログアウト
app.post('/api/mypage/logout', async (c) => {
  // Cookieを削除
  c.header('Set-Cookie', `mypage_session_token=; Path=/; HttpOnly; SameSite=Lax; Max-Age=0`)
  
  return c.json({ 
    success: true,
    message: 'ログアウトしました'
  })
})

// マイページ - ログイン画面
// マイページ - 予約一覧
app.get('/api/mypage/bookings', async (c) => {
  const { DB } = c.env
  const email = c.req.query('email')
  
  if (!email) {
    return c.json({ error: 'メールアドレスが必要です' }, 400)
  }
  
  try {
    // 顧客情報を取得
    const customer = await DB.prepare(`
      SELECT * FROM members WHERE email = ?
    `).bind(email).first()
    
    if (!customer) {
      return c.json({ bookings: [] })
    }
    
    // 予約一覧を取得
    const { results: bookings } = await DB.prepare(`
      SELECT 
        pb.*,
        p.name as product_name,
        ps.date,
        ps.stock_name,
        ps.price_band,
        e.name as event_name
      FROM product_bookings pb
      JOIN products p ON pb.product_id = p.id
      JOIN events e ON p.event_id = e.id
      LEFT JOIN product_stocks ps ON pb.product_stock_id = ps.id
      WHERE pb.member_id = ?
      ORDER BY pb.created_at DESC
    `).bind(customer.id).all()
    
    return c.json({ bookings })
  } catch (error) {
    console.error('Mypage API error:', error)
    return c.json({ error: error.message }, 500)
  }
})

