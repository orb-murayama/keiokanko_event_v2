// API: アカウント一覧取得
app.get('/api/accounts', requireAuth, async (c) => {
  const { DB } = c.env
  
  try {
    // クエリパラメータ取得
    const page = c.req.query('page') ? parseInt(c.req.query('page')) : null
    const perPage = c.req.query('per_page') ? parseInt(c.req.query('per_page')) : 20
    
    // 検索条件
    const loginId = c.req.query('login_id') || ''
    const personName = c.req.query('person_name') || ''
    const email = c.req.query('email') || ''
    const role = c.req.query('role') || ''
    const clientId = c.req.query('client_id') || ''
    const status = c.req.query('status') || ''
    
    // WHERE句の構築
    let whereConditions = []
    let bindings = []
    
    if (loginId) {
      whereConditions.push('a.login_id LIKE ?')
      bindings.push(`%${loginId}%`)
    }
    if (personName) {
      whereConditions.push('a.person_name LIKE ?')
      bindings.push(`%${personName}%`)
    }
    if (email) {
      whereConditions.push('a.email LIKE ?')
      bindings.push(`%${email}%`)
    }
    if (role) {
      whereConditions.push('a.role = ?')
      bindings.push(role)
    }
    if (clientId) {
      whereConditions.push('a.client_id = ?')
      bindings.push(clientId)
    }
    if (status === 'active') {
      whereConditions.push('a.enable_flg = 1')
    }
    
    const whereClause = whereConditions.length > 0 
      ? 'WHERE ' + whereConditions.join(' AND ')
      : ''
    
    // パラメータなしの場合は全件取得
    if (!page && !c.req.query('per_page')) {
      const { results: accounts } = await DB.prepare(`
        SELECT 
          a.*,
          c.name as client_name,
          b.branch_name
        FROM accounts a
        LEFT JOIN clients c ON a.client_id = c.id
        LEFT JOIN branches b ON a.primary_branch_code = b.branch_code
        ${whereClause}
        ORDER BY a.created_at DESC
      `).bind(...bindings).all()
      
      return c.json(accounts)
    }
    
    // ページネーション付き取得
    const pageNum = page || 1
    const offset = (pageNum - 1) * perPage
    
    // 総件数取得
    const { results: countResult } = await DB.prepare(`
      SELECT COUNT(*) as total
      FROM accounts a
      ${whereClause}
    `).bind(...bindings).all()
    
    const total = countResult[0].total
    
    // データ取得
    const { results: accounts } = await DB.prepare(`
      SELECT 
        a.*,
        c.name as client_name,
        b.branch_name
      FROM accounts a
      LEFT JOIN clients c ON a.client_id = c.id
      LEFT JOIN branches b ON a.primary_branch_code = b.branch_code
      ${whereClause}
      ORDER BY a.created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...bindings, perPage, offset).all()
    
    return c.json({
      data: accounts,
      pagination: {
        page: pageNum,
        per_page: perPage,
        total,
        total_pages: Math.ceil(total / perPage)
      }
    })
  } catch (error) {
    console.error('アカウント一覧取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント登録API
// API: アカウント作成
app.post('/api/accounts', requireAuth, async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    // ログインIDの重複チェック
    const existing = await DB.prepare(`
      SELECT id FROM accounts WHERE login_id = ?
    `).bind(data.login_id).first()
    
    if (existing) {
      return c.json({ error: 'このログインIDは既に使用されています' }, 400)
    }

    const result = await DB.prepare(`
      INSERT INTO accounts (
        client_id, login_id, password, person_name, email, tel, mobile, role, enable_flg,
        account_type, primary_branch_code, accessible_branches, expiration_date
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.client_id || null,
      data.login_id,
      data.password,
      data.person_name,
      data.email,
      data.tel || null,
      data.mobile || null,
      data.role,
      data.enable_flg,
      data.account_type || 'keio',
      data.primary_branch_code || null,
      data.accessible_branches || null,
      data.expiration_date || null
    ).run()

    return c.json({ id: result.meta.last_row_id, message: 'アカウントを登録しました' })
  } catch (error) {
    console.error('アカウント登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント詳細取得API
// API: アカウント詳細取得
app.get('/api/accounts/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const account = await DB.prepare(`
      SELECT 
        a.*,
        c.name as client_name
      FROM accounts a
      LEFT JOIN clients c ON a.client_id = c.id
      WHERE a.id = ?
    `).bind(id).first()
    
    if (!account) {
      return c.json({ error: 'アカウントが見つかりません' }, 404)
    }
    
    return c.json(account)
  } catch (error) {
    console.error('アカウント詳細取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント更新API
// API: アカウント更新
app.put('/api/accounts/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // ログインIDの重複チェック（自分以外）
    if (data.login_id) {
      const existing = await DB.prepare(`
        SELECT id FROM accounts WHERE login_id = ? AND id != ?
      `).bind(data.login_id, id).first()
      
      if (existing) {
        return c.json({ error: 'このログインIDは既に使用されています' }, 400)
      }
    }
    
    // 更新フィールドの構築
    let updateFields = []
    let bindings = []
    
    if (data.login_id !== undefined) {
      updateFields.push('login_id = ?')
      bindings.push(data.login_id)
    }
    if (data.password !== undefined && data.password !== '') {
      updateFields.push('password = ?')
      bindings.push(data.password)
    }
    if (data.person_name !== undefined) {
      updateFields.push('person_name = ?')
      bindings.push(data.person_name)
    }
    if (data.email !== undefined) {
      updateFields.push('email = ?')
      bindings.push(data.email)
    }
    if (data.tel !== undefined) {
      updateFields.push('tel = ?')
      bindings.push(data.tel || null)
    }
    if (data.mobile !== undefined) {
      updateFields.push('mobile = ?')
      bindings.push(data.mobile || null)
    }
    if (data.role !== undefined) {
      updateFields.push('role = ?')
      bindings.push(data.role)
    }
    if (data.client_id !== undefined) {
      updateFields.push('client_id = ?')
      bindings.push(data.client_id || null)
    }
    if (data.enable_flg !== undefined) {
      updateFields.push('enable_flg = ?')
      bindings.push(data.enable_flg)
    }
    if (data.account_type !== undefined) {
      updateFields.push('account_type = ?')
      bindings.push(data.account_type || 'keio')
    }
    if (data.primary_branch_code !== undefined) {
      updateFields.push('primary_branch_code = ?')
      bindings.push(data.primary_branch_code || null)
    }
    if (data.accessible_branches !== undefined) {
      updateFields.push('accessible_branches = ?')
      bindings.push(data.accessible_branches || null)
    }
    if (data.expiration_date !== undefined) {
      updateFields.push('expiration_date = ?')
      bindings.push(data.expiration_date || null)
    }
    
    updateFields.push('modified_at = datetime("now", "localtime")')
    
    bindings.push(id)
    
    await DB.prepare(`
      UPDATE accounts 
      SET ${updateFields.join(', ')}
      WHERE id = ?
    `).bind(...bindings).run()
    
    return c.json({ message: 'アカウントを更新しました' })
  } catch (error) {
    console.error('アカウント更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// アカウント削除API
// API: アカウント削除
app.delete('/api/accounts/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    // アカウントが存在するか確認
    const account = await DB.prepare(`
      SELECT id, login_id FROM accounts WHERE id = ?
    `).bind(id).first()
    
    if (!account) {
      return c.json({ error: 'アカウントが見つかりません' }, 404)
    }
    
    // 物理削除（完全削除）
    await DB.prepare(`
      DELETE FROM accounts WHERE id = ?
    `).bind(id).run()
    
    return c.json({ message: 'アカウントを削除しました' })
  } catch (error) {
    console.error('アカウント削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ============================================
// 一括メッセージ登録API
// ============================================

// CSVアップロード & 一括メッセージ登録API
app.post('/api/booking-messages/bulk-upload', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.parseBody()
    const csvFile = body['csv_file']
    const displayOnMypage = body['display_on_mypage'] === '1' || body['display_on_mypage'] === 'true'
    
    if (!csvFile || typeof csvFile === 'string') {
      return c.json({ error: 'CSVファイルがアップロードされていません' }, 400)
    }
    
    // CSVファイルを読み込み
    const csvText = await csvFile.text()
    const lines = csvText.split('\n').filter(line => line.trim())
    
    if (lines.length === 0) {
      return c.json({ error: 'CSVファイルが空です' }, 400)
    }
    
    // ヘッダー行をスキップ
    const dataLines = lines.slice(1)
    
    if (dataLines.length > 1000) {
      return c.json({ error: 'CSVファイルは最大1000行までです' }, 400)
    }
    
    const results = {
      success: [],
      errors: []
    }
    
    // 各行を処理
    for (let i = 0; i < dataLines.length; i++) {
      const lineNumber = i + 2 // ヘッダー行を考慮
      const line = dataLines[i].trim()
      
      if (!line) continue
      
      // CSV行をパース（簡易版）
      const columns = line.split(',').map(col => col.trim().replace(/^"|"$/g, ''))
      
      if (columns.length < 5) {
        results.errors.push({
          line: lineNumber,
          error: '列数が不足しています（5列必要: 予約番号,メールアドレス,タイトル,メッセージ,送信日時）'
        })
        continue
      }
      
      const [bookingNumber, email, title, message, scheduledSendAt] = columns
      
      // バリデーション
      if (!bookingNumber) {
        results.errors.push({ line: lineNumber, error: '予約番号が入力されていません' })
        continue
      }
      if (!email) {
        results.errors.push({ line: lineNumber, error: 'メールアドレスが入力されていません' })
        continue
      }
      if (!title) {
        results.errors.push({ line: lineNumber, error: 'タイトルが入力されていません' })
        continue
      }
      if (!message) {
        results.errors.push({ line: lineNumber, error: 'メッセージが入力されていません' })
        continue
      }
      if (!scheduledSendAt) {
        results.errors.push({ line: lineNumber, error: '送信日時が入力されていません' })
        continue
      }
      
      // 送信日時のフォーマット変換（YYYY/MM/DD HH:MM → YYYY-MM-DD HH:MM:SS）
      let formattedDate
      try {
        const dateParts = scheduledSendAt.match(/(\d{4})\/(\d{1,2})\/(\d{1,2})\s+(\d{1,2}):(\d{1,2})/)
        if (!dateParts) {
          throw new Error('日時フォーマットが不正です')
        }
        const [, year, month, day, hour, minute] = dateParts
        formattedDate = `${year}-${month.padStart(2, '0')}-${day.padStart(2, '0')} ${hour.padStart(2, '0')}:${minute.padStart(2, '0')}:00`
      } catch (err) {
        results.errors.push({
          line: lineNumber,
          error: `送信日時のフォーマットが不正です（YYYY/MM/DD HH:MM形式で入力してください）: ${scheduledSendAt}`
        })
        continue
      }
      
      // 予約番号が存在するか確認
      const booking = await DB.prepare(`
        SELECT id, member_id FROM bookings WHERE booking_number = ?
      `).bind(bookingNumber).first()
      
      if (!booking) {
        results.errors.push({
          line: lineNumber,
          error: `予約番号「${bookingNumber}」が存在しません`
        })
        continue
      }
      
      // 予約のメールアドレスを確認
      const customer = await DB.prepare(`
        SELECT email FROM members WHERE id = ?
      `).bind(booking.member_id).first()
      
      if (!customer || customer.email !== email) {
        results.errors.push({
          line: lineNumber,
          error: `メールアドレスが予約と一致しません（予約: ${customer?.email || 'N/A'}）`
        })
        continue
      }
      
      // メッセージを登録
      try {
        await DB.prepare(`
          INSERT INTO booking_messages (
            booking_id,
            booking_number,
            recipient_email,
            title,
            message,
            scheduled_send_at,
            display_on_mypage,
            created_by
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          booking.id,
          bookingNumber,
          email,
          title,
          message,
          formattedDate,
          displayOnMypage ? 1 : 0,
          'admin' // TODO: ログインユーザー名に変更
        ).run()
        
        results.success.push({
          line: lineNumber,
          booking_number: bookingNumber
        })
      } catch (err) {
        results.errors.push({
          line: lineNumber,
          error: `登録に失敗しました: ${err.message}`
        })
      }
    }
    
    return c.json({
      total: dataLines.length,
      success_count: results.success.length,
      error_count: results.errors.length,
      results
    })
  } catch (error) {
    console.error('一括メッセージ登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// ========================================
// 帳票一括生成 - ヘルパー関数
// ========================================

/**
 * CSV文字列から予約番号のリストを抽出
 */
async function parseBookingCsv(csvText: string): Promise<string[]> {
  try {
    // CSVをパース
    const records = parse(csvText, {
      skip_empty_lines: true,
      trim: true,
      relax_column_count: true
    })
    
    const bookingNumbers: string[] = []
    
    for (let i = 0; i < records.length; i++) {
      const row = records[i]
      if (!row || row.length === 0) continue
      
      const value = String(row[0]).trim()
      
      // ヘッダー行をスキップ（予約番号、Booking Number等）
      if (i === 0 && (value === '予約番号' || value === 'Booking Number' || value === 'booking_number')) {
        continue
      }
      
      // 予約番号の形式チェック（BKで始まる）
      if (value && value.startsWith('BK')) {
        bookingNumbers.push(value)
      }
    }
    
    return bookingNumbers
    
  } catch (error) {
    console.error('CSV解析エラー:', error)
    throw new Error('CSVファイルの解析に失敗しました')
  }
}

/**
 * 予約データをDBから取得
 */
async function getBookingData(DB: D1Database, bookingNumber: string): Promise<any> {
  try {
    // 予約基本情報＋イベント＋顧客情報を取得
    const bookingResult = await DB.prepare(`
      SELECT 
        b.id as booking_id,
        b.booking_number,
        b.booker_name,
        b.booker_email,
        b.booker_phone,
        b.created_at,
        b.status,
        e.name as event_name,
        e.event_start_date as event_start_date,
        e.event_end_date as event_end_date,
        e.location as event_location,
        (c.family_name || ' ' || c.first_name) as customer_name,
        c.email as customer_email,
        COALESCE(c.mobile, c.tel) as customer_phone,
        (COALESCE(c.city, '') || COALESCE(c.addr, '') || COALESCE(c.bldg, '')) as customer_address,
        c.zip as customer_postal_code
      FROM bookings b
      LEFT JOIN events e ON b.event_id = e.id
      LEFT JOIN members c ON b.member_id = c.id
      WHERE b.booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!bookingResult) {
      return null
    }
    
    // 明細情報を取得
    const itemsResult = await DB.prepare(`
      SELECT 
        item_name,
        quantity,
        unit_price,
        subtotal,
        participation_date
      FROM booking_items
      WHERE booking_id = ?
      ORDER BY id
    `).bind(bookingResult.booking_id).all()
    
    // 決済情報を取得
    const paymentsResult = await DB.prepare(`
      SELECT 
        payment_number,
        payment_method,
        amount,
        payment_date,
        payment_status
      FROM booking_payments
      WHERE booking_number = ?
      ORDER BY payment_date DESC
    `).bind(bookingNumber).all()
    
    // 合計金額を計算
    const totalAmount = itemsResult.results.reduce((sum, item: any) => sum + (item.subtotal || 0), 0)
    const paidAmount = paymentsResult.results
      .filter((p: any) => p.payment_status === 'completed')
      .reduce((sum, p: any) => sum + (p.amount || 0), 0)
    
    // データを整形
    return {
      booking_number: bookingResult.booking_number,
      booker_name: bookingResult.booker_name || bookingResult.customer_name,
      booker_email: bookingResult.booker_email || bookingResult.customer_email,
      booker_phone: bookingResult.booker_phone || bookingResult.customer_phone,
      booker_postal_code: bookingResult.customer_postal_code || '',
      booker_address: bookingResult.customer_address || '',
      created_at: bookingResult.created_at,
      status: bookingResult.status,
      event_name: bookingResult.event_name,
      event_start_date: bookingResult.event_start_date,
      event_end_date: bookingResult.event_end_date,
      event_location: bookingResult.event_location,
      customer_name: bookingResult.customer_name,
      customer_email: bookingResult.customer_email,
      customer_phone: bookingResult.customer_phone,
      customer_address: bookingResult.customer_address,
      customer_postal_code: bookingResult.customer_postal_code,
      total_amount: totalAmount,
      paid_amount: paidAmount,
      pending_amount: totalAmount - paidAmount,
      unbilled_amount: totalAmount - paidAmount,
      items: itemsResult.results,
      payments: paymentsResult.results,
      today: new Date().toISOString().split('T')[0].replace(/-/g, '/'),
      now: new Date().toLocaleString('ja-JP')
    }
    
  } catch (error) {
    console.error('予約データ取得エラー:', bookingNumber, error)
    throw error
  }
}

/**
 * Excelテンプレートにデータを埋め込む
 */
async function fillExcelTemplate(
  excelBytes: Uint8Array,
  bookingData: any
): Promise<Buffer> {
  try {
    const workbook = new ExcelJS.Workbook()
    await workbook.xlsx.load(excelBytes)
    
    const worksheet = workbook.getWorksheet(1) // 最初のシートを使用
    
    if (!worksheet) {
      throw new Error('Excelテンプレートにシートが見つかりません')
    }
    
    // 繰り返し行を検出してテンプレート化
    const repeatRows: { rowNumber: number; placeholders: string[] }[] = []
    
    worksheet.eachRow((row, rowNumber) => {
      row.eachCell((cell) => {
        const value = cell.value?.toString() || ''
        
        // {{items.xxx}} または {{payments.xxx}} を検出
        if (value.includes('{{items.') || value.includes('{{payments.')) {
          const existingRow = repeatRows.find(r => r.rowNumber === rowNumber)
          if (!existingRow) {
            repeatRows.push({ rowNumber, placeholders: [value] })
          } else {
            existingRow.placeholders.push(value)
          }
        }
      })
    })
    
    // 繰り返し行を処理（items）
    if (repeatRows.length > 0 && bookingData.items && bookingData.items.length > 0) {
      repeatRows.sort((a, b) => b.rowNumber - a.rowNumber) // 降順でソート
      
      for (const repeatRow of repeatRows) {
        if (repeatRow.placeholders.some((p: string) => p.includes('{{items.'))) {
          const templateRow = worksheet.getRow(repeatRow.rowNumber)
          const items = bookingData.items
          
          // アイテム数分行を挿入
          for (let i = items.length - 1; i >= 0; i--) {
            const item = items[i]
            
            if (i === 0) {
              // 最初のアイテムは既存行を使用
              templateRow.eachCell((cell) => {
                const value = cell.value?.toString() || ''
                let newValue = value
                
                // {{items.xxx}} を置換
                newValue = newValue.replace(/\{\{items\.(\w+)\}\}/g, (match, key) => {
                  return item[key] !== undefined ? String(item[key]) : ''
                })
                
                cell.value = newValue
              })
            } else {
              // 2つ目以降は行を挿入
              const newRow = worksheet.insertRow(repeatRow.rowNumber + 1, [])
              
              // テンプレート行のスタイルとデータをコピー
              templateRow.eachCell((cell, colNumber) => {
                const newCell = newRow.getCell(colNumber)
                
                // スタイルをコピー
                newCell.style = cell.style
                
                // 値を置換
                const value = cell.value?.toString() || ''
                let newValue = value
                
                newValue = newValue.replace(/\{\{items\.(\w+)\}\}/g, (match, key) => {
                  return item[key] !== undefined ? String(item[key]) : ''
                })
                
                newCell.value = newValue
              })
            }
          }
        }
      }
    }
    
    // 単一値プレースホルダーを置換
    worksheet.eachRow((row) => {
      row.eachCell((cell) => {
        const value = cell.value?.toString() || ''
        
        if (value.includes('{{') && value.includes('}}')) {
          let newValue = value
          
          // {{xxx}} を置換
          newValue = newValue.replace(/\{\{(\w+)\}\}/g, (match, key) => {
            return bookingData[key] !== undefined ? String(bookingData[key]) : ''
          })
          
          cell.value = newValue
        }
      })
    })
    
    // Excelファイルをバッファに出力
    const buffer = await workbook.xlsx.writeBuffer()
    return Buffer.from(buffer)
    
  } catch (error) {
    console.error('Excel埋め込みエラー:', error)
    throw new Error('Excelテンプレートへのデータ埋め込みに失敗しました')
  }
}

/**
 * バックグラウンド処理：帳票を一括生成
 */
async function processBulkDocuments(
  DB: D1Database,
  KV: KVNamespace | undefined,
  R2: R2Bucket,
  apiKey: string,
  jobId: string,
  excelBytes: Uint8Array,
  excelFileName: string,
  bookingNumbers: string[]
): Promise<void> {
  try {
    console.log(`帳票一括生成処理開始 [${jobId}]: ${bookingNumbers.length}件`)
    
    const results: any[] = []
    let completed = 0
    let errors = 0
    
    // Note: Cloudflare Workersの制約により、全処理を同期的に実行
    // 本来は非同期で並行処理すべきだが、CPU時間制限があるため逐次処理
    for (const bookingNumber of bookingNumbers) {
      try {
        console.log(`処理中: ${bookingNumber}`)
        
        // 1. DBから予約データを取得
        const bookingData = await getBookingData(DB, bookingNumber)
        
        if (!bookingData) {
          console.error(`予約が見つかりません: ${bookingNumber}`)
          results.push({
            booking_number: bookingNumber,
            status: 'error',
            error: '予約が見つかりません',
            filename: null
          })
          errors++
          completed++
          continue
        }
        
        // 2. Excelにデータを埋め込む
        const filledExcelBuffer = await fillExcelTemplate(excelBytes, bookingData)
        
        // 3. PDF変換（CloudConvert API）
        const pdfBuffer = await convertExcelToPdf(
          filledExcelBuffer,
          excelFileName,
          apiKey
        )
        
        // 4. ファイル名を生成
        const templateNameWithoutExt = excelFileName.replace(/\.[^.]+$/, '')
        const timestamp = new Date().toISOString().split('T')[0].replace(/-/g, '')
        const pdfFilename = `${templateNameWithoutExt}_${bookingNumber}_${timestamp}.pdf`
        
        // 5. R2にアップロード
        const fileKey = await uploadToR2(R2, pdfBuffer, pdfFilename)
        
        // 6. booking_filesテーブルに登録
        const fileId = await registerBookingFile(
          DB,
          bookingNumber,
          fileKey,
          pdfFilename,
          pdfBuffer.length
        )
        
        results.push({
          booking_number: bookingNumber,
          status: 'success',
          filename: pdfFilename,
          file_id: fileId,
          error: null
        })
        
        completed++
        
        console.log(`完了: ${bookingNumber} -> ${pdfFilename}`)
        
      } catch (error) {
        console.error(`処理エラー: ${bookingNumber}`, error)
        results.push({
          booking_number: bookingNumber,
          status: 'error',
          error: error instanceof Error ? error.message : '処理に失敗しました',
          filename: null
        })
        errors++
        completed++
      }
      
      // KVのステータスを更新
      if (KV) {
        const status = {
          job_id: jobId,
          status: completed === bookingNumbers.length ? 'completed' : 'processing',
          total: bookingNumbers.length,
          completed,
          errors,
          results
        }
        
        await KV.put(`bulk-documents:${jobId}`, JSON.stringify(status), {
          expirationTtl: 86400
        })
      }
    }
    
    console.log(`帳票一括生成処理完了 [${jobId}]: 成功=${completed - errors}, エラー=${errors}`)
    
  } catch (error) {
    console.error('processBulkDocuments エラー:', error)
    
    // エラー時もKVを更新
    if (KV) {
      const status = {
        job_id: jobId,
        status: 'failed',
        total: bookingNumbers.length,
        completed: 0,
        errors: bookingNumbers.length,
        results: [],
        error: error instanceof Error ? error.message : '処理に失敗しました'
      }
      
      await KV.put(`bulk-documents:${jobId}`, JSON.stringify(status), {
        expirationTtl: 86400
      })
    }
  }
}

/**
 * CloudConvert APIでExcel→PDF変換
 */
async function convertExcelToPdf(
  excelBuffer: Buffer,
  filename: string,
  apiKey: string
): Promise<Buffer> {
  try {
    console.log('CloudConvert PDF変換開始:', filename)
    
    // 1. ジョブを作成
    const createJobResponse = await fetch('https://api.cloudconvert.com/v2/jobs', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        tasks: {
          'upload-file': {
            operation: 'import/upload'
          },
          'convert-file': {
            operation: 'convert',
            input: 'upload-file',
            output_format: 'pdf',
            engine: 'office'
          },
          'export-file': {
            operation: 'export/url',
            input: 'convert-file'
          }
        }
      })
    })
    
    if (!createJobResponse.ok) {
      const errorText = await createJobResponse.text()
      throw new Error(`CloudConvert ジョブ作成失敗: ${errorText}`)
    }
    
    const jobData = await createJobResponse.json()
    const uploadTask = jobData.data.tasks.find((t: any) => t.name === 'upload-file')
    
    if (!uploadTask || !uploadTask.result?.form) {
      throw new Error('アップロードタスクが見つかりません')
    }
    
    // 2. Excelファイルをアップロード
    const formData = new FormData()
    Object.entries(uploadTask.result.form.parameters).forEach(([key, value]) => {
      formData.append(key, value as string)
    })
    formData.append('file', new Blob([excelBuffer]), filename)
    
    const uploadResponse = await fetch(uploadTask.result.form.url, {
      method: 'POST',
      body: formData
    })
    
    if (!uploadResponse.ok) {
      throw new Error(`ファイルアップロード失敗: ${uploadResponse.statusText}`)
    }
    
    // 3. 変換完了を待機
    const jobId = jobData.data.id
    let attempts = 0
    const maxAttempts = 60 // 最大60回 (約2分)
    
    while (attempts < maxAttempts) {
      await new Promise(resolve => setTimeout(resolve, 2000)) // 2秒待機
      
      const statusResponse = await fetch(`https://api.cloudconvert.com/v2/jobs/${jobId}`, {
        headers: {
          'Authorization': `Bearer ${apiKey}`
        }
      })
      
      if (!statusResponse.ok) {
        throw new Error('ジョブステータス取得失敗')
      }
      
      const statusData = await statusResponse.json()
      const exportTask = statusData.data.tasks.find((t: any) => t.name === 'export-file')
      
      if (exportTask?.status === 'finished' && exportTask.result?.files?.[0]?.url) {
        // 4. PDFをダウンロード
        const pdfUrl = exportTask.result.files[0].url
        const pdfResponse = await fetch(pdfUrl)
        
        if (!pdfResponse.ok) {
          throw new Error('PDFダウンロード失敗')
        }
        
        const pdfArrayBuffer = await pdfResponse.arrayBuffer()
        console.log('CloudConvert PDF変換完了:', filename, `${pdfArrayBuffer.byteLength} bytes`)
        
        return Buffer.from(pdfArrayBuffer)
      }
      
      if (exportTask?.status === 'error') {
        throw new Error(`変換エラー: ${exportTask.message || '不明なエラー'}`)
      }
      
      attempts++
    }
    
    throw new Error('変換タイムアウト')
    
  } catch (error) {
    console.error('CloudConvert PDF変換エラー:', error)
    throw error
  }
}

/**
 * R2にPDFをアップロード
 */
async function uploadToR2(
  r2Bucket: R2Bucket,
  pdfBuffer: Buffer,
  filename: string
): Promise<string> {
  try {
    const fileKey = `documents/${Date.now()}-${filename}`
    
    await r2Bucket.put(fileKey, pdfBuffer, {
      httpMetadata: {
        contentType: 'application/pdf'
      }
    })
    
    console.log('R2アップロード完了:', fileKey)
    return fileKey
    
  } catch (error) {
    console.error('R2アップロードエラー:', error)
    throw error
  }
}

/**
 * booking_filesテーブルに登録
 */
async function registerBookingFile(
  DB: D1Database,
  bookingNumber: string,
  fileKey: string,
  filename: string,
  fileSize: number
): Promise<number> {
  try {
    const result = await DB.prepare(`
      INSERT INTO booking_files (
        booking_number,
        file_key,
        original_filename,
        display_filename,
        file_size,
        download_limit,
        download_count
      ) VALUES (?, ?, ?, ?, ?, 0, 0)
    `).bind(
      bookingNumber,
      fileKey,
      filename,
      filename,
      fileSize
    ).run()
    
    console.log('booking_files登録完了:', result.meta.last_row_id)
    return result.meta.last_row_id as number
    
  } catch (error) {
    console.error('booking_files登録エラー:', error)
    throw error
  }
}

// ========================================
// 帳票一括生成API
// ========================================

/**
 * 帳票一括生成開始API
 * POST /api/v2/bulk-documents/generate
 * 
 * FormData:
 *  - excel_template: File (Excelテンプレートファイル)
 *  - booking_csv: File (予約番号CSVファイル)
 */
// 一括書類生成
// 支店管理者は担当イベントの予約のみ
app.post('/api/v2/bulk-documents/generate', requireAuth, async (c) => {
  const { DB, KV, BOOKING_FILES, CLOUDCONVERT_API_KEY } = c.env
  
  try {
    // FormDataから取得
    const body = await c.req.parseBody()
    const excelFile = body['excel_template'] as File
    const csvFile = body['booking_csv'] as File
    
    if (!excelFile || !csvFile) {
      return c.json({ error: 'Excelテンプレートと予約番号CSVの両方が必要です' }, 400)
    }
    
    console.log('帳票一括生成開始:', {
      excel: excelFile.name,
      csv: csvFile.name
    })
    
    // CSVファイルを読み込んで予約番号リストを取得
    const csvText = await csvFile.text()
    const bookingNumbers = await parseBookingCsv(csvText)
    
    if (bookingNumbers.length === 0) {
      return c.json({ error: '予約番号が見つかりません' }, 400)
    }
    
    console.log(`予約番号数: ${bookingNumbers.length}件`, bookingNumbers.slice(0, 5))
    
    // ジョブIDを生成
    const jobId = `job_${Date.now()}_${Math.random().toString(36).substring(7)}`
    
    // ジョブステータスを初期化（KVに保存）
    const jobStatus = {
      job_id: jobId,
      status: 'pending',
      total: bookingNumbers.length,
      completed: 0,
      errors: 0,
      results: [],
      created_at: new Date().toISOString()
    }
    
    // KVに保存（有効期限: 24時間）
    if (KV) {
      await KV.put(`bulk-documents:${jobId}`, JSON.stringify(jobStatus), {
        expirationTtl: 86400 // 24時間
      })
    }
    
    // Excelファイルのバッファを取得
    const excelBuffer = await excelFile.arrayBuffer()
    const excelBytes = new Uint8Array(excelBuffer)
    
    // バックグラウンドで処理を開始（非同期）
    // Note: Cloudflare Workersでは真の非同期処理は難しいため、
    // 実装上はここで全処理を実行する
    c.executionCtx.waitUntil(
      processBulkDocuments(
        DB,
        KV,
        BOOKING_FILES,
        CLOUDCONVERT_API_KEY,
        jobId,
        excelBytes,
        excelFile.name,
        bookingNumbers
      )
    )
    
    return c.json({
      success: true,
      job_id: jobId,
      total: bookingNumbers.length,
      message: '処理を開始しました'
    })
    
  } catch (error) {
    console.error('帳票一括生成エラー:', error)
    return c.json({ error: error.message || '一括生成の開始に失敗しました' }, 500)
  }
})

/**
 * ジョブステータス取得API
 * GET /api/v2/bulk-documents/status/:job_id
 */
app.get('/api/v2/bulk-documents/status/:job_id', async (c) => {
  const { KV } = c.env
  const jobId = c.req.param('job_id')
  
  try {
    if (!KV) {
      return c.json({ error: 'KV storage is not configured' }, 500)
    }
    
    const statusJson = await KV.get(`bulk-documents:${jobId}`)
    
    if (!statusJson) {
      return c.json({ error: 'ジョブが見つかりません' }, 404)
    }
    
    const status = JSON.parse(statusJson)
    return c.json(status)
    
  } catch (error) {
    console.error('ジョブステータス取得エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

