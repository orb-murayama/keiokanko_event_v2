      e.enable_flg,
      e.detail,
      e.detail_en,
      e.location,
      e.location_en,
      e.contact,
      e.contact_en,
      e.remarks,
      e.remarks_en,
      e.thanks_msg,
      e.thanks_msg_en,
      e.category,
      e.date_selection_type,
      e.event_type,
      e.parent_event_id,
      e.event_start_date,
      e.event_end_date,
      e.registration_start_date,
      e.registration_end_date,
      e.admin_login_start_date,
      e.admin_login_end_date,
      e.payment_flg,
      e.payment_credit_card,
      e.payment_bank_transfer,
      e.payment_convenience_store,
      e.bank_name,
      e.bank_branch,
      e.bank_account_type,
      e.bank_account_number,
      e.bank_account_name,
      e.bank_transfer_deadline,
      e.credit_fee_type,
      e.credit_fee_percentage,
      e.credit_fee_fixed,
      e.bank_fee_type,
      e.bank_fee_percentage,
      e.bank_fee_fixed,
      e.convenience_fee_type,
      e.convenience_fee_percentage,
      e.convenience_fee_fixed,
      e.admin_email,
      e.admin_cc_email,
      e.sender_name,
      e.sender_email,
      e.email_signature,
      e.email_signature_en,
      e.auto_reply_enabled,
      e.auto_reply_credit_payment,
      e.auto_reply_bank_payment,
      e.auto_reply_convenience_payment,
      e.image_url,
      e.client_id,
      e.organizer_id,
      e.vendor_id,
      e.created_at,
      e.modified_at,
      o.name as organizer_name,
      v.name as vendor_name,
      v.business_notes as vendor_business_notes
    FROM events e
    LEFT JOIN organizers o ON e.organizer_id = o.id
    LEFT JOIN vendors v ON e.vendor_id = v.id
    WHERE e.id = ? AND e.deleted_at IS NULL
  `).bind(eventId).first<Event>()

  if (!event) {
    return c.json({ error: 'Event not found' }, 404)
  }

  return c.json({ event })
})

// API: イベントコピー（統合版）
app.post('/api/events/:id/copy', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  try {
    // 元のイベントデータを取得
    const originalEvent = await DB.prepare(`
      SELECT * FROM events WHERE id = ? AND deleted_at IS NULL
    `).bind(eventId).first<Event>()

    if (!originalEvent) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }

    // 新しいイベントURLを生成（元のURL + -copy-{timestamp}）
    const timestamp = Date.now()
    const newEventUrl = `${originalEvent.event_url}-copy-${timestamp}`
    const newName = `${originalEvent.name} (コピー)`
    const newNameEn = originalEvent.name_en ? `${originalEvent.name_en} (Copy)` : null

    // SQLを使ってイベントをコピー（id, created_at, modified_at, deleted_at以外をコピー）
    const result = await DB.prepare(`
      INSERT INTO events (
        name, name_en, event_url, enable_flg,
        detail, detail_en, location, location_en, contact, contact_en, remarks, remarks_en, thanks_msg, thanks_msg_en,
        client_id, customer_client_id, vendor_id, organizer_id, branch_code,
        category, date_selection_type, event_type, parent_event_id,
        event_start_date, event_end_date, registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, admin_cc_email, sender_name, sender_email, email_signature, email_signature_en,
        payment_flg, payment_methods, payment_credit_card, payment_bank_transfer, payment_convenience_store,
        credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name, bank_transfer_deadline,
        store_code, convenience_payment_deadline, available_convenience_stores,
        form_field_settings,
        auto_reply_enabled,
        auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en,
        image_url, postage, question, note, company_flg, payment_cd
      )
      SELECT
        ?, ?, ?, 0,
        detail, detail_en, location, location_en, contact, contact_en, remarks, remarks_en, thanks_msg, thanks_msg_en,
        client_id, customer_client_id, vendor_id, organizer_id, branch_code,
        category, date_selection_type, event_type, parent_event_id,
        event_start_date, event_end_date, registration_start_date, registration_end_date,
        admin_login_start_date, admin_login_end_date,
        admin_email, admin_cc_email, sender_name, sender_email, email_signature, email_signature_en,
        payment_flg, payment_methods, payment_credit_card, payment_bank_transfer, payment_convenience_store,
        credit_fee_type, credit_fee_percentage, credit_fee_fixed,
        bank_fee_type, bank_fee_percentage, bank_fee_fixed,
        convenience_fee_type, convenience_fee_percentage, convenience_fee_fixed,
        bank_name, bank_branch, bank_account_type, bank_account_number, bank_account_name, bank_transfer_deadline,
        store_code, convenience_payment_deadline, available_convenience_stores,
        form_field_settings,
        auto_reply_enabled,
        auto_reply_credit_payment, auto_reply_bank_payment, auto_reply_convenience_payment,
        auto_reply_credit_cancel, auto_reply_bank_cancel, auto_reply_convenience_cancel,
        auto_reply_credit_refund, auto_reply_bank_deposit, auto_reply_bank_refund,
        auto_reply_convenience_deposit, auto_reply_convenience_refund,
        auto_reply_credit_payment_en, auto_reply_bank_payment_en, auto_reply_convenience_payment_en,
        auto_reply_credit_cancel_en, auto_reply_bank_cancel_en, auto_reply_convenience_cancel_en,
        auto_reply_credit_refund_en, auto_reply_bank_deposit_en, auto_reply_bank_refund_en,
        auto_reply_convenience_deposit_en, auto_reply_convenience_refund_en,
        image_url, postage, question, note, company_flg, payment_cd
      FROM events
      WHERE id = ? AND deleted_at IS NULL
    `).bind(newName, newNameEn, newEventUrl, eventId).run()

    const newEventId = result.meta.last_row_id

    return c.json({ 
      message: 'イベントをコピーしました',
      event_id: newEventId,
      event_url: newEventUrl
    })
  } catch (error) {
    console.error('イベントコピーエラー:', error)
    return c.json({ error: 'イベントのコピーに失敗しました' }, 500)
  }
})

// API: イベント担当者取得
app.get('/api/events/:id/staff', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  try {
    console.log('========== イベント担当者取得 ==========')
    console.log('Event ID:', eventId)
    
    const { results: staff } = await DB.prepare(`
      SELECT 
        es.id,
        es.account_id,
        a.person_name as name,
        a.login_id,
        a.email,
        b.branch_name,
        es.assigned_at
      FROM event_staff es
      JOIN accounts a ON es.account_id = a.id
      LEFT JOIN branches b ON a.primary_branch_code = b.branch_code
      WHERE es.event_id = ?
      ORDER BY a.person_name
    `).bind(eventId).all()
    
    console.log('担当者数:', staff.length)
    
    return c.json({ staff: staff || [] })
  } catch (error) {
    console.error('イベント担当者取得エラー:', error)
    return c.json({ error: 'イベント担当者の取得に失敗しました' }, 500)
  }
})

// API: イベント担当者保存
app.post('/api/events/:id/staff', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  try {
    const body = await c.req.json()
    const assignedStaff = body.assigned_staff || []
    
    console.log('========== イベント担当者保存 ==========')
    console.log('Event ID:', eventId)
    console.log('Assigned Staff:', assignedStaff)
    
    // 既存の担当者を削除
    await DB.prepare(`DELETE FROM event_staff WHERE event_id = ?`).bind(eventId).run()
    
    // 新しい担当者を登録
    if (assignedStaff.length > 0) {
      const stmt = DB.prepare(`
        INSERT INTO event_staff (event_id, account_id)
        VALUES (?, ?)
      `)
      
      for (const accountId of assignedStaff) {
        await stmt.bind(eventId, accountId).run()
      }
    }
    
    console.log('担当者保存完了:', assignedStaff.length + '名')
    
    return c.json({ 
      success: true, 
      message: '担当者を更新しました',
      count: assignedStaff.length
    })
  } catch (error) {
    console.error('担当者更新エラー:', error)
    return c.json({ error: '担当者の更新に失敗しました' }, 500)
  }
})

