})

// API v2: 新規予約作成
app.post('/api/v2/bookings', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const { 
      event_id, event_name, participation_date, stock_id,
      booker, participants, items, 
      total_amount, payment_method, card_info, is_new_member 
    } = body
    
    console.log('📝 予約作成開始:', { event_id, booker_email: booker.email, is_new_member })
    
    // 1. 会員情報の処理
    let member_id = null
    if (is_new_member) {
      // 新規会員登録
      const memberResult = await DB.prepare(`
        INSERT INTO members (
          email, password_hash, family_name, first_name, family_kana, first_kana,
          tel, mobile, zip, addr, enable_flg, email_verified
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1, 1)
      `).bind(
        booker.email,
        '',  // パスワードハッシュは空
        booker.family_name || '',
        booker.first_name || '',
        booker.family_kana || '',
        booker.first_kana || '',
        booker.tel || '',
        booker.mobile || '',
        booker.zip || '',
        booker.addr || ''
      ).run()
      
      member_id = memberResult.meta.last_row_id
      console.log('✅ 新規会員登録完了:', member_id)
    } else {
      // 既存会員の検索
      const member = await DB.prepare(`
        SELECT id FROM members WHERE email = ? AND enable_flg = 1
      `).bind(booker.email).first()
      
      if (member) {
        member_id = member.id
        console.log('✅ 既存会員確認:', member_id)
      }
    }
    
    // 2. 予約番号を生成（BK + YYYYMMDD + 連番）
    const today = new Date().toISOString().split('T')[0].replace(/-/g, '')
    const lastBooking = await DB.prepare(`
      SELECT booking_number FROM bookings 
      WHERE booking_number LIKE ? 
      ORDER BY booking_number DESC 
      LIMIT 1
    `).bind(`BK${today}%`).first()
    
    let seq = 1
    if (lastBooking) {
      const lastSeq = parseInt(lastBooking.booking_number.slice(-3))
      seq = lastSeq + 1
    }
    const bookingNumber = `BK${today}-${String(seq).padStart(3, '0')}`
    console.log('📋 予約番号生成:', bookingNumber)
    
    // 3. 商品全体のカスタムフィールド（category=1）を収集
    const allProductCustomFields = {}
    for (const item of items) {
      if (item.product_custom_fields) {
        // 商品ごとのフィールドをマージ（フィールド名が重複する場合は上書き）
        Object.assign(allProductCustomFields, item.product_custom_fields)
      }
    }
    
    // 3.5. 予約グループを作成（custom_fields を含む）
    const bookingResult = await DB.prepare(`
      INSERT INTO bookings (
        booking_number, member_id, event_id, booker_name, booker_email, booker_phone, custom_fields
      ) VALUES (?, ?, ?, ?, ?, ?, ?)
    `).bind(
      bookingNumber,
      member_id,
      event_id,
      `${booker.family_name} ${booker.first_name}`,
      booker.email,
      booker.tel || '',
      Object.keys(allProductCustomFields).length > 0 ? JSON.stringify(allProductCustomFields) : null
    ).run()
    
    const bookingId = bookingResult.meta.last_row_id
    console.log('✅ 予約グループ作成:', bookingId, 
      Object.keys(allProductCustomFields).length > 0 ? `(カスタムフィールド: ${Object.keys(allProductCustomFields).length}件)` : '')
    
    // 4. 決済番号を生成
    const paymentNumber = `PAY${today}-${String(seq).padStart(3, '0')}`
    
    // 5. 決済を作成
    const paymentResult = await DB.prepare(`
      INSERT INTO booking_payments (
        booking_number, payment_number, payment_type, payment_method,
        payment_status, amount, payment_date
      ) VALUES (?, ?, ?, ?, ?, ?, ?)
    `).bind(
      bookingNumber,
      paymentNumber,
      'immediate',
      payment_method,
      payment_method === 'credit_card' ? 'completed' : 'pending',
      total_amount,
      new Date().toISOString()
    ).run()
    
    const paymentId = paymentResult.meta.last_row_id
    console.log('💳 決済情報作成:', paymentId, payment_method)
    
    // 6. カード情報を保存（クレジットカードの場合）
    if (payment_method === 'credit_card' && card_info) {
      await DB.prepare(`
        INSERT INTO booking_card_transactions (
          payment_id, booking_number, card_last4, card_exp_month, card_exp_year,
          card_holder_name, transaction_status
        ) VALUES (?, ?, ?, ?, ?, ?, ?)
      `).bind(
        paymentId,
        bookingNumber,
        card_info.last4,
        card_info.exp_month,
        card_info.exp_year,
        card_info.holder_name,
        'completed'
      ).run()
      console.log('💳 カード情報保存完了')
    }
    
    // 7. 予約明細を作成（参加者情報を含む）
    // 各商品の参加者をグループ化
    const itemParticipantsMap = new Map()
    if (participants && participants.length > 0) {
      participants.forEach(participant => {
        const key = `${participant.item_type}-${participant.item_id}-${participant.stock_id}`
        if (!itemParticipantsMap.has(key)) {
          itemParticipantsMap.set(key, [])
        }
        // フィールド名を変換（lastname → family_name, firstname → first_name）
        itemParticipantsMap.get(key).push({
          lastname: participant.family_name || '',
          firstname: participant.first_name || '',
          lastname_kana: participant.family_kana || '',
          firstname_kana: participant.first_kana || '',
          last_name_en: participant.last_name_en || '',
          first_name_en: participant.first_name_en || '',
          age: participant.age || '',
          gender: participant.sex || '',
          email: participant.email || '',
          phone: participant.tel || '',
          birth: participant.birth_date || '',
          address: participant.addr || '',
          custom_fields: participant.custom_fields || {}
        })
      })
    }
    
    for (const item of items) {
      const key = `${item.type}-${item.id}-${item.stock_id}`
      const itemParticipants = itemParticipantsMap.get(key) || []
      
      const itemResult = await DB.prepare(`
        INSERT INTO booking_items (
          booking_id, payment_id, item_type, item_id, item_name,
          quantity, unit_price, subtotal, participation_date, price_category, stock_id, participants
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(
        bookingId,
        paymentId,
        item.type,
        item.id,
        item.name,
        item.quantity,
        item.unit_price,
        item.unit_price * item.quantity,
        participation_date,
        item.category || null,
        item.stock_id || stock_id || null,
        JSON.stringify(itemParticipants)
      ).run()
      
      const itemId = itemResult.meta.last_row_id
      
      console.log(`✅ 予約明細作成: ${item.name} x ${item.quantity} (参加者: ${itemParticipants.length}名)`)
    }
    
    // 8. 在庫を減算（商品とオプションを区別して処理）
    for (const item of items) {
      if (item.stock_id) {
        if (item.type === 'product') {
          // 商品在庫を減算
          await DB.prepare(`
            UPDATE product_stocks 
            SET booked = booked + ?
            WHERE id = ?
          `).bind(item.quantity, item.stock_id).run()
          console.log(`✅ 商品在庫減算: stock_id=${item.stock_id}, quantity=${item.quantity}`)
        } else if (item.type === 'option') {
          // オプション在庫を減算
          await DB.prepare(`
            UPDATE option_stocks 
            SET booked = booked + ?
            WHERE id = ?
          `).bind(item.quantity, item.stock_id).run()
          console.log(`✅ オプション在庫減算: stock_id=${item.stock_id}, quantity=${item.quantity}`)
        }
      }
    }
    console.log('✅ 全在庫減算完了')
    
    console.log('🎉 予約作成完了:', bookingNumber)
    
    return c.json({ 
      success: true,
      booking_number: bookingNumber,
      payment_number: paymentNumber,
      message: '予約が完了しました'
    }, 201)
  } catch (error) {
    console.error('❌ 予約作成エラー:', error)
    return c.json({ error: '予約の作成に失敗しました', details: error.message }, 500)
  }
})

// API v2: 商品・参加者追加
app.post('/api/v2/bookings/:booking_number/items', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    const body = await c.req.json()
    const { items, payment } = body
    
    // 予約を取得
    const booking = await DB.prepare(`
      SELECT * FROM bookings WHERE booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // 決済番号を生成
    const lastPayment = await DB.prepare(`
      SELECT payment_number FROM booking_payments 
      WHERE booking_number = ? 
      ORDER BY created_at DESC 
      LIMIT 1
    `).bind(bookingNumber).first()
    
    let paymentSeq = 1
    if (lastPayment) {
      const match = lastPayment.payment_number.match(/-(\d+)$/)
      if (match) {
        paymentSeq = parseInt(match[1]) + 1
      }
    }
    
    const today = new Date().toISOString().split('T')[0].replace(/-/g, '')
    const paymentNumber = `PAY${today}-${String(paymentSeq).padStart(3, '0')}`
    
    // 決済を作成
    const paymentResult = await DB.prepare(`
      INSERT INTO booking_payments (
        booking_number, payment_number, payment_type, payment_method,
        payment_status, amount, payment_due_date
      ) VALUES (?, ?, ?, ?, ?, ?, ?)
    `).bind(
      bookingNumber,
      paymentNumber,
      payment.payment_type || 'immediate',
      payment.payment_method,
      payment.payment_status || 'pending',
      payment.amount,
      payment.payment_due_date || null
    ).run()
    
    const paymentId = paymentResult.meta.last_row_id
    
    // 明細を追加
    for (const item of items) {
      await DB.prepare(`
        INSERT INTO booking_items (
          booking_id, payment_id, item_type, item_id, item_name,
          quantity, unit_price, subtotal, participation_date, participants, price_category
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(
        booking.id,
        paymentId,
        item.item_type,
        item.item_id,
        item.item_name,
        item.quantity,
        item.unit_price,
        item.subtotal,
        item.participation_date || null,
        JSON.stringify(item.participants || []),
        item.price_category || null
      ).run()
    }
    
    return c.json({ 
      success: true,
      payment_number: paymentNumber
    }, 201)
  } catch (error) {
    console.error('商品追加エラー:', error)
    return c.json({ error: '商品の追加に失敗しました' }, 500)
  }
})

// API v2: GMO決済URL取得API（キー型）
app.post('/api/v2/gmo/get-payment-url', async (c) => {
  const { DB } = c.env
  
  try {
    console.log('🔐 [GMO] API開始')
    
    const body = await c.req.json()
    const { 
      booking_number, 
      payment_method, // 'credit' or 'cvs'
      amount,
      tax = 0
    } = body
    
    console.log('📥 [GMO] リクエストボディ:', { booking_number, payment_method, amount, tax })
    
    // 環境変数からGMO設定を取得
    const shopId = c.env.GMO_SHOP_ID
    const shopPass = c.env.GMO_SHOP_PASS
    const configId = c.env.GMO_CONFIG_ID
    const apiUrl = c.env.GMO_API_URL || 'https://pt01.mul-pay.jp' // デフォルトはテスト環境
    
    console.log('🔧 [GMO] 環境変数確認:', {
      hasShopId: !!shopId,
      shopId: shopId,  // 実際の値を表示
      hasShopPass: !!shopPass,
      hasConfigId: !!configId,
      configId: configId,  // 実際の値を表示（重要！）
      apiUrl
    })
    
    if (!shopId || !shopPass || !configId) {
      console.error('❌ [GMO] 環境変数が不足しています')
      return c.json({ 
        error: 'GMO決済設定が完了していません。管理者に連絡してください。',
        details: {
          GMO_SHOP_ID: !!shopId,
          GMO_SHOP_PASS: !!shopPass,
          GMO_CONFIG_ID: !!configId
        }
      }, 500)
    }
    
    console.log('🔍 [GMO] 予約確認中:', booking_number)
    
    // 予約の存在確認と会員情報取得（コンビニ決済用）
    const booking = await DB.prepare(`
      SELECT 
        b.id, 
        b.member_id,
        b.event_id,
        m.family_name,
        m.first_name,
        m.family_kana,
        m.first_kana,
        m.email,
        m.tel,
        m.mobile,
        e.convenience_payment_deadline
      FROM bookings b
      LEFT JOIN members m ON b.member_id = m.id
      LEFT JOIN events e ON b.event_id = e.id
      WHERE b.booking_number = ?
    `).bind(booking_number).first()
    
    if (!booking) {
      console.error('❌ [GMO] 予約が見つかりません:', booking_number)
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    console.log('✅ [GMO] 予約確認完了:', booking)
    
    // PayMethodsを決済手段に応じて設定
    let payMethods: string[]
    if (payment_method === 'credit') {
      payMethods = ['credit']
    } else if (payment_method === 'cvs') {
      payMethods = ['cvs']
    } else {
      console.error('❌ [GMO] 無効な決済手段:', payment_method)
      return c.json({ error: '無効な決済手段です。credit または cvs を指定してください' }, 400)
    }
    
    console.log('✅ [GMO] 決済手段設定:', payMethods)
    
    // GMO決済URL取得APIリクエストボディを構築
    // リンクタイプ Plus APIの正しいJSON形式
    const gmoRequest: any = {
      geturlparam: {
        ShopID: shopId,
        ShopPass: shopPass
      },
      configid: configId,  // 管理画面で設定した設定ID
      transaction: {
        OrderID: booking_number,
        Amount: String(amount),
        Tax: String(tax),
        PayMethods: payMethods,  // ['credit'] or ['cvs']
        // 戻り先URL系パラメータ（GMOが自動的にOrderIDを付与しますが、念のため明示的に含めます）
        RetUrl: `https://webapp-geh.pages.dev/payment-callback?OrderID=${booking_number}`,
        CompleteUrl: `https://webapp-geh.pages.dev/payment-callback?status=success&OrderID=${booking_number}`,
        CancelUrl: `https://webapp-geh.pages.dev/payment-callback?status=cancel&OrderID=${booking_number}`,
        // 画面スキップフラグ
        ConfirmSkipFlag: '1',  // 確認画面をスキップ
        ResultSkipFlag: '1'    // 結果画面（レシート画面）をスキップ
      }
    }
    
    // コンビニ決済の場合、cvsパラメータを追加
    if (payment_method === 'cvs') {
      // 会員情報から漢字氏名を作成（CustomerName）
      const familyName = booking.family_name || ''
      const firstName = booking.first_name || ''
      let customerName = `${familyName} ${firstName}`.trim()
      if (!customerName) {
        customerName = '山田 太郎'  // デフォルト値（漢字）
      }
      
      // 会員情報からカナ氏名を作成（CustomerKana）
      const familyKana = booking.family_kana || ''
      const firstKana = booking.first_kana || ''
      let customerKana = `${familyKana} ${firstKana}`.trim()
      if (!customerKana) {
        customerKana = 'ヤマダ タロウ'  // デフォルト値（カナ）
      }
      
      // メールアドレス取得
      const mailAddress = booking.email || ''
      
      // 電話番号取得（携帯優先）、ハイフン等を除去
      let telNo = booking.mobile || booking.tel || ''
      telNo = telNo.replace(/[^0-9]/g, '')  // 数字のみに変換
      
      // 電話番号が空の場合はエラー
      if (!telNo) {
        console.error('❌ [GMO] 電話番号が取得できません')
        return c.json({ 
          error: 'コンビニ決済には電話番号が必要です。参加者情報を確認してください。',
          details: {
            mobile: booking.mobile,
            tel: booking.tel
          }
        }, 400)
      }
      
      // 支払期限日数（イベントの設定値、デフォルト7日）
      const paymentTermDay = booking.convenience_payment_deadline || 7
      
      // PaymentTermDayは1〜60の範囲
      let validPaymentTermDay = parseInt(String(paymentTermDay), 10)
      if (isNaN(validPaymentTermDay) || validPaymentTermDay < 1) {
        validPaymentTermDay = 7
      }
      if (validPaymentTermDay > 60) {
        validPaymentTermDay = 60
      }
      
      gmoRequest.cvs = {
        CustomerName: customerName,        // 漢字氏名
        CustomerKana: customerKana,        // カナ氏名
        TelNo: telNo,
        PaymentTermDay: String(validPaymentTermDay),
        MailAddress: mailAddress,          // メールアドレス
        MailAddressRequiredFlag: '0',      // メールアドレス任意
        // お問い合わせ先情報（レシートに表示される情報）
        ReceiptsDisp11: '京王観光株式会社',
        ReceiptsDisp12: '03-0000-0000',
        ReceiptsDisp13: '09:00-18:00'
      }
      
      console.log('🏪 [GMO] コンビニ決済パラメータ:', {
        CustomerName: customerName,
        CustomerNameLength: customerName.length,
        CustomerKana: customerKana,
        CustomerKanaLength: customerKana.length,
        TelNo: telNo,
        TelNoLength: telNo.length,
        MailAddress: mailAddress,
        MailAddressLength: mailAddress.length,
        PaymentTermDay: validPaymentTermDay,
        ReceiptsDisp11: '京王観光株式会社',
        ReceiptsDisp12: '03-0000-0000',
        ReceiptsDisp13: '09:00-18:00',
        rawFamilyName: booking.family_name,
        rawFirstName: booking.first_name,
        rawFamilyKana: booking.family_kana,
        rawFirstKana: booking.first_kana,
        rawEmail: booking.email,
        rawMobile: booking.mobile,
        rawTel: booking.tel,
        rawPaymentTermDay: booking.convenience_payment_deadline
      })
    }
    
    console.log('📤 [GMO] リクエスト送信:', JSON.stringify(gmoRequest, null, 2))
    console.log('ℹ️ [GMO] 設定ID:', configId, '（管理画面の設定が適用されます）')
    
    // GMO APIを呼び出し（リンクタイプ Plus 決済URL取得API）
    // エンドポイント: /payment/GetLinkplusUrlPayment.json
    const gmoApiEndpoint = `${apiUrl}/payment/GetLinkplusUrlPayment.json`
    console.log('🌐 [GMO] エンドポイント:', gmoApiEndpoint)
    
    const gmoResponse = await fetch(gmoApiEndpoint, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json;charset=UTF-8'
      },
      body: JSON.stringify(gmoRequest)
    })
    
    console.log('📥 [GMO] レスポンスステータス:', gmoResponse.status)
    console.log('📥 [GMO] レスポンスヘッダー:', Object.fromEntries(gmoResponse.headers.entries()))
    
    // レスポンスをテキストとして取得
    const responseText = await gmoResponse.text()
    console.log('📥 [GMO] レスポンステキスト:', responseText)
    console.log('📥 [GMO] レスポンスステータス:', gmoResponse.status)
    
    // HTTPステータスエラー
    if (!gmoResponse.ok) {
      console.error('❌ [GMO] HTTPエラー:', gmoResponse.status, responseText)
      return c.json({ 
        error: 'GMO決済URLの取得に失敗しました',
        status: gmoResponse.status,
        details: responseText
      }, gmoResponse.status)
    }
    
    // レスポンスをJSON形式でパース（リンクタイプ Plus は JSON レスポンス）
    let gmoData: any = {}
    try {
      gmoData = JSON.parse(responseText)
      console.log('✅ [GMO] JSONパース成功:', JSON.stringify(gmoData, null, 2))
    } catch (parseError) {
      console.error('❌ [GMO] JSONパースエラー:', parseError)
      console.error('❌ [GMO] レスポンス内容:', responseText)
      return c.json({ 
        error: 'GMO APIからの応答が不正です（JSON形式ではありません）',
        details: responseText,
        endpoint: gmoApiEndpoint
      }, 500)
    }
    
    // エラーコードチェック（配列形式）
    // リンクタイプ Plus のエラーレスポンス形式: [{"errCode": "EZ1", "errInfo": "EZ1004005"}]
    if (Array.isArray(gmoData) && gmoData.length > 0 && gmoData[0].errCode) {
      const firstError = gmoData[0]
      console.error('❌ [GMO] エラーコード:', firstError.errCode, firstError.errInfo)
      console.error('❌ [GMO] 全エラー:', JSON.stringify(gmoData, null, 2))
      console.error('❌ [GMO] 送信したリクエスト:', JSON.stringify(gmoRequest, null, 2))
      return c.json({ 
        error: 'GMO決済でエラーが発生しました',
        errCode: firstError.errCode,
        errInfo: firstError.errInfo,
        allErrors: gmoData,
        sentRequest: gmoRequest  // デバッグ用: 送信したリクエストを返す
      }, 400)
    }
    
    // オブジェクト形式のエラーもチェック（互換性のため）
    if (gmoData.errCode) {
      console.error('❌ [GMO] エラーコード(オブジェクト形式):', gmoData.errCode, gmoData.errInfo)
      console.error('❌ [GMO] 送信したリクエスト:', JSON.stringify(gmoRequest, null, 2))
      return c.json({ 
        error: 'GMO決済でエラーが発生しました',
        errCode: gmoData.errCode,
        errInfo: gmoData.errInfo,
        sentRequest: gmoRequest  // デバッグ用: 送信したリクエストを返す
      }, 400)
    }
    
    // 成功レスポンス
    const { OrderID, LinkUrl, ProcessDate } = gmoData
    
    if (!LinkUrl) {
      console.error('❌ [GMO] LinkUrlが取得できません:', gmoData)
      return c.json({ 
        error: 'GMO決済URLが取得できませんでした',
        details: gmoData
      }, 500)
    }
    
    console.log('✅ [GMO] 決済URL取得成功:', { OrderID, LinkUrl })
    
    return c.json({
      success: true,
      order_id: OrderID,
      link_url: LinkUrl,
      process_date: ProcessDate,
      payment_method: payment_method
    })
    
  } catch (error: any) {
    console.error('❌❌❌ [GMO] 例外エラー:', error)
    console.error('エラーメッセージ:', error?.message)
    console.error('エラースタック:', error?.stack)
    return c.json({ 
      error: 'GMO決済URL取得処理中にエラーが発生しました',
      details: error?.message || String(error),
      stack: error?.stack
    }, 500)
  }
})

// API v2: 決済完了処理（GMOからのコールバック）
app.post('/api/v2/bookings/payment-complete', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const { 
      booking_number, 
      payment_method, 
      status,
      transaction_id,
      payment_code,
      store,
      amount,
      deadline,
      gmo_details  // GMOの詳細情報（JSON）
    } = body
    
    console.log('💳 決済完了処理:', { booking_number, payment_method, status })
    console.log('📋 GMO詳細情報:', gmo_details)
    
    // 予約番号の存在確認
    const booking = await DB.prepare(`
      SELECT id FROM bookings WHERE booking_number = ?
    `).bind(booking_number).first()
    
    if (!booking) {
      return c.json({ success: false, error: '予約が見つかりません' }, 404)
    }
    
    // GMO詳細情報をJSON文字列に変換
    const gmoDetailsJson = gmo_details ? JSON.stringify(gmo_details) : null
    
    // 決済情報を更新
    if (payment_method === 'credit_card' || payment_method === 'credit') {
      // クレジットカード決済の場合
      
      // payment_transaction_id にGMOのTranIDを設定
      const tranId = gmo_details?.credit?.TranID || transaction_id || null
      
      await DB.prepare(`
        UPDATE booking_payments 
        SET payment_status = 'completed',
            payment_date = datetime('now'),
            payment_transaction_id = ?,
            payment_details = ?
        WHERE booking_number = ?
      `).bind(tranId, gmoDetailsJson, booking_number).run()
      
      console.log('✅ クレジットカード決済完了', {
        tranId,
        hasGmoDetails: !!gmoDetailsJson
      })
      
    } else if (payment_method === 'convenience') {
      // コンビニ決済の場合（払込票番号発行）
      await DB.prepare(`
        UPDATE booking_payments 
        SET payment_status = 'pending',
            payment_code = ?,
            payment_due_date = ?,
            payment_details = ?
        WHERE booking_number = ?
      `).bind(payment_code, deadline, gmoDetailsJson, booking_number).run()
      
      console.log('✅ コンビニ払込票発行完了:', payment_code)
    }
    
    // 予約ステータスを更新
    const newStatus = (payment_method === 'credit_card' || payment_method === 'credit') ? 'confirmed' : 'pending_payment'
    await DB.prepare(`
      UPDATE bookings 
      SET status = ?
      WHERE booking_number = ?
    `).bind(newStatus, booking_number).run()
    
    return c.json({ 
      success: true, 
      message: '決済情報を更新しました',
      booking_number,
      status: newStatus,
      gmo_saved: !!gmoDetailsJson
    })
    
  } catch (error) {
    console.error('決済完了処理エラー:', error)
    return c.json({ 
      success: false, 
      error: '決済完了処理に失敗しました' 
    }, 500)
  }
})

// API v2: 予約変更用データ取得
app.get('/api/v2/bookings/:booking_number/edit-data', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    // 予約基本情報を取得
    const booking = await DB.prepare(`
      SELECT 
        b.*,
        e.name AS event_name,
        e.event_start_date,
        e.event_end_date
      FROM bookings b
      LEFT JOIN events e ON b.event_id = e.id
      WHERE b.booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!booking) {
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // 予約明細を取得
    const items = await DB.prepare(`
      SELECT 
        bi.*,
        bp.payment_method,
        bp.payment_status
      FROM booking_items bi
      LEFT JOIN booking_payments bp ON bi.payment_id = bp.id
      WHERE bi.booking_id = ? AND bi.status = 'active'
      ORDER BY bi.id
    `).bind(booking.id).all()
    
    // 各商品のフォーム設定を取得
    const formFieldsMap = {}
    
    for (const item of items.results || []) {
      if (item.item_type === 'product' && item.item_id) {
        const formFields = await DB.prepare(`
          SELECT * FROM product_form_fields
          WHERE product_id = ?
            AND category = 2
          ORDER BY display_order, id
        `).bind(item.item_id).all()
        
        formFieldsMap[item.id] = formFields.results || []
      }
    }
    
    return c.json({
      booking,
      items: items.results || [],
      formFieldsMap
    })
    
  } catch (error) {
    console.error('予約変更用データ取得エラー:', error)
    return c.json({ error: 'データの取得に失敗しました' }, 500)
  }
})

// API v2: 予約明細の参加者情報更新
app.put('/api/v2/booking-items/:item_id/participants', async (c) => {
  const { DB } = c.env
  const itemId = c.req.param('item_id')
  
  try {
    const body = await c.req.json()
    const { participants } = body
    
    if (!Array.isArray(participants)) {
      return c.json({ error: '参加者情報は配列形式で指定してください' }, 400)
    }
    
    // 予約明細を取得
    const item = await DB.prepare(`
      SELECT * FROM booking_items WHERE id = ?
    `).bind(itemId).first()
    
    if (!item) {
      return c.json({ error: '予約明細が見つかりません' }, 404)
    }
    
    // 参加者数が数量を超えていないかチェック
    if (participants.length > item.quantity) {
      return c.json({ 
        error: `参加者数（${participants.length}名）が予約数量（${item.quantity}名）を超えています` 
      }, 400)
    }
    
    // 参加者情報を更新
    await DB.prepare(`
      UPDATE booking_items SET
        participants = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      JSON.stringify(participants),
      itemId
    ).run()
    
    return c.json({ 
      success: true,
      message: '参加者情報を更新しました'
    })
  } catch (error) {
    console.error('参加者情報更新エラー:', error)
    return c.json({ error: '参加者情報の更新に失敗しました' }, 500)
  }
})

// API v2: CSV参加者テンプレートダウンロード
app.get('/api/v2/booking-items/:item_id/participants/template', async (c) => {
  const { DB } = c.env
  const itemId = c.req.param('item_id')
  
  try {
    console.log('========== CSVテンプレートダウンロード ==========')
    console.log('Item ID:', itemId)
    
    // 予約明細を取得
    const item = await DB.prepare(`
      SELECT 
        bi.*,
        b.booking_number,
        p.name as product_name
      FROM booking_items bi
      JOIN bookings b ON bi.booking_id = b.id
      LEFT JOIN products p ON bi.item_id = p.id AND bi.item_type = 'product'
      WHERE bi.id = ?
    `).bind(itemId).first()
    
    if (!item) {
      return c.json({ error: '予約明細が見つかりません' }, 404)
    }
    
    console.log('商品情報:', {
      item_name: item.item_name,
      product_name: item.product_name,
      quantity: item.quantity
    })
    
    // 商品の参加者情報設定を取得
    let formFieldSettings = {}
    if (item.item_type === 'product' && item.item_id) {
      const product = await DB.prepare(`
        SELECT form_field_settings
        FROM products
        WHERE id = ?
      `).bind(item.item_id).first()
      
      if (product && product.form_field_settings) {
        try {
          formFieldSettings = JSON.parse(product.form_field_settings)
          console.log('商品の参加者情報設定:', formFieldSettings)
        } catch (e) {
          console.error('form_field_settingsパースエラー:', e)
        }
      }
    }
    
    // 商品のフォームフィールドを取得（category=2: 参加者毎のカスタムフィールド）
    let formFields = []
    if (item.item_type === 'product' && item.item_id) {
      const fields = await DB.prepare(`
        SELECT field_name, field_label, field_type, is_required, display_order
        FROM product_form_fields
        WHERE product_id = ? AND category = 2
        ORDER BY display_order
      `).bind(item.item_id).all()
      
      formFields = fields.results || []
      console.log('フォームフィールド数（参加者毎のカスタムフィールド）:', formFields.length)
    }
    
    // CSVヘッダーを生成（商品設定に基づいて動的に生成）
    const headers = []
    const fieldMapping = [
      { key: 'lastname_kanji', label: '姓（漢字）' },
      { key: 'firstname_kanji', label: '名（漢字）' },
      { key: 'lastname_kana', label: '姓（カナ）' },
      { key: 'firstname_kana', label: '名（カナ）' },
      { key: 'lastname_roman', label: '姓（ローマ字）' },
      { key: 'firstname_roman', label: '名（ローマ字）' },
      { key: 'age', label: '年齢' },
      { key: 'gender', label: '性別' },
      { key: 'email', label: 'メール' },
      { key: 'phone', label: '電話' },
      { key: 'birth_date', label: '生年月日' },
      { key: 'address', label: '住所' }
    ]
    
    // form_field_settingsがtrueの項目のみヘッダーに追加
    fieldMapping.forEach(field => {
      if (formFieldSettings[field.key] === true) {
        headers.push(field.label)
      }
    })
    
    // カスタムフィールドのラベルを追加
    formFields.forEach(field => {
      headers.push(field.field_label)
    })
    
    console.log('CSVヘッダー（商品設定に基づく）:', headers)
    
    // 既存の参加者データを取得
    let participants = []
    try {
      participants = JSON.parse(item.participants || '[]')
    } catch (e) {
      console.error('参加者JSONパースエラー:', e)
      participants = []
    }
    
    console.log('既存参加者数:', participants.length)
    
    // CSVデータを生成（UTF-8 BOM付き、CRLF、ダブルクォートエスケープ）
    const BOM = '\uFEFF'
    let csvContent = BOM + headers.map(h => `"${h}"`).join(',') + '\r\n'
    
    // 既存参加者データを行として追加（商品設定に基づいて動的に生成）
    participants.forEach(p => {
      const row = []
      
      // form_field_settingsがtrueの項目のみ値を追加
      fieldMapping.forEach(field => {
        if (formFieldSettings[field.key] === true) {
          row.push(p[field.key] || '')
        }
      })
      
      // カスタムフィールドの値を追加
      formFields.forEach(field => {
        const value = (p.custom_fields && p.custom_fields[field.field_label]) || ''
        row.push(value)
      })
      
      // ダブルクォートエスケープ処理
      const escapedRow = row.map(cell => {
        const str = String(cell)
        // ダブルクォートを二重化
        const escaped = str.replace(/"/g, '""')
        return `"${escaped}"`
      })
      
      csvContent += escapedRow.join(',') + '\r\n'
    })
    
    // ファイル名を生成（予約番号_商品名_参加者一覧.csv）
    const sanitizedProductName = (item.product_name || item.item_name || '商品')
      .replace(/[<>:"/\\|?*]/g, '_')  // 無効な文字を置換
      .substring(0, 50)  // 長さ制限
    
    const filename = `${item.booking_number}_${sanitizedProductName}_参加者一覧.csv`
    
    console.log('生成ファイル名:', filename)
    console.log('CSV行数:', participants.length + 1)
    
    return new Response(csvContent, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename="${encodeURIComponent(filename)}"`
      }
    })
    
  } catch (error) {
    console.error('CSVテンプレート生成エラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ error: 'CSVテンプレートの生成に失敗しました' }, 500)
  }
})

// API v2: CSV参加者アップロード
app.post('/api/v2/booking-items/:item_id/participants/upload', async (c) => {
  const { DB } = c.env
  const itemId = c.req.param('item_id')
  
  try {
    console.log('========== CSV参加者アップロード ==========')
    console.log('Item ID:', itemId)
    
    // FormDataからCSVファイルを取得
    const formData = await c.req.formData()
    const file = formData.get('csv_file')
    
    if (!file || !(file instanceof File)) {
      return c.json({ success: false, error: 'CSVファイルが必要です' }, 400)
    }
    
    console.log('ファイル名:', file.name)
    console.log('ファイルサイズ:', file.size)
    
    // 予約明細を取得
    const item = await DB.prepare(`
      SELECT 
        bi.*,
        b.booking_number
      FROM booking_items bi
      JOIN bookings b ON bi.booking_id = b.id
      WHERE bi.id = ?
    `).bind(itemId).first()
    
    if (!item) {
      return c.json({ success: false, error: '予約明細が見つかりません' }, 404)
    }
    
    console.log('商品情報:', {
      item_name: item.item_name,
      quantity: item.quantity
    })
    
    // 商品の参加者情報設定を取得
    let formFieldSettings = {}
    if (item.item_type === 'product' && item.item_id) {
      const product = await DB.prepare(`
        SELECT form_field_settings
        FROM products
        WHERE id = ?
      `).bind(item.item_id).first()
      
      if (product && product.form_field_settings) {
        try {
          formFieldSettings = JSON.parse(product.form_field_settings)
          console.log('商品の参加者情報設定:', formFieldSettings)
        } catch (e) {
          console.error('form_field_settingsパースエラー:', e)
        }
      }
    }
    
    // 商品のフォームフィールドを取得（category=2: 参加者毎のカスタムフィールド）
    let formFields = []
    if (item.item_type === 'product' && item.item_id) {
      const fields = await DB.prepare(`
        SELECT field_name, field_label, field_type, is_required, display_order
        FROM product_form_fields
        WHERE product_id = ? AND category = 2
        ORDER BY display_order
      `).bind(item.item_id).all()
      
      formFields = fields.results || []
      console.log('フォームフィールド数（参加者毎のカスタムフィールド）:', formFields.length)
    }
    
    // 期待されるヘッダーを生成（商品設定に基づく）
    const expectedHeaders = []
    const fieldMapping = [
      { key: 'lastname_kanji', label: '姓（漢字）' },
      { key: 'firstname_kanji', label: '名（漢字）' },
      { key: 'lastname_kana', label: '姓（カナ）' },
      { key: 'firstname_kana', label: '名（カナ）' },
      { key: 'lastname_roman', label: '姓（ローマ字）' },
      { key: 'firstname_roman', label: '名（ローマ字）' },
      { key: 'age', label: '年齢' },
      { key: 'gender', label: '性別' },
      { key: 'email', label: 'メール' },
      { key: 'phone', label: '電話' },
      { key: 'birth_date', label: '生年月日' },
      { key: 'address', label: '住所' }
    ]
    
    fieldMapping.forEach(field => {
      if (formFieldSettings[field.key] === true) {
        expectedHeaders.push({ key: field.key, label: field.label })
      }
    })
    
    // カスタムフィールドも追加
    formFields.forEach(field => {
      expectedHeaders.push({ key: field.field_name, label: field.field_label, isCustom: true })
    })
    
    console.log('期待されるCSVヘッダー:', expectedHeaders.map(h => h.label))
    
    // CSVファイルを読み込み（UTF-8 BOM除去）
    let csvText = await file.text()
    
    // BOM除去
    if (csvText.charCodeAt(0) === 0xFEFF) {
      csvText = csvText.substring(1)
    }
    
    // 行分割（CRLF、LF両対応）
    const lines = csvText.split(/\r?\n/).filter(line => line.trim())
    
    if (lines.length === 0) {
      return c.json({ success: false, error: 'CSVファイルが空です' }, 400)
    }
    
    console.log('CSV行数（ヘッダー含む）:', lines.length)
    
    // ヘッダー行をパース
    const headerLine = lines[0]
    const headers = headerLine.split(',').map(h => {
      // ダブルクォート除去
      let header = h.trim()
      if (header.startsWith('"') && header.endsWith('"')) {
        header = header.substring(1, header.length - 1)
      }
      // エスケープされたダブルクォートを戻す
      header = header.replace(/""/g, '"')
      return header
    })
    
    console.log('CSVヘッダー:', headers)
    
    // 必須ヘッダーの検証（商品設定に基づく）
    const requiredHeaders = expectedHeaders.map(h => h.label)
    const missingHeaders = requiredHeaders.filter(h => !headers.includes(h))
    
    if (missingHeaders.length > 0) {
      return c.json({ 
        success: false, 
        error: `必須列が不足しています: ${missingHeaders.join(', ')}` 
      }, 400)
    }
    
    // 各データ行をパース
    const participants = []
    const errors = []
    
    for (let i = 1; i < lines.length; i++) {
      const line = lines[i].trim()
      if (!line) continue
      
      const lineNumber = i + 1
      
      // CSV行をパース（ダブルクォート対応）
      const values = []
      let currentValue = ''
      let insideQuotes = false
      
      for (let j = 0; j < line.length; j++) {
        const char = line[j]
        const nextChar = line[j + 1]
        
        if (char === '"' && insideQuotes && nextChar === '"') {
          // エスケープされたダブルクォート
          currentValue += '"'
          j++ // 次の文字をスキップ
        } else if (char === '"') {
          // クォート開始/終了
          insideQuotes = !insideQuotes
        } else if (char === ',' && !insideQuotes) {
          // 区切り文字
          values.push(currentValue)
          currentValue = ''
        } else {
          currentValue += char
        }
      }
      values.push(currentValue) // 最後の値
      
      // ヘッダーとマッピング
      const row = {}
      headers.forEach((header, idx) => {
        row[header] = (values[idx] || '').trim()
      })
      
      console.log(`${lineNumber}行目データ:`, row)
      
      // 必須フィールドのバリデーション（商品設定に基づく）
      for (const headerInfo of expectedHeaders) {
        if (!headerInfo.isCustom && formFieldSettings[headerInfo.key] === true) {
          // 標準フィールドで必須のもの
          if (!row[headerInfo.label] || !row[headerInfo.label].trim()) {
            errors.push(`${lineNumber}行目: ${headerInfo.label}は必須です`)
            break
          }
        } else if (headerInfo.isCustom) {
          // カスタムフィールドで必須のもの
          const field = formFields.find(f => f.field_label === headerInfo.label)
          if (field && field.is_required && (!row[headerInfo.label] || !row[headerInfo.label].trim())) {
            errors.push(`${lineNumber}行目: ${headerInfo.label}は必須です`)
            break
          }
        }
      }
      
      if (errors.length > 0) break
      
      // 参加者オブジェクトを構築（商品設定に基づく）
      const participant = {
        custom_fields: {}
      }
      
      // 標準フィールドの値を設定
      expectedHeaders.forEach(headerInfo => {
        if (!headerInfo.isCustom) {
          participant[headerInfo.key] = row[headerInfo.label] || ''
        } else {
          // カスタムフィールドの値を追加
          const value = row[headerInfo.label] || ''
          if (value) {
            participant.custom_fields[headerInfo.label] = value
          }
        }
      })
      
      participants.push(participant)
    }
    
    // エラーがあれば返す
    if (errors.length > 0) {
      console.error('バリデーションエラー:', errors)
      return c.json({ 
        success: false, 
        error: errors[0]  // 最初のエラーのみ返す
      }, 400)
    }
    
    console.log('パース完了。参加者数:', participants.length)
    
    // 参加者数が数量を超えていないかチェック
    if (participants.length > item.quantity) {
      return c.json({ 
        success: false,
        error: `参加者数（${participants.length}名）が予約数量（${item.quantity}名）を超えています` 
      }, 400)
    }
    
    // 参加者情報をDBに保存（既存データを上書き）
    await DB.prepare(`
      UPDATE booking_items SET
        participants = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      JSON.stringify(participants),
      itemId
    ).run()
    
    console.log('参加者情報を更新しました')
    
    return c.json({ 
      success: true,
      count: participants.length,
      message: `${participants.length}名の参加者情報を登録しました`
    })
    
  } catch (error) {
    console.error('CSV参加者アップロードエラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ 
      success: false, 
      error: 'CSV参加者のアップロードに失敗しました: ' + error.message 
    }, 500)
  }
})

// API v2: 予約明細の数量変更
app.put('/api/v2/booking-items/:item_id/quantity', async (c) => {
  const { DB } = c.env
  const itemId = c.req.param('item_id')
  
  try {
    const body = await c.req.json()
    const { quantity, participation_date, unit_price, price_category } = body
    
    if (!quantity || quantity < 1) {
      return c.json({ error: '数量は1以上で指定してください' }, 400)
    }
    
    // 予約明細を取得
    const item = await DB.prepare(`
      SELECT * FROM booking_items WHERE id = ?
    `).bind(itemId).first()
    
    if (!item) {
      return c.json({ error: '予約明細が見つかりません' }, 404)
    }
    
    // 参加者情報がある場合、数量が参加者数以上かチェック
    let participants = []
    try {
      participants = JSON.parse(item.participants || '[]')
    } catch (e) {
      participants = []
    }
    
    if (participants.length > quantity) {
      return c.json({ 
        error: `登録済み参加者（${participants.length}名）より少ない数量（${quantity}名）には変更できません` 
      }, 400)
    }
    
    // 小計を再計算（unit_priceが指定されている場合はそれを使用）
    const oldQuantity = item.quantity
    const oldSubtotal = item.subtotal
    const actualUnitPrice = unit_price !== undefined ? unit_price : item.unit_price
    const newSubtotal = actualUnitPrice * quantity
    
    // 数量、参加日、単価、価格帯を更新
    await DB.prepare(`
      UPDATE booking_items SET
        quantity = ?,
        unit_price = ?,
        subtotal = ?,
        participation_date = ?,
        price_category = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      quantity,
      actualUnitPrice,
      newSubtotal,
      participation_date || item.participation_date,
      price_category !== undefined ? price_category : item.price_category,
      itemId
    ).run()
    
    // 数量減少時に返金レコードを自動作成
    if (quantity < oldQuantity) {
      const refundAmount = oldSubtotal - newSubtotal
      
      // 予約情報を取得
      const booking = await DB.prepare(`
        SELECT booking_number FROM bookings WHERE id = ?
      `).bind(item.booking_id).first()
      
      if (booking) {
        // 返金番号を生成（REF + YYYYMMDD + 連番）
        const today = new Date().toISOString().split('T')[0].replace(/-/g, '')
        const lastRefund = await DB.prepare(`
          SELECT payment_number FROM booking_payments 
          WHERE payment_number LIKE ? 
          ORDER BY payment_number DESC LIMIT 1
        `).bind(`REF${today}-%`).first()
        
        let seq = 1
        if (lastRefund) {
          const lastSeq = parseInt(lastRefund.payment_number.slice(-3))
          seq = lastSeq + 1
        }
        const refundNumber = `REF${today}-${seq.toString().padStart(3, '0')}`
        
        // 返金レコード作成
        await DB.prepare(`
          INSERT INTO booking_payments (
            booking_number,
            payment_number,
            payment_type,
            payment_method,
            payment_status,
            amount,
            remarks,
            created_at,
            modified_at
          ) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
        `).bind(
          booking.booking_number,
          refundNumber,
          'refund',
          'refund',
          'refund_pending',
          refundAmount,
          `予約変更による返金（数量減少：${oldQuantity}名→${quantity}名）`
        ).run()
        
        console.log(`返金レコード自動作成: ${refundNumber}, 金額: ¥${refundAmount}`)
      }
    }
    
    return c.json({ 
      success: true,
      message: '数量を更新しました',
      new_subtotal: newSubtotal,
      refund_created: quantity < oldQuantity
    })
  } catch (error) {
    console.error('数量更新エラー:', error)
    return c.json({ error: '数量の更新に失敗しました' }, 500)
  }
})

// API v2: 新規予約明細作成
app.post('/api/v2/booking-items', async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const { booking_id, product_id, participation_date, quantity, price, unit_price, price_category, item_name, remarks } = body
    
    console.log('========== 新規明細作成リクエスト ==========')
    console.log('リクエストデータ:', JSON.stringify(body, null, 2))
    
    // 基本的な必須パラメータチェック
    if (!booking_id || quantity === undefined || quantity < 1) {
      console.log('エラー: 必須パラメータ不足 (booking_id, quantity)')
      return c.json({ error: '必須パラメータが不足しています' }, 400)
    }
    
    // 予約情報を取得
    const booking = await DB.prepare(`
      SELECT * FROM bookings WHERE id = ?
    `).bind(booking_id).first()
    
    if (!booking) {
      console.log('エラー: 予約が見つかりません (booking_id:', booking_id, ')')
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // 自由入力商品 (product_id === 0) と登録商品を区別
    const isCustomItem = product_id === 0 || product_id === null || product_id === undefined
    
    let itemType = 'product'
    let itemId = product_id
    let itemName = item_name
    let unitPrice = unit_price || price || 0
    let priceCategory = price_category || null
    
    if (isCustomItem) {
      // 自由入力商品の場合
      console.log('自由入力商品として処理します')
      
      if (!item_name || item_name.trim() === '') {
        console.log('エラー: 商品名が必要です')
        return c.json({ error: '商品名が必要です' }, 400)
      }
      
      if (price === undefined || price === null) {
        console.log('エラー: 価格が必要です')
        return c.json({ error: '価格が必要です' }, 400)
      }
      
      itemType = 'custom'
      itemId = 0
      itemName = item_name.trim()
      unitPrice = price
      
    } else {
      // 登録商品の場合
      console.log('登録商品として処理します (product_id:', product_id, ')')
      
      if (!participation_date) {
        console.log('エラー: 参加日が必要です')
        return c.json({ error: '参加日が必要です' }, 400)
      }
      
      // 商品情報を取得
      const product = await DB.prepare(`
        SELECT * FROM products WHERE id = ?
      `).bind(product_id).first()
      
      if (!product) {
        console.log('エラー: 商品が見つかりません (product_id:', product_id, ')')
        return c.json({ error: '商品が見つかりません' }, 404)
      }
      
      itemName = product.name
      // unit_priceを優先し、priceは後方互換用
      unitPrice = unit_price || price || 0
    }
    
    const subtotal = unitPrice * quantity
    
    console.log('明細作成データ:', {
      item_type: itemType,
      item_id: itemId,
      item_name: itemName,
      participation_date: participation_date || null,
      quantity,
      unit_price: unitPrice,
      price_category: priceCategory,
      subtotal,
      remarks: remarks || null
    })
    
    // 新規明細を作成
    const result = await DB.prepare(`
      INSERT INTO booking_items (
        booking_id,
        item_type,
        item_id,
        item_name,
        participation_date,
        quantity,
        unit_price,
        price_category,
        subtotal,
        participants,
        remarks,
        created_at,
        modified_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      booking_id,
      itemType,
      itemId,
      itemName,
      participation_date || null,
      quantity,
      unitPrice,
      priceCategory,
      subtotal,
      '[]',
      remarks || null
    ).run()
    
    const newItemId = result.meta.last_row_id
    
    console.log('明細作成成功 (id:', newItemId, ')')
    
    return c.json({ 
      success: true,
      id: newItemId,
      booking_id,
      item_type: itemType,
      item_id: itemId,
      item_name: itemName,
      participation_date: participation_date || null,
      quantity,
      unit_price: unitPrice,
      price_category: priceCategory,
      subtotal,
      remarks: remarks || null,
      message: '新規明細を作成しました'
    })
  } catch (error) {
    console.error('新規明細作成エラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ error: '新規明細の作成に失敗しました' }, 500)
  }
})

// API v2: 返金処理
app.post('/api/v2/bookings/:booking_number/refund', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    const body = await c.req.json()
    const { payment_id, booking_item_id, refund_amount, refund_reason, refund_details } = body
    
    // 決済を取得
    const payment = await DB.prepare(`
      SELECT * FROM booking_payments WHERE id = ? AND booking_number = ?
    `).bind(payment_id, bookingNumber).first()
    
    if (!payment) {
      return c.json({ error: '決済が見つかりません' }, 404)
    }
    
    // 返金履歴を作成
    await DB.prepare(`
      INSERT INTO refund_history (
        payment_id, booking_item_id, refund_amount, refund_reason, refund_details
      ) VALUES (?, ?, ?, ?, ?)
    `).bind(
      payment_id,
      booking_item_id || null,
      refund_amount,
      refund_reason,
      refund_details ? JSON.stringify(refund_details) : null
    ).run()
    
    // 決済の返金額を更新
    const newRefundedAmount = (payment.refunded_amount || 0) + refund_amount
    const newPaymentStatus = newRefundedAmount >= payment.amount ? 'refunded' : 'partially_refunded'
    
    await DB.prepare(`
      UPDATE booking_payments SET
        refunded_amount = ?,
        payment_status = ?,
        refund_date = ?
      WHERE id = ?
    `).bind(
      newRefundedAmount,
      newPaymentStatus,
      new Date().toISOString(),
      payment_id
    ).run()
    
    // 明細がある場合は明細も更新
    if (booking_item_id) {
      await DB.prepare(`
        UPDATE booking_items SET
          status = 'refunded',
          refund_amount = ?,
          canceled_at = ?
        WHERE id = ?
      `).bind(
        refund_amount,
        new Date().toISOString(),
        booking_item_id
      ).run()
    }
    
    return c.json({ success: true })
  } catch (error) {
    console.error('返金処理エラー:', error)
    return c.json({ error: '返金処理に失敗しました' }, 500)
  }
})

// API v2: 決済ステータス更新
app.put('/api/v2/booking-payments/:id/status', requireAuth, async (c) => {
  const { DB } = c.env
  const paymentId = c.req.param('id')
  
  try {
    const body = await c.req.json()
    const { payment_status, refund_date, payment_date } = body
    
    // 有効なステータス値をチェック
    const validStatuses = ['pending', 'completed', 'canceled', 'refund_pending', 'refunded']
    if (!validStatuses.includes(payment_status)) {
      return c.json({ error: '無効なステータスです' }, 400)
    }
    
    // 決済レコードを取得
    const payment = await DB.prepare(`
      SELECT * FROM booking_payments WHERE id = ?
    `).bind(paymentId).first()
    
    if (!payment) {
      return c.json({ error: '決済が見つかりません' }, 404)
    }
    
    // ステータスを更新
    await DB.prepare(`
      UPDATE booking_payments SET
        payment_status = ?,
        payment_date = ?,
        refund_date = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      payment_status,
      payment_date || payment.payment_date,
      refund_date || payment.refund_date,
      paymentId
    ).run()
    
    // 更新後のレコードを取得
    const updatedPayment = await DB.prepare(`
      SELECT * FROM booking_payments WHERE id = ?
    `).bind(paymentId).first()
    
    return c.json({ 
      success: true,
      payment: updatedPayment
    })
  } catch (error) {
    console.error('決済ステータス更新エラー:', error)
    return c.json({ error: '決済ステータスの更新に失敗しました' }, 500)
  }
})

// API v2: 決済削除
app.delete('/api/v2/booking-payments/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const paymentId = c.req.param('id')
  
  try {
    // 決済レコードを取得
    const payment = await DB.prepare(`
      SELECT * FROM booking_payments WHERE id = ?
    `).bind(paymentId).first()
    
    if (!payment) {
      return c.json({ error: '決済が見つかりません' }, 404)
    }
    
    // 決済済みまたは返金済みは削除不可
    if (payment.payment_status === 'completed' || payment.payment_status === 'refunded') {
      return c.json({ error: '決済済みまたは返金済みのレコードは削除できません' }, 400)
    }
    
    // 関連する予約明細があるかチェック
    const items = await DB.prepare(`
      SELECT COUNT(*) as count FROM booking_items WHERE payment_id = ?
    `).bind(paymentId).first()
    
    if (items && items.count > 0) {
      return c.json({ error: 'この決済に関連する予約明細が存在するため削除できません' }, 400)
    }
    
    // 決済レコードを削除
    await DB.prepare(`
      DELETE FROM booking_payments WHERE id = ?
    `).bind(paymentId).run()
    
    return c.json({ 
      success: true,
      message: '決済レコードを削除しました'
    })
  } catch (error) {
    console.error('決済削除エラー:', error)
    return c.json({ error: '決済の削除に失敗しました' }, 500)
  }
})

// API: イベント詳細取得（event_url指定）
app.get('/api/events/by-url/:event_url', async (c) => {
  const { DB } = c.env
  const eventUrl = c.req.param('event_url')

  const event = await DB.prepare(`
    SELECT 
      e.id,
      e.name,
      e.name_en,
      e.event_url,
      e.enable_flg,
      e.detail,
      e.detail_en,
      e.location,
      e.location_en,
      e.contact,
      e.contact_en,
      e.remarks,
      e.remarks_en,
      e.thanks_msg,
      e.thanks_msg_en,
      e.category,
      e.date_selection_type,
      e.event_type,
      e.parent_event_id,
      e.event_start_date,
      e.event_end_date,
      e.registration_start_date,
      e.registration_end_date,
      e.admin_login_start_date,
      e.admin_login_end_date,
      e.payment_flg,
      e.payment_credit_card,
      e.payment_bank_transfer,
      e.payment_convenience_store,
      e.bank_name,
      e.bank_branch,
      e.bank_account_type,
      e.bank_account_number,
      e.bank_account_name,
      e.bank_transfer_deadline,
      e.credit_fee_type,
      e.credit_fee_percentage,
      e.credit_fee_fixed,
      e.bank_fee_type,
      e.bank_fee_percentage,
      e.bank_fee_fixed,
      e.convenience_fee_type,
      e.convenience_fee_percentage,
      e.convenience_fee_fixed,
      e.admin_email,
      e.admin_cc_email,
      e.sender_name,
      e.sender_email,
      e.email_signature,
      e.email_signature_en,
      e.auto_reply_enabled,
      e.auto_reply_credit_payment,
      e.auto_reply_bank_payment,
      e.auto_reply_convenience_payment,
      e.image_url,
      e.client_id,
      e.organizer_id,
      e.vendor_id,
      e.created_at,
      e.modified_at,
      o.name as organizer_name,
      v.name as vendor_name,
      v.business_notes as vendor_business_notes
    FROM events e
    LEFT JOIN organizers o ON e.organizer_id = o.id
    LEFT JOIN vendors v ON e.vendor_id = v.id
    WHERE e.event_url = ? AND e.deleted_at IS NULL
  `).bind(eventUrl).first<Event>()

  if (!event) {
    return c.json({ error: 'Event not found' }, 404)
  }

  return c.json({ event })
})

