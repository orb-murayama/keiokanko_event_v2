                gap: 8px;
                padding: 15px 30px;
                background: linear-gradient(135deg, #dc2626, #991b1b);
                color: white;
                text-decoration: none;
                border-radius: 10px;
                font-weight: 700;
                font-size: 1.1rem;
                transition: all 0.3s ease;
                box-shadow: 0 4px 12px rgba(220, 38, 38, 0.3);
            }

            .booking-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(220, 38, 38, 0.4);
            }

            .no-products {
                text-align: center;
                padding: 60px 20px;
                color: #9ca3af;
                font-size: 1.1rem;
            }

            /* Navigation */
            .back-nav {
                margin-bottom: 30px;
            }

            .back-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #4b5563;
                text-decoration: none;
                font-weight: 600;
                padding: 10px 20px;
                background: white;
                border-radius: 8px;
                transition: all 0.3s ease;
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

            .back-link:hover {
                background: #f9fafb;
                color: #dc2626;
                transform: translateX(-4px);
            }

            /* Responsive */
            @media (max-width: 768px) {
                .hero h1 {
                    font-size: 1.8rem;
                }

                .hero p {
                    font-size: 1rem;
                }

                .product-card {
                    flex-direction: column;
                    gap: 20px;
                    text-align: center;
                }

                .product-action {
                    margin-left: 0;
                    width: 100%;
                }

                .booking-btn {
                    width: 100%;
                    justify-content: center;
                }
            }

            /* Animation */
            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .event-info,
            .products-section {
                animation: fadeInUp 0.6s ease backwards;
            }

            .products-section {
                animation-delay: 0.2s;
            }
        </style>
    </head>
    <body>
        <!-- Hero Section -->
        <section class="hero">
            <div class="hero-content">
                <h1>${event.name}</h1>
                <p>イベント詳細情報</p>
            </div>
        </section>

        <!-- Main Container -->
        <div class="container">
            <!-- Back Navigation -->
            <div class="back-nav">
                <a href="/events" class="back-link">
                    <i class="fas fa-arrow-left"></i>
                    イベント一覧に戻る
                </a>
            </div>

            <!-- Event Info -->
            <div class="event-info">
                <h2><i class="fas fa-info-circle"></i>イベント概要</h2>
                <div class="event-detail">${event.detail || 'イベント詳細情報はありません'}</div>
                
                ${event.contact ? `
