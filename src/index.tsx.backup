// API: 商品と共有在庫プールを一括紐付け（期間指定）
app.post('/api/products/:id/shared-stocks/batch', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const data = await c.req.json()

  // 指定された期間内の共有在庫プールを取得
  const { results: pools } = await DB.prepare(`
    SELECT id, date FROM shared_stock_pools
    WHERE pool_name = ? 
    AND (pool_code = ? OR (pool_code IS NULL AND ? IS NULL))
    AND date BETWEEN ? AND ?
    AND enable_flg = 1
    ORDER BY date
  `).bind(
    data.pool_name,
    data.pool_code,
    data.pool_code,
    data.date_start,
    data.date_end
  ).all()

  if (pools.length === 0) {
    return c.json({ 
      success: false, 
      error: '指定された期間に該当する共有在庫プールが見つかりません',
      added_count: 0
    }, 400)
  }

  // 各プールに対して紐付けを作成
  let addedCount = 0
  for (const pool of pools) {
    await DB.prepare(`
      INSERT INTO product_shared_stock_pools (
        product_id, shared_stock_pool_id, stock_name,
        price_band, enable_flg
      ) VALUES (?, ?, ?, ?, ?)
    `).bind(
      productId,
      pool.id,
      data.stock_name || null,
      data.price_band || null,
      1
    ).run()
    addedCount++
  }

  return c.json({ 
    success: true, 
    added_count: addedCount,
    message: `${addedCount}件の共有在庫を紐付けました` 
  })
})

