// API - 商品画像アップロード
app.post('/api/products/upload-image', async (c) => {
  const { R2 } = c.env
  
  try {
    const formData = await c.req.formData()
    const file = formData.get('image')
    
    if (!file || !(file instanceof File)) {
      return c.json({ error: '画像ファイルが選択されていません' }, 400)
    }
    
    // ファイルサイズチェック（5MB制限）
    if (file.size > 5 * 1024 * 1024) {
      return c.json({ error: '画像ファイルは5MB以下にしてください' }, 400)
    }
    
    // ファイルタイプチェック
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp']
    if (!allowedTypes.includes(file.type)) {
      return c.json({ error: '対応していない画像形式です（JPEG, PNG, GIF, WebPのみ）' }, 400)
    }
    
    // ファイル名を生成（タイムスタンプ + ランダム文字列）
    const timestamp = Date.now()
    const randomStr = Math.random().toString(36).substring(2, 15)
    const ext = file.name.split('.').pop()
    const fileName = `products/${timestamp}-${randomStr}.${ext}`
    
    // R2にアップロード
    const arrayBuffer = await file.arrayBuffer()
    await R2.put(fileName, arrayBuffer, {
      httpMetadata: {
        contentType: file.type
      }
    })
    
    // URLを返す（本番環境ではカスタムドメインまたはR2のPublic URLを使用）
    const imageUrl = `/api/products/images/${fileName}`
    
    return c.json({ 
      success: true,
      image_url: imageUrl,
      file_name: fileName
    })
  } catch (error) {
    console.error('Image upload error:', error)
    return c.json({ error: '画像のアップロードに失敗しました' }, 500)
  }
})

// API - 商品画像取得
app.get('/api/products/images/*', async (c) => {
  const { R2 } = c.env
  const fileName = c.req.path.replace('/api/products/images/', '')
  
  try {
    const object = await R2.get(fileName)
    
    if (!object) {
      return c.notFound()
    }
    
    const headers = new Headers()
    headers.set('Content-Type', object.httpMetadata?.contentType || 'image/jpeg')
    headers.set('Cache-Control', 'public, max-age=31536000')
    
    return new Response(object.body, { headers })
  } catch (error) {
    console.error('Image fetch error:', error)
    return c.notFound()
  }
})

