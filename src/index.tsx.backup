// API - 販売会社登録
app.post('/api/vendors', requireAuth, async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    const result = await DB.prepare(`
      INSERT INTO vendors (
        name, contactable_person, email, tel, fax, password,
        zip, pref_id, addr,
        business_hours, closed_days, business_notes,
        remarks, reg_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.contactable_person || null,
      data.email || null,
      data.tel || null,
      data.fax || null,
      data.password || '',
      data.zip || null,
      data.pref_id || null,
      data.addr || null,
      data.business_hours || null,
      data.closed_days || null,
      data.business_notes || null,
      data.remarks || null,
      data.reg_flg !== undefined ? data.reg_flg : 1
    ).run()

    return c.json({ id: result.meta.last_row_id, message: '販売会社を登録しました' })
  } catch (error) {
    console.error('販売会社登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 販売会社更新
app.put('/api/vendors/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()

  try {
    // パスワード更新がある場合とない場合で分岐
    let query = `
      UPDATE vendors SET
        name = ?,
        contactable_person = ?,
        email = ?,
        tel = ?,
        fax = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        business_hours = ?,
        closed_days = ?,
        business_notes = ?,
        remarks = ?,
        reg_flg = ?,
        modified_at = datetime('now', 'localtime')
    `
    
    const params = [
      data.name,
      data.contactable_person || null,
      data.email || null,
      data.tel || null,
      data.fax || null,
      data.zip || null,
      data.pref_id || null,
      data.addr || null,
      data.business_hours || null,
      data.closed_days || null,
      data.business_notes || null,
      data.remarks || null,
      data.reg_flg !== undefined ? data.reg_flg : 1
    ]

    if (data.password) {
      query += `, password = ?`
      params.push(data.password)
    }

    query += ` WHERE id = ?`
    params.push(id)

    await DB.prepare(query).bind(...params).run()

    return c.json({ message: '販売会社情報を更新しました' })
  } catch (error) {
    console.error('販売会社更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 販売会社詳細表示
app.delete('/api/vendors/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const vendorId = c.req.param('id')
  
  try {
    // 販売会社が存在するか確認
    const vendor = await DB.prepare(`
      SELECT id, name FROM vendors WHERE id = ?
    `).bind(vendorId).first()
    
    if (!vendor) {
      return c.json({ error: '販売会社が見つかりません' }, 404)
    }
    
    // 物理削除（完全削除）
    await DB.prepare('DELETE FROM vendors WHERE id = ?').bind(vendorId).run()
    
    return c.json({ message: '販売会社を削除しました' })
  } catch (error) {
    console.error('販売会社削除エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

