// API: オプション一覧取得
// API: オプション一覧取得
app.get('/api/options', requireAuth, async (c) => {
  const { DB } = c.env
  const { name, event_name, event_id, status, page, per_page } = c.req.query()
  
  // Vue.jsフロントエンド用：event_idが指定された場合はシンプルな一覧を返す
  if (event_id) {
    try {
      const { results } = await DB.prepare(`
        SELECT 
          o.id,
          o.name,
          o.description,
          o.image_url,
          os.price,
          os.stock_name as category_name
        FROM options o
        LEFT JOIN option_stocks os ON o.id = os.option_id
        WHERE o.event_id = ? AND o.enable_flg = 1 AND o.deleted_at IS NULL
        ORDER BY o.id
      `).bind(event_id).all()

      // オプションごとにグループ化
      const optionMap = new Map()
      for (const row of results || []) {
        if (!optionMap.has(row.id)) {
          optionMap.set(row.id, {
            id: row.id,
            name: row.name,
            description: row.description,
            image_url: row.image_url,
            price: row.price || 0
          })
        }
      }

      return c.json({ options: Array.from(optionMap.values()) })
    } catch (error) {
      console.error('オプション取得エラー:', error)
      return c.json({ error: 'オプション情報の取得に失敗しました' }, 500)
    }
  }
  
  // 管理画面用：ページネーション付き一覧
  const currentPage = parseInt(page || '1')
  const perPage = parseInt(per_page || '20')
  const offset = (currentPage - 1) * perPage
  
  let baseQuery = `
    SELECT 
      o.*,
      e.name as event_name,
      oc.name as category_name,
      GROUP_CONCAT(DISTINCT os.price) as prices
    FROM options o
    LEFT JOIN events e ON o.event_id = e.id
    LEFT JOIN option_categories oc ON o.option_category_id = oc.id
    LEFT JOIN option_stocks os ON o.id = os.option_id
    WHERE o.deleted_at IS NULL
  `
  const params: any[] = []
  
  if (name) {
    baseQuery += ' AND o.name LIKE ?'
    params.push(`%${name}%`)
  }
  
  if (event_name) {
    baseQuery += ' AND e.name LIKE ?'
    params.push(`%${event_name}%`)
  }
  
  if (status !== undefined && status !== '') {
    baseQuery += ' AND o.enable_flg = ?'
    params.push(parseInt(status))
  }
  
  baseQuery += ' GROUP BY o.id'
  
  // 総件数を取得
  const countQuery = `SELECT COUNT(*) as total FROM (${baseQuery})`
  const countStmt = DB.prepare(countQuery)
  const countResult = await (params.length > 0 ? countStmt.bind(...params) : countStmt).first()
  const total = countResult?.total || 0
  
  // データを取得（ページネーション付き）
  const dataQuery = baseQuery + ` ORDER BY o.id DESC LIMIT ? OFFSET ?`
  const dataStmt = DB.prepare(dataQuery)
  const dataParams = [...params, perPage, offset]
  const { results } = await dataStmt.bind(...dataParams).all()
  
  // ページネーション情報
  const totalPages = Math.ceil(total / perPage)
  
  return c.json({ 
    options: results,
    pagination: {
      page: currentPage,
      per_page: perPage,
      total: total,
      total_pages: totalPages
    }
  })
})

// API: オプション詳細取得
app.get('/api/options/:id', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')
  
  const option = await DB.prepare(`
    SELECT 
      o.*,
      e.name as event_name,
      oc.name as category_name
    FROM options o
    LEFT JOIN events e ON o.event_id = e.id
    LEFT JOIN option_categories oc ON o.option_category_id = oc.id
    WHERE o.id = ? AND o.deleted_at IS NULL
  `).bind(parseInt(optionId)).first()
  
  if (!option) {
    return c.json({ error: 'オプションが見つかりません' }, 404)
  }
  
  // 価格情報を option_stocks から取得
  const { results: prices } = await DB.prepare(`
    SELECT id, option_id, price, stock_name as category_name, date, stock, booked
    FROM option_stocks 
    WHERE option_id = ?
    ORDER BY date, id
  `).bind(parseInt(optionId)).all()
  
  return c.json({ option, prices })
})

// API: オプションの共有在庫紐付け一覧取得
app.get('/api/options/:id/shared-stocks', async (c) => {
  const { DB } = c.env
  const optionId = c.req.param('id')

  const { results } = await DB.prepare(`
    SELECT os.*, sp.pool_name, sp.pool_code, sp.date, sp.total_stock, sp.booked
    FROM option_shared_stocks os
    LEFT JOIN shared_stock_pools sp ON os.shared_stock_pool_id = sp.id
    WHERE os.option_id = ? AND os.enable_flg = 1
    ORDER BY os.priority, os.id
  `).bind(optionId).all()

  return c.json({ shared_stocks: results })
})

// API: 商品の共有在庫紐付け削除
app.delete('/api/products/:productId/shared-stocks/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')

  await DB.prepare(`
    UPDATE product_shared_stock_pools SET
      enable_flg = 0,
      modified_at = datetime('now', 'localtime')
    WHERE id = ?
  `).bind(id).run()

  return c.json({ success: true, message: '共有在庫の紐付けを削除しました' })
})

// API: オプションの共有在庫紐付け削除
app.delete('/api/options/:optionId/shared-stocks/:id', async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')

  await DB.prepare(`
    UPDATE option_shared_stocks SET
      enable_flg = 0,
      modified_at = datetime('now', 'localtime')
    WHERE id = ?
  `).bind(id).run()

