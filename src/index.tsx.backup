// API: 商品フォームフィールド取得
app.get('/api/products/:id/form-fields', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')

  // テーブルが存在しない場合は作成
  await DB.prepare(`
    CREATE TABLE IF NOT EXISTS product_form_fields (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      product_id INTEGER NOT NULL,
      field_type TEXT NOT NULL,
      field_name TEXT NOT NULL,
      field_label TEXT NOT NULL,
      field_options TEXT,
      is_required INTEGER DEFAULT 0,
      description TEXT,
      display_order INTEGER DEFAULT 0,
      placeholder TEXT,
      parent_field_id INTEGER,
      parent_condition TEXT,
      indent_level INTEGER DEFAULT 0,
      category INTEGER DEFAULT 1,
      created_at TEXT DEFAULT (datetime('now', 'localtime')),
      modified_at TEXT DEFAULT (datetime('now', 'localtime')),
      FOREIGN KEY (product_id) REFERENCES products(id)
    )
  `).run()

  const { results: fields } = await DB.prepare(`
    SELECT * FROM product_form_fields
    WHERE product_id = ?
    ORDER BY display_order ASC, id ASC
  `).bind(productId).all()

  return c.json({ fields })
})

// API: 参加者情報入力画面用 - 商品のフォーム設定とカスタムフィールドを取得（認証不要）
app.get('/api/auth/product-form-settings/:id', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    // 商品のフォーム設定を取得
    const product = await DB.prepare(`
      SELECT form_field_settings FROM products WHERE id = ?
    `).bind(productId).first()
    
    let formSettings = {}
    if (product && product.form_field_settings) {
      try {
        formSettings = JSON.parse(product.form_field_settings)
      } catch (e) {
        console.error('form_field_settings parse error:', e)
        formSettings = {}
      }
    }
    
    // カスタムフィールドを取得
    const { results: customFields } = await DB.prepare(`
      SELECT 
        id, field_type, field_name, field_label, field_options,
        is_required, description, display_order, placeholder,
        parent_field_id, parent_condition, indent_level, category
      FROM product_form_fields
      WHERE product_id = ?
      ORDER BY display_order ASC, id ASC
    `).bind(productId).all()
    
    // field_options を JSON パース
    const parsedFields = customFields.map(field => {
      if (field.field_options) {
        try {
          field.field_options = JSON.parse(field.field_options)
        } catch (e) {
          field.field_options = []
        }
      } else {
        field.field_options = []
      }
      return field
    })
    
    return c.json({
      form_settings: formSettings,
      custom_fields: parsedFields
    })
  } catch (error) {
    console.error('Error loading product form settings:', error)
    return c.json({
      form_settings: {},
      custom_fields: []
    }, 500)
  }
})

// API: フォーム設定コピー用の商品一覧取得（サジェスト）
app.get('/api/v2/products/form-fields/templates', async (c) => {
  const { DB } = c.env
  const currentProductId = c.req.query('exclude_id') // 現在編集中の商品IDを除外
  const search = c.req.query('search') || '' // 検索キーワード
  
  try {
    console.log('========== フォーム設定テンプレート一覧取得 ==========')
    console.log('除外商品ID:', currentProductId)
    console.log('検索キーワード:', search)
    
    // 商品一覧とフィールド数を取得
    let query = `
      SELECT 
        p.id,
        p.name,
        COUNT(pff.id) as field_count
      FROM products p
      LEFT JOIN product_form_fields pff ON p.id = pff.product_id
      WHERE p.enable_flg = 1
    `
    
    const bindings = []
    
    // 現在編集中の商品を除外
    if (currentProductId) {
      query += ` AND p.id != ?`
      bindings.push(currentProductId)
    }
    
    // 検索キーワードでフィルタ
    if (search) {
      query += ` AND p.name LIKE ?`
      bindings.push(`%${search}%`)
    }
    
    query += `
      GROUP BY p.id, p.name
      ORDER BY p.name ASC
      LIMIT 20
    `
    
    const { results: products } = await DB.prepare(query).bind(...bindings).all()
    
    console.log('取得商品数:', products.length)
    
    return c.json({
      success: true,
      products: products
    })
    
  } catch (error) {
    console.error('フォーム設定テンプレート一覧取得エラー:', error)
    return c.json({ error: 'テンプレート一覧の取得に失敗しました' }, 500)
  }
})

// API: フォーム設定をコピー
app.post('/api/v2/products/:product_id/form-fields/copy', async (c) => {
  const { DB } = c.env
  const targetProductId = c.req.param('product_id') // コピー先の商品ID
  const { source_product_id } = await c.req.json() // コピー元の商品ID
  
  try {
    console.log('========== フォーム設定コピー ==========')
    console.log('コピー元商品ID:', source_product_id)
    console.log('コピー先商品ID:', targetProductId)
    
    // コピー元のフィールド一覧を取得
    const { results: sourceFields } = await DB.prepare(`
      SELECT 
        field_type, field_name, field_label, field_options,
        is_required, description, display_order, placeholder,
        parent_field_id, parent_condition, indent_level,
        validation_rule, default_value, help_text, category
      FROM product_form_fields
      WHERE product_id = ?
      ORDER BY display_order ASC
    `).bind(source_product_id).all()
    
    if (sourceFields.length === 0) {
      return c.json({ 
        success: false, 
        error: 'コピー元の商品にフォーム設定がありません' 
      }, 400)
    }
    
    console.log('コピーするフィールド数:', sourceFields.length)
    
    // コピー先の既存フィールドを削除
    await DB.prepare(`
      DELETE FROM product_form_fields WHERE product_id = ?
    `).bind(targetProductId).run()
    
    console.log('既存フィールドを削除しました')
    
    // 新しいフィールドを挿入
    for (const field of sourceFields) {
      await DB.prepare(`
        INSERT INTO product_form_fields (
          product_id, field_type, field_name, field_label, field_options,
          is_required, description, display_order, placeholder,
          parent_field_id, parent_condition, indent_level,
          validation_rule, default_value, help_text, category
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(
        targetProductId, // 新しい product_id
        field.field_type,
        field.field_name,
        field.field_label,
        field.field_options,
        field.is_required,
        field.description,
        field.display_order,
        field.placeholder,
        field.parent_field_id,
        field.parent_condition,
        field.indent_level,
        field.validation_rule,
        field.default_value,
        field.help_text,
        field.category
      ).run()
    }
    
    console.log('フィールドコピー完了')
    
    return c.json({
      success: true,
      copied_count: sourceFields.length,
      message: `${sourceFields.length}件のフィールドをコピーしました`
    })
    
  } catch (error) {
    console.error('フォーム設定コピーエラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ 
      success: false, 
      error: 'フォーム設定のコピーに失敗しました: ' + error.message 
    }, 500)
  }
})

// API: 商品フォームフィールド一括保存（更新）
app.put('/api/products/:id/form-fields', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  const { fields } = await c.req.json()

  // テーブルが存在しない場合は作成
  await DB.prepare(`
    CREATE TABLE IF NOT EXISTS product_form_fields (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      product_id INTEGER NOT NULL,
      field_type TEXT NOT NULL,
      field_name TEXT NOT NULL,
      field_label TEXT NOT NULL,
      field_options TEXT,
      is_required INTEGER DEFAULT 0,
      description TEXT,
      display_order INTEGER DEFAULT 0,
      placeholder TEXT,
      parent_field_id INTEGER,
      parent_condition TEXT,
      indent_level INTEGER DEFAULT 0,
      category INTEGER DEFAULT 1,
      created_at TEXT DEFAULT (datetime('now', 'localtime')),
      modified_at TEXT DEFAULT (datetime('now', 'localtime')),
      FOREIGN KEY (product_id) REFERENCES products(id)
    )
  `).run()

  // 既存フィールドを取得
  const { results: existingFields } = await DB.prepare(`
    SELECT id FROM product_form_fields WHERE product_id = ?
  `).bind(productId).all()

  const existingIds = existingFields.map(f => f.id)
  const receivedIds = []
  const idMapping = {} // old ID -> new/existing ID のマッピング

  // 第1パス: 新規作成 or 既存更新
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i]
    const isNewField = !field.id || field.id.toString().startsWith('new_')

    if (isNewField) {
      // 新規作成 (INSERT)
      const result = await DB.prepare(`
        INSERT INTO product_form_fields (
          product_id, field_type, field_name, field_label, field_options,
          is_required, description, display_order, placeholder,
          parent_field_id, parent_condition, indent_level, category
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(
        productId,
        field.field_type,
        field.field_name,
        field.field_label,
        field.field_options || null,
        field.is_required ? 1 : 0,
        field.description || null,
        i,
        field.placeholder || null,
        null, // 親IDは第2パスで更新
        field.parent_condition || null,
        field.indent_level || 0,
        field.category || 1
      ).run()

      const newId = result.meta.last_row_id
      // temp_idがある場合はそれを使用、なければfield.idを使用
      const mappingKey = field.temp_id || field.id
      idMapping[mappingKey] = newId
      receivedIds.push(newId)
    } else {
      // 既存更新 (UPDATE)
      await DB.prepare(`
        UPDATE product_form_fields
        SET field_type = ?,
            field_name = ?,
            field_label = ?,
            field_options = ?,
            is_required = ?,
            description = ?,
            display_order = ?,
            placeholder = ?,
            parent_condition = ?,
            indent_level = ?,
            category = ?,
            modified_at = datetime('now', 'localtime')
        WHERE id = ? AND product_id = ?
      `).bind(
        field.field_type,
        field.field_name,
        field.field_label,
        field.field_options || null,
        field.is_required ? 1 : 0,
        field.description || null,
        i,
        field.placeholder || null,
        field.parent_condition || null,
        field.indent_level || 0,
        field.category || 1,
        field.id,
        productId
      ).run()

      // 既存フィールドもマッピングに追加（temp_idがあればそれも）
      const mappingKey = field.temp_id || field.id
      idMapping[mappingKey] = field.id
      receivedIds.push(parseInt(field.id))
    }
  }

  // 削除: リクエストに含まれないフィールド
  for (const existingId of existingIds) {
    if (!receivedIds.includes(existingId)) {
      await DB.prepare(`
        DELETE FROM product_form_fields WHERE id = ? AND product_id = ?
      `).bind(existingId, productId).run()
    }
  }

  // 第2パス: parent_field_id を更新
  console.log('[DEBUG] ID Mapping:', idMapping)
  for (let i = 0; i < fields.length; i++) {
    const field = fields[i]
    if (field.parent_field_id) {
      // 現在のフィールドIDを取得（temp_idまたはfield.idから）
      const currentFieldKey = field.temp_id || field.id
      const currentFieldId = idMapping[currentFieldKey] || field.id
      let parentId = null

      // 親IDを解決
      const parentIdStr = field.parent_field_id.toString()
      console.log(`[DEBUG] Resolving parent for field ${field.temp_id || field.id} (${field.field_label}): parent_field_id=${parentIdStr}`)
      
      if (idMapping[parentIdStr]) {
        parentId = idMapping[parentIdStr]
        console.log(`[DEBUG] Found in mapping: ${parentIdStr} -> ${parentId}`)
      } else if (!parentIdStr.startsWith('new_')) {
        parentId = parseInt(parentIdStr) || null
        console.log(`[DEBUG] Using existing ID: ${parentId}`)
      } else {
        console.log(`[DEBUG] Warning: parent ID ${parentIdStr} not found in mapping and is a new ID`)
      }

      if (parentId) {
        console.log(`[DEBUG] Updating field ${currentFieldId} with parent_field_id=${parentId}`)
        await DB.prepare(`
          UPDATE product_form_fields
          SET parent_field_id = ?
          WHERE id = ?
        `).bind(parentId, currentFieldId).run()
      } else {
        console.log(`[DEBUG] Warning: Could not resolve parent ID for field ${currentFieldId}`)
      }
    }
  }

  return c.json({ success: true, message: 'フォームフィールドを保存しました' })
})

// ========================================
// イベント関連付けAPI（親子構造）
// ========================================

// API: 子イベント一覧取得
app.get('/api/events/:id/children', async (c) => {
  const { DB } = c.env
  const parentId = c.req.param('id')
  
  const { results: children } = await DB.prepare(`
    SELECT *
    FROM events
    WHERE parent_event_id = ? AND enable_flg = 1
    ORDER BY id ASC
  `).bind(parentId).all()
  
  return c.json({ children })
})

// API: イベントグループ全体取得（親+子）
app.get('/api/events/:id/group', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  
  // イベント情報取得
  const event = await DB.prepare(`
    SELECT *
    FROM events
    WHERE id = ?
  `).bind(eventId).first()
  
  if (!event) {
    return c.json({ error: 'イベントが見つかりません' }, 404)
  }
  
  let parentEvent = null
  let childEvents = []
  
  if (event.event_type === 'parent') {
    // 親イベントの場合、子イベントを取得
    parentEvent = event
    const { results } = await DB.prepare(`
      SELECT *
      FROM events
      WHERE parent_event_id = ? AND enable_flg = 1
      ORDER BY id ASC
    `).bind(eventId).all()
    childEvents = results
  } else if (event.event_type === 'child') {
    // 子イベントの場合、親と兄弟を取得
    parentEvent = await DB.prepare(`
      SELECT *
      FROM events
      WHERE id = ?
    `).bind(event.parent_event_id).first()
    
    const { results } = await DB.prepare(`
      SELECT *
      FROM events
      WHERE parent_event_id = ? AND enable_flg = 1
      ORDER BY id ASC
    `).bind(event.parent_event_id).all()
    childEvents = results
  } else {
    // standalone の場合
    parentEvent = event
    childEvents = []
  }
  
  return c.json({ parent: parentEvent, children: childEvents })
})

// API: 親イベント一覧取得（イベント作成・編集時のドロップダウン用）
app.get('/api/events/parents/list', async (c) => {
  const { DB } = c.env
  
  const { results: parents } = await DB.prepare(`
    SELECT id, name, event_type
    FROM events 
    WHERE event_type IN ('parent', 'standalone') AND enable_flg = 1
    ORDER BY id DESC
  `).bind().all()
  
  return c.json({ parents })
})

// ========================================
// 共有在庫プールAPI
// ========================================

// API: 共有在庫プール一覧取得
app.get('/api/shared-stock-pools', async (c) => {
  const { DB } = c.env
  const { date, enable_flg } = c.req.query()

  let query = 'SELECT * FROM shared_stock_pools WHERE 1=1'
  const params: any[] = []

  if (date) {
    query += ' AND date = ?'
    params.push(date)
  }
  if (enable_flg !== undefined) {
    query += ' AND enable_flg = ?'
    params.push(parseInt(enable_flg))
  }

  query += ' ORDER BY date, time_slot_start, id'

  const stmt = DB.prepare(query)
  const { results } = await (params.length > 0 ? stmt.bind(...params) : stmt).all()

  return c.json({ pools: results })
})

// API: 共有在庫プール詳細取得
// API: 共有在庫プールサマリー取得（プール名とコードでグループ化）
app.get('/api/shared-stock-pools/summary', async (c) => {
  const { DB } = c.env
  
  try {
    const { results: pools } = await DB.prepare(`
      SELECT 
        pool_name,
        pool_code,
        description,
        COUNT(*) as date_count,
        SUM(total_stock) as total_stock_sum,
        SUM(booked) as booked_sum,
        SUM(available_stock) as available_stock_sum,
        MIN(date) as first_date,
        MAX(date) as last_date
      FROM shared_stock_pools
      WHERE enable_flg = 1
      GROUP BY pool_name, pool_code, description
      ORDER BY pool_name, pool_code
    `).all()
    
    return c.json({ pools })
  } catch (error) {
    console.error('Get pool summary error:', error)
    return c.json({ error: error.message }, 500)
  }
})
app.get('/api/shared-stock-pools/by-name', async (c) => {
  const { DB } = c.env
  const poolName = c.req.query('pool_name')
  const poolCode = c.req.query('pool_code') || ''
  
  if (!poolName) {
    return c.json({ error: 'プール名が指定されていません' }, 400)
  }
  
  try {
    const { results: stocks } = await DB.prepare(`
      SELECT * FROM shared_stock_pools
      WHERE pool_name = ? AND (pool_code = ? OR (pool_code IS NULL AND ? = ''))
      AND enable_flg = 1
      ORDER BY date ASC, time_slot_start
    `).bind(poolName, poolCode, poolCode).all()
    
    if (stocks.length === 0) {
      return c.json({ error: 'プールが見つかりません' }, 404)
    }
    
    // サマリー情報を計算
    const totalStock = stocks.reduce((sum, s) => sum + s.total_stock, 0)
    const totalBooked = stocks.reduce((sum, s) => sum + s.booked, 0)
    const totalAvailable = stocks.reduce((sum, s) => sum + s.available_stock, 0)
    
    return c.json({
      pool_name: poolName,
      pool_code: poolCode,
      description: stocks[0]?.description || '',
      summary: {
        total_stock: totalStock,
        total_booked: totalBooked,
        total_available: totalAvailable,
        date_count: stocks.length
      },
      stocks
    })
  } catch (error) {
    console.error('Get pool stocks by name error:', error)
    return c.json({ error: error.message }, 500)
  }
})
app.get('/api/shared-stock-pools/:id', async (c) => {
  const { DB } = c.env
  const poolId = c.req.param('id')

  const pool = await DB.prepare(`
    SELECT * FROM shared_stock_pools WHERE id = ?
  `).bind(poolId).first()

  if (!pool) {
    return c.json({ error: 'Pool not found' }, 404)
  }

  // 紐付けられた商品を取得
  const { results: products } = await DB.prepare(`
    SELECT ps.*, p.name as product_name
    FROM product_shared_stock_pools ps
    LEFT JOIN products p ON ps.product_id = p.id
    WHERE ps.shared_stock_pool_id = ? AND ps.enable_flg = 1
  `).bind(poolId).all()

  // TODO: optionsテーブル作成後に有効化
  // const { results: options } = await DB.prepare(`
  //   SELECT os.*, o.name as option_name
  //   FROM option_shared_stocks os
  //   LEFT JOIN options o ON os.option_id = o.id
  //   WHERE os.shared_stock_pool_id = ? AND os.enable_flg = 1
  // `).bind(poolId).all()

  return c.json({ pool, products, options: [] })
})

// API: 共有在庫プール作成
app.post('/api/shared-stock-pools', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  const result = await DB.prepare(`
    INSERT INTO shared_stock_pools (
      pool_name, pool_code, description, date,
      time_slot_start, time_slot_end, time_slot_label,
      total_stock, booked, enable_flg
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
  `).bind(
    data.pool_name,
    data.pool_code || null,
    data.description || null,
    data.date,
    data.time_slot_start || null,
    data.time_slot_end || null,
    data.time_slot_label || null,
    data.total_stock || 0,
    data.booked || 0,
    data.enable_flg !== undefined ? data.enable_flg : 1
  ).run()

  return c.json({ 
    success: true, 
    id: result.meta.last_row_id,
    message: '共有在庫プールを作成しました' 
  })
})

// API: 共有在庫プール一括作成（日付範囲対応）
app.post('/api/shared-stock-pools/batch', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()
  
  try {
    // 必須フィールドチェック
    if (!data.pool_name || !data.date_start || data.total_stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 日付範囲を取得
    const startDate = new Date(data.date_start)
    const endDate = data.date_end ? new Date(data.date_end) : startDate
    const dates = []
    
    for (let d = new Date(startDate); d <= endDate; d.setDate(d.getDate() + 1)) {
      dates.push(d.toISOString().split('T')[0])
    }
    
    let createdCount = 0
    let errors = []
    const createdIds = []
    
    for (const date of dates) {
      try {
        const result = await DB.prepare(`
          INSERT INTO shared_stock_pools (
            pool_name, pool_code, description, date,
            time_slot_start, time_slot_end, time_slot_label,
            total_stock, booked, enable_flg
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          data.pool_name,
          data.pool_code || null,
          data.description || null,
          date,
          data.time_slot_start || null,
          data.time_slot_end || null,
          data.time_slot_label || null,
          parseInt(data.total_stock),
          0,
          data.enable_flg !== undefined ? data.enable_flg : 1
        ).run()
        
        createdIds.push(result.meta.last_row_id)
        createdCount++
      } catch (error) {
        errors.push(`${date}: ${error.message}`)
      }
    }
    
    return c.json({
      success: true,
      created_count: createdCount,
      created_ids: createdIds,
      errors: errors.length > 0 ? errors : null,
      message: `${createdCount}個の共有在庫プールを作成しました`
    })
  } catch (error) {
    console.error('Batch pool creation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 共有在庫プール更新
app.put('/api/shared-stock-pools/:id', async (c) => {
  const { DB } = c.env
  const poolId = c.req.param('id')
  const data = await c.req.json()

  try {
    // 既存のプールを取得
    const existingPool = await DB.prepare(`
      SELECT * FROM shared_stock_pools WHERE id = ?
    `).bind(parseInt(poolId)).first()

    if (!existingPool) {
      return c.json({ error: '共有在庫プールが見つかりません' }, 404)
    }

    // 部分更新対応: 送信されたフィールドのみ更新
    await DB.prepare(`
      UPDATE shared_stock_pools SET
        pool_name = ?,
        pool_code = ?,
        description = ?,
        date = ?,
        time_slot_start = ?,
        time_slot_end = ?,
        time_slot_label = ?,
        total_stock = ?,
        enable_flg = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.pool_name !== undefined ? data.pool_name : existingPool.pool_name,
      data.pool_code !== undefined ? data.pool_code : existingPool.pool_code,
      data.description !== undefined ? data.description : existingPool.description,
      data.date !== undefined ? data.date : existingPool.date,
      data.time_slot_start !== undefined ? data.time_slot_start : existingPool.time_slot_start,
      data.time_slot_end !== undefined ? data.time_slot_end : existingPool.time_slot_end,
      data.time_slot_label !== undefined ? data.time_slot_label : existingPool.time_slot_label,
      data.total_stock !== undefined ? parseInt(data.total_stock) : existingPool.total_stock,
      data.enable_flg !== undefined ? data.enable_flg : existingPool.enable_flg,
      parseInt(poolId)
    ).run()

    return c.json({ success: true, message: '共有在庫プールを更新しました' })
  } catch (error) {
    console.error('Update shared stock pool error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 共有在庫プール削除
app.delete('/api/shared-stock-pools/:id', async (c) => {
  const { DB } = c.env
  const poolId = c.req.param('id')

  // 論理削除
  await DB.prepare(`
    UPDATE shared_stock_pools SET
      enable_flg = 0,
      modified_at = datetime('now', 'localtime')
    WHERE id = ?
  `).bind(poolId).run()

  return c.json({ success: true, message: '共有在庫プールを削除しました' })
})

