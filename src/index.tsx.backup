})

// API: 商品一覧取得（管理画面用）
app.get('/api/v1/products', async (c) => {
  const { DB } = c.env
  
  try {
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '20')
    const searchName = c.req.query('name') || ''
    const searchEventId = c.req.query('event_id') || ''
    const searchCategoryId = c.req.query('category_id') || ''
    const searchEnableFlg = c.req.query('enable_flg') || ''
    const offset = (page - 1) * perPage

    let query = `
      SELECT 
        p.id,
        p.name,
        p.client_id,
        p.event_id,
        p.product_category_id,
        p.sales_start,
        p.sales_end,
        p.enable_flg,
        e.name as event_name,
        pc.name as category_name,
        c.name as client_name
      FROM products p
      LEFT JOIN events e ON p.event_id = e.id
      LEFT JOIN product_categories pc ON p.product_category_id = pc.id
      LEFT JOIN clients c ON p.client_id = c.id
      WHERE p.deleted_at IS NULL
    `
    const params: any[] = []

    if (searchName) {
      query += ` AND p.name LIKE ?`
      params.push(`%${searchName}%`)
    }

    if (searchEventId) {
      query += ` AND p.event_id = ?`
      params.push(searchEventId)
    }

    if (searchCategoryId) {
      query += ` AND p.product_category_id = ?`
      params.push(searchCategoryId)
    }

    if (searchEnableFlg) {
      query += ` AND p.enable_flg = ?`
      params.push(searchEnableFlg)
    }

    // 総件数を取得
    const countQuery = query.replace(/SELECT .+ FROM/, 'SELECT COUNT(*) as count FROM')
    const { results: countResults } = await DB.prepare(countQuery).bind(...params).all()
    const totalCount = (countResults && countResults[0]) ? countResults[0].count : 0

    // ページングを追加
    query += ` ORDER BY p.id DESC LIMIT ? OFFSET ?`
    params.push(perPage, offset)

    const { results } = await DB.prepare(query).bind(...params).all()

    return c.json({
      products: results || [],
      total: totalCount,
      page,
      per_page: perPage,
      total_pages: Math.ceil(totalCount / perPage)
    })
  } catch (error) {
    console.error('商品一覧取得エラー:', error)
    return c.json({ error: '商品一覧の取得に失敗しました' }, 500)
  }
})

// API: 商品一覧取得（イベント別）
app.get('/api/events/:id/products', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  const { results: products } = await DB.prepare(`
    SELECT p.*, pp.price, pp.category_name, pp.id as price_id
    FROM products p
    LEFT JOIN product_prices pp ON p.id = pp.product_id
    WHERE p.event_id = ? AND p.enable_flg = 1
    AND datetime('now') >= datetime(p.sales_start)
    AND datetime('now') <= datetime(p.sales_end)
    ORDER BY p.id
  `).bind(eventId).all<Product & ProductPrice>()

  // 商品ごとにグループ化し、共通名称を追加
  const productMap = new Map();
  
  for (const row of products) {
    const productId = row.id;
    
    if (!productMap.has(productId)) {
      // JSONフィールドをパース
      let commonNames = [];
      try {
        if (row.common_names) {
          commonNames = JSON.parse(row.common_names);
        }
      } catch (e) {
        console.error('JSON parse error:', e);
      }
      
      productMap.set(productId, {
        id: row.id,
        client_id: row.client_id,
        event_id: row.event_id,
        name: row.name,
        sales_start: row.sales_start,
        sales_end: row.sales_end,
        closing_trade: row.closing_trade,
        description: row.description,
        remarks: row.remarks,
        fee_include: row.fee_include,
        fee_exclude: row.fee_exclude,
        cancel_policy: row.cancel_policy,
        purchase_limit: row.purchase_limit,
        enable_flg: row.enable_flg,
        price_unit: row.price_unit,
        charge_type: row.charge_type,
        charge_description: row.charge_description,
        common_names: commonNames,
        prices: []
      });
    }
    
    // priceデータを追加（共通名称付き）
    if (row.price !== null && row.category_name) {
      let commonName = '';
      let commonDescription = '';
      
      // category_nameから「名称X」のXを抽出
      const match = row.category_name.match(/名称(\d+)$/);
      if (match) {
        const slotNumber = parseInt(match[1]);
        const product = productMap.get(productId);
        const commonNameItem = product.common_names.find(item => item.label === `名称${slotNumber}`);
        if (commonNameItem) {
          commonName = commonNameItem.name || '';
          commonDescription = commonNameItem.description || '';
        }
      }
      
      productMap.get(productId).prices.push({
        id: row.price_id,
        product_id: productId,
        price: row.price,
        category_name: row.category_name,
        common_name: commonName,
        common_description: commonDescription
      });
    }
  }

  return c.json({ products: Array.from(productMap.values()) })
})

// API: 商品在庫取得
app.get('/api/products/:id/stocks', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')

  const { results: stocks } = await DB.prepare(`
    SELECT * FROM product_stocks 
    WHERE product_id = ? 
    AND date >= date('now')
    ORDER BY date
  `).bind(productId).all<ProductStock>()

  return c.json({ stocks })
})

// API: イベントの商品取得（Vue.jsフロントエンド用・管理画面用）
// API: 商品一覧取得
app.get('/api/products', requireAuth, async (c) => {
  const { DB } = c.env
  const eventId = c.req.query('event_id')
  const perPage = parseInt(c.req.query('per_page') || '1000')
  const searchName = c.req.query('name') || ''
  const searchEnableFlg = c.req.query('enable_flg') || ''

  try {
    // 管理画面用（event_idなし）
    if (!eventId) {
      let query = `
        SELECT 
          p.id,
          p.name,
          p.description,
          p.enable_flg,
          p.sales_start,
          p.sales_end,
          e.name as event_name,
          pc.name as category_name
        FROM products p
        LEFT JOIN events e ON p.event_id = e.id
        LEFT JOIN product_categories pc ON p.product_category_id = pc.id
        WHERE p.deleted_at IS NULL
      `
      const params: any[] = []

      if (searchName) {
        query += ` AND p.name LIKE ?`
        params.push(`%${searchName}%`)
      }

      if (searchEnableFlg !== '') {
        query += ` AND p.enable_flg = ?`
        params.push(parseInt(searchEnableFlg))
      }

      query += ` ORDER BY p.id DESC LIMIT ?`
      params.push(perPage)

      const { results } = await DB.prepare(query).bind(...params).all()
      return c.json({ products: results || [] })
    }

    // フロントエンド用（event_id指定）
    let query = `
      SELECT 
        p.id,
        p.name,
        p.description,
        p.enable_flg,
        p.sales_start,
        p.sales_end,
        e.name as event_name,
        pc.name as category_name,
        (
          SELECT price 
          FROM product_prices pp 
          WHERE pp.product_id = p.id 
          ORDER BY pp.id ASC 
          LIMIT 1
        ) as price,
        (
          SELECT SUM(ps.stock - ps.booked)
          FROM product_stocks ps
          WHERE ps.product_id = p.id
            AND ps.date >= date('now')
        ) as stock
      FROM products p
      LEFT JOIN events e ON p.event_id = e.id
      LEFT JOIN product_categories pc ON p.product_category_id = pc.id
      WHERE p.event_id = ? AND p.deleted_at IS NULL AND p.enable_flg = 1
    `
    const params: any[] = [eventId]

    if (searchName) {
      query += ` AND p.name LIKE ?`
      params.push(`%${searchName}%`)
    }

    if (searchEnableFlg !== '') {
      query += ` AND p.enable_flg = ?`
      params.push(parseInt(searchEnableFlg))
    }

    query += ` ORDER BY p.id DESC LIMIT ?`
    params.push(perPage)

    const { results } = await DB.prepare(query).bind(...params).all()
    return c.json({ products: results || [] })
  } catch (error) {
    console.error('商品取得エラー:', error)
    return c.json({ error: '商品情報の取得に失敗しました' }, 500)
  }
})

// API: イベント在庫取得（Vue.jsフロントエンド用）
app.get('/api/stocks', async (c) => {
  const { DB } = c.env
  const eventId = c.req.query('event_id')
  const days = parseInt(c.req.query('days') || '30')

  if (!eventId) {
    return c.json({ error: 'event_id is required' }, 400)
  }

  const today = new Date().toISOString().split('T')[0]
  const futureDate = new Date()
  futureDate.setDate(futureDate.getDate() + days)
  const endDate = futureDate.toISOString().split('T')[0]

  try {
    const result = await DB.prepare(`
      SELECT 
        ps.id,
        ps.product_id,
        ps.date,
        ps.stock_name,
        ps.price_band,
        ps.stock,
        ps.booked,
        (ps.stock - ps.booked) as available,
        p.name as product_name,
        p.sales_start,
        p.sales_end,
        p.closing_trade,
        p.purchase_limit
      FROM product_stocks ps
      INNER JOIN products p ON ps.product_id = p.id
      WHERE p.event_id = ?
        AND ps.date >= ?
        AND ps.date <= ?
        AND (ps.stock - ps.booked) > 0
        AND p.enable_flg = 1
        AND p.deleted_at IS NULL
      ORDER BY ps.date ASC, ps.stock_name ASC
    `).bind(eventId, today, endDate).all()

    return c.json({ stocks: result.results || [] })
  } catch (error) {
    console.error('在庫取得エラー:', error)
    return c.json({ error: '在庫情報の取得に失敗しました' }, 500)
  }
})

// API: イベントの利用可能な日付一覧を取得
app.get('/api/events/:id/available-dates', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  const today = new Date().toISOString().split('T')[0]

  try {
    const result = await DB.prepare(`
      SELECT DISTINCT ps.date
      FROM product_stocks ps
      INNER JOIN products p ON ps.product_id = p.id
      WHERE p.event_id = ?
        AND ps.date >= ?
        AND (ps.stock - ps.booked) > 0
        AND p.enable_flg = 1
      ORDER BY ps.date ASC
    `).bind(eventId, today).all()

    return c.json({ dates: result.results || [] })
  } catch (error) {
    console.error('日付取得エラー:', error)
    return c.json({ error: '日付情報の取得に失敗しました' }, 500)
  }
})

// API: 特定日付の商品と在庫を取得（商品ごとにグループ化）
app.get('/api/events/:id/products-by-date', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const date = c.req.query('date')

  if (!date) {
    return c.json({ error: 'date is required' }, 400)
  }

  try {
    // 商品情報と在庫を取得
    const result = await DB.prepare(`
      SELECT 
        p.id as product_id,
        p.name as product_name,
        p.description,
        p.note,
        p.fee_include,
        p.fee_exclude,
        p.image_url,
        p.sales_start,
        p.sales_end,
        p.closing_trade,
        p.purchase_limit,
        ps.id as stock_id,
        ps.stock_name,
        ps.price_band,
        ps.stock,
        ps.booked,
        (ps.stock - ps.booked) as available
      FROM products p
      INNER JOIN product_stocks ps ON p.id = ps.product_id
      WHERE p.event_id = ?
        AND ps.date = ?
        AND (ps.stock - ps.booked) > 0
        AND p.enable_flg = 1
      ORDER BY p.id ASC, ps.stock_name ASC
    `).bind(eventId, date).all()

    // 商品ごとにグループ化
    const productsMap = new Map()
    
    for (const row of result.results || []) {
      if (!productsMap.has(row.product_id)) {
        productsMap.set(row.product_id, {
          product_id: row.product_id,
          product_name: row.product_name,
          description: row.description,
          note: row.note,
          fee_include: row.fee_include,
          fee_exclude: row.fee_exclude,
          image_url: row.image_url,
          sales_start: row.sales_start,
          sales_end: row.sales_end,
          closing_trade: row.closing_trade,
          purchase_limit: row.purchase_limit,
          stocks: [],
          prices: [] // 価格情報を追加
        })
      }
      
      productsMap.get(row.product_id).stocks.push({
        stock_id: row.stock_id,
        stock_name: row.stock_name,
        price_band: row.price_band,
        stock: row.stock,
        booked: row.booked,
        available: row.available
      })
    }

    // 各商品の価格情報を取得
    for (const [productId, product] of productsMap) {
      const pricesResult = await DB.prepare(`
        SELECT id, price, category_name, price_band, price_name
        FROM product_prices
        WHERE product_id = ?
        ORDER BY id ASC
      `).bind(productId).all()
      
      product.prices = pricesResult.results || []
    }

    const products = Array.from(productsMap.values())

    return c.json({ products })
  } catch (error) {
    console.error('商品・在庫取得エラー:', error)
    return c.json({ error: '商品情報の取得に失敗しました' }, 500)
  }
})

// API: イベントの全商品と在庫名を取得（日付選択前の表示用）
app.get('/api/events/:id/products-all', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  try {
    // 商品情報と価格情報、在庫名を取得
    const result = await DB.prepare(`
      SELECT 
        p.id as product_id,
        p.name as product_name,
        p.description as product_description,
        p.image_url,
        pp.id as price_id,
        pp.price,
        pp.category_name,
        ps.stock_name,
        ps.price_band
      FROM products p
      LEFT JOIN product_prices pp ON p.id = pp.product_id
      LEFT JOIN product_stocks ps ON p.id = ps.product_id
      WHERE p.event_id = ?
        AND p.enable_flg = 1
      GROUP BY p.id, pp.id, ps.stock_name, ps.price_band
      ORDER BY p.id ASC, ps.stock_name ASC
    `).bind(eventId).all()

    // 商品ごとにグループ化
    const productsMap = new Map()
    
    for (const row of result.results || []) {
      if (!productsMap.has(row.product_id)) {
        productsMap.set(row.product_id, {
          product_id: row.product_id,
          product_name: row.product_name,
          product_description: row.product_description,
          image_url: row.image_url,
          prices: [],
          stock_names: []
        })
      }
      
      const product = productsMap.get(row.product_id)
      
      // 価格情報を追加（重複排除）
      if (row.price_id && !product.prices.find(p => p.price_id === row.price_id)) {
        product.prices.push({
          price_id: row.price_id,
          price: row.price,
          category_name: row.category_name
        })
      }
      
      // 在庫名を追加（重複排除）
      if (row.stock_name && !product.stock_names.find(s => s.stock_name === row.stock_name && s.price_band === row.price_band)) {
        product.stock_names.push({
          stock_name: row.stock_name,
          price_band: row.price_band
        })
      }
    }

    const products = Array.from(productsMap.values())

    return c.json({ products })
  } catch (error) {
    console.error('商品一覧取得エラー:', error)
    return c.json({ error: '商品情報の取得に失敗しました' }, 500)
  }
})

// API: 在庫登録
app.post('/api/stocks', async (c) => {
  const { DB } = c.env
  const data = await c.req.json()
  
  try {
    // 必須フィールドチェック
    if (!data.product_id || !data.date || data.stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 既存の在庫をチェック（同じ商品ID、日付、在庫名、価格帯の組み合わせ）
    const existing = await DB.prepare(`
      SELECT id FROM product_stocks
      WHERE product_id = ? AND date = ? 
        AND (stock_name IS NULL AND ? IS NULL OR stock_name = ?)
        AND (price_band IS NULL AND ? IS NULL OR price_band = ?)
    `).bind(
      parseInt(data.product_id),
      data.date,
      data.stock_name || null,
      data.stock_name || null,
      data.price_band || null,
      data.price_band || null
    ).first()
    
    if (existing) {
      return c.json({ error: '同じ日付・在庫名・価格帯の在庫が既に存在します' }, 400)
    }
    
    // 在庫を登録
    const result = await DB.prepare(`
      INSERT INTO product_stocks (product_id, date, stock, booked, stock_name, price_band)
      VALUES (?, ?, ?, 0, ?, ?)
    `).bind(
      parseInt(data.product_id),
      data.date,
      parseInt(data.stock),
      data.stock_name || null,
      data.price_band || null
    ).run()
    
    return c.json({ 
      success: true,
      id: result.meta.last_row_id,
      message: '在庫を登録しました'
    })
  } catch (error) {
    console.error('Stock creation error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 在庫更新
app.put('/api/stocks/:id', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('id')
  const data = await c.req.json()
  
  try {
    // 必須フィールドチェック
    if (!data.product_id || !data.date || data.stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 在庫が存在するかチェック
    const existing = await DB.prepare(`
      SELECT * FROM product_stocks WHERE id = ?
    `).bind(parseInt(stockId)).first()
    
    if (!existing) {
      return c.json({ error: '在庫が見つかりません' }, 404)
    }
    
    // 重複チェック（同じ商品ID、日付、在庫名、価格帯で別のレコードが存在しないか）
    const duplicate = await DB.prepare(`
      SELECT id FROM product_stocks
      WHERE product_id = ? AND date = ? 
        AND (stock_name IS NULL AND ? IS NULL OR stock_name = ?)
        AND (price_band IS NULL AND ? IS NULL OR price_band = ?)
        AND id != ?
    `).bind(
      parseInt(data.product_id),
      data.date,
      data.stock_name || null,
      data.stock_name || null,
      data.price_band || null,
      data.price_band || null,
      parseInt(stockId)
    ).first()
    
    if (duplicate) {
      return c.json({ error: '同じ日付・在庫名・価格帯の在庫が既に存在します' }, 400)
    }
    
    // 在庫を更新
    await DB.prepare(`
      UPDATE product_stocks
      SET product_id = ?, date = ?, stock = ?, stock_name = ?, price_band = ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      parseInt(data.product_id),
      data.date,
      parseInt(data.stock),
      data.stock_name || null,
      data.price_band || null,
      parseInt(stockId)
    ).run()
    
    return c.json({ 
      success: true,
      message: '在庫を更新しました'
    })
  } catch (error) {
    console.error('Stock update error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 在庫削除
app.delete('/api/stocks/:id', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('id')
  
  try {
    // 在庫が存在するかチェック
    const existing = await DB.prepare(`
      SELECT * FROM product_stocks WHERE id = ?
    `).bind(parseInt(stockId)).first()
    
    if (!existing) {
      return c.json({ error: '在庫が見つかりません' }, 404)
    }
    
    // 予約が入っている場合は削除不可
    if (existing.booked > 0) {
      return c.json({ 
        error: `予約済み（${existing.booked}件）のため削除できません` 
      }, 400)
    }
    
    // 在庫を削除
    await DB.prepare(`
      DELETE FROM product_stocks WHERE id = ?
    `).bind(parseInt(stockId)).run()
    
    return c.json({ 
      success: true,
      message: '在庫を削除しました'
    })
  } catch (error) {
    console.error('Stock deletion error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 商品別在庫一覧取得
app.get('/api/products/:id/stocks', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    const { results: stocks } = await DB.prepare(`
      SELECT * FROM product_stocks
      WHERE product_id = ?
      ORDER BY date ASC, stock_name ASC, price_band ASC
    `).bind(parseInt(productId)).all()
    
    return c.json({ 
      success: true,
      stocks: stocks || []
    })
  } catch (error) {
    console.error('Stock fetch error:', error)
    return c.json({ error: '在庫情報の取得に失敗しました' }, 500)
  }
})

// API: オプション一覧取得（イベント別）
app.get('/api/events/:id/options', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')

  const { results: options } = await DB.prepare(`
    SELECT o.*, os.price, os.stock_name as category_name
    FROM options o
    LEFT JOIN option_stocks os ON o.id = os.option_id
    WHERE o.event_id = ? AND o.enable_flg = 1
    ORDER BY o.id
  `).bind(eventId).all<Option & OptionPrice>()

  return c.json({ options })
})

// API - 日付別オプション取得（在庫と料金を含む）
app.get('/api/events/:id/options-by-date', async (c) => {
  const { DB } = c.env
  const eventId = c.req.param('id')
  const date = c.req.query('date')

  if (!date) {
    return c.json({ error: '日付パラメータが必要です' }, 400)
  }

  // オプション在庫を取得
  const { results: optionStocks } = await DB.prepare(`
    SELECT 
      os.id as stock_id,
      os.option_id,
      os.date,
      os.stock_name,
      os.price,
      os.stock,
      os.booked,
      COALESCE(os.available_stock, os.stock - os.booked) as available,
      o.name as option_name,
      o.description as option_description,
      o.image_url,
      o.sales_start,
      o.sales_end,
      o.closing_trade,
      o.purchase_limit
    FROM option_stocks os
    INNER JOIN options o ON os.option_id = o.id
    WHERE o.event_id = ? 
      AND o.enable_flg = 1 
      AND os.enable_flg = 1
      AND os.date = ?
    ORDER BY o.id, os.id
  `).bind(eventId, date).all()

  // オプションごとにグループ化
  const optionsMap = new Map()
  
  for (const stock of optionStocks) {
    if (!optionsMap.has(stock.option_id)) {
      optionsMap.set(stock.option_id, {
        option_id: stock.option_id,
        option_name: stock.option_name,
        option_description: stock.option_description,
        image_url: stock.image_url,
        sales_start: stock.sales_start,
        sales_end: stock.sales_end,
        closing_trade: stock.closing_trade,
        purchase_limit: stock.purchase_limit,
        stocks: []
      })
    }
    
    optionsMap.get(stock.option_id).stocks.push({
      stock_id: stock.stock_id,
      stock_name: stock.stock_name,
      price: stock.price,
      date: stock.date,
      stock: stock.stock,
      booked: stock.booked,
      available: stock.available
    })
  }

  const options = Array.from(optionsMap.values())

  return c.json({ options })
})

