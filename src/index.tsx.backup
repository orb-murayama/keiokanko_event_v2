// イベント一覧ページ（お客様側）
app.get('/events', async (c) => {
  const { DB } = c.env
  
  // 有効なイベント一覧を取得（削除済みを除外）
  const { results } = await DB.prepare(`
    SELECT * FROM events 
    WHERE enable_flg = 1 
      AND deleted_at IS NULL
    ORDER BY created_at DESC
  `).all<Event>()

  const eventsHtml = results.map(event => `
    <div class="bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition">
      <h3 class="text-xl font-bold text-gray-800 mb-2">
        <a href="/events/${event.id}" class="hover:text-blue-600">
          ${event.name}
        </a>
      </h3>
      <p class="text-gray-600 mb-4">${event.detail || ''}</p>
      <div class="flex items-center justify-between">
        <span class="text-sm text-gray-500">
          <i class="fas fa-calendar mr-1"></i>
          ${new Date(event.created_at).toLocaleDateString('ja-JP')}
        </span>
        <a href="/events/${event.id}/booking" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 transition text-sm">
          <i class="fas fa-ticket-alt mr-1"></i>予約する
        </a>
      </div>
    </div>
  `).join('')

