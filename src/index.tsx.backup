// 予約フロー：参加者情報入力画面
// ========================

app.get('/booking/customer-info', async (c) => {
  const { DB } = c.env
  const eventId = c.req.query('event_id')
  
  // Cookieからmember_idを取得
  const cookies = c.req.header('Cookie') || ''
  const memberIdMatch = cookies.match(/member_id=(\d+)/)
  const memberId = memberIdMatch ? parseInt(memberIdMatch[1]) : null
  
  if (!memberId) {
    return c.redirect(`/booking/login?event_id=${eventId}`)
  }
  
  // 会員情報を取得
  const member = await DB.prepare(
    'SELECT * FROM members WHERE id = ? AND enable_flg = 1'
  ).bind(memberId).first()
  
  if (!member) {
    return c.redirect(`/booking/login?event_id=${eventId}`)
  }
  
  // イベント情報を取得
  const event = await DB.prepare(
    'SELECT * FROM events WHERE id = ?'
  ).bind(eventId).first()
  
  // フォーム設定をパース
  let formSettings = {
    name_kanji: true,
    name_kana: true,
    name_roma: false,
    address: true,
    tel: true,
    birth_date: false,
    age: false
  }
  
  try {
    if (event?.form_field_settings) {
      formSettings = JSON.parse(event.form_field_settings)
    }
  } catch (e) {
    console.error('Form settings parse error:', e)
  }
  
  // 都道府県リストを取得
  const { results: prefs } = await DB.prepare('SELECT id, name FROM prefs ORDER BY id').all()
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>参加者情報入力 | ${event?.name || 'イベント予約'}</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
    </head>
    <body class="bg-gradient-to-br from-blue-50 to-purple-50 min-h-screen">
        <div class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <!-- ヘッダー -->
                <div class="text-center mb-8">
                    <div class="inline-block bg-white rounded-full p-4 shadow-lg mb-4">
                        <i class="fas fa-user-edit text-5xl text-blue-600"></i>
                    </div>
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">参加者情報入力</h1>
                    <p class="text-gray-600">イベント: ${event?.name || ''}</p>
                </div>

                <!-- 進捗バー -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center">
                                <i class="fas fa-check text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-700">予約内容選択</span>
                        </div>
                        <div class="flex-1 h-1 bg-green-500 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center">
                                <i class="fas fa-user text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-blue-600">参加者情報</span>
                        </div>
                        <div class="flex-1 h-1 bg-gray-300 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-gray-300 text-white flex items-center justify-center">
                                <i class="fas fa-check-circle text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-500">確認</span>
                        </div>
                        <div class="flex-1 h-1 bg-gray-300 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-gray-300 text-white flex items-center justify-center">
                                <i class="fas fa-credit-card text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-500">決済</span>
                        </div>
                    </div>
                </div>

                <!-- 参加者情報フォーム -->
                <div class="bg-white rounded-2xl shadow-xl p-8">
                    <form id="customerInfoForm" class="space-y-8">
                        <!-- 代理予約チェックボックス -->
                        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
                            <label class="flex items-center cursor-pointer">
                                <input type="checkbox" id="is_proxy" class="w-5 h-5 text-blue-600 mr-3">
                                <div>
                                    <span class="font-semibold text-gray-800">代理予約</span>
                                    <p class="text-sm text-gray-600 mt-1">予約者と参加者が異なる場合はチェックしてください</p>
                                </div>
                            </label>
                        </div>

                        <!-- 参加者情報 -->
                        <div id="participantSection">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b-2 border-blue-600">
                                <i class="fas fa-user mr-2"></i>参加者情報
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                ${formSettings.name_kanji ? `
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        姓（漢字）<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="participant_family_name" required
                                           value="${member.family_name || ''}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        名（漢字）<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="participant_first_name" required
                                           value="${member.first_name || ''}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                ` : ''}
                                ${formSettings.name_kana ? `
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        姓（カナ）<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="participant_family_kana" required
                                           value="${member.family_kana || ''}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        名（カナ）<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="participant_first_kana" required
                                           value="${member.first_kana || ''}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                ` : ''}
                                ${formSettings.name_roma ? `
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        姓（ローマ字）
                                    </label>
                                    <input type="text" id="participant_last_name_en"
                                           value="${member.last_name_en || ''}"
                                           placeholder="YAMADA"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        名（ローマ字）
                                    </label>
                                    <input type="text" id="participant_first_name_en"
                                           value="${member.first_name_en || ''}"
                                           placeholder="TARO"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                ` : ''}
                                ${formSettings.birth_date ? `
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        生年月日<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="date" id="birth_date" required
                                           value="${member.birth || ''}"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                ` : ''}
                                ${formSettings.age ? `
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        年齢<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="number" id="age" required
                                           placeholder="30"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                ` : ''}
                            </div>
                        </div>

                        <!-- 連絡先 -->
                        ${formSettings.tel ? `
                        <div>
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b-2 border-blue-600">
                                <i class="fas fa-phone mr-2"></i>連絡先
                            </h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        電話番号<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="tel" id="tel" required
                                           value="${member.tel || ''}"
                                           placeholder="03-1234-5678"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        緊急連絡先<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="tel" id="emergency_tel" required
                                           placeholder="090-1234-5678"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                    <p class="text-xs text-gray-500 mt-1">※ 当日連絡がつく電話番号を入力してください</p>
                                </div>
                            </div>
                        </div>
                        ` : ''}

                        <!-- 住所 -->
                        ${formSettings.address ? `
                        <div>
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b-2 border-blue-600">
                                <i class="fas fa-map-marker-alt mr-2"></i>住所
                            </h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        郵便番号<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="zip" required
                                           value="${member.zip || ''}"
                                           placeholder="123-4567"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                                <div>
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        都道府県<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <select id="pref_id" required
                                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                        <option value="">選択してください</option>
                                        ${prefs.map(p => `<option value="${p.id}" ${member.pref_id == p.id ? 'selected' : ''}>${p.name}</option>`).join('')}
                                    </select>
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                        住所<span class="text-red-500 ml-1">*</span>
                                    </label>
                                    <input type="text" id="addr" required
                                           value="${member.addr || ''}"
                                           placeholder="市区町村・番地"
                                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
                                </div>
                            </div>
                        </div>
                        ` : ''}

                        <!-- 追加情報（カスタムフォームフィールド） -->
                        <div id="customFieldsSection" style="display: none;">
                            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-2 border-b-2 border-blue-600">
                                <i class="fas fa-clipboard-list mr-2"></i>追加情報
                            </h3>
                            <div id="customFieldsContainer" class="space-y-4">
                                <!-- カスタムフィールドが動的に追加されます -->
                            </div>
                        </div>

                        <!-- エラーメッセージ -->
                        <div id="errorMessage" class="hidden bg-red-50 border-l-4 border-red-500 p-4">
                            <div class="flex">
                                <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
                                <p id="errorText" class="text-sm text-red-700"></p>
                            </div>
                        </div>

                        <!-- ボタン -->
                        <div class="flex gap-4">
                            <button type="button" onclick="history.back()"
                                    class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-3 rounded-lg font-semibold transition">
                                <i class="fas fa-arrow-left mr-2"></i>戻る
                            </button>
                            <button type="submit" id="submitBtn"
                                    class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                                <i class="fas fa-arrow-right mr-2"></i>予約内容を確認する
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            const formSettings = ${JSON.stringify(formSettings)};
            const eventId = '${eventId}';
            let customFields = [];
            
            // カスタムフォームフィールドを読み込み
            async function loadCustomFields() {
                try {
                    const response = await axios.get(\`/api/events/\${eventId}/form-fields\`);
                    customFields = response.data.fields || [];
                    
                    if (customFields.length > 0) {
                        document.getElementById('customFieldsSection').style.display = 'block';
                        renderCustomFields();
                    }
                } catch (error) {
                    console.error('カスタムフィールド読み込みエラー:', error);
                }
            }
            
            // カスタムフィールドをレンダリング
            function renderCustomFields() {
                const container = document.getElementById('customFieldsContainer');
                container.innerHTML = '';
                
                customFields.forEach(field => {
                    // 親フィールドがある場合、初期状態では非表示
                    // parent_field_id が -1 またはそれ以外の値で、parent_condition が存在する場合は子フィールド
                    const hasParent = (field.parent_field_id === -1 || 
                                      field.parent_field_id === '-1' ||
                                      (field.parent_field_id !== null && 
                                       field.parent_field_id !== 'null' && 
                                       field.parent_field_id !== ''));
                    const hasCondition = (field.parent_condition !== null &&
                                         field.parent_condition !== 'null' &&
                                         field.parent_condition !== '');
                    const shouldHide = hasParent && hasCondition;
                    
                    console.log('Field: ' + field.field_name + ', parent_field_id: ' + field.parent_field_id + ', parent_condition: ' + field.parent_condition + ', shouldHide: ' + shouldHide);
                    
                    const fieldHtml = generateFieldHtml(field, shouldHide);
                    container.insertAdjacentHTML('beforeend', fieldHtml);
                });
                
                // 階層フィールドの表示制御を初期化
                initializeHierarchicalFields();
            }
            
            // フィールドのHTMLを生成
            function generateFieldHtml(field, shouldHide = false) {
                const required = field.is_required ? 'required' : '';
                const requiredLabel = field.is_required ? '<span class="text-red-500 ml-1">*</span>' : '';
                const placeholder = field.placeholder || '';
                const description = field.description ? '<p class="text-xs text-gray-500 mt-1">' + field.description + '</p>' : '';
                
                // スタイルを統合（インデントと表示制御）
                let styleStr = '';
                if (field.indent_level > 0) {
                    styleStr += 'margin-left: ' + (field.indent_level * 20) + 'px;';
                }
                if (shouldHide) {
                    styleStr += ' display: none;';
                }
                const styleAttr = styleStr ? 'style="' + styleStr + '"' : '';
                
                let inputHtml = '';
                
                switch (field.field_type) {
                    case 'text':
                    case 'email':
                    case 'tel':
                        inputHtml = '<input type="' + field.field_type + '" id="custom_field_' + field.id + '" name="' + field.field_name + '" ' +
                                   required + ' placeholder="' + placeholder + '"' +
                                   ' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"' +
                                   ' data-field-id="' + field.id + '"' +
                                   ' data-field-name="' + field.field_name + '">';
                        break;
                    
                    case 'date':
                        inputHtml = '<input type="date" id="custom_field_' + field.id + '" name="' + field.field_name + '" ' +
                                   required +
                                   ' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"' +
                                   ' data-field-id="' + field.id + '"' +
                                   ' data-field-name="' + field.field_name + '">';
                        break;
                    
                    case 'textarea':
                        inputHtml = '<textarea id="custom_field_' + field.id + '" name="' + field.field_name + '" ' +
                                      'rows="3" ' + required + ' placeholder="' + placeholder + '"' +
                                      ' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"' +
                                      ' data-field-id="' + field.id + '"' +
                                      ' data-field-name="' + field.field_name + '"></textarea>';
                        break;
                    
                    case 'select':
                        const options = field.field_options ? JSON.parse(field.field_options) : [];
                        const optionsHtml = options.map(opt => '<option value="' + opt + '">' + opt + '</option>').join('');
                        inputHtml = '<select id="custom_field_' + field.id + '" name="' + field.field_name + '" ' +
                                    required +
                                    ' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"' +
                                    ' data-field-id="' + field.id + '"' +
                                    ' data-field-name="' + field.field_name + '">' +
                                    '<option value="">選択してください</option>' +
                                    optionsHtml +
                                    '</select>';
                        break;
                    
                    case 'radio':
                        const radioOptions = field.field_options ? JSON.parse(field.field_options) : [];
                        const radioHtml = radioOptions.map((opt, idx) => 
                            '<label class="inline-flex items-center mr-4">' +
                                '<input type="radio" id="custom_field_' + field.id + '_' + idx + '" ' +
                                       'name="' + field.field_name + '_' + field.id + '" value="' + opt + '" ' + required +
                                       ' class="mr-2" ' +
                                       ' data-field-id="' + field.id + '"' +
                                       ' data-field-name="' + field.field_name + '">' +
                                '<span>' + opt + '</span>' +
                            '</label>'
                        ).join('');
                        inputHtml = '<div class="flex flex-wrap gap-2">' + radioHtml + '</div>';
                        break;
                    
                    case 'checkbox':
                        const checkboxOptions = field.field_options ? JSON.parse(field.field_options) : [];
                        const checkboxHtml = checkboxOptions.map((opt, idx) => 
                            '<label class="inline-flex items-center mr-4">' +
                                '<input type="checkbox" id="custom_field_' + field.id + '_' + idx + '" ' +
                                       'name="' + field.field_name + '_' + field.id + '[]" value="' + opt + '"' +
                                       ' class="mr-2" ' +
                                       ' data-field-id="' + field.id + '"' +
                                       ' data-field-name="' + field.field_name + '">' +
                                '<span>' + opt + '</span>' +
                            '</label>'
                        ).join('');
                        inputHtml = '<div class="flex flex-wrap gap-2">' + checkboxHtml + '</div>';
                        break;
                    
                    default:
                        inputHtml = '<input type="text" id="custom_field_' + field.id + '" name="' + field.field_name + '" ' +
                                   required + ' placeholder="' + placeholder + '"' +
                                   ' class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"' +
                                   ' data-field-id="' + field.id + '"' +
                                   ' data-field-name="' + field.field_name + '">';
                }
                
                return '<div class="custom-field-wrapper" ' + styleAttr +
                         ' data-field-id="' + field.id + '"' +
                         ' data-parent-field-id="' + (field.parent_field_id || '') + '"' +
                         ' data-parent-condition="' + (field.parent_condition || '') + '">' +
                        '<label class="block text-sm font-semibold text-gray-700 mb-2">' +
                            field.field_label + requiredLabel +
                        '</label>' +
                        inputHtml +
                        description +
                    '</div>';
            }
            
            // 階層フィールドの表示制御を初期化
            function initializeHierarchicalFields() {
                console.log('Initializing hierarchical fields...');
                console.log('Custom fields:', customFields);
                
                // parent_field_id が -1 の場合、親フィールドのIDを解決
                customFields.forEach(field => {
                    if (field.parent_field_id === -1 && field.parent_condition) {
                        // 親フィールドを名前で検索（display_orderが小さい方を優先）
                        const parentField = customFields
                            .filter(f => f.display_order < field.display_order)
                            .reverse()[0];
                        
                        if (parentField) {
                            console.log('Resolved parent for field "' + field.field_name + '": parent_id=' + parentField.id + ', parent_name=' + parentField.field_name);
                            field.parent_field_id = parentField.id;
                        }
                    }
                });
                
                // 親フィールドの変更を監視
                customFields.forEach(field => {
                    if (field.field_type === 'select' || field.field_type === 'radio') {
                        // IDベースで要素を取得（field.id を使用）
                        const element = document.getElementById('custom_field_' + field.id);
                        if (!element) {
                            console.warn('Element not found for field ' + field.field_name + ' (ID: ' + field.id + ')');
                            return;
                        }
                        
                        console.log('Attaching change listener to field ' + field.field_name + ' (ID: ' + field.id + ')');
                        element.addEventListener('change', function() {
                            console.log('Parent field ' + field.field_name + ' changed to: ' + this.value);
                            handleParentFieldChange(field.id, this.value);
                        });
                        
                        // ラジオボタンの場合
                        if (field.field_type === 'radio') {
                            const radioInputs = document.querySelectorAll('[name="' + field.field_name + '"]');
                            console.log('Found ' + radioInputs.length + ' radio inputs for ' + field.field_name);
                            radioInputs.forEach(input => {
                                input.addEventListener('change', function() {
                                    console.log('Radio field ' + field.field_name + ' changed to: ' + this.value);
                                    handleParentFieldChange(field.id, this.value);
                                });
                            });
                        }
                    }
                });
            }
            
            // 親フィールドの変更時に子フィールドを表示/非表示
            function handleParentFieldChange(parentFieldId, selectedValue) {
                console.log('handleParentFieldChange called: parentFieldId=' + parentFieldId + ', selectedValue=' + selectedValue);
                
                // この親フィールドに依存する子フィールドを探す
                const childFields = document.querySelectorAll('[data-parent-field-id="' + parentFieldId + '"]');
                console.log('Found ' + childFields.length + ' child fields for parent ' + parentFieldId);
                
                childFields.forEach(childField => {
                    const parentCondition = childField.getAttribute('data-parent-condition');
                    const fieldId = childField.getAttribute('data-field-id');
                    
                    console.log('  Child field ' + fieldId + ': condition=' + parentCondition + ', match=' + (selectedValue === parentCondition));
                    
                    if (selectedValue === parentCondition) {
                        // 条件に一致する場合は表示
                        childField.style.display = 'block';
                        console.log('  -> Showing child field ' + fieldId);
                    } else {
                        // 条件に一致しない場合は非表示にして値をクリア
                        childField.style.display = 'none';
                        clearFieldValue(childField);
                        console.log('  -> Hiding child field ' + fieldId);
                    }
                });
            }
            
            // フィールドの値をクリア
            function clearFieldValue(fieldWrapper) {
                const inputs = fieldWrapper.querySelectorAll('input, select, textarea');
                inputs.forEach(input => {
                    if (input.type === 'checkbox' || input.type === 'radio') {
                        input.checked = false;
                    } else {
                        input.value = '';
                    }
                });
            }
            
            // カスタムフィールドの値を収集
            function collectCustomFieldValues() {
                const customFieldValues = {};
                
                customFields.forEach(field => {
                    const fieldWrapper = document.querySelector('[data-field-id="' + field.id + '"]');
                    
                    // 非表示フィールドはスキップ
                    if (fieldWrapper && fieldWrapper.style.display === 'none') {
                        return;
                    }
                    
                    let value = null;
                    
                    if (field.field_type === 'checkbox') {
                        const checkedBoxes = document.querySelectorAll('[name="' + field.field_name + '_' + field.id + '[]"]:checked');
                        value = Array.from(checkedBoxes).map(cb => cb.value);
                    } else if (field.field_type === 'radio') {
                        const checkedRadio = document.querySelector('[name="' + field.field_name + '_' + field.id + '"]:checked');
                        value = checkedRadio ? checkedRadio.value : '';
                    } else {
                        const element = document.getElementById('custom_field_' + field.id);
                        value = element ? element.value : '';
                    }
                    
                    customFieldValues[field.field_name] = value;
                });
                
                return customFieldValues;
            }
            
            // ページ読み込み時にカスタムフィールドを読み込む
            loadCustomFields();
            
            // 代理予約チェックボックスの制御
            document.getElementById('is_proxy').addEventListener('change', function(e) {
                // 代理予約の場合は参加者情報をクリア
                if (e.target.checked) {
                    if (formSettings.name_kanji) {
                        document.getElementById('participant_family_name').value = '';
                        document.getElementById('participant_first_name').value = '';
                    }
                    if (formSettings.name_kana) {
                        document.getElementById('participant_family_kana').value = '';
                        document.getElementById('participant_first_kana').value = '';
                    }
                } else {
                    // 代理予約解除の場合は会員情報で自動入力
                    if (formSettings.name_kanji) {
                        document.getElementById('participant_family_name').value = '${member.family_name || ''}';
                        document.getElementById('participant_first_name').value = '${member.first_name || ''}';
                    }
                    if (formSettings.name_kana) {
                        document.getElementById('participant_family_kana').value = '${member.family_kana || ''}';
                        document.getElementById('participant_first_kana').value = '${member.first_kana || ''}';
                    }
                }
            });

            // フォーム送信
            document.getElementById('customerInfoForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const submitBtn = document.getElementById('submitBtn');
                const errorMessage = document.getElementById('errorMessage');
                const errorText = document.getElementById('errorText');
                
                // エラーメッセージを非表示
                errorMessage.classList.add('hidden');
                
                // ボタンを無効化
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>処理中...';
                
                try {
                    // 参加者情報をセッションストレージに保存
                    const customerInfo = {
                        is_proxy: document.getElementById('is_proxy').checked
                    };
                    
                    // フォーム設定に応じて項目を追加
                    if (formSettings.name_kanji) {
                        customerInfo.participant_family_name = document.getElementById('participant_family_name').value;
                        customerInfo.participant_first_name = document.getElementById('participant_first_name').value;
                    }
                    if (formSettings.name_kana) {
                        customerInfo.participant_family_kana = document.getElementById('participant_family_kana').value;
                        customerInfo.participant_first_kana = document.getElementById('participant_first_kana').value;
                    }
                    if (formSettings.name_roma) {
                        customerInfo.participant_last_name_en = document.getElementById('participant_last_name_en')?.value || '';
                        customerInfo.participant_first_name_en = document.getElementById('participant_first_name_en')?.value || '';
                    }
                    if (formSettings.birth_date) {
                        customerInfo.birth_date = document.getElementById('birth_date')?.value || '';
                    }
                    if (formSettings.age) {
                        customerInfo.age = document.getElementById('age')?.value || '';
                    }
                    if (formSettings.tel) {
                        customerInfo.tel = document.getElementById('tel').value;
                        customerInfo.emergency_tel = document.getElementById('emergency_tel').value;
                    }
                    if (formSettings.address) {
                        customerInfo.zip = document.getElementById('zip').value;
                        customerInfo.pref_id = document.getElementById('pref_id').value;
                        customerInfo.addr = document.getElementById('addr').value;
                    }
                    
                    // カスタムフィールドの値を追加
                    customerInfo.customFields = collectCustomFieldValues();
                    
                    sessionStorage.setItem('customerInfo', JSON.stringify(customerInfo));
                    
                    // 予約内容確認画面へ遷移
                    window.location.href = '/booking/confirm?event_id=${eventId}';
                } catch (error) {
                    // エラー表示
                    errorText.textContent = error.message || '処理に失敗しました';
                    errorMessage.classList.remove('hidden');
                    
                    // ボタンを再有効化
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-arrow-right mr-2"></i>予約内容を確認する';
                }
            });
        </script>
    </body>
    </html>
  `)
})

// ========================
// 予約確認画面
// ========================

app.get('/booking/confirm', async (c) => {
  const { DB } = c.env
  const eventId = c.req.query('event_id')
  
  // Cookieからmember_idを取得
  const cookies = c.req.header('Cookie') || ''
  const memberIdMatch = cookies.match(/member_id=(\d+)/)
  const memberId = memberIdMatch ? parseInt(memberIdMatch[1]) : null
  
  if (!memberId) {
    return c.redirect(`/booking/login?event_id=${eventId}`)
  }
  
  // 会員情報を取得
  const member = await DB.prepare(
    'SELECT * FROM members WHERE id = ? AND enable_flg = 1'
  ).bind(memberId).first()
  
  if (!member) {
    return c.redirect(`/booking/login?event_id=${eventId}`)
  }
  
  // イベント情報を取得
  const event = await DB.prepare(
    'SELECT * FROM events WHERE id = ?'
  ).bind(eventId).first()
  
  if (!event) {
    return c.html('<h1>イベントが見つかりません</h1>', 404)
  }
  
  // 都道府県リストを取得
  const { results: prefs } = await DB.prepare('SELECT id, name FROM prefs ORDER BY id').all()
  
  // カスタムフォームフィールドを取得
  const { results: customFields } = await DB.prepare(`
    SELECT * FROM event_form_fields
    WHERE event_id = ?
    ORDER BY display_order ASC, id ASC
  `).bind(eventId).all()
  
  // 決済設定（個別フラグから取得）
  const paymentSettings = {
    payment_credit_card: event.payment_credit_card === 1,
    payment_bank_transfer: event.payment_bank_transfer === 1,
    payment_convenience_store: event.payment_convenience_store === 1,
    bank_name: event.bank_name || '',
    bank_branch: event.bank_branch || '',
    bank_account_type: event.bank_account_type || '',
    bank_account_number: event.bank_account_number || '',
    bank_account_holder: event.bank_account_name || '',
    bank_transfer_deadline: event.bank_transfer_deadline || 7,
    convenience_payment_deadline: event.convenience_payment_deadline || 7
  }
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>予約内容確認 | ${event?.name || 'イベント予約'}</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/axios@1.6.0/dist/axios.min.js"></script>
    </head>
    <body class="bg-gradient-to-br from-blue-50 to-purple-50 min-h-screen">
        <div class="container mx-auto px-4 py-8">
            <div class="max-w-4xl mx-auto">
                <!-- ヘッダー -->
                <div class="text-center mb-8">
                    <div class="inline-block bg-white rounded-full p-4 shadow-lg mb-4">
                        <i class="fas fa-check-circle text-5xl text-green-600"></i>
                    </div>
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">予約内容確認</h1>
                    <p class="text-gray-600">イベント: ${event?.name || ''}</p>
                </div>

                <!-- 進捗バー -->
                <div class="bg-white rounded-lg shadow-md p-6 mb-6">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center">
                                <i class="fas fa-check text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-700">予約内容選択</span>
                        </div>
                        <div class="flex-1 h-1 bg-green-500 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center">
                                <i class="fas fa-check text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-700">参加者情報</span>
                        </div>
                        <div class="flex-1 h-1 bg-green-500 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center">
                                <i class="fas fa-check-circle text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-blue-600">確認</span>
                        </div>
                        <div class="flex-1 h-1 bg-gray-300 mx-4"></div>
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-gray-300 text-white flex items-center justify-center">
                                <i class="fas fa-credit-card text-sm"></i>
                            </div>
                            <span class="ml-2 text-sm font-semibold text-gray-500">決済</span>
                        </div>
                    </div>
                </div>

                <!-- 予約内容 -->
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 pb-2 border-b-2 border-blue-600">
                        <i class="fas fa-calendar-check mr-2"></i>予約内容
                    </h2>
                    <div id="bookingDetailsContainer" class="space-y-4">
                        <!-- 予約詳細が表示されます -->
                    </div>
                </div>

                <!-- 参加者情報 -->
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 pb-2 border-b-2 border-blue-600">
                        <i class="fas fa-user mr-2"></i>参加者情報
                    </h2>
                    <div id="customerInfoContainer" class="space-y-4">
                        <!-- 参加者情報が表示されます -->
                    </div>
                </div>

                <!-- カスタムフィールド情報 -->
                <div id="customFieldsInfoSection" class="bg-white rounded-2xl shadow-xl p-8 mb-6" style="display: none;">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 pb-2 border-b-2 border-blue-600">
                        <i class="fas fa-clipboard-list mr-2"></i>追加情報
                    </h2>
                    <div id="customFieldsInfoContainer" class="space-y-4">
                        <!-- カスタムフィールド情報が表示されます -->
                    </div>
                </div>

                <!-- 決済方法選択 -->
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 pb-2 border-b-2 border-blue-600">
                        <i class="fas fa-credit-card mr-2"></i>お支払い方法
                    </h2>
                    <div id="paymentMethodsContainer" class="space-y-4">
                        <!-- 決済方法が表示されます -->
                    </div>
                </div>

                <!-- エラーメッセージ -->
                <div id="errorMessage" class="hidden bg-red-50 border-l-4 border-red-500 p-4 mb-6">
                    <div class="flex">
                        <i class="fas fa-exclamation-circle text-red-500 mr-2"></i>
                        <p id="errorText" class="text-sm text-red-700"></p>
                    </div>
                </div>

                <!-- ボタン -->
                <div class="flex gap-4">
                    <button type="button" onclick="history.back()"
                            class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-3 rounded-lg font-semibold transition">
                        <i class="fas fa-arrow-left mr-2"></i>戻る
                    </button>
                    <button type="button" id="confirmBtn"
                            class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                        <i class="fas fa-credit-card mr-2"></i>決済へ進む
                    </button>
                </div>
            </div>
        </div>

        <script>
            const eventId = '${eventId}';
            const prefs = ${JSON.stringify(prefs)};
            const customFieldsData = ${JSON.stringify(customFields)};
            const eventData = ${JSON.stringify(paymentSettings)};
            
            // セッションストレージからデータを取得
            const bookingData = JSON.parse(sessionStorage.getItem('bookingData') || '{}');
            const customerInfo = JSON.parse(sessionStorage.getItem('customerInfo') || '{}');
            
            // 選択された決済方法
            let selectedPaymentMethod = null;
            
            console.log('Booking Data:', bookingData);
            console.log('Customer Info:', customerInfo);
            console.log('Event Data:', eventData);
            
            // 予約内容を表示
            function displayBookingDetails() {
                const container = document.getElementById('bookingDetailsContainer');
                
                if (!bookingData.event_id) {
                    container.innerHTML = '<p class="text-red-500">予約情報が見つかりません</p>';
                    return;
                }
                
                let html = '';
                
                // 日付
                if (bookingData.selected_date) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">開催日</span>
                            <span class="text-gray-900">\${bookingData.selected_date}</span>
                        </div>
                    \`;
                }
                
                // 商品・チケット
                if (bookingData.items && bookingData.items.length > 0) {
                    html += '<div class="py-3 border-b"><span class="font-semibold text-gray-700 block mb-2">チケット</span>';
                    bookingData.items.forEach(item => {
                        html += \`
                            <div class="flex justify-between items-center py-2 pl-4">
                                <div>
                                    <div class="text-gray-900 font-medium">\${item.product_name || 'チケット'}</div>
                                    \${item.stock_name ? \`<div class="text-sm text-gray-600 mt-1">\${item.stock_name}</div>\` : ''}
                                </div>
                                <div class="text-right">
                                    <span class="text-gray-700">\${item.quantity}枚 × ¥\${(item.price || 0).toLocaleString()}</span>
                                    <span class="font-semibold text-gray-900 ml-4">¥\${((item.quantity || 0) * (item.price || 0)).toLocaleString()}</span>
                                </div>
                            </div>
                        \`;
                    });
                    html += '</div>';
                }
                
                // オプション
                if (bookingData.options && bookingData.options.length > 0) {
                    html += '<div class="py-3 border-b"><span class="font-semibold text-gray-700 block mb-2">オプション</span>';
                    bookingData.options.forEach(option => {
                        html += \`
                            <div class="flex justify-between items-center py-2 pl-4">
                                <div>
                                    <div class="text-gray-900 font-medium">\${option.option_name}</div>
                                    \${option.stock_name ? \`<div class="text-sm text-gray-600 mt-1">\${option.stock_name}</div>\` : ''}
                                </div>
                                <div class="text-right">
                                    <span class="text-gray-700">\${option.quantity}個 × ¥\${(option.price || 0).toLocaleString()}</span>
                                    <span class="font-semibold text-gray-900 ml-4">¥\${((option.quantity || 0) * (option.price || 0)).toLocaleString()}</span>
                                </div>
                            </div>
                        \`;
                    });
                    html += '</div>';
                }
                
                // 合計金額
                html += \`
                    <div class="flex justify-between py-4 text-xl">
                        <span class="font-bold text-gray-800">合計金額</span>
                        <span class="font-bold text-blue-600">¥\${(bookingData.total_amount || 0).toLocaleString()}</span>
                    </div>
                \`;
                
                container.innerHTML = html;
            }
            
            // 参加者情報を表示
            function displayCustomerInfo() {
                const container = document.getElementById('customerInfoContainer');
                
                if (!customerInfo || Object.keys(customerInfo).length === 0) {
                    container.innerHTML = '<p class="text-red-500">参加者情報が見つかりません</p>';
                    return;
                }
                
                let html = '';
                
                // 代理予約
                if (customerInfo.is_proxy) {
                    html += \`
                        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
                            <p class="text-sm text-yellow-800"><i class="fas fa-info-circle mr-2"></i>代理予約</p>
                        </div>
                    \`;
                }
                
                // 氏名（漢字）
                if (customerInfo.participant_family_name || customerInfo.participant_first_name) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">氏名</span>
                            <span class="text-gray-900">\${customerInfo.participant_family_name || ''} \${customerInfo.participant_first_name || ''}</span>
                        </div>
                    \`;
                }
                
                // 氏名（カナ）
                if (customerInfo.participant_family_kana || customerInfo.participant_first_kana) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">氏名（カナ）</span>
                            <span class="text-gray-900">\${customerInfo.participant_family_kana || ''} \${customerInfo.participant_first_kana || ''}</span>
                        </div>
                    \`;
                }
                
                // 氏名（ローマ字）
                if (customerInfo.participant_last_name_en || customerInfo.participant_first_name_en) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">氏名（ローマ字）</span>
                            <span class="text-gray-900">\${customerInfo.participant_last_name_en || ''} \${customerInfo.participant_first_name_en || ''}</span>
                        </div>
                    \`;
                }
                
                // 生年月日
                if (customerInfo.birth_date) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">生年月日</span>
                            <span class="text-gray-900">\${customerInfo.birth_date}</span>
                        </div>
                    \`;
                }
                
                // 年齢
                if (customerInfo.age) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">年齢</span>
                            <span class="text-gray-900">\${customerInfo.age}歳</span>
                        </div>
                    \`;
                }
                
                // 電話番号
                if (customerInfo.tel) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">電話番号</span>
                            <span class="text-gray-900">\${customerInfo.tel}</span>
                        </div>
                    \`;
                }
                
                // 緊急連絡先
                if (customerInfo.emergency_tel) {
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">緊急連絡先</span>
                            <span class="text-gray-900">\${customerInfo.emergency_tel}</span>
                        </div>
                    \`;
                }
                
                // 住所
                if (customerInfo.zip || customerInfo.pref_id || customerInfo.addr) {
                    const pref = prefs.find(p => p.id == customerInfo.pref_id);
                    const prefName = pref ? pref.name : '';
                    html += \`
                        <div class="flex justify-between py-3 border-b">
                            <span class="font-semibold text-gray-700">住所</span>
                            <span class="text-gray-900">
                                〒\${customerInfo.zip || ''}<br>
                                \${prefName} \${customerInfo.addr || ''}
                            </span>
                        </div>
                    \`;
                }
                
                container.innerHTML = html;
            }
            
            // カスタムフィールド情報を表示
            function displayCustomFields() {
                const customFields = customerInfo.customFields || {};
                
                // カスタムフィールドが存在しない場合は非表示
                if (Object.keys(customFields).length === 0 || customFieldsData.length === 0) {
                    return;
                }
                
                document.getElementById('customFieldsInfoSection').style.display = 'block';
                const container = document.getElementById('customFieldsInfoContainer');
                
                let html = '';
                
                customFieldsData.forEach(field => {
                    const value = customFields[field.field_name];
                    
                    // 値が存在しない場合はスキップ
                    if (!value || (Array.isArray(value) && value.length === 0)) {
                        return;
                    }
                    
                    // 表示用の値を整形
                    let displayValue = '';
                    if (Array.isArray(value)) {
                        displayValue = value.join(', ');
                    } else {
                        displayValue = value;
                    }
                    
                    // インデント表示（階層構造）
                    const indent = field.indent_level > 0 ? \`style="padding-left: \${field.indent_level * 20}px;"\` : '';
                    
                    html += \`
                        <div class="flex justify-between py-3 border-b" \${indent}>
                            <span class="font-semibold text-gray-700">\${field.field_label}</span>
                            <span class="text-gray-900">\${displayValue}</span>
                        </div>
                    \`;
                });
                
                container.innerHTML = html;
            }
            
            // ページ読み込み時に情報を表示
            displayBookingDetails();
            displayCustomerInfo();
            displayCustomFields();
            displayPaymentMethods();
            
            // 決済方法を表示
            function displayPaymentMethods() {
                const container = document.getElementById('paymentMethodsContainer');
                let html = '';
                
                // クレジットカード
                if (eventData.payment_credit_card) {
                    html += \`
                        <div class="border rounded-lg p-4 hover:border-blue-500 transition cursor-pointer" onclick="selectPaymentMethod('credit_card')">
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" name="payment_method" value="credit_card" class="w-4 h-4 text-blue-600">
                                <div class="ml-3 flex-1">
                                    <div class="flex items-center">
                                        <i class="fas fa-credit-card text-blue-600 mr-2"></i>
                                        <span class="font-semibold text-gray-800">クレジットカード</span>
                                    </div>
                                    <p class="text-sm text-gray-600 mt-1">Visa, Mastercard, JCB, American Express</p>
                                </div>
                            </label>
                        </div>
                    \`;
                }
                
                // 銀行振込
                if (eventData.payment_bank_transfer) {
                    html += \`
                        <div class="border rounded-lg p-4 hover:border-blue-500 transition cursor-pointer" onclick="selectPaymentMethod('bank_transfer')">
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" name="payment_method" value="bank_transfer" class="w-4 h-4 text-blue-600">
                                <div class="ml-3 flex-1">
                                    <div class="flex items-center">
                                        <i class="fas fa-university text-green-600 mr-2"></i>
                                        <span class="font-semibold text-gray-800">銀行振込</span>
                                    </div>
                                    <p class="text-sm text-gray-600 mt-1">振込先情報は選択後に表示されます</p>
                                </div>
                            </label>
                            <div id="bank_transfer_details" class="hidden mt-4 pt-4 border-t bg-gray-50 rounded p-4">
                                <h4 class="font-semibold text-gray-800 mb-3"><i class="fas fa-info-circle mr-2 text-blue-600"></i>振込先情報</h4>
                                <div class="space-y-2 text-sm">
                                    <div class="flex">
                                        <span class="w-24 text-gray-600">銀行名：</span>
                                        <span class="font-semibold">\${eventData.bank_name || '-'}</span>
                                    </div>
                                    <div class="flex">
                                        <span class="w-24 text-gray-600">支店名：</span>
                                        <span class="font-semibold">\${eventData.bank_branch || '-'}</span>
                                    </div>
                                    <div class="flex">
                                        <span class="w-24 text-gray-600">口座種別：</span>
                                        <span class="font-semibold">\${eventData.bank_account_type || '-'}</span>
                                    </div>
                                    <div class="flex">
                                        <span class="w-24 text-gray-600">口座番号：</span>
                                        <span class="font-semibold">\${eventData.bank_account_number || '-'}</span>
                                    </div>
                                    <div class="flex">
                                        <span class="w-24 text-gray-600">口座名義：</span>
                                        <span class="font-semibold">\${eventData.bank_account_holder || '-'}</span>
                                    </div>
                                </div>
                                <div class="mt-4 bg-yellow-50 border border-yellow-300 rounded p-3">
                                    <p class="text-sm text-yellow-800">
                                        <i class="fas fa-clock mr-2"></i>
                                        <span class="font-semibold">振込期限：</span>
                                        \${eventData.bank_transfer_deadline || '予約後3日以内'}
                                    </p>
                                </div>
                            </div>
                        </div>
                    \`;
                }
                
                // コンビニ払い
                if (eventData.payment_convenience_store) {
                    html += \`
                        <div class="border rounded-lg p-4 hover:border-blue-500 transition cursor-pointer" onclick="selectPaymentMethod('convenience_store')">
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" name="payment_method" value="convenience_store" class="w-4 h-4 text-blue-600">
                                <div class="ml-3 flex-1">
                                    <div class="flex items-center">
                                        <i class="fas fa-store text-orange-600 mr-2"></i>
                                        <span class="font-semibold text-gray-800">コンビニ払い</span>
                                    </div>
                                    <p class="text-sm text-gray-600 mt-1">セブンイレブン、ファミリーマート、ローソンなど</p>
                                </div>
                            </label>
                            <div id="convenience_store_details" class="hidden mt-4 pt-4 border-t bg-gray-50 rounded p-4">
                                <div class="bg-blue-50 border border-blue-300 rounded p-3 mb-3">
                                    <p class="text-sm text-blue-800">
                                        <i class="fas fa-info-circle mr-2"></i>
                                        お支払い手続き後、コンビニでお支払いいただける番号が発行されます
                                    </p>
                                </div>
                                <div class="bg-yellow-50 border border-yellow-300 rounded p-3">
                                    <p class="text-sm text-yellow-800">
                                        <i class="fas fa-clock mr-2"></i>
                                        <span class="font-semibold">入金期限：</span>
                                        \${eventData.convenience_payment_deadline || '予約後5日以内'}
                                    </p>
                                </div>
                            </div>
                        </div>
                    \`;
                }
                
                if (!html) {
                    html = '<p class="text-gray-500">利用可能な決済方法がありません</p>';
                }
                
                container.innerHTML = html;
            }
            
            // 決済方法を選択
            function selectPaymentMethod(method) {
                selectedPaymentMethod = method;
                
                // 全ての詳細を非表示
                document.getElementById('bank_transfer_details')?.classList.add('hidden');
                document.getElementById('convenience_store_details')?.classList.add('hidden');
                
                // 選択された決済方法の詳細を表示
                if (method === 'bank_transfer') {
                    document.getElementById('bank_transfer_details')?.classList.remove('hidden');
                } else if (method === 'convenience_store') {
                    document.getElementById('convenience_store_details')?.classList.remove('hidden');
                }
            }
            
            // 決済へ進むボタン
            document.getElementById('confirmBtn').addEventListener('click', async () => {
                const confirmBtn = document.getElementById('confirmBtn');
                const errorMessage = document.getElementById('errorMessage');
                const errorText = document.getElementById('errorText');
                
                // エラーメッセージを非表示
                errorMessage.classList.add('hidden');
                
                // 決済方法が選択されているか確認
                if (!selectedPaymentMethod) {
                    errorText.textContent = 'お支払い方法を選択してください';
                    errorMessage.classList.remove('hidden');
                    return;
                }
                
                // ボタンを無効化
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>処理中...';
                
                try {
                    // 決済方法に応じて遷移先を変更
                    if (selectedPaymentMethod === 'credit_card') {
                        window.location.href = '/booking/payment/credit-card?event_id=' + eventId;
                    } else if (selectedPaymentMethod === 'bank_transfer') {
                        // TODO: 予約完了画面へ遷移（未実装）
                        window.location.href = '/booking/complete?event_id=' + eventId;
                    } else if (selectedPaymentMethod === 'convenience_store') {
                        window.location.href = '/booking/payment/convenience-store?event_id=' + eventId;
                    }
                } catch (error) {
                    // エラー表示
                    errorText.textContent = error.message || '処理に失敗しました';
                    errorMessage.classList.remove('hidden');
                    
                    // ボタンを有効化
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '<i class="fas fa-credit-card mr-2"></i>決済へ進む';
                }
            });
        </script>
    </body>
    </html>
  `)
})

// クレジットカード決済ダミーページ
app.get('/booking/payment/credit-card', async (c) => {
  const eventId = c.req.query('event_id')
  
  return c.html(`
    <!DOCTYPE html>
    <html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>クレジットカード決済 | イベント予約</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css" rel="stylesheet">
    </head>
    <body class="bg-gradient-to-br from-blue-50 to-purple-50 min-h-screen">
        <div class="container mx-auto px-4 py-8">
            <div class="max-w-2xl mx-auto">
                <!-- ヘッダー -->
                <div class="text-center mb-8">
                    <div class="inline-block bg-white rounded-full p-4 shadow-lg mb-4">
                        <i class="fas fa-credit-card text-5xl text-blue-600"></i>
                    </div>
                    <h1 class="text-3xl font-bold text-gray-800 mb-2">クレジットカード決済</h1>
                    <p class="text-gray-600">カード情報を入力してください</p>
                </div>

                <!-- クレジットカードフォーム -->
                <div class="bg-white rounded-2xl shadow-xl p-8 mb-6">
                    <form id="creditCardForm" class="space-y-6">
                        <!-- カード番号 -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                カード番号 <span class="text-red-600">*</span>
                            </label>
                            <div class="relative">
                                <input type="text" 
                                       id="cardNumber" 
                                       placeholder="1234 5678 9012 3456" 
                                       maxlength="19"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                                <div class="absolute right-3 top-3 flex gap-2">
                                    <i class="fab fa-cc-visa text-2xl text-blue-600"></i>
                                    <i class="fab fa-cc-mastercard text-2xl text-red-600"></i>
                                    <i class="fab fa-cc-jcb text-2xl text-green-600"></i>
                                </div>
                            </div>
                        </div>

                        <!-- カード名義 -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                カード名義（ローマ字） <span class="text-red-600">*</span>
                            </label>
                            <input type="text" 
                                   id="cardName" 
                                   placeholder="TARO YAMADA" 
                                   class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                        </div>

                        <!-- 有効期限とCVV -->
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    有効期限 <span class="text-red-600">*</span>
                                </label>
                                <input type="text" 
                                       id="cardExpiry" 
                                       placeholder="MM/YY" 
                                       maxlength="5"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">
                                    セキュリティコード <span class="text-red-600">*</span>
                                </label>
                                <input type="text" 
                                       id="cardCvv" 
                                       placeholder="123" 
                                       maxlength="4"
                                       class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            </div>
                        </div>

                        <!-- 注意事項 -->
                        <div class="bg-blue-50 border border-blue-300 rounded-lg p-4">
                            <p class="text-sm text-blue-800">
                                <i class="fas fa-info-circle mr-2"></i>
                                これはダミーの決済画面です。実際の決済は行われません。
                            </p>
                        </div>

                        <!-- ボタン -->
                        <div class="flex gap-4">
                            <button type="button" onclick="history.back()"
                                    class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-3 rounded-lg font-semibold transition">
                                <i class="fas fa-arrow-left mr-2"></i>戻る
                            </button>
                            <button type="submit"
                                    class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                                <i class="fas fa-lock mr-2"></i>決済する
                            </button>
                        </div>
                    </form>
                </div>

                <!-- セキュリティ表示 -->
                <div class="text-center text-sm text-gray-600">
                    <i class="fas fa-lock mr-2"></i>
                    SSL暗号化通信により保護されています
                </div>
            </div>
        </div>

        <script>
            // カード番号のフォーマット
            document.getElementById('cardNumber').addEventListener('input', (e) => {
                let value = e.target.value.replace(/\s/g, '');
                let formattedValue = value.match(/.{1,4}/g)?.join(' ') || value;
                e.target.value = formattedValue;
            });

            // 有効期限のフォーマット
            document.getElementById('cardExpiry').addEventListener('input', (e) => {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length >= 2) {
                    value = value.slice(0, 2) + '/' + value.slice(2, 4);
                }
                e.target.value = value;
            });

            // CVVは数字のみ
            document.getElementById('cardCvv').addEventListener('input', (e) => {
                e.target.value = e.target.value.replace(/\D/g, '');
            });

            // フォーム送信
            document.getElementById('creditCardForm').addEventListener('submit', (e) => {
                e.preventDefault();
                
                const cardNumber = document.getElementById('cardNumber').value;
                const cardName = document.getElementById('cardName').value;
                const cardExpiry = document.getElementById('cardExpiry').value;
                const cardCvv = document.getElementById('cardCvv').value;
                
                // 簡易バリデーション
                if (!cardNumber || !cardName || !cardExpiry || !cardCvv) {
                    alert('すべての項目を入力してください');
                    return;
                }
                
                // ダミー処理
                alert('決済処理が完了しました（ダミー）\\n\\n※実際の決済は行われていません');
                
                // TODO: 予約完了画面へ遷移
                window.location.href = '/booking/complete?event_id=${eventId}';
            });
        </script>
    </body>
    </html>
  `)
})

