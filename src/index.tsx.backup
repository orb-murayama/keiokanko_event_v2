const app = new Hono<AuthContext>()

// ベーシック認証ミドルウェア（環境変数から認証情報を取得）
// 一般公開前：全ページにBasic認証を適用
app.use('*', async (c, next) => {
  const path = new URL(c.req.url).pathname
  
  // デバッグログ
  console.log('🔐 [Auth] Check path:', path)
  
  // Basic認証から完全除外するパス（認証なしでアクセス可能）
  const authExcludedPaths = [
    // 認証API
    '/api/admin/auth/send-otp',
    '/api/admin/auth/verify-otp',
    '/api/admin/auth/session',
    '/api/admin/auth/logout',
    '/api/auth/send-otp',
    '/api/auth/verify-otp',
    '/api/auth/session',
    '/api/auth/logout',
    
    // GMOコールバック（認証除外必須 - GMOからのリダイレクト）
    '/payment-callback',
    '/payment-callback.html',
    
    // 予約完了画面（ユーザーがアクセスする）
    '/booking-complete',
    '/booking-complete.html',
    
    // マイページ（OTP認証）
    '/mypage',
    '/mypage/bookings',
    '/mypage/booking/:id',
    '/api/mypage/check-session',
    '/auth-email',
    '/auth-email.html'
  ]
  
  // セッション認証（Cookieベース）を使用するパス
  // Basic認証済みならCookieを発行し、以降はCookieで認証
  const sessionAuthPaths = [
    '/index.html',
    '/product-detail',
    '/product-detail.html',
    '/participant-info',
    '/participant-info.html',
    '/payment-method',
    '/payment-method.html',
    '/gmo-payment-credit',
    '/gmo-payment-credit.html',
    '/gmo-payment-convenience',
    '/gmo-payment-convenience.html'
  ]
  
  // APIエンドポイントと除外パスはBasic認証をスキップ
  if (authExcludedPaths.includes(path) || path.startsWith('/api/') || path.startsWith('/mypage/booking/')) {
    console.log('✅ [Auth] Skipped (API or excluded path)')
    await next()
    return
  }
  
  // ルートパス
  if (path === '/') {
    console.log('✅ [Auth] Skipped (root path)')
    await next()
    return
  }
  
  // 静的ファイル（CSS, JS, 画像）もBasic認証をスキップ
  if (path.startsWith('/static/') || path.startsWith('/images/') || path.startsWith('/css/') || path.startsWith('/js/')) {
    console.log('✅ [Auth] Skipped (static files)')
    await next()
    return
  }
  
  // セッション認証パスの場合、Cookieをチェック
  if (sessionAuthPaths.includes(path)) {
    const sessionCookie = c.req.header('cookie')?.split(';').find(c => c.trim().startsWith('basic_auth_session='))
    
    if (sessionCookie) {
      // セッションCookieがあればBasic認証をスキップ
      console.log('✅ [Auth] Skipped (valid session cookie)')
      await next()
      return
    }
    console.log('⚠️ [Auth] Session path but no cookie, applying Basic Auth')
  }
  
  // 環境変数から認証情報を取得
  // Cloudflare Pages の Secret も vars も両方対応
  const BASIC_AUTH_USER = c.env?.BASIC_AUTH_USER || c.env?.BASIC_AUTH_USER_SECRET
  const BASIC_AUTH_PASS = c.env?.BASIC_AUTH_PASS || c.env?.BASIC_AUTH_PASS_SECRET
  
  // デバッグログ（認証情報の存在を確認）
  console.log('Basic Auth Check:', {
    hasUser: !!BASIC_AUTH_USER,
    hasPass: !!BASIC_AUTH_PASS,
    userLength: BASIC_AUTH_USER?.length || 0,
    envKeys: Object.keys(c.env || {}).filter(k => k.includes('BASIC') || k.includes('AUTH'))
  })
  
  // 認証情報が設定されていない場合はスキップ
  if (!BASIC_AUTH_USER || !BASIC_AUTH_PASS) {
    console.log('Basic Auth: Skipped (no credentials set)')
    await next()
    return
  }
  
  console.log('Basic Auth: Enabled')
  
  // ベーシック認証を適用
  const auth = basicAuth({
    username: BASIC_AUTH_USER,
    password: BASIC_AUTH_PASS,
    realm: 'Event Booking System'
  })
  
  // 認証ミドルウェアを実行
  await auth(c, async () => {
    // 認証成功後、セッション認証パスの場合はCookieを発行
    if (sessionAuthPaths.includes(path)) {
      // 24時間有効なセッションCookie
      c.header('Set-Cookie', `basic_auth_session=authenticated; Path=/; Max-Age=86400; HttpOnly; SameSite=Lax`)
    }
    await next()
  })
})

