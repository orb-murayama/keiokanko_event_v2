// API - 販売会社一覧取得
// API: 販売会社一覧取得（ページネーション対応）
app.get('/api/vendors', requireAuth, async (c) => {
  const { DB } = c.env
  
  // クエリパラメータ取得
  const page = c.req.query('page')
  const perPage = c.req.query('per_page')
  const name = c.req.query('name')
  const email = c.req.query('email')
  
  // パラメータがない場合は全件取得（イベントフォーム等で使用）
  if (!page && !perPage && !name && !email) {
    const { results } = await DB.prepare('SELECT * FROM vendors ORDER BY created_at DESC').all()
    return c.json(results)
  }
  
  // ページネーション処理
  const pageNum = parseInt(page || '1', 10)
  const perPageNum = parseInt(perPage || '20', 10)
  const offset = (pageNum - 1) * perPageNum
  
  // WHERE句構築
  const conditions = []
  const params = []
  
  if (name) {
    conditions.push('name LIKE ?')
    params.push('%' + name + '%')
  }
  
  if (email) {
    conditions.push('email LIKE ?')
    params.push('%' + email + '%')
  }
  
  const whereClause = conditions.length > 0 ? 'WHERE ' + conditions.join(' AND ') : ''
  
  // 総数取得
  const countQuery = `SELECT COUNT(*) as total FROM vendors ${whereClause}`
  const countResult = await DB.prepare(countQuery).bind(...params).first()
  const total = countResult?.total || 0
  
  // データ取得
  const dataQuery = `
    SELECT * FROM vendors 
    ${whereClause}
    ORDER BY created_at DESC
    LIMIT ? OFFSET ?
  `
  const { results } = await DB.prepare(dataQuery).bind(...params, perPageNum, offset).all()
  
  // ページネーション情報
  const totalPages = Math.ceil(total / perPageNum)
  
  return c.json({
    data: results,
    pagination: {
      current_page: pageNum,
      per_page: perPageNum,
      total: total,
      total_pages: totalPages,
      from: offset + 1,
      to: Math.min(offset + perPageNum, total)
    }
  })
})

