// API: 環境変数チェック（デバッグ用）
app.get('/api/debug/env-check', async (c) => {
  const BASIC_AUTH_USER = c.env?.BASIC_AUTH_USER || c.env?.BASIC_AUTH_USER_SECRET
  const BASIC_AUTH_PASS = c.env?.BASIC_AUTH_PASS || c.env?.BASIC_AUTH_PASS_SECRET
  
  // 全ての環境変数キーを確認
  const allEnvKeys = Object.keys(c.env || {})
  const authRelatedKeys = allEnvKeys.filter(k => 
    k.includes('BASIC') || k.includes('AUTH') || k.includes('USER') || k.includes('PASS')
  )
  
  return c.json({
    basicAuthConfigured: !!(BASIC_AUTH_USER && BASIC_AUTH_PASS),
    hasUser: !!BASIC_AUTH_USER,
    hasPass: !!BASIC_AUTH_PASS,
    userLength: BASIC_AUTH_USER?.length || 0,
    passLength: BASIC_AUTH_PASS?.length || 0,
    authRelatedKeys: authRelatedKeys,
    allEnvKeysCount: allEnvKeys.length,
    message: (BASIC_AUTH_USER && BASIC_AUTH_PASS) 
      ? 'Basic auth is configured and should be active' 
      : 'Basic auth is NOT configured - add BASIC_AUTH_USER and BASIC_AUTH_PASS environment variables'
  })
})

