// API v2: メッセージ作成
app.post('/api/v2/bookings/:booking_number/messages', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    const body = await c.req.json()
    const { title, message, scheduled_send_at, display_on_mypage, created_by } = body
    
    console.log('========== メッセージ作成 ==========')
    console.log('予約番号:', bookingNumber)
    console.log('リクエストデータ:', JSON.stringify(body, null, 2))
    
    // バリデーション
    if (!title || !title.trim()) {
      return c.json({ error: 'タイトルが必要です' }, 400)
    }
    
    if (!message || !message.trim()) {
      return c.json({ error: 'メッセージが必要です' }, 400)
    }
    
    if (!scheduled_send_at) {
      return c.json({ error: '送信日時が必要です' }, 400)
    }
    
    // 予約情報を取得
    const booking = await DB.prepare(`
      SELECT id, booker_email FROM bookings WHERE booking_number = ?
    `).bind(bookingNumber).first()
    
    if (!booking) {
      console.log('エラー: 予約が見つかりません')
      return c.json({ error: '予約が見つかりません' }, 404)
    }
    
    // メッセージを作成
    const result = await DB.prepare(`
      INSERT INTO booking_messages (
        booking_id,
        booking_number,
        recipient_email,
        title,
        message,
        scheduled_send_at,
        send_status,
        display_on_mypage,
        created_by,
        created_at,
        modified_at
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      booking.id,
      bookingNumber,
      booking.booker_email,
      title.trim(),
      message.trim(),
      scheduled_send_at,
      'pending',
      display_on_mypage !== undefined ? display_on_mypage : 1,
      created_by || null
    ).run()
    
    const newMessageId = result.meta.last_row_id
    
    console.log('メッセージ作成成功 (id:', newMessageId, ')')
    
    return c.json({
      success: true,
      id: newMessageId,
      message: 'メッセージを登録しました'
    })
    
  } catch (error) {
    console.error('メッセージ作成エラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ error: 'メッセージの作成に失敗しました' }, 500)
  }
})

// API v2: メッセージ更新
app.put('/api/v2/booking-messages/:id', async (c) => {
  const { DB } = c.env
  const messageId = c.req.param('id')
  
  try {
    const body = await c.req.json()
    const { title, message, scheduled_send_at, display_on_mypage } = body
    
    console.log('========== メッセージ更新 ==========')
    console.log('メッセージID:', messageId)
    console.log('リクエストデータ:', JSON.stringify(body, null, 2))
    
    // バリデーション
    if (!title || !title.trim()) {
      return c.json({ error: 'タイトルが必要です' }, 400)
    }
    
    if (!message || !message.trim()) {
      return c.json({ error: 'メッセージが必要です' }, 400)
    }
    
    if (!scheduled_send_at) {
      return c.json({ error: '送信日時が必要です' }, 400)
    }
    
    // メッセージを更新
    const result = await DB.prepare(`
      UPDATE booking_messages
      SET 
        title = ?,
        message = ?,
        scheduled_send_at = ?,
        display_on_mypage = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      title.trim(),
      message.trim(),
      scheduled_send_at,
      display_on_mypage !== undefined ? display_on_mypage : 1,
      messageId
    ).run()
    
    if (result.meta.changes === 0) {
      console.log('エラー: メッセージが見つかりません')
      return c.json({ error: 'メッセージが見つかりません' }, 404)
    }
    
    console.log('メッセージ更新成功')
    
    return c.json({
      success: true,
      message: 'メッセージを更新しました'
    })
    
  } catch (error) {
    console.error('メッセージ更新エラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ error: 'メッセージの更新に失敗しました' }, 500)
  }
})

// API v2: 予約のメール送信履歴取得
app.get('/api/v2/bookings/:booking_number/emails', async (c) => {
  const { DB } = c.env
  const bookingNumber = c.req.param('booking_number')
  
  try {
    // メール送信履歴を取得
    const emails = await DB.prepare(`
      SELECT 
        id,
        from_email,
        to_email,
        subject,
        body,
        scheduled_send_at,
        send_status,
        sent_at,
        created_at
      FROM booking_emails
      WHERE booking_number = ?
      ORDER BY created_at DESC
    `).bind(bookingNumber).all()
    
    return c.json({
      success: true,
      emails: emails.results || []
    })
    
  } catch (error) {
    console.error('メール送信履歴取得エラー:', error)
    return c.json({ error: 'メール送信履歴の取得に失敗しました' }, 500)
  }
})

