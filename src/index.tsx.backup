    }
    if (!family_name || !family_name.trim()) {
      return c.json({ error: '姓は必須です' }, 400)
    }
    if (!first_name || !first_name.trim()) {
      return c.json({ error: '名は必須です' }, 400)
    }
    
    // メールアドレスの重複チェック（自分以外）
    const existingMember = await DB.prepare(`
      SELECT id FROM members WHERE email = ? AND id != ?
    `).bind(email.trim(), id).first()
    
    if (existingMember) {
      return c.json({ error: 'このメールアドレスは既に登録されています' }, 400)
    }
    
    // 会員を更新
    const result = await DB.prepare(`
      UPDATE members
      SET 
        email = ?,
        family_name = ?,
        first_name = ?,
        family_kana = ?,
        first_kana = ?,
        last_name_en = ?,
        first_name_en = ?,
        sex = ?,
        birth = ?,
        tel = ?,
        mobile = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        enable_flg = ?,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      email.trim(),
      family_name.trim(),
      first_name.trim(),
      family_kana?.trim() || null,
      first_kana?.trim() || null,
      last_name_en?.trim() || null,
      first_name_en?.trim() || null,
      sex || null,
      birth || null,
      tel?.trim() || null,
      mobile?.trim() || null,
      zip?.trim() || null,
      pref_id || null,
      addr?.trim() || null,
      enable_flg !== undefined ? enable_flg : 1,
      id
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    console.log('会員更新成功')
    
    return c.json({
      success: true,
      message: '会員情報を更新しました'
    })
    
  } catch (error) {
    console.error('会員更新エラー:', error)
    return c.json({ error: '会員情報の更新に失敗しました' }, 500)
  }
})

// API: 会員削除（論理削除）（system_admin と admin のみ）
app.delete('/api/members/:id', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    console.log('========== 会員削除 ==========')
    console.log('会員ID:', id)
    
    // 会員の有効フラグを0に設定（論理削除）
    const result = await DB.prepare(`
      UPDATE members
      SET 
        enable_flg = 0,
        modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(id).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    console.log('会員削除成功')
    
    return c.json({
      success: true,
      message: '会員を削除しました'
    })
    
  } catch (error) {
    console.error('会員削除エラー:', error)
    return c.json({ error: '会員の削除に失敗しました' }, 500)
  }
})

// API: 会員CSVテンプレートダウンロード（system_admin と admin のみ）
app.get('/api/v2/members/csv-template', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  
  try {
    console.log('========== 会員CSVテンプレートダウンロード ==========')
    
    // 都道府県一覧を取得
    const prefs = await DB.prepare(`
      SELECT id, name FROM prefs ORDER BY id
    `).all()
    
    console.log('都道府県数:', prefs.results.length)
    
    // CSVヘッダーを生成（日本語）
    const headers = [
      '姓',
      '名',
      '姓カナ',
      '名カナ',
      '姓（英語）',
      '名（英語）',
      'メールアドレス',
      '電話番号',
      '携帯電話',
      '性別',
      '生年月日',
      '郵便番号',
      '都道府県',
      '住所',
      '有効フラグ'
    ]
    
    console.log('CSVヘッダー:', headers)
    
    // CSVデータを生成（UTF-8 BOM付き、CRLF、ダブルクォートエスケープ）
    const BOM = '\uFEFF'
    let csvContent = BOM + headers.map(h => `"${h}"`).join(',') + '\r\n'
    
    // サンプル行を追加（参考用）
    const sampleRow = [
      '山田',
      '太郎',
      'ヤマダ',
      'タロウ',
      'Yamada',
      'Taro',
      'yamada.taro@example.com',
      '03-1234-5678',
      '090-1234-5678',
      '男性',
      '1985-04-15',
      '160-0023',
      '東京都',
      '新宿区西新宿1-1-1',
      '1'
    ]
    
    const escapedRow = sampleRow.map(cell => {
      const str = String(cell)
      const escaped = str.replace(/"/g, '""')
      return `"${escaped}"`
    })
    
    csvContent += escapedRow.join(',') + '\r\n'
    
    // ファイル名を生成
    const filename = '会員一括登録テンプレート.csv'
    
    console.log('生成ファイル名:', filename)
    
    return new Response(csvContent, {
      headers: {
        'Content-Type': 'text/csv; charset=utf-8',
        'Content-Disposition': `attachment; filename="${encodeURIComponent(filename)}"`
      }
    })
    
  } catch (error) {
    console.error('会員CSVテンプレート生成エラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ error: '会員CSVテンプレートの生成に失敗しました' }, 500)
  }
})

// API: 会員CSVアップロード（system_admin と admin のみ）
app.post('/api/v2/members/csv-upload', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  
  try {
    console.log('========== 会員CSVアップロード ==========')
    
    // FormDataからCSVファイルを取得
    const formData = await c.req.formData()
    const file = formData.get('csv_file')
    
    if (!file || !(file instanceof File)) {
      return c.json({ success: false, error: 'CSVファイルが必要です' }, 400)
    }
    
    console.log('ファイル名:', file.name)
    console.log('ファイルサイズ:', file.size)
    
    // 都道府県マスタを取得
    const prefs = await DB.prepare(`
      SELECT id, name FROM prefs ORDER BY id
    `).all()
    
    const prefMap = {}
    prefs.results.forEach(pref => {
      prefMap[pref.name] = pref.id
    })
    
    console.log('都道府県マップ:', Object.keys(prefMap).length, '件')
    
    // CSVファイルを読み込み（UTF-8 BOM除去）
    let csvText = await file.text()
    
    // BOM除去
    if (csvText.charCodeAt(0) === 0xFEFF) {
      csvText = csvText.substring(1)
    }
    
    // 行分割（CRLF、LF両対応）
    const lines = csvText.split(/\r?\n/).filter(line => line.trim())
    
    if (lines.length === 0) {
      return c.json({ success: false, error: 'CSVファイルが空です' }, 400)
    }
    
    console.log('CSV行数（ヘッダー含む）:', lines.length)
    
    // ヘッダー行をパース
    const headerLine = lines[0]
    const headers = headerLine.split(',').map(h => {
      let header = h.trim()
      if (header.startsWith('"') && header.endsWith('"')) {
        header = header.substring(1, header.length - 1)
      }
      header = header.replace(/""/g, '"')
      return header
    })
    
    console.log('CSVヘッダー:', headers)
    
    // 必須ヘッダーの検証
    const requiredHeaders = ['メールアドレス']
    const missingHeaders = requiredHeaders.filter(h => !headers.includes(h))
    
    if (missingHeaders.length > 0) {
      return c.json({ 
        success: false, 
        error: `必須列が不足しています: ${missingHeaders.join(', ')}` 
      }, 400)
    }
    
    // 固定の初期パスワードをハッシュ化
    const defaultPassword = 'Member2024!'
    const passwordHash = await bcrypt.hash(defaultPassword, 10)
    
    console.log('初期パスワードハッシュ生成完了')
    
    // 各データ行をパース
    const registeredMembers = []
    const skippedRows = []
    
    for (let i = 1; i < lines.length; i++) {
      const line = lines[i].trim()
      if (!line) continue
      
      const lineNumber = i + 1
      
      try {
        // CSV行をパース（ダブルクォート対応）
        const values = []
        let currentValue = ''
        let insideQuotes = false
        
        for (let j = 0; j < line.length; j++) {
          const char = line[j]
          const nextChar = line[j + 1]
          
          if (char === '"' && insideQuotes && nextChar === '"') {
            currentValue += '"'
            j++
          } else if (char === '"') {
            insideQuotes = !insideQuotes
          } else if (char === ',' && !insideQuotes) {
            values.push(currentValue)
            currentValue = ''
          } else {
            currentValue += char
          }
        }
        values.push(currentValue)
        
        // ヘッダーとマッピング
        const row = {}
        headers.forEach((header, idx) => {
          row[header] = (values[idx] || '').trim()
        })
        
        console.log(`${lineNumber}行目データ:`, row)
        
        // メールアドレス必須チェック
        if (!row['メールアドレス'] || !row['メールアドレス'].trim()) {
          skippedRows.push({
            line: lineNumber,
            email: row['メールアドレス'] || '(空)',
            reason: 'メールアドレスは必須です'
          })
          continue
        }
        
        const email = row['メールアドレス'].trim()
        
        // メールアドレス重複チェック
        const existingMember = await DB.prepare(`
          SELECT id FROM members WHERE email = ?
        `).bind(email).first()
        
        if (existingMember) {
          skippedRows.push({
            line: lineNumber,
            email: email,
            reason: 'メールアドレスが既に登録されています'
          })
          continue
        }
        
        // 都道府県IDの自動判定
        let prefId = null
        const prefName = row['都道府県']
        if (prefName) {
          prefId = prefMap[prefName]
          if (!prefId) {
            skippedRows.push({
              line: lineNumber,
              email: email,
              reason: `都道府県「${prefName}」が見つかりません`
            })
            continue
          }
        }
        
        // 会員レコード作成
        await DB.prepare(`
          INSERT INTO members (
            email, password_hash,
            family_name, first_name, family_kana, first_kana,
            last_name_en, first_name_en,
            sex, birth, zip, pref_id, addr, tel, mobile, enable_flg
          ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        `).bind(
          email,
          passwordHash,
          row['姓'] || '',
          row['名'] || '',
          row['姓カナ'] || '',
          row['名カナ'] || '',
          row['姓（英語）'] || null,
          row['名（英語）'] || null,
          row['性別'] || null,
          row['生年月日'] || null,
          row['郵便番号'] || null,
          prefId,
          row['住所'] || null,
          row['電話番号'] || '',
          row['携帯電話'] || null,
          row['有効フラグ'] ? parseInt(row['有効フラグ']) : 1
        ).run()
        
        registeredMembers.push({
          line: lineNumber,
          email: email
        })
        
      } catch (error) {
        console.error(`${lineNumber}行目処理エラー:`, error)
        skippedRows.push({
          line: lineNumber,
          email: row['メールアドレス'] || '(不明)',
          reason: `処理エラー: ${error.message}`
        })
      }
    }
    
    console.log('登録完了:', registeredMembers.length, '件')
    console.log('スキップ:', skippedRows.length, '件')
    
    return c.json({ 
      success: true,
      registered: registeredMembers.length,
      skipped: skippedRows.length,
      skippedRows: skippedRows,
      message: `${registeredMembers.length}件の会員を登録しました${skippedRows.length > 0 ? `（${skippedRows.length}件スキップ）` : ''}`
    })
    
  } catch (error) {
    console.error('会員CSVアップロードエラー:', error)
    console.error('エラースタック:', error.stack)
    return c.json({ 
      success: false, 
      error: '会員CSVのアップロードに失敗しました: ' + error.message 
    }, 500)
  }
})

