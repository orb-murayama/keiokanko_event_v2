// API: 主催者登録
app.post('/api/organizers', requireAuth, async (c) => {
  const { DB } = c.env
  const data = await c.req.json()

  try {
    const result = await DB.prepare(`
      INSERT INTO organizers (
        name, contactable_person, branch_office, zip, pref_id, addr, tel, fax, email, password,
        business_hours, closed_days, business_notes,
        registration_number, association_name, association_membership,
        travel_manager_title, travel_manager_name,
        remarks, reg_flg
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      data.name,
      data.contactable_person || null,
      data.branch_office || null,
      data.zip || null,
      data.pref_id || null,
      data.addr || null,
      data.tel || null,
      data.fax || null,
      data.email || null,
      data.password || '',
      data.business_hours || null,
      data.closed_days || null,
      data.business_notes || null,
      data.registration_number || null,
      data.association_name || null,
      data.association_membership || null,
      data.travel_manager_title || null,
      data.travel_manager_name || null,
      data.remarks || null,
      data.reg_flg !== undefined ? data.reg_flg : 1
    ).run()

    return c.json({ success: true, id: result.meta.last_row_id })
  } catch (error: any) {
    console.error('主催者登録エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

app.put('/api/organizers/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  const data = await c.req.json()

  try {
    // パスワード更新がある場合とない場合で分岐
    let query = `
      UPDATE organizers SET
        name = ?,
        contactable_person = ?,
        branch_office = ?,
        zip = ?,
        pref_id = ?,
        addr = ?,
        tel = ?,
        fax = ?,
        email = ?,
        business_hours = ?,
        closed_days = ?,
        business_notes = ?,
        registration_number = ?,
        association_name = ?,
        association_membership = ?,
        travel_manager_title = ?,
        travel_manager_name = ?,
        remarks = ?,
        reg_flg = ?,
        modified_at = datetime('now', 'localtime')
    `
    
    const params = [
      data.name,
      data.contactable_person || null,
      data.branch_office || null,
      data.zip || null,
      data.pref_id || null,
      data.addr || null,
      data.tel || null,
      data.fax || null,
      data.email || null,
      data.business_hours || null,
      data.closed_days || null,
      data.business_notes || null,
      data.registration_number || null,
      data.association_name || null,
      data.association_membership || null,
      data.travel_manager_title || null,
      data.travel_manager_name || null,
      data.remarks || null,
      data.reg_flg !== undefined ? data.reg_flg : 1
    ]

    if (data.password) {
      query += `, password = ?`
      params.push(data.password)
    }

    query += ` WHERE id = ?`
    params.push(id)

    await DB.prepare(query).bind(...params).run()

    return c.json({ message: '主催者情報を更新しました' })
  } catch (error) {
    console.error('主催者更新エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API: 主催者削除
app.delete('/api/organizers/:id', requireAuth, async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')

  try {
    // 主催者が存在するか確認
    const organizer = await DB.prepare('SELECT id FROM organizers WHERE id = ?')
      .bind(id)
      .first()
    
    if (!organizer) {
      return c.json({ error: '主催者が見つかりません' }, 404)
    }

    // 主催者を削除
    await DB.prepare('DELETE FROM organizers WHERE id = ?')
      .bind(id)
      .run()

    return c.json({ message: '主催者を削除しました' })
  } catch (error) {
    console.error('主催者削除エラー:', error)
    return c.json({ error: '主催者の削除に失敗しました' }, 500)
  }
})

