app.get('/api/members/:id', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  const id = c.req.param('id')
  
  try {
    const member = await DB.prepare(`
      SELECT m.*, p.name as pref_name
      FROM members m
      LEFT JOIN prefs p ON m.pref_id = p.id
      WHERE m.id = ?
    `).bind(id).first()
    
    if (!member) {
      return c.json({ error: '会員が見つかりません' }, 404)
    }
    
    return c.json(member)
  } catch (error) {
    console.error('Error fetching member:', error)
    return c.json({ error: '会員情報の取得に失敗しました' }, 500)
  }
})

// API: 会員新規作成（system_admin と admin のみ）
app.post('/api/members', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  
  try {
    const body = await c.req.json()
    const {
      email, family_name, first_name, family_kana, first_kana,
      last_name_en, first_name_en, sex, birth, tel, mobile, zip, pref_id, addr, enable_flg
    } = body
    
    console.log('========== 会員新規作成 ==========')
    console.log('リクエストデータ:', JSON.stringify(body, null, 2))
    
    // バリデーション
    if (!email || !email.trim()) {
      return c.json({ error: 'メールアドレスは必須です' }, 400)
    }
    if (!family_name || !family_name.trim()) {
      return c.json({ error: '姓は必須です' }, 400)
    }
    if (!first_name || !first_name.trim()) {
      return c.json({ error: '名は必須です' }, 400)
    }
    
    // メールアドレスの重複チェック
    const existingMember = await DB.prepare(`
      SELECT id FROM members WHERE email = ?
    `).bind(email.trim()).first()
    
    if (existingMember) {
      return c.json({ error: 'このメールアドレスは既に登録されています' }, 400)
    }
    
    // 会員を作成
    const result = await DB.prepare(`
      INSERT INTO members (
        email, password_hash, family_name, first_name, family_kana, first_kana,
        last_name_en, first_name_en, sex, birth, tel, mobile, zip, pref_id, addr, enable_flg,
        created_at, modified_at
      ) VALUES (?, '', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now', 'localtime'), datetime('now', 'localtime'))
    `).bind(
      email.trim(),
      family_name.trim(),
      first_name.trim(),
      family_kana?.trim() || '',
      first_kana?.trim() || '',
      last_name_en?.trim() || null,
      first_name_en?.trim() || null,
      sex || null,
      birth || null,
      tel?.trim() || '',
      mobile?.trim() || null,
      zip?.trim() || null,
      pref_id || null,
      addr?.trim() || null,
      enable_flg !== undefined ? enable_flg : 1
    ).run()
    
    const newMemberId = result.meta.last_row_id
    
    console.log('会員作成成功 (id:', newMemberId, ')')
    
    return c.json({
      success: true,
      id: newMemberId,
      message: '会員を登録しました'
    })
    
  } catch (error) {
    console.error('会員作成エラー:', error)
    return c.json({ error: '会員の登録に失敗しました' }, 500)
  }
})

// API: 会員更新（system_admin と admin のみ）
