// 管理者用OTP送信
app.post('/api/admin/auth/send-otp', async (c) => {
  const { DB } = c.env
  const { email } = await c.req.json()
  
  if (!email) {
    return c.json({ error: 'メールアドレスが必要です' }, 400)
  }
  
  try {
    // アカウントテーブルで管理者を確認
    const account = await DB.prepare(`
      SELECT id, login_id, person_name, email, role FROM accounts 
      WHERE email = ? AND enable_flg = 1
    `).bind(email).first()
    
    if (!account) {
      return c.json({ error: 'この管理者アカウントは存在しません' }, 404)
    }
    
    // 6桁のOTPコードを生成
    const otpCode = Math.floor(100000 + Math.random() * 900000).toString()
    
    // 有効期限を10分後に設定
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000).toISOString()
    
    // 既存の未使用OTPを削除
    await DB.prepare(`
      DELETE FROM otp_tokens 
      WHERE email = ? AND used_at IS NULL
    `).bind(email).run()
    
    // 新しいOTPを保存
    await DB.prepare(`
      INSERT INTO otp_tokens (email, otp_code, expires_at, attempts)
      VALUES (?, ?, ?, 0)
    `).bind(email, otpCode, expiresAt).run()
    
    // 本番環境ではメール送信サービスを使用
    // 開発環境ではコンソールにOTPを出力
    console.log('='.repeat(60))
    console.log('🔐 管理者ログイン OTP送信')
    console.log('='.repeat(60))
    console.log(`宛先: ${email}`)
    console.log(`管理者名: ${account.person_name}`)
    console.log(`役割: ${account.role}`)
    console.log(`OTPコード: ${otpCode}`)
    console.log(`有効期限: ${new Date(expiresAt).toLocaleString('ja-JP')}`)
    console.log('='.repeat(60))
    
    return c.json({ 
      success: true,
      message: 'ワンタイムパスワードを送信しました',
      expires_at: expiresAt,
      // 開発環境でのテスト用（本番環境では削除すること）
      dev_otp: otpCode
    })
  } catch (error: any) {
    console.error('管理者OTP生成エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 管理者用OTP検証
app.post('/api/admin/auth/verify-otp', async (c) => {
  const { DB } = c.env
  const { email, code } = await c.req.json()
  
  if (!email || !code) {
    return c.json({ error: 'メールアドレスとOTPコードが必要です' }, 400)
  }
  
  try {
    // OTPコードを取得
    const otp = await DB.prepare(`
      SELECT * FROM otp_tokens 
      WHERE email = ? AND otp_code = ? AND used_at IS NULL
      ORDER BY created_at DESC
      LIMIT 1
    `).bind(email, code).first()
    
    if (!otp) {
      // 試行回数をカウント
      await DB.prepare(`
        UPDATE otp_tokens 
        SET attempts = attempts + 1
        WHERE email = ? AND used_at IS NULL
      `).bind(email).run()
      
      return c.json({ error: 'OTPコードが正しくありません' }, 401)
    }
    
    // 有効期限チェック
    const now = new Date()
    const expiresAt = new Date(otp.expires_at)
    
    if (now > expiresAt) {
      return c.json({ error: 'OTPコードの有効期限が切れています' }, 401)
    }
    
    // 管理者アカウント取得
    const account = await DB.prepare(`
      SELECT id, login_id, person_name, email, role FROM accounts 
      WHERE email = ? AND enable_flg = 1
    `).bind(email).first()
    
    if (!account) {
      return c.json({ error: '管理者アカウントが無効化されています' }, 403)
    }
    
    // セッショントークンを生成
    const sessionToken = crypto.randomUUID()
    
    // OTPを使用済みに更新し、セッショントークンを保存
    await DB.prepare(`
      UPDATE otp_tokens 
      SET used_at = datetime('now'), session_token = ?
      WHERE id = ?
    `).bind(sessionToken, otp.id).run()
    
    // httpOnly Cookieにセッショントークンを保存（XSS対策）
    setCookie(c, 'admin_session_token', sessionToken, {
      httpOnly: true,      // JavaScriptからアクセス不可（XSS対策）
      secure: true,        // HTTPS通信のみ
      sameSite: 'Strict',  // CSRF対策
      maxAge: 86400,       // 24時間
      path: '/'
    })
    
    console.log('='.repeat(60))
    console.log('✅ 管理者ログイン成功')
    console.log('='.repeat(60))
    console.log(`管理者: ${account.person_name} (${account.email})`)
    console.log(`役割: ${account.role}`)
    console.log(`セッショントークン: ${sessionToken}`)
    console.log('='.repeat(60))
    
    return c.json({ 
      success: true,
      // session_token をレスポンスから削除（Cookieで送信するため不要）
      account: {
        id: account.id,
        login_id: account.login_id,
        person_name: account.person_name,
        email: account.email,
        role: account.role
      }
    })
  } catch (error: any) {
    console.error('管理者OTP検証エラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

// 管理者セッション検証
app.get('/api/admin/auth/session', async (c) => {
  const { DB } = c.env
  
  // Cookieからセッショントークンを取得（優先）
  let sessionToken = getCookie(c, 'admin_session_token')
  
  // フォールバック: Authorization ヘッダーからも取得可能にする（開発用）
  if (!sessionToken) {
    const authHeader = c.req.header('Authorization')
    sessionToken = authHeader?.replace('Bearer ', '') || c.req.query('token')
  }
  
  if (!sessionToken) {
    return c.json({ authenticated: false, error: '認証が必要です' }, 401)
  }
  
  try {
    // セッショントークンを検証
    const otp = await DB.prepare(`
      SELECT * FROM otp_tokens 
      WHERE session_token = ? AND used_at IS NOT NULL
    `).bind(sessionToken).first()
    
    if (!otp) {
      return c.json({ authenticated: false, error: 'セッションが無効です' }, 401)
    }
    
    // セッションの有効期限チェック（使用後24時間まで有効）
    const usedAt = new Date(otp.used_at)
    const now = new Date()
    const hoursSinceUse = (now.getTime() - usedAt.getTime()) / (1000 * 60 * 60)
    
    if (hoursSinceUse > 24) {
      return c.json({ authenticated: false, error: 'セッションの有効期限が切れています' }, 401)
    }
    
    // 管理者アカウント取得
    const account = await DB.prepare(`
      SELECT id, login_id, person_name, email, role FROM accounts 
      WHERE email = ? AND enable_flg = 1
    `).bind(otp.email).first()
    
    if (!account) {
      return c.json({ authenticated: false, error: '管理者アカウントが無効化されています' }, 403)
    }
    
    return c.json({ 
      authenticated: true,
      account: {
        id: account.id,
        login_id: account.login_id,
        person_name: account.person_name,
        email: account.email,
        role: account.role
      }
    })
  } catch (error: any) {
    console.error('管理者セッション検証エラー:', error)
    return c.json({ authenticated: false, error: error.message }, 500)
  }
})

// 管理者ログアウト
app.post('/api/admin/auth/logout', async (c) => {
  const { DB } = c.env
  
  // Cookieからセッショントークンを取得（優先）
  let sessionToken = getCookie(c, 'admin_session_token')
  
  // フォールバック: Authorization ヘッダーからも取得
  if (!sessionToken) {
    const authHeader = c.req.header('Authorization')
    sessionToken = authHeader?.replace('Bearer ', '')
  }
  
  if (!sessionToken) {
    return c.json({ error: '認証が必要です' }, 401)
  }
  
  try {
    // セッショントークンを削除（論理削除）
    await DB.prepare(`
      UPDATE otp_tokens 
      SET session_token = NULL
      WHERE session_token = ?
    `).bind(sessionToken).run()
    
    // Cookieを削除
    deleteCookie(c, 'admin_session_token', {
      path: '/'
    })
    
    return c.json({ success: true, message: 'ログアウトしました' })
  } catch (error: any) {
    console.error('管理者ログアウトエラー:', error)
    return c.json({ error: error.message }, 500)
  }
})

export default app
