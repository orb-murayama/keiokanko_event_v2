app.post('/api/events/upload-image', async (c) => {
  const { R2 } = c.env
  
  try {
    const formData = await c.req.formData()
    const file = formData.get('image')
    
    if (!file || !(file instanceof File)) {
      return c.json({ error: '画像ファイルが選択されていません' }, 400)
    }
    
    // ファイルサイズチェック（5MB制限）
    if (file.size > 5 * 1024 * 1024) {
      return c.json({ error: '画像ファイルは5MB以下にしてください' }, 400)
    }
    
    // ファイルタイプチェック
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp']
    if (!allowedTypes.includes(file.type)) {
      return c.json({ error: '対応していない画像形式です（JPEG, PNG, GIF, WebPのみ）' }, 400)
    }
    
    // ファイル名を生成（タイムスタンプ + ランダム文字列）
    const timestamp = Date.now()
    const randomStr = Math.random().toString(36).substring(2, 15)
    const ext = file.name.split('.').pop()
    const fileName = `events/${timestamp}-${randomStr}.${ext}`
    
    // R2にアップロード
    const arrayBuffer = await file.arrayBuffer()
    await R2.put(fileName, arrayBuffer, {
      httpMetadata: {
        contentType: file.type
      }
    })
    
    // URLを返す（本番環境ではカスタムドメインまたはR2のPublic URLを使用）
    const imageUrl = `/api/events/images/${fileName}`
    
    return c.json({ 
      success: true,
      image_url: imageUrl,
      file_name: fileName
    })
  } catch (error) {
    console.error('Event image upload error:', error)
    return c.json({ error: '画像のアップロードに失敗しました' }, 500)
  }
})

// API - イベント画像取得
app.get('/api/events/images/*', async (c) => {
  const { R2 } = c.env
  const fileName = c.req.path.replace('/api/events/images/', '')
  
  try {
    const object = await R2.get(fileName)
    
    if (!object) {
      return c.notFound()
    }
    
    const headers = new Headers()
    headers.set('Content-Type', object.httpMetadata?.contentType || 'image/jpeg')
    headers.set('Cache-Control', 'public, max-age=31536000')
    
    return new Response(object.body, { headers })
  } catch (error) {
    console.error('Event image fetch error:', error)
    return c.notFound()
  }
})

// API - 商品登録
// API - 商品画像アップロード
app.post('/api/products/upload-image', async (c) => {
  try {
    const formData = await c.req.formData()
    const file = formData.get('image')
    
    if (!file || !(file instanceof File)) {
      return c.json({ error: '画像ファイルが選択されていません' }, 400)
    }
    
    // ファイルサイズチェック（5MB）
    const maxSize = 5 * 1024 * 1024
    if (file.size > maxSize) {
      return c.json({ error: 'ファイルサイズは5MB以下にしてください' }, 400)
    }
    
    // ファイルタイプチェック
    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif']
    if (!allowedTypes.includes(file.type)) {
      return c.json({ error: '対応していないファイル形式です（JPG、PNG、GIFのみ）' }, 400)
    }
    
    // ファイル名生成（タイムスタンプ + ランダム文字列）
    const timestamp = Date.now()
    const random = Math.random().toString(36).substring(2, 8)
    const ext = file.name.split('.').pop()
    const fileName = `product_${timestamp}_${random}.${ext}`
    
    // Base64エンコード（実際の実装ではCloudflare R2などに保存）
    const arrayBuffer = await file.arrayBuffer()
    const base64 = btoa(String.fromCharCode(...new Uint8Array(arrayBuffer)))
    const dataUrl = `data:${file.type};base64,${base64}`
    
    // TODO: 本番環境ではCloudflare R2やS3などに保存
    // 現在はBase64 Data URLとして返す（デモ用）
    console.log('画像アップロード:', { fileName, size: file.size, type: file.type })
    
    return c.json({ 
      success: true,
      image_url: dataUrl,
      file_name: fileName
    })
  } catch (error) {
    console.error('画像アップロードエラー:', error)
    return c.json({ error: '画像のアップロードに失敗しました' }, 500)
  }
})

app.post('/api/products', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.event_id || !data.prices || data.prices.length === 0 || !data.sales_start || !data.sales_end) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントからclient_idを取得
    const event = await DB.prepare(`
      SELECT client_id FROM events WHERE id = ?
    `).bind(parseInt(data.event_id)).first()
    
    if (!event) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    // 共通名称設定と取消条件設定（フロントエンドから配列で受け取る）
    const commonNames = data.common_names || [];
    const cancellationPolicyDetails = data.cancellation_policy_details || [];
    
    console.log('[バックエンド] 受信データ:', {
      common_names: data.common_names,
      commonNames: commonNames,
      cancellation_policy_details: data.cancellation_policy_details
    });
    
    // 後方互換性：古い形式（common_name_1など）もサポート
    if (commonNames.length === 0) {
      for (let i = 1; i <= 5; i++) {
        if (data[`common_name_${i}`]) {
          commonNames.push({
            label: `名称${i}`,
            name: data[`common_name_${i}`],
            description: data[`common_desc_${i}`] || ''
          });
        }
      }
    }
    
    // 後方互換性：cancellation_policy_detailsの古い形式もサポート
    if (cancellationPolicyDetails.length === 0) {
      for (let i = 1; i <= 5; i++) {
        if (data[`cancellation_days_${i}`]) {
          cancellationPolicyDetails.push({
            days: parseInt(data[`cancellation_days_${i}`]),
            rate: parseInt(data[`cancellation_rate_${i}`]) || 0
          });
        }
      }
    }
    
    // 商品を登録（テーブル構造に合わせて実際に存在するカラムのみ）
    const productResult = await DB.prepare(`
      INSERT INTO products (
        client_id, event_id, product_category_id, name, sales_start, sales_end, 
        closing_trade, description, remarks, note, fee_include, fee_exclude, 
        cancel_policy, purchase_limit, deposit_address, enable_flg,
        common_names, cancellation_policy_details,
        price_unit, charge_type, charge_description, image_url,
        form_field_settings
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      event.client_id,
      parseInt(data.event_id),
      data.product_category_id ? parseInt(data.product_category_id) : null,
      data.name,
      data.sales_start,
      data.sales_end,
      parseInt(data.closing_trade) || 0,
      data.description || '',
      data.remarks || '',
      data.note || '',
      data.fee_include || '',
      data.fee_exclude || '',
      data.cancel_policy || '',
      parseInt(data.purchase_limit) || null,
      data.deposit_address || null,
      parseInt(data.enable_flg) || 1,
      JSON.stringify(commonNames),
      JSON.stringify(cancellationPolicyDetails),
      data.price_unit || '人',
      data.charge_type || 'per_person',
      data.charge_description || '',
      data.image_url || null,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}'
    ).run()
    
    const productId = productResult.meta.last_row_id
    
    // 価格帯データを登録
    // フロントエンドから送信される形式: [{ price_band: "A", category_name: "A-名称1", price_name: "大人", price: 10000, slot_number: 1, display_order: 0 }, ...]
    for (const priceData of data.prices) {
      await DB.prepare(`
        INSERT INTO product_prices (
          product_id, 
          price, 
          price_band, 
          category_name,
          price_name,
          slot_number,
          display_order
        ) VALUES (?, ?, ?, ?, ?, ?, ?)
      `).bind(
        productId,
        parseInt(priceData.price) || 0,
        priceData.price_band || '',
        priceData.category_name || '',
        priceData.price_name || '',
        parseInt(priceData.slot_number) || 1,
        parseInt(priceData.display_order) || 0
      ).run()
    }
    
    return c.json({ 
      success: true, 
      id: productId,
      message: '商品を登録しました' 
    })
  } catch (error) {
    console.error('Product registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品コピー
app.post('/api/products/:id/copy', async (c) => {
  const { DB } = c.env
  const sourceProductId = c.req.param('id')
  
  try {
    // 元の商品情報を取得
    const sourceProduct = await DB.prepare(`
      SELECT * FROM products WHERE id = ? AND deleted_at IS NULL
    `).bind(parseInt(sourceProductId)).first()
    
    if (!sourceProduct) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    // 同じイベントで「（コピー）」または「（コピーN）」を持つ商品数をカウント
    // LIKE パターンの複雑性を避けるため、全商品を取得してアプリケーション側でフィルタ
    const { results: allProducts } = await DB.prepare(`
      SELECT name FROM products
      WHERE event_id = ? AND deleted_at IS NULL
    `).bind(sourceProduct.event_id).all()
    
    // JavaScriptでフィルタリング
    const copyPattern = new RegExp(`^${sourceProduct.name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}（コピー\\d*）$`)
    const existingCopies = allProducts.filter(p => copyPattern.test(p.name))
    const copyCount = existingCopies.length
    
    // 商品名に「（コピー）」または「（コピーN）」を追加
    const newProductName = copyCount === 0 
      ? `${sourceProduct.name}（コピー）`
      : `${sourceProduct.name}（コピー${copyCount + 1}）`
    
    // NULL値を正しく処理するヘルパー関数
    const toNull = (value) => {
      if (value === undefined || value === null || value === 'null') return null
      return value
    }
    
    // 新しい商品を作成
    const newProduct = await DB.prepare(`
      INSERT INTO products (
        client_id, event_id, name, sales_start, sales_end, closing_trade,
        product_category_id, description, remarks, fee_include, fee_exclude,
        cancel_policy, purchase_limit, deposit_address, note, enable_flg,
        slot_type, common_names, cancellation_policy_details, price_unit,
        charge_type, charge_description, image_url, form_field_settings
      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `).bind(
      toNull(sourceProduct.client_id),
      toNull(sourceProduct.event_id),
      newProductName,
      toNull(sourceProduct.sales_start),
      toNull(sourceProduct.sales_end),
      sourceProduct.closing_trade || 0,
      toNull(sourceProduct.product_category_id),
      toNull(sourceProduct.description),
      toNull(sourceProduct.remarks),
      toNull(sourceProduct.fee_include),
      toNull(sourceProduct.fee_exclude),
      toNull(sourceProduct.cancel_policy),
      toNull(sourceProduct.purchase_limit),
      toNull(sourceProduct.deposit_address),
      toNull(sourceProduct.note),
      sourceProduct.enable_flg || 1,
      sourceProduct.slot_type || 0,
      toNull(sourceProduct.common_names),
      toNull(sourceProduct.cancellation_policy_details),
      toNull(sourceProduct.price_unit),
      toNull(sourceProduct.charge_type),
      toNull(sourceProduct.charge_description),
      toNull(sourceProduct.image_url),
      toNull(sourceProduct.form_field_settings)
    ).run()
    
    const newProductId = newProduct.meta.last_row_id
    
    // 価格帯をコピー
    const { results: prices } = await DB.prepare(`
      SELECT * FROM product_prices WHERE product_id = ?
    `).bind(parseInt(sourceProductId)).all()
    
    for (const price of prices) {
      await DB.prepare(`
        INSERT INTO product_prices (
          product_id, price, price_band, category_name, price_name,
          slot_number, display_order
        ) VALUES (?, ?, ?, ?, ?, ?, ?)
      `).bind(
        newProductId,
        toNull(price.price),
        toNull(price.price_band),
        toNull(price.category_name),
        toNull(price.price_name),
        toNull(price.slot_number),
        toNull(price.display_order)
      ).run()
    }
    
    // 在庫をコピー
    const { results: stocks } = await DB.prepare(`
      SELECT * FROM product_stocks WHERE product_id = ?
    `).bind(parseInt(sourceProductId)).all()
    
    for (const stock of stocks) {
      await DB.prepare(`
        INSERT INTO product_stocks (
          product_id, date, stock, booked, time_slot_start, time_slot_end,
          time_slot_label, stock_name, shared_pool_id, price_band
        ) VALUES (?, ?, ?, 0, ?, ?, ?, ?, ?, ?)
      `).bind(
        newProductId,
        toNull(stock.date),
        toNull(stock.stock),
        toNull(stock.time_slot_start),
        toNull(stock.time_slot_end),
        toNull(stock.time_slot_label),
        toNull(stock.stock_name),
        toNull(stock.shared_pool_id),
        toNull(stock.price_band)
      ).run()
    }
    
    // フォームフィールドをコピー
    const { results: formFields } = await DB.prepare(`
      SELECT * FROM product_form_fields WHERE product_id = ? ORDER BY display_order
    `).bind(parseInt(sourceProductId)).all()
    
    const fieldIdMapping = {} // 元のfield_id -> 新しいfield_id
    
    // 第1パス: すべてのフィールドを作成
    for (const field of formFields) {
      const newField = await DB.prepare(`
        INSERT INTO product_form_fields (
          product_id, field_type, field_name, field_label, field_options,
          is_required, description, display_order, placeholder,
          parent_field_id, parent_condition, indent_level, category
        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
      `).bind(
        newProductId,
        toNull(field.field_type),
        toNull(field.field_name),
        toNull(field.field_label),
        toNull(field.field_options),
        field.is_required || 0,
        toNull(field.description),
        field.display_order || 0,
        toNull(field.placeholder),
        null, // 第2パスで更新
        toNull(field.parent_condition),
        field.indent_level || 0,
        field.category || 1
      ).run()
      
      fieldIdMapping[field.id] = newField.meta.last_row_id
    }
    
    // 第2パス: parent_field_idを更新
    for (const field of formFields) {
      if (field.parent_field_id) {
        const newFieldId = fieldIdMapping[field.id]
        const newParentId = fieldIdMapping[field.parent_field_id]
        
        if (newFieldId && newParentId) {
          await DB.prepare(`
            UPDATE product_form_fields
            SET parent_field_id = ?
            WHERE id = ?
          `).bind(newParentId, newFieldId).run()
        }
      }
    }
    
    return c.json({
      success: true,
      id: newProductId,
      message: `商品「${newProductName}」をコピーしました`
    })
  } catch (error) {
    console.error('Product copy error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品詳細取得
app.get('/api/products/:id', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    // 商品情報を取得
    const product = await DB.prepare(`
      SELECT 
        p.*,
        e.name as event_name
      FROM products p
      LEFT JOIN events e ON p.event_id = e.id
      WHERE p.id = ? AND p.deleted_at IS NULL
    `).bind(parseInt(productId)).first()
    
    if (!product) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    // 価格帯情報を取得
    const prices = await DB.prepare(`
      SELECT * FROM product_prices
      WHERE product_id = ?
      ORDER BY id
    `).bind(parseInt(productId)).all()
    
    // JSONフィールドをパース
    let commonNames = [];
    let cancellationPolicyDetails = [];
    let formFieldSettings = {};
    try {
      if (product.common_names) {
        // 二重エンコードされている可能性があるため、複数回パースを試みる
        let parsedCommonNames = product.common_names;
        
        // 文字列の場合、パースを試みる
        if (typeof parsedCommonNames === 'string') {
          try {
            parsedCommonNames = JSON.parse(parsedCommonNames);
          } catch (e) {
            console.error('First parse failed, trying again:', e);
          }
          
          // まだ文字列の場合、もう一度パース
          if (typeof parsedCommonNames === 'string') {
            try {
              parsedCommonNames = JSON.parse(parsedCommonNames);
            } catch (e) {
              console.error('Second parse failed:', e);
            }
          }
        }
        
        // 配列であることを確認
        if (Array.isArray(parsedCommonNames)) {
          commonNames = parsedCommonNames;
        } else {
          console.error('common_names is not an array:', parsedCommonNames);
          commonNames = [];
        }
      }
      
      if (product.cancellation_policy_details) {
        let parsedDetails = product.cancellation_policy_details;
        
        if (typeof parsedDetails === 'string') {
          try {
            parsedDetails = JSON.parse(parsedDetails);
          } catch (e) {
            console.error('Cancellation policy parse failed:', e);
          }
          
          if (typeof parsedDetails === 'string') {
            try {
              parsedDetails = JSON.parse(parsedDetails);
            } catch (e) {
              console.error('Cancellation policy second parse failed:', e);
            }
          }
        }
        
        if (Array.isArray(parsedDetails)) {
          cancellationPolicyDetails = parsedDetails;
        } else {
          cancellationPolicyDetails = [];
        }
      }
      
      // form_field_settingsをパース
      if (product.form_field_settings) {
        let parsedSettings = product.form_field_settings;
        
        if (typeof parsedSettings === 'string') {
          try {
            parsedSettings = JSON.parse(parsedSettings);
          } catch (e) {
            console.error('form_field_settings parse failed:', e);
          }
        }
        
        if (typeof parsedSettings === 'object' && parsedSettings !== null) {
          formFieldSettings = parsedSettings;
          
          // 管理画面表示用に統合フィールドを追加
          // lastname_kanji と firstname_kanji が両方 true なら name_kanji も true
          if (formFieldSettings.lastname_kanji === true && formFieldSettings.firstname_kanji === true) {
            formFieldSettings.name_kanji = true;
          }
          if (formFieldSettings.lastname_kana === true && formFieldSettings.firstname_kana === true) {
            formFieldSettings.name_kana = true;
          }
          if (formFieldSettings.lastname_roman === true && formFieldSettings.firstname_roman === true) {
            formFieldSettings.name_roman = true;
          }
        } else {
          formFieldSettings = {};
        }
      }
    } catch (e) {
      console.error('JSON parse error:', e);
    }
    
    // pricesに共通名称を追加
    const enrichedPrices = (prices.results || []).map(priceItem => {
      // price_nameが存在する場合はそれを使用
      if (priceItem.price_name) {
        return {
          ...priceItem,
          common_name: priceItem.price_name,
          common_description: ''
        };
      }
      
      // 旧形式：category_nameから「名称X」のXを抽出（例: "A-名称1" → 1）
      let commonName = '';
      let commonDescription = '';
      if (priceItem.category_name && Array.isArray(commonNames)) {
        const match = priceItem.category_name.match(/名称(\d+)$/);
        if (match) {
          const slotNumber = parseInt(match[1]); // 1, 2, 3...
          // commonNamesから対応する名称を取得
          const commonNameItem = commonNames.find(item => {
            // labelフィールドがある場合
            if (item.label === `名称${slotNumber}`) {
              return true;
            }
            // インデックスで判定（0-based）
            return false;
          });
          
          // インデックスベースでも試す（0-based）
          const indexBasedItem = commonNames[slotNumber - 1];
          
          if (commonNameItem) {
            commonName = commonNameItem.name || '';
            commonDescription = commonNameItem.description || '';
          } else if (indexBasedItem) {
            commonName = indexBasedItem.name || '';
            commonDescription = indexBasedItem.description || '';
          }
        }
      }
      
      return {
        ...priceItem,
        common_name: commonName,          // 「大人」「子供」など
        common_description: commonDescription  // 「大人料金」など
      };
    });
    
    return c.json({ 
      product: {
        ...product,
        common_names: commonNames,
        cancellation_policy_details: cancellationPolicyDetails,
        form_field_settings: formFieldSettings,
        prices: enrichedPrices
      }
    })
  } catch (error) {
    console.error('Product detail error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 商品更新
app.put('/api/products/:id', async (c) => {
  const { DB } = c.env
  const productId = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.name || !data.event_id) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 共通名称設定と取消条件設定（フロントエンドから配列で受け取る）
    const commonNames = data.common_names || [];
    const cancellationPolicyDetails = data.cancellation_policy_details || [];
    
    console.log('[バックエンド] 受信データ:', {
      common_names: data.common_names,
      commonNames: commonNames,
      cancellation_policy_details: data.cancellation_policy_details
    });
    
    // 後方互換性：古い形式（common_name_1など）もサポート
    if (commonNames.length === 0) {
      for (let i = 1; i <= 5; i++) {
        if (data[`common_name_${i}`]) {
          commonNames.push({
            label: `名称${i}`,
            name: data[`common_name_${i}`],
            description: data[`common_desc_${i}`] || ''
          });
        }
      }
    }
    
    // 後方互換性：cancellation_policy_detailsの古い形式もサポート
    if (cancellationPolicyDetails.length === 0) {
      for (let i = 1; i <= 5; i++) {
        if (data[`cancellation_days_${i}`]) {
          cancellationPolicyDetails.push({
            days: parseInt(data[`cancellation_days_${i}`]),
            rate: parseInt(data[`cancellation_rate_${i}`]) || 0
          });
        }
      }
    }
    
    // 商品を更新（実際に存在するカラムのみ）
    const result = await DB.prepare(`
      UPDATE products
      SET event_id = ?,
          product_category_id = ?,
          name = ?,
          sales_start = ?,
          sales_end = ?,
          description = ?,
          remarks = ?,
          note = ?,
          fee_include = ?,
          fee_exclude = ?,
          deposit_address = ?,
          cancel_policy = ?,
          closing_trade = ?,
          purchase_limit = ?,
          enable_flg = ?,
          common_names = ?,
          cancellation_policy_details = ?,
          price_unit = ?,
          charge_type = ?,
          charge_description = ?,
          image_url = ?,
          form_field_settings = ?,
          modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      parseInt(data.event_id),
      data.product_category_id ? parseInt(data.product_category_id) : null,
      data.name,
      data.sales_start,
      data.sales_end,
      data.description || '',
      data.remarks || '',
      data.note || '',
      data.fee_include || '',
      data.fee_exclude || '',
      data.deposit_address || null,
      data.cancel_policy || '',
      parseInt(data.closing_trade) || 0,
      parseInt(data.purchase_limit) || null,
      parseInt(data.enable_flg) || 1,
      JSON.stringify(commonNames),
      JSON.stringify(cancellationPolicyDetails),
      data.price_unit || '人',
      data.charge_type || 'per_person',
      data.charge_description || '',
      data.image_url || null,
      data.form_field_settings || '{"name_kanji":true,"name_kana":true,"name_roma":false,"address":true,"tel":true,"birth_date":false,"age":false}',
      parseInt(productId)
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: '商品が見つかりません' }, 404)
    }
    
    // 価格帯データを更新（既存の価格を削除して再登録）
    if (data.prices && Array.isArray(data.prices)) {
      // 既存の価格をすべて削除
      await DB.prepare(`
        DELETE FROM product_prices WHERE product_id = ?
      `).bind(parseInt(productId)).run()
      
      // 新しい価格データを登録
      // フロントエンドから送信される形式: [{ price_band: "A", category_name: "A-名称1", price_name: "大人", price: 10000, slot_number: 1, display_order: 0 }, ...]
      for (const priceData of data.prices) {
        await DB.prepare(`
          INSERT INTO product_prices (
            product_id, 
            price, 
            price_band, 
            category_name,
            price_name,
            slot_number,
            display_order
          ) VALUES (?, ?, ?, ?, ?, ?, ?)
        `).bind(
          parseInt(productId),
          parseInt(priceData.price) || 0,
          priceData.price_band || '',
          priceData.category_name || '',
          priceData.price_name || '',
          parseInt(priceData.slot_number) || 1,
          parseInt(priceData.display_order) || 0
        ).run()
      }
    }
    
    return c.json({ 
      success: true,
      message: '商品を更新しました' 
    })
  } catch (error) {
    console.error('Product update error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - オプション登録
app.post('/api/options', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック（priceを削除）
    if (!data.name || !data.event_id || !data.option_category_id) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // イベントが存在するか確認
    const event = await DB.prepare(`
      SELECT id FROM events WHERE id = ?
    `).bind(parseInt(data.event_id)).first()
    
    if (!event) {
      return c.json({ error: 'イベントが見つかりません' }, 404)
    }
    
    // オプションを登録（client_idカラムは存在しないため除外）
    const optionResult = await DB.prepare(`
      INSERT INTO options (
        event_id, name, option_category_id,
        description, remarks, enable_flg, image_url
      ) VALUES (?, ?, ?, ?, ?, ?, ?)
    `).bind(
      parseInt(data.event_id),
      data.name,
      parseInt(data.option_category_id),
      data.description || '',
      data.remarks || '',
      parseInt(data.enable_flg) || 1,
      data.image_url || null
    ).run()
    
    const optionId = optionResult.meta.last_row_id
    
    return c.json({ 
      success: true, 
      id: optionId,
      message: 'オプションを登録しました' 
    })
  } catch (error) {
    console.error('Option registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 在庫登録
app.post('/api/stocks', async (c) => {
  const { DB } = c.env
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.product_id || !data.date || data.stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 同じ日付・在庫名・価格帯の在庫が既に存在するかチェック
    const existing = await DB.prepare(`
      SELECT id FROM product_stocks
      WHERE product_id = ? AND date = ? 
        AND (stock_name IS ? OR (stock_name IS NULL AND ? IS NULL))
        AND (price_band IS ? OR (price_band IS NULL AND ? IS NULL))
    `).bind(
      parseInt(data.product_id), 
      data.date,
      data.stock_name || null,
      data.stock_name || null,
      data.price_band || null,
      data.price_band || null
    ).first()
    
    if (existing) {
      return c.json({ error: 'この日付・在庫名・価格帯の在庫は既に登録されています。編集してください。' }, 400)
    }
    
    // 在庫を登録
    const result = await DB.prepare(`
      INSERT INTO product_stocks (
        product_id, date, stock_name, price_band, stock, booked
      ) VALUES (?, ?, ?, ?, ?, 0)
    `).bind(
      parseInt(data.product_id),
      data.date,
      data.stock_name || null,
      data.price_band || null,
      parseInt(data.stock)
    ).run()
    
    return c.json({ 
      success: true, 
      id: result.meta.last_row_id,
      message: '在庫を登録しました' 
    })
  } catch (error) {
    console.error('Stock registration error:', error)
    return c.json({ error: error.message }, 500)
  }
})

// API - 在庫更新
app.put('/api/stocks/:id', async (c) => {
  const { DB } = c.env
  const stockId = c.req.param('id')
  
  try {
    const data = await c.req.json()
    
    // 必須フィールドチェック
    if (!data.date || data.stock === undefined) {
      return c.json({ error: '必須フィールドが入力されていません' }, 400)
    }
    
    // 同じ日付・在庫名・価格帯の在庫が他に存在しないかチェック
    const duplicate = await DB.prepare(`
      SELECT id FROM product_stocks
      WHERE product_id = (SELECT product_id FROM product_stocks WHERE id = ?)
        AND date = ? 
        AND (stock_name IS ? OR (stock_name IS NULL AND ? IS NULL))
        AND (price_band IS ? OR (price_band IS NULL AND ? IS NULL))
        AND id != ?
    `).bind(
      parseInt(stockId),
      data.date,
      data.stock_name || null,
      data.stock_name || null,
      data.price_band || null,
      data.price_band || null,
      parseInt(stockId)
    ).first()
    
    if (duplicate) {
      return c.json({ error: 'この日付・在庫名・価格帯の在庫は既に存在します' }, 400)
    }
    
    // 在庫を更新
    const result = await DB.prepare(`
      UPDATE product_stocks
      SET date = ?, stock_name = ?, price_band = ?, stock = ?, modified_at = datetime('now', 'localtime')
      WHERE id = ?
    `).bind(
      data.date,
      data.stock_name || null,
      data.price_band || null,
      parseInt(data.stock),
      parseInt(stockId)
    ).run()
    
    if (result.meta.changes === 0) {
      return c.json({ error: '在庫が見つかりません' }, 404)
    }
    
    return c.json({ 
      success: true,
      message: '在庫を更新しました' 
    })
  } catch (error) {
    console.error('Stock update error:', error)
    return c.json({ error: error.message }, 500)
  }
})

