// API: 会員一覧取得（system_admin と admin のみアクセス可能）
app.get('/api/members', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  
  try {
    const page = parseInt(c.req.query('page') || '1')
    const perPage = parseInt(c.req.query('per_page') || '20')
    const offset = (page - 1) * perPage
    const search = c.req.query('search') || ''
    
    let whereClause = ''
    let bindParams = []
    
    if (search) {
      whereClause = `WHERE (m.email LIKE ? OR m.family_name LIKE ? OR m.first_name LIKE ? OR m.tel LIKE ?)`
      const searchPattern = `%${search}%`
      bindParams = [searchPattern, searchPattern, searchPattern, searchPattern]
    }
    
    const countQuery = `SELECT COUNT(*) as total FROM members m ${whereClause}`
    const countResult = await DB.prepare(countQuery).bind(...bindParams).first()
    const total = countResult.total
    
    const dataQuery = `
      SELECT m.id, m.email, m.family_name, m.first_name, m.family_kana, m.first_kana,
             m.sex, m.birth, m.tel, m.zip, m.pref_id, m.addr,
             m.enable_flg, m.created_at, m.modified_at, p.name as pref_name
      FROM members m
      LEFT JOIN prefs p ON m.pref_id = p.id
      ${whereClause}
      ORDER BY m.id DESC
      LIMIT ? OFFSET ?
    `
    const { results: members } = await DB.prepare(dataQuery).bind(...bindParams, perPage, offset).all()
    
    return c.json({
      data: members,
      pagination: { page: page, per_page: perPage, total: total, total_pages: Math.ceil(total / perPage) },
      search: search
    })
  } catch (error) {
    console.error('Error fetching members:', error)
    return c.json({ error: '会員一覧の取得に失敗しました' }, 500)
  }
})

// API: メールアドレス重複チェック（system_admin と admin のみ）
app.get('/api/members/check-email', requireAuth, requireRole(['system_admin', 'admin']), async (c) => {
  const { DB } = c.env
  const email = c.req.query('email')
  
  if (!email) {
    return c.json({ error: 'メールアドレスが指定されていません' }, 400)
  }
  
  try {
    const result = await DB.prepare(
      'SELECT id FROM members WHERE email = ? AND enable_flg = 1'
    ).bind(email).first()
    
    return c.json({ exists: !!result })
  } catch (error) {
    console.error('Error checking email:', error)
    return c.json({ error: 'メールアドレスのチェックに失敗しました' }, 500)
  }
})

