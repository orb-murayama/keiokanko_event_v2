// 静的ファイルの配信設定
app.use('/static/*', serveStatic({ root: './' }))

// 環境変数から動作モードを取得
// APP_MODE=customer: お客様側画面のみ
// APP_MODE=admin: 管理画面のみ
// APP_MODE=all または未設定: 両方動作（開発環境用）
const getAppMode = (c: any): 'customer' | 'admin' | 'all' => {
  const mode = c.env?.APP_MODE || 'all'
  return mode as 'customer' | 'admin' | 'all'
}

// ルートアクセス制御ミドルウェア
const routeAccessControl = (requiredMode: 'customer' | 'admin') => {
  return async (c: any, next: any) => {
    const appMode = getAppMode(c)
    
    // allモードは全てのルートにアクセス可能
    if (appMode === 'all') {
      await next()
      return
    }
    
    // モードが一致しない場合は404を返す
    if (appMode !== requiredMode) {
      return c.notFound()
    }
    
    await next()
  }
}

// CORS設定（API用）
app.use('/api/*', cors())

// Wrangler Pages Devの拡張子削除リダイレクト対応
// 拡張子なしのリクエストを対応する.htmlルートにルーティング
app.use('*', async (c, next) => {
  const url = new URL(c.req.url)
  const path = url.pathname
  // 特定のパスはミドルウェアをスキップ
  if (path === '/' || path === '/admin') {
    await next()
    return
  }
  // /admin/* で始まるパス（動的ルート）はスキップ
  if (path.startsWith('/admin/')) {
    await next()
    return
  }
  // /events/* で始まるパス（動的ルート）もスキップ
  if (path.startsWith('/events/')) {
    await next()
    return
  }
  // /booking/* で始まるパス（動的ルート）もスキップ
  if (path.startsWith('/booking/')) {
    await next()
    return
  }
  // GMOコールバックページはスキップ（クエリパラメータを保持するため）
  if (path === '/payment-callback' || path === '/booking-complete') {
    await next()
    return
  }
  // マイページルートはスキップ（OTP認証を使用）
  if (path === '/mypage' || path === '/mypage/bookings' || path.startsWith('/mypage/booking/')) {
    await next()
    return
  }
  // .htmlで終わらず、拡張子がないパス（/api/は除外）
  if (!path.includes('.') && !path.startsWith('/api/') && !path.startsWith('/static/')) {
    const htmlPath = path + '.html'
    // 対応する.htmlルートへ内部ルーティング
    const htmlUrl = new URL(htmlPath + url.search, c.req.url)
    return await app.fetch(new Request(htmlUrl, c.req.raw), c.env)
  }
  await next()
})

// 静的ファイル配信は wrangler pages dev が自動的に dist/ から配信

