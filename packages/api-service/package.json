{
  "name": "@keiokanko/api-service",
  "version": "1.0.0",
  "type": "module",
  "description": "共通APIサービス - すべてのAPIエンドポイント",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler pages dev dist --d1=webapp-v2-production --local --ip 0.0.0.0 --port 8000",
    "build": "vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name keiokanko-api",
    "db:migrate:local": "wrangler d1 migrations apply webapp-v2-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-v2-production"
  },
  "dependencies": {
    "@keiokanko/shared": "workspace:*",
    "hono": "^4.10.6",
    "csv-parse": "^6.1.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "typescript": "^5.0.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
